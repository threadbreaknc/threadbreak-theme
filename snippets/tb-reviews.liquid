{%- comment -%}
  Customer reviews strip, pulled live from Judge.me's synced shop metafield.
  Store reviews (about the business / custom orders) show first, then product reviews.
  Usage: {% render 'tb-reviews' %}
{%- endcomment -%}
{%- assign jm = shop.metafields.judgeme -%}
{%- assign rvdata = jm.all_reviews_widget_v2025_data.value -%}
{%- if rvdata -%}
<section class="tbrv" aria-labelledby="tbrvTitle">
  <div class="tbrv-head">
    <h2 id="tbrvTitle">What customers say</h2>
    <a href="/pages/reviews" class="tbrv-all">&#9733; {{ jm.all_reviews_rating | default: 5.0 | round: 1 }} from {{ jm.all_reviews_count | default: rvdata.number_of_reviews }} reviews &rarr;</a>
  </div>
  <div class="tbrv-row">
    {%- assign shown = 0 -%}
    {%- for r in rvdata.shop_reviews -%}
      {%- if r.body != blank and shown < 12 -%}
        {%- assign shown = shown | plus: 1 -%}
        <figure class="tbrv-card">
          <div class="tbrv-stars" aria-label="{{ r.rating }} out of 5 stars">{%- for i in (1..r.rating) -%}&#9733;{%- endfor -%}</div>
          <blockquote>{{ r.body | strip_html | escape | truncate: 230 }}</blockquote>
          <figcaption><strong>{{ r.reviewer_name | escape }}</strong>{% if r.verified_buyer %}<span>Verified buyer</span>{% endif %}</figcaption>
        </figure>
      {%- endif -%}
    {%- endfor -%}
    {%- for r in rvdata.product_reviews -%}
      {%- if r.body != blank and shown < 12 -%}
        {%- assign shown = shown | plus: 1 -%}
        <figure class="tbrv-card">
          <div class="tbrv-stars" aria-label="{{ r.rating }} out of 5 stars">{%- for i in (1..r.rating) -%}&#9733;{%- endfor -%}</div>
          <blockquote>{{ r.body | strip_html | escape | truncate: 230 }}</blockquote>
          <figcaption><strong>{{ r.reviewer_name | escape }}</strong>{% if r.verified_buyer %}<span>Verified buyer</span>{% endif %}{% if r.product_title != blank %}<em>on {{ r.product_title | strip_html | escape | truncate: 48 }}</em>{% endif %}</figcaption>
        </figure>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
<style>
  .tbrv{max-width:1100px;margin:34px auto 0;padding:0 2px}
  .tbrv-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}
  .tbrv h2{font-size:20px;margin:0}
  .tbrv-all{font-size:13.5px;font-weight:700;color:#5028AA;text-decoration:none;white-space:nowrap}
  .tbrv-row{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(260px,1fr);gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;padding-bottom:6px}
  .tbrv-card{scroll-snap-align:start;margin:0;background:#fff;border:1px solid #E2E0EA;border-radius:14px;padding:16px 16px 14px;display:flex;flex-direction:column;gap:8px}
  .tbrv-stars{color:#F2B417;letter-spacing:1px;font-size:15px}
  .tbrv-card blockquote{margin:0;font-size:14px;line-height:1.55;color:#2a2638;flex:1}
  .tbrv-card figcaption{font-size:13px;color:#6B6A78;display:flex;flex-wrap:wrap;gap:4px 8px;align-items:baseline}
  .tbrv-card figcaption strong{color:#14121C}
  .tbrv-card figcaption span{color:#2f8a4e;font-weight:600;font-size:12px}
  .tbrv-card figcaption em{font-style:normal;flex-basis:100%;font-size:12px}
  @media(max-width:640px){.tbrv-row{grid-auto-columns:82%}}
</style>
{%- endif -%}
