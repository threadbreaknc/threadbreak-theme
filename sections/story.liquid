<section class="tb-story">
  <div class="tb-story-inner">
    <div class="tb-story-lead">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body }}</p>
      <a href="{{ section.settings.cta_link }}" class="tb-story-cta">{{ section.settings.cta_text }} <span>→</span></a>
    </div>
    <div class="tb-story-grid">
      <div class="tb-story-item">
        <div class="tb-story-num">01</div>
        <strong>Send your logo</strong>
        <span>Any format works. We digitize it for embroidery, free, and send a mockup for approval.</span>
      </div>
      <div class="tb-story-item">
        <div class="tb-story-num">02</div>
        <strong>Pick your blank</strong>
        <span>Otto, Richardson, Yupoong, Atonal, and more. Snapbacks, trucker, camo, flat bill.</span>
      </div>
      <div class="tb-story-item">
        <div class="tb-story-num">03</div>
        <strong>We stitch & ship</strong>
        <span>Every hat embroidered in-house in Burlington, NC. Nothing produced until you approve.</span>
      </div>
    </div>
  </div>
</section>

{% style %}
  .tb-story{background:#14121C;color:#F7F4F0;padding:5rem 2rem;}
  .tb-story-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:3.5rem;align-items:center;}
  .tb-story-lead h2{font-family:var(--font-display,'Bebas Neue',sans-serif);font-size:clamp(2.2rem,4vw,3.4rem);line-height:1.02;margin:0 0 1.25rem;}
  .tb-story-lead p{color:#C9C8D4;font-size:1.05rem;line-height:1.65;margin:0 0 1.5rem;}
  .tb-story-cta{color:#B7A6EE;font-weight:700;text-decoration:none;font-size:1rem;}
  .tb-story-cta span{transition:margin .18s;display:inline-block;}
  .tb-story-cta:hover span{margin-left:.35rem;}
  .tb-story-grid{display:grid;gap:1rem;}
  .tb-story-item{background:rgba(247,244,240,.05);border:1px solid rgba(247,244,240,.1);border-radius:14px;padding:1.5rem 1.75rem;}
  .tb-story-num{font-family:var(--font-display,'Bebas Neue',sans-serif);font-size:1.6rem;color:#B7A6EE;margin-bottom:.35rem;}
  .tb-story-item strong{display:block;font-size:1.15rem;margin-bottom:.4rem;}
  .tb-story-item span{color:#C9C8D4;font-size:.95rem;line-height:1.55;}
  @media(max-width:800px){
    .tb-story{padding:3.5rem 1.5rem;}
    .tb-story-inner{grid-template-columns:1fr;gap:2rem;}
  }
{% endstyle %}

{% schema %}
{
  "name": "Story",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your logo. Our stitches." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Threadbreak is a one-person embroidery shop in Burlington, NC. We make custom embroidered hats for businesses, brands, teams, and events, plus our own lineup of Carolina hockey-inspired designs. Every hat is stitched, checked, and shipped by hand. Nothing mass-produced, nothing rushed." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Start a custom order" },
    { "type": "url", "id": "cta_link", "label": "CTA link", "default": "/pages/quote" }
  ],
  "presets": [{ "name": "Story" }]
}
{% endschema %}
