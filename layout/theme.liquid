  {{ content_for_layout }}
</main>

<footer>
  <div class="footer-grid">
    <div class="footer-brand-row">
      <img src="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/tbstar-notext.png?v=1787534858" alt="{{ shop.name }}" class="footer-logo footer-logo-full">
    </div>
    <div class="footer-nav-groups">
      <div class="footer-col">
        <p class="footer-col-head">Company</p>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/pages/about">About Us</a></li>
          <li><a href="/pages/our-work">Our Work</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul>
      </div>
