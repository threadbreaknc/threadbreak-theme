<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page_title }}, {{ shop.name }}</title>
<meta name="description" content="{{ page_description | escape }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
{{ content_for_header }}
<link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
<style>
  html, body { margin: 0 !important; padding: 0 !important; }
  #shopify-section-header,
  .shopify-section-header,
  header[role="banner"],
  .site-header { display: none !important; }
  main { display: block !important; margin: 0 !important; padding: 0 !important; }
  .shopify-section { margin: 0 !important; padding: 0 !important; }
</style>
</head>
<body>

<canvas id="needle-canvas"></canvas>

<!-- MOBILE MENU OVERLAY -->
<div class="nav-mobile-menu" id="mobile-menu">
  <a href="/" onclick="closeMobileMenu()">Home</a>
  <a href="/collections/pre-made-hats" onclick="closeMobileMenu()">Shop</a>
  <a href="/pages/about" onclick="closeMobileMenu()">About</a>
  <a href="/pages/faq" onclick="closeMobileMenu()">FAQ</a>
  <a href="/pages/quote" class="nav-cta" onclick="closeMobileMenu()">Get a Quote</a>
</div>

<nav id="main-nav">
  <a href="/" class="nav-brand">
    <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" class="nav-logo-img nav-logo-animated">
    {%- if template == 'index' -%}
      <span class="nav-wordmark">{{ shop.name }}</span>
    {%- endif -%}
  </a>
  <ul class="nav-links">
    <li><a href="/">Home</a></li>
    <li><a href="/collections/pre-made-hats">Shop</a></li>
    <li><a href="/pages/about">About</a></li>
    <li><a href="/pages/faq">FAQ</a></li>
    <li><a href="/pages/quote" class="nav-cta">Get a Quote</a></li>
  </ul>
  <div class="nav-right">
    {%- if cart.item_count > 0 -%}
    <a href="/cart" class="nav-cart" aria-label="Cart">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 01-8 0"/>
      </svg>
      <span class="nav-cart-count">{{ cart.item_count }}</span>
    </a>
    {%- endif -%}
    <button class="nav-hamburger" id="hamburger" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<main>
  {{ content_for_layout }}
</main>

<footer>
  <div class="footer-grid">
    <div class="footer-brand-row">
      <img src="{{ 'logo-white.png' | asset_url }}" alt="{{ shop.name }}" class="footer-logo">
      <span class="footer-wordmark">{{ shop.name }}</span>
    </div>
    <ul class="footer-links">
      <li><a href="/collections/pre-made-hats">Shop</a></li>
      <li><a href="/pages/about">About</a></li>
      <li><a href="/pages/faq">FAQ</a></li>
      <li><a href="/pages/quote">Get a Quote</a></li>
    </ul>
    <div class="footer-contact">
      <p class="footer-contact-label">Questions?</p>
      <a href="mailto:help@threadbreak.com" class="footer-contact-email">help@threadbreak.com</a>
      <div class="footer-social">
        <a href="https://www.instagram.com/THREADBREAK_" class="soc" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://www.facebook.com/people/Threadbreak/61584381824570/" class="soc" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@threadbreak_" class="soc" target="_blank" rel="noopener" aria-label="TikTok">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.77 1.52V6.75a4.85 4.85 0 01-1-.06z"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Burlington, NC.</p>
    <a href="/policies/privacy-policy" style="font-size:0.68rem;color:rgba(247,244,240,0.2);text-decoration:none;">Privacy</a>
  </div>
</footer>

<script src="{{ 'theme.js' | asset_url }}"></script>
</body>
</html>
