<!-- build: allfixes-2026-08 -->
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{%- assign pt = page_title | downcase -%}
{%- assign sn = shop.name | downcase -%}
{%- comment -%} shop.name is lowercase; capitalize it for the browser tab and search results {%- endcomment -%}
<title>{{ page_title }}{% unless pt contains sn %} | {{ shop.name | capitalize }}{% endunless %}</title>
<meta name="description" content="{{ page_description | escape }}">
{%- comment -%} warm the CDN connection so the hero video starts sooner {%- endcomment -%}
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

{%- comment -%}
  Backend-only products (the custom order form's hat + add-on products) must stay
  published to the Online Store so /cart/add.js can reference their variants, but
  they should never show up in search. Tagged custom-order-form.
{%- endcomment -%}
{%- if template contains 'product' and product.tags contains 'custom-order-form' -%}
  <meta name="robots" content="noindex,nofollow">
{%- endif -%}

{%- comment -%} ===== SEO: favicon ===== {%- endcomment -%}
{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
{%- else -%}
  {%- comment -%} sized variants so browsers pick the right one instead of squashing a big file {%- endcomment -%}
  <link rel="icon" type="image/png" sizes="32x32" href="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/tbfav.png?v=1787537082&width=32&height=32">
  <link rel="icon" type="image/png" sizes="16x16" href="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/tbfav.png?v=1787537082&width=16&height=16">
  <link rel="apple-touch-icon" sizes="180x180" href="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/tbfav.png?v=1787537082&width=180&height=180">
{%- endif -%}

{%- comment -%} ===== SEO: Open Graph + Twitter ===== {%- endcomment -%}
{%- assign og_title = page_title | default: shop.name -%}
{%- assign og_desc = page_description | default: shop.description | default: 'Custom embroidered hats for your brand, stitched in-house in Burlington, North Carolina. Free shipping to the lower 48.' -%}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- else -%}
  <meta property="og:image" content="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/hat-hero.jpg">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | escape }}">

{%- comment -%} ===== SEO: Organization + LocalBusiness schema ===== {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Threadbreak",
  "description": "Custom embroidered hats for businesses, brands, teams, and events. Stitched in-house in Burlington, North Carolina, with free shipping to the lower 48.",
  "image": "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/hat-hero.jpg",
  "url": "{{ shop.url }}",
  "email": "help@threadbreak.com",
  "telephone": "+1-336-585-6176",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Burlington",
    "addressRegion": "NC",
    "addressCountry": "US"
  },
  "logo": "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/tbstar-notext.png?v=1787534858",
  "areaServed": "US",
  "priceRange": "$$",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ shop.metafields.judgeme.all_reviews_rating | default: 5.0 | round: 1 }}",
    "reviewCount": "{{ shop.metafields.judgeme.all_reviews_count | default: 45 }}"
  },
  "hasMap": "https://www.google.com/maps/place/Threadbreak+-+Custom+Hat+Embroidery/@35.1705075,-79.86097,15z/data=!4m6!3m5!1s0x4894ed3daa75cd09:0xa65e93c4550cc52d!8m2!3d35.1705075!4d-79.86097",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 35.1705075,
    "longitude": -79.86097
  },
  "sameAs": [
    "https://instagram.com/threadbreak_",
    "https://share.google/7xKE8jEQONDBDGPqy"
  ]
}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
{{ content_for_header }}
<link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
<style>
  html, body { margin: 0 !important; padding: 0 !important; }
  /* full threadbreak wordmark logo, override theme's square/black-filter rules */
  .nav-brand{display:flex;align-items:center;height:100%;}
  .nav-logo-full.nav-logo-img{height:56px !important;width:auto !important;display:block;object-fit:contain;align-self:center;filter:none !important;animation:none !important;position:relative;top:2px;}
  /* one logo file for both placements: the footer sits on the dark band, so the
     mark is forced to solid white rather than needing a second artwork file. */
  .footer-logo-full.footer-logo{height:80px !important;width:auto !important;display:block;object-fit:contain;
    filter:brightness(0) invert(1) !important;}
  @media(max-width:700px){ .nav-logo-full.nav-logo-img{height:50px !important;} .footer-logo-full.footer-logo{height:64px !important;} }
  /* keep the Place a Custom Order button text white on hover */
  .nav-links a.nav-cta,
  .nav-links a.nav-cta:hover{color:#ffffff !important;}
  /* shrink the logo when the theme's existing .scrolled class is active (theme.js adds it at 60px) */
  .nav-logo-full.nav-logo-img{transition:height .3s ease;}
  #main-nav.scrolled .nav-logo-full.nav-logo-img{height:42px !important;}
  @media(max-width:700px){ #main-nav.scrolled .nav-logo-full.nav-logo-img{height:38px !important;} }
  /* collapse the free-shipping banner when scrolled down */
  .shipping-banner{transition:transform .28s ease, opacity .28s ease;}
  body.tb-scrolled .shipping-banner{transform:translateY(-100%);opacity:0;pointer-events:none;}
  /* nav is offset below the banner; pull it up and reclaim the space when collapsed */
  #main-nav{transition:top .28s ease;}
  body.tb-scrolled #main-nav{top:0 !important;}
  {%- comment -%}
    The banner and nav are both position:fixed, so collapsing the banner does not
    move the document. Changing body padding DID move it, which is what made the
    page jump on the way down and again on the way back up. Padding now stays
    constant and only the fixed nav slides.
  {%- endcomment -%}
  #shopify-section-header,
  .shopify-section-header,
  header[role="banner"],
  .site-header { display: none !important; }
  main { display: block !important; margin: 0 !important; padding: 0 !important; }
  .shopify-section { margin: 0 !important; padding: 0 !important; }
  /* footer newsletter prompt */
  .footer-newsletter{margin-top:1rem}
  .footer-nl-text{font-size:0.8rem;color:rgba(247,244,240,0.55);margin:0 0 0.5rem}
  .footer-nl-btn{background:var(--purple,#5028aa);color:#fff;border:none;border-radius:8px;padding:9px 18px;font-size:0.82rem;font-weight:600;font-family:inherit;cursor:pointer;transition:background .15s,transform .15s}
  .footer-nl-btn:hover{background:#6234c9;transform:translateY(-1px)}
  /* grouped footer link columns */
  .footer-grid{display:flex;flex-wrap:wrap;gap:2.5rem 3rem;align-items:flex-start;max-width:1200px;margin:0 auto;padding:3rem 1.5rem 2rem;}
  .footer-brand-row{flex:1 1 100%;}
  .footer-nav-groups{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.5rem 2rem;flex:2 1 340px;}
  .footer-grid .footer-col{display:block !important;}
  .footer-contact{flex:1 1 220px;}
  /* theme.css forces .soc to a near-black color, which is invisible on the dark footer.
     Higher specificity (.footer-social .soc) wins over the .soc !important rule. */
  .footer-social{display:flex;gap:0.6rem;flex-wrap:wrap;}
  .footer-social .soc{width:34px;height:34px;border:1px solid rgba(247,244,240,0.25) !important;border-radius:8px;display:flex;align-items:center;justify-content:center;text-decoration:none;color:rgba(247,244,240,0.75) !important;transition:color .18s,border-color .18s,background .18s;}
  .footer-social .soc:hover{color:#fff !important;border-color:var(--purple,#5028aa) !important;background:rgba(80,40,170,0.25);}
  .footer-social .soc svg{width:16px;height:16px;display:block;}
  /* colour count + rainbow wheel on collection cards (collection.liquid has no style block) */
  /* square PNGs with the wordmark inset, so size the square not the mark.
     Card clips overflow, so keep the offset small enough that nothing is cut. */
  /* dropdown items explain who each path is for */
  .nav-dd-wide{min-width:280px;}
  .nav-dd-wide a{display:block;line-height:1.35;padding-top:9px;padding-bottom:9px;}
  .nav-dd-wide a strong{display:block;font-weight:700;}
  .nav-dd-wide a span{display:block;font-size:11.5px;color:#6B6A78;font-weight:400;margin-top:2px;}
  .nav-dd-wide a:hover span{color:#5028AA;}
  .coll-brand{position:absolute;top:-6px;right:0;width:86px;height:86px;object-fit:contain;z-index:2;
    mix-blend-mode:multiply;pointer-events:none;}
  @media(max-width:600px){.coll-brand{width:64px;height:64px;top:-5px;right:0;}}
  /* more hats per row on wide screens; theme.css locks it to 3 */
  @media(min-width:1100px){ .collection-grid{ grid-template-columns:repeat(4,1fr) !important; } }
  @media(min-width:1500px){ .collection-grid{ grid-template-columns:repeat(5,1fr) !important; } }
  /* package cards link to the product page rather than quick-adding */
  .coll-atc-link{display:block;text-align:center;text-decoration:none;}
  /* brand filter dropdown with logos, sits in the collection bar */
  .collection-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:nowrap;}
  .brand-dd{position:relative;flex:0 0 auto;}
  .brand-dd-btn{display:flex;align-items:center;gap:9px;background:#fff;border:1.5px solid #E2E0EA;border-radius:10px;
    padding:8px 13px;font-family:inherit;font-size:14px;color:#14121C;cursor:pointer;min-width:150px;text-align:left;}
  .brand-dd-btn:hover{border-color:#B7A6EE;}
  .brand-dd-current{flex:1;white-space:nowrap;}
  .brand-dd-chev{flex:0 0 auto;transition:transform .18s;}
  .brand-dd-btn[aria-expanded="true"] .brand-dd-chev{transform:rotate(180deg);}
  .brand-dd-menu{position:absolute;z-index:60;top:calc(100% + 6px);right:0;min-width:210px;background:#fff;
    border:1.5px solid #E2E0EA;border-radius:12px;box-shadow:0 14px 34px rgba(20,18,28,.16);overflow:hidden;}
  .brand-dd-opt{width:100%;display:flex;align-items:center;gap:11px;padding:9px 13px;background:none;border:none;
    border-bottom:1px solid #f2f1f6;font-family:inherit;font-size:14px;color:#14121C;cursor:pointer;text-align:left;}
  .brand-dd-opt:last-child{border-bottom:none;}
  .brand-dd-opt:hover{background:#F3EFFC;}
  .brand-dd-opt.on{background:#eee9fb;font-weight:600;}
  .brand-dd-opt img{width:62px;height:30px;object-fit:contain;flex:0 0 auto;}
  .brand-dd-opt span{flex:1;}
  @media(max-width:600px){
    .collection-bar{gap:8px;}
    .brand-dd-btn{min-width:0;font-size:13px;padding:7px 11px;}
    .brand-dd-menu{min-width:190px;}
  }
  .coll-colors{display:inline-flex;align-items:center;gap:6px;margin-left:10px;font-size:12.5px;color:#6B6A78;white-space:nowrap;}
  .coll-wheel{width:15px;height:15px;border-radius:50%;display:inline-block;flex:0 0 auto;border:1px solid rgba(0,0,0,.12);
    background:conic-gradient(#e23b3b,#e2a13b,#d7e23b,#4ce23b,#3be2c0,#3b8fe2,#7a3be2,#e23bc0,#e23b3b);}
  .coll-price-was{margin-left:6px;font-size:0.85em;color:#8b8996;text-decoration:line-through;}
  .footer-policies{display:flex;flex-wrap:wrap;gap:0.35rem 1.1rem;justify-content:center;margin-top:0.35rem;}
  .footer-policies a{font-size:0.8rem;color:rgba(247,244,240,0.55);text-decoration:none;transition:color .15s;}
  .footer-policies a:hover{color:#fff;text-decoration:underline;}
  .footer-contact-text{display:inline-block;margin-top:8px;color:rgba(247,244,240,0.85);text-decoration:none;font-size:0.92rem;font-weight:600;transition:color .15s}
  .footer-contact-text:hover{color:#fff}
  @media(max-width:768px){
    .footer-grid{gap:2rem;}
    .footer-nav-groups{grid-template-columns:1fr 1fr;gap:1.5rem;flex-basis:100%;}
    .footer-contact{flex-basis:100%;}
  }
  /* ===== MOBILE MENU: full override of theme.css full-screen version ===== */
  @media(max-width:768px){
    .nav-mobile-menu{
      justify-content:flex-start !important;
      align-items:stretch !important;
      gap:0 !important;
      padding:9rem 1.75rem 2.5rem !important;
      overflow-y:auto !important;
      background:#F8F5FF !important;
    }
    .nav-mobile-menu a{
      font-family:var(--font-display,'Bebas Neue',sans-serif) !important;
      font-size:1.5rem !important;
      letter-spacing:0.04em !important;
      text-align:left !important;
      padding:0.55rem 0 !important;
      opacity:1 !important;
      transform:none !important;
      animation:none !important;
      line-height:1.15 !important;
    }
    .nav-mobile-menu .nav-m-head{
      font-family:var(--font-body,'DM Sans',sans-serif) !important;
      font-size:0.72rem !important;
      font-weight:700 !important;
      letter-spacing:0.18em !important;
      color:var(--purple,#5028AA) !important;
      text-transform:uppercase;
      margin:1.5rem 0 0.35rem !important;
      padding:0 !important;
      text-align:left !important;
    }
    .nav-mobile-menu .nav-m-head:first-child{margin-top:0 !important;}
    .nav-mobile-menu .nav-cta{
      margin-top:1.75rem !important;
      text-align:center !important;
      align-self:stretch !important;
      border-radius:10px;
      font-size:1.3rem !important;
    }
  }
  /* desktop dropdown menus */
  .nav-dd{position:relative;}
  .nav-dd-toggle{background:none;border:none;cursor:pointer;display:inline-flex;align-items:center;gap:5px;padding:0;font-family:var(--font-display,'Bebas Neue',sans-serif);font-size:1.25rem;font-weight:400;letter-spacing:0.06em;text-transform:uppercase;color:#14121C;line-height:1;transition:color .2s;}
  .nav-dd-toggle:hover{color:var(--purple,#5028AA);}
  /* plain nav links (Our Work) match the dropdown toggles */
  .nav-links > li > a:not(.nav-cta){font-family:var(--font-display,'Bebas Neue',sans-serif) !important;font-size:1.25rem !important;font-weight:400 !important;letter-spacing:0.06em !important;color:#14121C !important;text-transform:uppercase;line-height:1;}
  .nav-links > li > a:not(.nav-cta):hover{color:var(--purple,#5028AA) !important;}
  .nav-dd-caret{font-size:0.85em;letter-spacing:0;transition:transform .18s;}
  .nav-dd:hover .nav-dd-caret,.nav-dd.open .nav-dd-caret{transform:rotate(180deg);}
  .nav-dd-menu{position:absolute;top:100%;left:50%;transform:translateX(-50%) translateY(8px);min-width:170px;background:#fff;border:1px solid #E2E0EA;border-radius:12px;box-shadow:0 12px 32px rgba(20,18,28,.14);padding:6px;opacity:0;visibility:hidden;transition:opacity .16s,transform .16s;z-index:1200;display:flex;flex-direction:column;gap:1px;}
  .nav-dd:hover .nav-dd-menu,.nav-dd.open .nav-dd-menu{opacity:1;visibility:visible;transform:translateX(-50%) translateY(4px);}
  .nav-dd-menu::before{content:"";position:absolute;top:-8px;left:0;right:0;height:8px;}
  .nav-dd-menu a{display:block;padding:8px 12px;border-radius:7px;text-decoration:none;color:#14121C !important;font-family:var(--font-body,'DM Sans',sans-serif);font-size:0.8rem;letter-spacing:0.02em;text-transform:none;white-space:nowrap;transition:background .12s,color .12s;}
  .nav-dd-menu a:hover{background:#F3EFFC;color:var(--purple,#5028AA) !important;}
  /* text "Menu" button (mobile only) */
  .nav-hamburger{display:none;align-items:center;justify-content:center;background:none;border:1.5px solid #E2E0EA;border-radius:9px;padding:7px 16px;cursor:pointer;}
  @media(max-width:768px){ .nav-hamburger{display:flex;} }
  /* theme.css paints spans inside .nav-hamburger as black bars; force our label back to text */
  .nav-hamburger span,.nav-hamburger > span.nav-hamburger-label{display:inline-block !important;width:auto !important;height:auto !important;background:none !important;transform:none !important;opacity:1 !important;font-family:'Bebas Neue',sans-serif;font-size:1.15rem;letter-spacing:.06em;color:#14121C;line-height:1;}
  .footer-col-head{font-family:'Bebas Neue',sans-serif;font-size:0.95rem;letter-spacing:.08em;color:#fff;margin:0 0 0.7rem;text-transform:uppercase}
  .footer-col ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem}
  .footer-col li{margin:0}
  .footer-col a{text-decoration:none;font-size:0.88rem;color:rgba(247,244,240,0.65);transition:color .15s}
  .footer-col a:hover{color:#fff}
  @media(max-width:600px){
    .footer-nav-groups{gap:1.75rem}
    .footer-col{min-width:40%}
  }
</style>
</head>
