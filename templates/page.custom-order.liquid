  rich168: { "Black Camo": "Black/Camo/Loden", "Charcoal/White/Black": "Charcoal/Black/White", "Pale Khaki/Loden": "Pale Khaki/Loden Green" },
  rich256: { "Black": "Black/Black", "Cardinal": "Cardinal/White" }
};
function stockEntry(s, c){ const st = s && STOCK[s.id]; if (!st) return null; const al = STOCK_ALIAS[s.id]; return st[normColor((al && al[c]) || c)] || null; }
// unknown color or style = treat as in stock, so a name mismatch never blocks a sale
function isOut(s, c){ const e = stockEntry(s, c); return !!e && e.qty < STOCK_MIN; }
// S&S SKU for a color (and size, for fitted), saved on the order as a hidden property
function skuFor(s, c, z){
  const e = stockEntry(s, c); if (!e || !e.skus) return "";
  if (z && e.skus[z]) return e.skus[z];
  for (const p of ["Adjustable", "M/L", "One Size", "OSFA"]) if (e.skus[p]) return e.skus[p];
  const k = Object.keys(e.skus); return k.length ? e.skus[k[0]] : "";
}
function skuSummary(){
  const s = state.style; if (!s || !STOCK[s.id]) return "";
  const parts = [];
  if (!isSized() && state.colors.length === 1){
    const c = state.colors[0]; parts.push(c + ": " + (skuFor(s, c) || "n/a") + " x" + state.qty);
  } else {
