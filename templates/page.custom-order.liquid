function markDone(step, done){
  const sec = document.querySelector(`.acc[data-step="${step}"]`);
  if (sec) sec.classList.toggle("done", !!done);
}

function setOpen(step, open){
  const sec = document.querySelector(`.acc[data-step="${step}"]`);
  if (sec) sec.classList.toggle("open", open);
}

function updateBarBtn(){
  const label = quoteMode() ? "Review quote" : "Review order";
  const btn = $("submitBtn");
  if (btn){
    const step4Open = document.querySelector('.acc[data-step="4"]')?.classList.contains("open");
    // only show the bar button once they've opened the final step
    btn.style.display = step4Open ? "" : "none";
    btn.textContent = label;
  }
  // keep the step-4 button in sync (preserve its arrow icon)
  document.querySelectorAll('[data-checkout]').forEach(b => {
    const svg = b.querySelector("svg");
    b.textContent = label + " ";
    if (svg) b.appendChild(svg);
  });
}

function initAccordion(){
  // header click toggles that step open/closed (multiple can be open)
  document.querySelectorAll('[data-acc-toggle]').forEach(head => {
    head.addEventListener("click", () => {
      head.closest(".acc").classList.toggle("open");
      updateBarBtn();
    });
  });
  // Continue buttons: mark done, collapse this step, open next, then gently scroll after collapse settles
  document.querySelectorAll('[data-continue]').forEach(btn => {
    btn.addEventListener("click", () => {
      const step = +btn.getAttribute("data-continue");
      // step 3 (colors): buy mode needs a picked color; quote mode needs the text field
      if (step === 3){
        if (quoteMode()){
          const qc = $("quoteColor");
          if (qc && qc.value.trim() === ""){
            const hint = $("colorHint");
            if (hint){ hint.textContent = "Please tell us a color to continue."; hint.style.color = "#C22B3F"; hint.style.display = "block"; }
            qc.focus(); qc.scrollIntoView({ behavior:"smooth", block:"center" });
            return;
          }
        } else if (state.colorSel.length === 0){
          const hint = $("colorHint");
          if (hint){ hint.textContent = "Please pick at least one color to continue."; hint.style.color = "#C22B3F"; }
          const dd = $("cddTrigger"); if (dd) dd.scrollIntoView({ behavior:"smooth", block:"center" });
          return;
        }
      }
      markDone(step, true);
      setOpen(step + 1, true);
      updateBarBtn();
      const next = document.querySelector(`.acc[data-step="${step+1}"]`);
      if (next){
        // no collapse of the current step, so the page doesn't jump.
        // wait briefly for the next step to expand, then glide to it.
        setTimeout(() => {
          const y = next.getBoundingClientRect().top + window.pageYOffset - 90;
          easeScrollTo(y, 650);
        }, 120);
      }
    });
  });

  // gentle eased scroll (consistent speed, softer than native smooth)
  function easeScrollTo(targetY, duration){
    const startY = window.pageYOffset;
    const dist = targetY - startY;
    if (Math.abs(dist) < 4) return;
    const start = performance.now();
    const ease = t => t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2,3)/2;
    function step(now){
      const p = Math.min(1, (now - start) / duration);
      window.scrollTo(0, startY + dist * ease(p));
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  // Step 4's button opens the order-review modal
  document.querySelectorAll('[data-checkout]').forEach(btn => {
    btn.addEventListener("click", () => {
      if (!quoteMode() && !state.qtyTouched){
        const qi = $("qty");
        if (qi){
          qi.focus();
          qi.scrollIntoView({ behavior:"smooth", block:"center" });
          qi.classList.add("qty-nudge");
          setTimeout(() => qi.classList.remove("qty-nudge"), 1200);
        }
        return;
      }
      markDone(4, true); openSummary();
    });
  });
  const sc = $("sbSummaryClose");
  if (sc) sc.addEventListener("click", closeSummary);
  const ov = $("sbOverlay");
  if (ov) ov.addEventListener("click", closeSummary);
  document.addEventListener("keydown", e => { if (e.key === "Escape") closeSummary(); });
}

function validateContact(){
  // contact fields only exist / matter in quote mode; buy mode uses Shopify checkout
  if (!quoteMode()) return true;
  const name = $("custName")?.value.trim() || "";
  const email = $("custEmail")?.value.trim() || "";
  const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  const ok = name.length > 0 && emailOk;
  const err = $("contactErr");
  if (err) err.classList.toggle("show", !ok);
  if (!ok){
    const target = name.length === 0 ? $("custName") : $("custEmail");
    if (target){ target.focus(); target.scrollIntoView({ behavior:"smooth", block:"center" }); }
  }
  return ok;
}
function openSummary(){
  if (!validateContact()) return;
  buildOrderSummary();
  $("sbSummary").classList.add("open");
  const ov = $("sbOverlay"); if (ov) ov.classList.add("open");
}
function closeSummary(){
  $("sbSummary").classList.remove("open");
  const ov = $("sbOverlay"); if (ov) ov.classList.remove("open");
}

function tbcoInit(){
  const enT = $("enToggle"), enE = $("enExample");
  if (enT && enE) enT.addEventListener("click", () => {
    const show = enE.hasAttribute("hidden");
    if (show){ enE.removeAttribute("hidden"); enT.setAttribute("aria-expanded","true"); enT.firstChild.textContent = "Hide example"; }
    else { enE.setAttribute("hidden",""); enT.setAttribute("aria-expanded","false"); enT.firstChild.textContent = "View example"; }
  });
  const pib = $("puffInfoBtn"), pi = $("puffInfo");
  if (pib && pi) pib.addEventListener("click", () => {
    const open = pi.hasAttribute("hidden");
    if (open){ pi.removeAttribute("hidden"); pib.setAttribute("aria-expanded","true"); pib.textContent = "Hide"; }
    else { pi.setAttribute("hidden",""); pib.setAttribute("aria-expanded","false"); pib.textContent = "What is 3D puff?"; }
  });
  initAccordion();
  // color dropdown open/close
  const cddT = $("cddTrigger"), cddL = $("cddList"), cddCue = $("cddScrollCue");
  function updateScrollCue(){
    if (!cddCue || !cddL) return;
    const canScroll = cddL.scrollHeight > cddL.clientHeight + 4;
    const atBottom = cddL.scrollTop + cddL.clientHeight >= cddL.scrollHeight - 6;
    const show = !cddL.classList.contains("hidden") && canScroll && !atBottom;
    cddCue.classList.toggle("show", show);
    cddL.classList.toggle("scrollable", show);
  }
  if (cddT && cddL){
    cddT.addEventListener("click", () => {
      const open = cddL.classList.toggle("hidden") === false;
      cddT.classList.toggle("open", open);
      cddT.setAttribute("aria-expanded", open ? "true" : "false");
      updateScrollCue();
    });
    cddL.addEventListener("scroll", updateScrollCue, { passive: true });
    document.addEventListener("click", e => {
      if (!e.target.closest("#colorDD")){ cddL.classList.add("hidden"); cddT.classList.remove("open"); cddT.setAttribute("aria-expanded","false"); if (cddCue) cddCue.classList.remove("show"); cddL.classList.remove("scrollable"); }
    });
  }
  $("submitBtn").addEventListener("click", openSummary);
  render();
  cleanupReviews();
}

// The empty bordered box is an empty <section> Judge.me leaves inside the
// carousel wrapper. CSS :empty misses it (it contains whitespace), so hide it here.
function cleanupReviews(){
  const kill = () => {
    document.querySelectorAll("#tbco .jdgm-carousel-wrapper section").forEach(sec => {
      if (sec.textContent.trim() === "" && !sec.querySelector("img")) sec.style.display = "none";
    });
  };
  [300, 900, 2000].forEach(t => setTimeout(kill, t));
}
if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", tbcoInit);
else tbcoInit();
</script>
