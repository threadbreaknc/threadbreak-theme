  <script>
  (function(){
    var lb = document.getElementById("chLb"); if (!lb) return;
    document.body.appendChild(lb);
    var im = lb.querySelector("img"), cap = lb.querySelector(".ch-cap");
    var tiles = document.querySelectorAll(".ch-tile");
    var peek = document.getElementById("chPeek");
    if (peek && tiles.length){
      var h = '<span class="ch-peek-thumbs">';
      for (var k = 0; k < Math.min(5, tiles.length); k++){
        var src = tiles[k].querySelector("img").getAttribute("src").replace(/&width=\d+/, "&width=96");
        h += '<img src="' + src + '" alt="" width="34" height="34" decoding="async" fetchpriority="low">';
      }
      peek.innerHTML = h + '</span><span class="ch-peek-txt">See hats we\u2019ve made <b>&darr;</b></span>';
    }
    var warmed = {};
    function warm(t){ var u = t.dataset.full; if (warmed[u]) return; warmed[u] = 1; var p = new Image(); p.src = u; }
    function close(){ lb.hidden = true; document.body.style.overflow = ""; }
    tiles.forEach(function(t){
      t.addEventListener("pointerenter", function(){ warm(t); });
      t.addEventListener("touchstart", function(){ warm(t); }, { passive:true });
      t.addEventListener("click", function(){
        var i = t.querySelector("img");
        im.src = t.dataset.full; im.alt = i.alt; cap.textContent = i.alt;
        lb.hidden = false; document.body.style.overflow = "hidden";
      });
    });
    lb.addEventListener("click", function(e){ if (e.target !== im) close(); });
    document.addEventListener("keydown", function(e){ if (e.key === "Escape" && !lb.hidden) close(); });
  })();
  </script>


