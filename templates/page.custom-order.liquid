{%- comment -%} build: order-v14 {%- endcomment -%}
{%- comment -%}
  Custom Hats order page. Replaces the old quote form.
  URL stays /pages/quote so existing links keep working.
  Requires the two Shopify products (Custom Embroidered Hat + Custom Hat
  Add-On) set to ACTIVE. Cart add uses /cart/add.js on the live domain.
  Reviews use the Judge.me featured carousel (feature reviews in Judge.me).
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">

<style>


/* ---- theme-compatibility hardening ---- */
#tbco{position:relative;z-index:1;padding-top:5.5rem;max-width:100%;overflow-x:hidden;font-family:'DM Sans',sans-serif;}
#tbco *{box-sizing:border-box;}
#tbco button{font-family:inherit;-webkit-appearance:none;appearance:none;}
#tbco .tbco-hero{margin-top:0;}
/* keep the sticky checkout bar above the newsletter FAB, and give the FAB room */
#tbco .scoreboard{z-index:9999;}
.nl-fab{bottom:6.5rem !important;}
@media(max-width:560px){ .nl-fab{bottom:6rem !important;} }

  #tbco{
    --purple:#5028AA; --purple-dark:#3D1E85; --ink:#14121C; --ice:#F2F3F6;
    --white:#FFFFFF; --line:#DDDEE6; --muted:#6B6A78; --good:#1E9E5A;
  }
#tbco * {box-sizing:border-box;margin:0;padding:0}
html {scroll-behavior:smooth}
#tbco {font-family:'DM Sans',sans-serif;background:var(--ice);color:var(--ink);line-height:1.55;padding-bottom:96px}
#tbco .wrap {max-width:880px;margin:0 auto;padding:0 20px}
#tbco header {position:relative;overflow:hidden;background:var(--ink);color:var(--white);padding:56px 0 48px}
#tbco .hero-photos{position:absolute;inset:0;display:flex;z-index:0;opacity:.5}
#tbco .hero-photos div{flex:1;background-size:cover;background-position:center;min-width:0}
#tbco .hero-photos div:not(:first-child){-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%);mask-image:linear-gradient(90deg,transparent,#000 12%);margin-left:-6%}
#tbco header::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,var(--ink) 0%,rgba(20,18,28,.7) 42%,rgba(20,18,28,.32) 100%)}
#tbco header .wrap{position:relative;z-index:2}
@media(max-width:640px){#tbco .hero-photos div:nth-child(n+4){display:none}#tbco header::after{background:linear-gradient(180deg,rgba(20,18,28,.72),rgba(20,18,28,.9))}}
#tbco .kicker {font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#7F5FD8;font-weight:700}
#tbco h1 {font-family:'Bebas Neue',sans-serif;font-size:clamp(44px,8vw,76px);line-height:.95;letter-spacing:.01em;margin:10px 0 14px}
#tbco h1 em {font-style:normal;color:#7F5FD8}
#tbco .sub {max-width:520px;color:#C9C8D4;font-size:16px}
#tbco .props {display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:22px}
#tbco .props span {font-size:14px;font-weight:500;color:#EDEAF7}
#tbco .props span::before {content:"✓";color:#7F5FD8;font-weight:700;margin-right:7px}
#tbco section {background:var(--white);border:1px solid var(--line);border-radius:14px;padding:26px 24px;margin-top:22px}
#tbco section:first-of-type {margin-top:28px}
#tbco .step-head {display:flex;align-items:center;gap:12px;margin-bottom:6px}
#tbco .step-num {font-family:'Bebas Neue',sans-serif;font-size:20px;color:var(--purple);min-width:30px;width:30px;height:30px;border-radius:50%;background:var(--ice);display:flex;align-items:center;justify-content:center;transition:background .2s,color .2s}
#tbco .step-head h2 {font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:.02em}
#tbco .step-sub {color:var(--muted);font-size:14px;margin:0 0 18px 42px}
#tbco .step-body {margin-left:42px}

  @media(max-width:560px){.step-sub,.step-body{margin-left:0}}

/* ---- accordion steps ---- */
#tbco .acc .step-head{cursor:pointer;user-select:none;margin-bottom:0}
#tbco .acc.done .step-num{background:var(--good);color:#fff}
#tbco .acc-arrow{margin-left:auto;width:20px;height:20px;flex:none;color:var(--muted);transition:transform .25s}
#tbco .acc.open .acc-arrow{transform:rotate(180deg)}
#tbco .acc-summary{font-size:13px;color:var(--purple);font-weight:600;margin:6px 0 0 42px}
#tbco .acc.open .acc-summary{display:none}
#tbco .acc:not(.open) .step-sub{display:none}
#tbco .acc-wrap{max-height:0;overflow:hidden;transition:max-height .45s ease}
#tbco .acc.open .acc-wrap{max-height:8000px;transition:max-height .7s ease}
#tbco .acc-wrap > *{opacity:0;transition:opacity .45s ease}
#tbco .acc.open .acc-wrap > *{opacity:1;transition:opacity .5s ease .15s}
@media(max-width:560px){#tbco .acc-summary{margin-left:0}}
#tbco .acc-continue-row{display:flex;justify-content:flex-end;margin-top:22px}
#tbco .acc-continue{display:inline-flex;align-items:center;gap:8px;background:var(--purple);color:#fff;border:none;font-family:'Bebas Neue',sans-serif;font-size:19px;letter-spacing:.05em;padding:11px 28px;border-radius:10px;cursor:pointer;transition:background .15s,transform .15s}
#tbco .acc-continue:hover{background:var(--purple-dark);transform:translateY(-1px)}
#tbco .acc-continue svg{width:17px;height:17px}
@media(max-width:560px){#tbco .acc-continue{width:100%;justify-content:center}}
#tbco .info-block{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:26px 24px;margin-top:22px}
#tbco .info-block h3{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:.02em;margin-bottom:14px}
#tbco .styles {display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px}
#tbco .style-card {position:relative;border:2px solid var(--line);border-radius:12px;padding:10px;cursor:pointer;background:var(--white);transition:border-color .15s, box-shadow .15s;display:flex;gap:12px;align-items:center}
#tbco .style-card:hover {border-color:#B7A6EE}
#tbco .style-card input {position:absolute;opacity:0}
#tbco .style-card.on {border-color:var(--purple);box-shadow:0 0 0 3px rgba(80,40,170,.18);background:#FAF8FE}
#tbco .style-thumb {width:62px;height:62px;flex:none;object-fit:cover;border-radius:9px;background:var(--ice);display:block}
#tbco .style-thumb.ph {display:flex;align-items:center;justify-content:center;color:var(--purple);font-family:'Bebas Neue',sans-serif;font-size:26px}
#tbco .style-info {min-width:0}
#tbco .style-name {font-weight:700;font-size:15px;line-height:1.25}
#tbco .style-brand {font-size:12px;color:var(--purple);font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-top:2px}
#tbco .style-desc {font-size:13px;color:var(--muted);margin-top:3px}
#tbco .style-price {margin-top:6px;font-size:13px;font-weight:700;color:var(--purple)}
#tbco .style-features {font-size:13px;line-height:1.5;color:var(--ink);margin-top:10px;padding-top:10px;border-top:1px solid var(--line);animation:featFade .25s ease}
@keyframes featFade{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}
#tbco /* ---------- expanded card photo viewer ---------- */
  .style-card.expanded {grid-column:1/-1;align-items:flex-start;gap:16px;padding:14px}
#tbco .hero-wrap {flex:none;width:min(300px,44%)}
#tbco .hero-stage {position:relative;width:100%;aspect-ratio:1/1;border-radius:10px;overflow:hidden;border:1px solid var(--line);background:var(--ice)}
#tbco .hero-img {position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;opacity:0;transition:opacity .5s ease}
#tbco .hero-img.on {opacity:1}
#tbco .hero-dots {display:flex;gap:6px;margin-top:9px;justify-content:center}
#tbco .hero-dots button {width:9px;height:9px;border-radius:50%;border:none;background:var(--line);cursor:pointer;padding:0;transition:background .15s}
#tbco .hero-dots button.on {background:var(--purple)}

  @media(max-width:560px){.style-card.expanded{flex-direction:column;align-items:stretch}.hero-wrap{width:100%}}
#tbco .chips {display:flex;flex-wrap:wrap;gap:8px}
#tbco .color-preview{display:flex;flex-direction:column;align-items:center;gap:8px;margin:4px 0 14px;padding:18px;background:var(--ice);border:1px solid var(--line);border-radius:14px}
#tbco .color-preview img{width:100%;max-width:320px;height:auto;border-radius:12px;display:block}
#tbco .color-preview span{font-size:15px;font-weight:700;color:var(--ink)}
#tbco .color-preview.empty{padding:26px 18px}
#tbco .color-preview.empty span{font-weight:500;color:var(--muted);text-align:center}
/* color dropdown */
#tbco .cdd{position:relative;margin-bottom:4px}
#tbco .cdd-trigger{width:100%;display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:#fff;border:2px solid var(--purple);border-radius:12px;font-size:15px;font-weight:700;color:var(--purple);cursor:pointer;box-shadow:0 2px 8px rgba(80,40,170,.1)}
#tbco .cdd-trigger:hover{background:#F7F4FF}
#tbco .cdd-trigger.ph #cddLabel,#tbco .cdd-trigger .ph{color:var(--muted);font-weight:500}
#tbco .cdd-arrow{transition:transform .2s;color:var(--purple);font-size:12px}
#tbco .cdd-trigger.open{border-color:var(--purple);border-radius:12px 12px 0 0}
#tbco .cdd-trigger.open .cdd-arrow{transform:rotate(180deg)}
#tbco .cdd-list{position:relative;z-index:20;background:#fff;border:1.5px solid var(--purple);border-top:none;border-radius:0 0 12px 12px;max-height:300px;overflow-y:auto;box-shadow:0 12px 30px rgba(0,0,0,.12);-webkit-overflow-scrolling:touch}
#tbco .cdd-list.scrollable{border-bottom:none;border-radius:0}
#tbco .cdd-scrollcue{display:none;text-align:center;font-size:12px;font-weight:600;color:var(--purple);background:#F3EFFC;border:1.5px solid var(--purple);border-top:none;border-radius:0 0 12px 12px;padding:6px}
#tbco .cdd-scrollcue.show{display:block}
#tbco .cdd-list.hidden{display:none}
#tbco .cdd-row{display:flex;align-items:center;gap:12px;padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--ice)}
#tbco .cdd-row:hover{background:var(--ice)}
#tbco .cdd-row img{width:46px;height:46px;border-radius:8px;object-fit:cover;flex:none;background:var(--ice)}
#tbco .cdd-row .cdd-nm{flex:1;font-size:14px;font-weight:500;color:var(--ink)}
#tbco .cdd-row .cdd-chk{width:22px;height:22px;border-radius:6px;border:2px solid var(--line);flex:none;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px}
#tbco .cdd-row.sel .cdd-chk{background:var(--purple);border-color:var(--purple)}
#tbco .cdd-dot{width:14px;height:14px;border-radius:50%;flex:none;border:1px solid rgba(0,0,0,.15)}
#tbco .chip {border:1.5px solid var(--line);border-radius:999px;padding:8px 15px;font-size:14px;font-weight:500;cursor:pointer;background:var(--white);user-select:none;transition:all .12s;display:inline-flex;align-items:center;gap:7px}
#tbco .chip:hover {border-color:#B7A6EE}
#tbco .chip.on {background:var(--purple);border-color:var(--purple);color:var(--white)}
#tbco .chip small {opacity:.75;font-weight:400}
#tbco .chip.more {border-style:dashed;color:var(--purple);font-weight:700}
#tbco .dot {width:13px;height:13px;border-radius:50%;border:1px solid rgba(0,0,0,.18);flex:none}
#tbco .chip.on .dot {border-color:rgba(255,255,255,.6)}
#tbco .field-label {display:block;font-weight:700;font-size:14px;margin:18px 0 8px}
#tbco .info-btn{font:inherit;font-size:12px;font-weight:700;color:var(--purple);background:none;border:none;cursor:pointer;padding:0;margin-left:8px;text-decoration:underline;text-underline-offset:2px}
#tbco .info-btn:hover{color:var(--purple-dark)}
#tbco .info-panel{margin:10px 0 4px;border:1.5px solid var(--line);border-radius:12px;padding:16px;background:var(--ice)}
#tbco .info-panel[hidden]{display:none}
#tbco .info-compare{display:grid;grid-template-columns:1fr 1fr;gap:14px}
#tbco .info-col{text-align:center;background:var(--white);border:1px solid var(--line);border-radius:10px;padding:14px 12px}
#tbco .info-col strong{display:block;font-size:14px;margin:10px 0 4px}
#tbco .info-col span{font-size:12.5px;color:var(--muted);line-height:1.45;display:block}
#tbco .info-swatch{height:52px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:30px;letter-spacing:.08em;color:var(--ink);background:#E4E2EC}
#tbco .flat-swatch{color:#4A4A52;text-shadow:none}
#tbco .puff-swatch{color:#2E2A3A;text-shadow:0 2px 0 #B7A6EE,0 3px 3px rgba(0,0,0,.28);transform:scaleY(1.06)}
#tbco .info-note{font-size:12.5px;color:var(--muted);line-height:1.5;margin-top:12px}
@media(max-width:420px){#tbco .info-compare{grid-template-columns:1fr}}
#tbco .hint {font-size:13px;color:var(--muted);margin-top:6px}
#tbco .breakdown {margin-top:14px;border:1.5px solid var(--line);border-radius:12px;overflow:hidden}
#tbco .bd-row {display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid var(--line)}
#tbco .bd-row:last-child {border-bottom:none}
#tbco .bd-name {flex:1;font-size:14px;font-weight:500}
#tbco .bd-qty {width:76px;border:1.5px solid var(--line);border-radius:8px;padding:7px 10px;font-size:15px;font-weight:700;font-family:'DM Sans',sans-serif;text-align:center}
#tbco .bd-qty:focus {outline:2px solid var(--purple);border-color:var(--purple)}
#tbco .bd-thumb{width:38px;height:38px;border-radius:8px;object-fit:cover;flex:none}
#tbco .bd-pick{display:flex;align-items:center;gap:10px;flex:1;background:none;border:none;padding:0;cursor:pointer;text-align:left;min-width:0}
#tbco .bd-pick .bd-name{font-family:'DM Sans',sans-serif}
#tbco .bd-row.previewing{background:#F3EFFC}
#tbco .bd-row.previewing .bd-name{color:var(--purple);font-weight:700}
#tbco .bd-remove{background:none;border:none;color:var(--muted);font-size:20px;line-height:1;cursor:pointer;padding:0 2px;flex:none}
#tbco .bd-remove:hover{color:#C22B3F}
#tbco .bd-total {padding:10px 14px;background:var(--ice);font-size:13px;font-weight:700;text-align:right}
#tbco .qty-row {display:flex;flex-wrap:wrap;gap:8px;align-items:center}
#tbco .qty-input {width:110px;border:1.5px solid var(--line);border-radius:10px;padding:11px 14px;font-size:16px;font-weight:700;font-family:'DM Sans',sans-serif}
#tbco .qty-input:focus {outline:2px solid var(--purple);border-color:var(--purple)}
#tbco .qty-input.qty-nudge {animation:qtyNudge .5s ease 2;border-color:var(--purple)}
@keyframes qtyNudge{0%,100%{box-shadow:0 0 0 0 rgba(80,40,170,0)}50%{box-shadow:0 0 0 4px rgba(80,40,170,.25)}}
#tbco .tiers {display:grid;grid-template-columns:repeat(auto-fit,minmax(86px,1fr));gap:8px;margin-top:14px}
#tbco .tier {border:1.5px solid var(--line);border-radius:10px;padding:10px 8px;text-align:center;cursor:pointer;transition:all .12s}
#tbco .tier:hover {border-color:#B7A6EE}
#tbco .tier.on {border-color:var(--purple);background:#F4F0FD}
#tbco .tier .t-qty {font-size:12px;color:var(--muted)}
#tbco .tier .t-price {font-family:'Bebas Neue',sans-serif;font-size:22px;color:var(--ink)}
#tbco .tier.on .t-price {color:var(--purple)}
#tbco .savings {margin-top:12px;font-size:14px;font-weight:500;color:var(--good);display:none}
#tbco .savings.show {display:block}
#tbco textarea, #tbco input[type=text], #tbco input[type=email], #tbco input[type=tel] {width:100%;border:1.5px solid var(--line);border-radius:10px;padding:12px 14px;font-size:15px;font-family:'DM Sans',sans-serif;background:var(--white)}
#tbco textarea:focus, #tbco input[type=text]:focus, #tbco input[type=email]:focus, #tbco input[type=tel]:focus {outline:2px solid var(--purple);border-color:var(--purple)}
#tbco .txt-input{margin-bottom:6px}
#tbco .opt{color:var(--muted);font-weight:400;font-size:13px}
#tbco textarea {min-height:90px;resize:vertical}
#tbco .social-optout{display:flex;align-items:flex-start;gap:10px;margin-top:16px;padding:14px 16px;background:var(--ice);border:1px solid var(--line);border-radius:12px;cursor:pointer}
#tbco .social-optout input{margin-top:3px;width:18px;height:18px;flex:none;accent-color:var(--purple);cursor:pointer}
#tbco .social-optout span{font-size:14px;font-weight:600;color:var(--ink);line-height:1.4}
#tbco .social-optout small{display:block;font-weight:400;font-size:12.5px;color:var(--muted);margin-top:3px;line-height:1.45}
#tbco .uploads-grid {display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
#tbco .upload {border:2px dashed var(--line);border-radius:12px;padding:16px 12px;text-align:center;cursor:pointer;transition:border-color .15s;display:block}
#tbco .upload:hover {border-color:var(--purple)}
#tbco .upload input {display:none}
#tbco .upload .u-title {font-weight:700;font-size:14px;word-break:break-word}
#tbco .upload .u-sub {font-size:12px;color:var(--muted);margin-top:2px}
#tbco .upload.has-file {border-style:solid;border-color:var(--good);background:#F1FAF5}
#tbco .flow {list-style:none;margin:0}
#tbco .flow li {display:flex;gap:12px;align-items:flex-start;padding:7px 0;font-size:15px}
#tbco .flow .n {flex:none;width:26px;height:26px;border-radius:50%;background:#F4F0FD;color:var(--purple);font-family:'Bebas Neue',sans-serif;font-size:16px;display:flex;align-items:center;justify-content:center;margin-top:1px}
#tbco .art-note {background:var(--ice);border-radius:10px;padding:12px 14px;font-size:13px;color:var(--muted);margin-top:10px;line-height:1.55}
#tbco .art-note strong {color:var(--ink)}
#tbco .art-note p + p {margin-top:8px}
#tbco .proof-note{border-left:4px solid var(--purple);background:#F3EFFC}
#tbco .proof-note strong{color:var(--purple)}
#tbco .embroidery-notice{display:flex;gap:12px;align-items:flex-start;background:#F3EFFC;border:1.5px solid var(--purple);border-left:5px solid var(--purple);border-radius:12px;padding:14px 16px;margin-top:12px}
#tbco .embroidery-notice p{font-size:13px;color:var(--ink);line-height:1.55;margin:0}
#tbco .embroidery-notice strong{color:var(--purple)}
#tbco .en-icon{flex:none;width:24px;height:24px;border-radius:50%;background:var(--purple);color:#fff;font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center;line-height:1}
#tbco .en-toggle{margin-top:8px;background:none;border:none;padding:0;color:var(--purple);font-weight:700;font-size:13px;font-family:inherit;cursor:pointer;text-decoration:underline;display:inline-flex;align-items:center;gap:5px}
#tbco .en-toggle::after{content:"▾";font-size:11px;transition:transform .2s}
#tbco .en-toggle[aria-expanded="true"]::after{transform:rotate(180deg)}
#tbco .en-example{margin-top:10px}
#tbco .en-example img{max-width:100%;border-radius:10px;border:1px solid var(--line);display:block}
#tbco .quote-only {display:none}
#tbco .quote-redirect{display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap;text-align:center;margin:20px 0 4px;padding:16px 20px;background:#F3EFFC;border:2px solid var(--purple);border-radius:12px;text-decoration:none;color:var(--ink);font-size:15px;font-weight:500;box-shadow:0 3px 12px rgba(80,40,170,.12);transition:background .15s,transform .15s,box-shadow .15s}
#tbco .tbco-textus{display:none !important; /* HIDDEN until SMS number approved - change back to flex to re-enable */ align-items:center;justify-content:center;align-items:center;justify-content:center;gap:10px;text-align:center;margin:40px 0 22px;padding:15px 22px;background:var(--purple);border:1.5px solid var(--purple);border-radius:12px;text-decoration:none;color:#fff;font-size:14.5px;box-shadow:0 4px 16px rgba(80,40,170,.22);transition:background .15s,transform .15s,box-shadow .15s}
#tbco .tbco-textus:hover{background:var(--purple2,#6234c9);transform:translateY(-1px);box-shadow:0 6px 20px rgba(80,40,170,.3)}
#tbco .tbco-textus-icon{display:inline-flex;color:#fff;flex:none}
#tbco .tbco-textus strong{color:#fff;font-weight:700;white-space:nowrap}
#tbco .quote-redirect:hover{background:#EAE2FA;transform:translateY(-1px);box-shadow:0 5px 16px rgba(80,40,170,.2)}
#tbco .quote-redirect strong{color:var(--purple);font-weight:700}
body.quote-mode #tbco .quote-only {display:block}
body.quote-mode #tbco .buy-only {display:none}
#tbco .scoreboard {position:fixed;left:0;right:0;bottom:0;background:var(--ink);color:var(--white);border-top:3px solid var(--purple);z-index:50;transition:transform .35s ease}
#tbco .scoreboard.sb-hidden{transform:translateY(110%)}
#tbco .sb-inner {max-width:880px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:18px}
#tbco .sb-stat {line-height:1.1}
#tbco .sb-label {font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#9A97AC}
#tbco .sb-value {font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:.03em}
#tbco .sb-value.accent {color:#B7A6EE}
#tbco .sb-divider {width:1px;height:34px;background:#312E44}
#tbco .sb-cta {margin-left:auto;background:var(--purple);color:var(--white);border:none;font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:.06em;padding:12px 26px;border-radius:10px;cursor:pointer;transition:background .15s}
#tbco .sb-cta:hover {background:var(--purple-dark)}
#tbco .sb-cta:disabled {opacity:.7;cursor:wait}
/* price change flash */
#tbco .sb-value{position:relative;transition:color .3s}
#tbco .sb-value.flash{animation:sbPulse .55s ease}
@keyframes sbPulse{0%{color:#B7A6EE;transform:scale(1.12)}100%{color:inherit;transform:none}}
/* expandable order summary above the bar */
/* order review modal + dimmed overlay */
#tbco .sb-overlay{position:fixed;inset:0;background:rgba(10,8,16,.72);opacity:0;visibility:hidden;transition:opacity .3s;z-index:9998}
#tbco .sb-overlay.open{opacity:1;visibility:visible}
#tbco .sb-summary{position:fixed;left:50%;top:50%;transform:translate(-50%,-46%) scale(.96);width:min(520px,92vw);max-height:86vh;overflow-y:auto;background:#1B1826;border:1px solid #312E44;border-radius:18px;box-shadow:0 24px 70px rgba(0,0,0,.5);opacity:0;visibility:hidden;transition:opacity .3s,transform .3s;z-index:9999}
#tbco .sb-summary.open{opacity:1;visibility:visible;transform:translate(-50%,-50%) scale(1)}
#tbco .sb-summary-inner{padding:26px 26px 24px}
#tbco .upload-progress{margin-top:16px}
#tbco .up-label{font-size:13px;font-weight:600;color:var(--purple);margin-bottom:8px;text-align:center}
#tbco .up-track{height:8px;background:var(--ice);border-radius:6px;overflow:hidden}
#tbco .up-fill{height:100%;width:0%;background:linear-gradient(90deg,var(--purple),#8B6FD4);border-radius:6px;transition:width .2s ease}
#tbco .up-fill.indeterminate{width:40%!important;animation:upSlide 1.1s ease-in-out infinite}
@keyframes upSlide{0%{margin-left:-40%}100%{margin-left:100%}}
#tbco .sb-summary-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px}
#tbco .sb-summary-head h3{font-family:'Bebas Neue',sans-serif;font-size:26px;color:#fff;letter-spacing:.02em}
#tbco .sb-summary-close{background:none;border:none;color:#9A97AC;font-size:22px;line-height:1;cursor:pointer;padding:2px 6px}
#tbco .sb-summary-close:hover{color:#fff}
#tbco .sb-summary-rows{display:flex;flex-direction:column;gap:0}
#tbco .sb-sum-row{display:flex;justify-content:space-between;gap:16px;font-size:14px;color:#D6D3E0;padding:11px 0;border-bottom:1px solid #29263A}
#tbco .sb-sum-row .sb-sum-label{color:#9A97AC;flex:none}
#tbco .sb-sum-row .sb-sum-val{color:#fff;font-weight:500;text-align:right}
#tbco .sb-sum-row.sb-sum-total{font-family:'Bebas Neue',sans-serif;font-size:22px;color:#fff;border-bottom:none;padding-top:14px}
#tbco .sb-sum-row.sb-sum-total .sb-sum-val{color:#B7A6EE;font-weight:400}
#tbco .sb-summary-cta{margin-top:20px;text-align:center}
#tbco .sb-summary-cta p{color:#C9C8D4;font-size:14px;margin-bottom:12px}
#tbco .sb-summary-cta .sb-cta{width:100%;justify-content:center;font-size:22px;padding:14px}

  @media(max-width:560px){
    .sb-inner{gap:12px;padding:10px 14px}
    .sb-value{font-size:21px}
    .sb-cta{font-size:17px;padding:10px 18px}
    .sb-hide-sm{display:none}
  }
#tbco .confirm {display:none;background:#F1FAF5;border:1px solid #BFE8D2;border-radius:14px;padding:24px;margin-top:22px}
#tbco .confirm.show {display:block}
#tbco .confirm h3 {font-family:'Bebas Neue',sans-serif;font-size:26px;margin-bottom:8px}
#tbco .confirm pre {background:var(--white);border:1px solid var(--line);border-radius:10px;padding:14px;font-size:13px;white-space:pre-wrap;font-family:'DM Sans',sans-serif;margin-top:12px}
#tbco .err {color:#C22B3F;font-size:14px;margin-top:12px;display:none}
/* ---- judge.me carousel ---- */
#tbco .jdgm-carousel-wrapper{text-align:center;margin:0 auto}
#tbco .jdgm-carousel-title-and-link{text-align:center;margin-bottom:1.25rem}
#tbco .jdgm-carousel-item{padding:0 16px !important}
#tbco .jdgm-carousel-item__review,
#tbco .jdgm-carousel-item__reviewer-name{text-align:center !important}
/* the empty box: an empty <section> Judge.me renders inside the carousel wrapper,
   which my generic "#tbco section" card style was turning into a bordered box.
   Strip the card styling and collapse it. */
#tbco .jdgm-carousel-wrapper section:empty,
#tbco .jdgm-carousel-wrapper > section:last-child:empty{
  display:none !important;background:none !important;border:none !important;
  padding:0 !important;margin:0 !important;
}
#tbco .err.show {display:block}


  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.hero-img{transition:none}}
