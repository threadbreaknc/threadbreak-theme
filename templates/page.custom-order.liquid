const shortOf = s => SHORT_NAME[s.id] || nameOf(s);

// Brand marks, matched off the brand string.
const BRAND_LOGOS = [
  { test: /richardson/i, src: "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/logo_richardson.png?v=1790739725", alt: "Richardson" },
  { test: /yupoong|yp classics/i, src: "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/logo_yupoong.png?v=1790739725", alt: "Yupoong" },
  { test: /atonal/i, src: "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/logo_atonal.png?v=1790739725", alt: "Atonal" },
  { test: /otto/i, src: "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/logo_otto.png?v=1790739725", alt: "Otto" },
  { test: /^10 ?10/i, src: "{{ '1010hats.png' | asset_url }}", alt: "10 10 Hats" },
  { test: /flexfit/i, src: "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/flexfit-logo.png?v=1792360646", alt: "Flexfit" }
];
function brandLogo(s){
  const hit = BRAND_LOGOS.find(b => b.test.test(s.brand) || b.test.test(s.name));
  return hit || null;
}
// Every blank we carry is one size fits most; the Richardsons are the standard M/L.
const sizingOf = s => s.sizing ? s.sizing : (/^rich/i.test(s.id) || /richardson/i.test(s.brand))
  ? "One size fits most (standard M/L)" : "One size fits most";
const specsOf = s => (s.desc || "").split("\u00b7").map(x => x.trim()).filter(x => x && !/size|fits/i.test(x));

const state = {
  style: null, colors: [], split: {}, qty: 5, activeColor: null,
  deco: DECOS[0], places: new Set(["front"]), frontPos: "Centered",
  files: { front:null, left:null, right:null, back:null },
  step: 1, maxStep: 1, done: new Set()
};

/* ---------- pricing ---------- */
function tierFor(style, qty){
  if (!style || !qty) return null;
  let t = style.tiers[0];
  for (const tier of style.tiers) if (qty >= tier[0]) t = tier;
  return t;
}
function perHat(){
  const t = tierFor(state.style, state.qty);
  if (!t) return null;
  let p = t[1] + (state.deco.add || 0);
  state.places.forEach(id => {
    const pl = PLACEMENTS.find(x => x.id === id);
    if (pl) p += pl.add || 0;
  });
  return p;
}
function nextTier(){
  if (!state.style || !state.qty) return null;
  for (const t of state.style.tiers) if (t[0] > state.qty) return t;
  return null;
}
function colorSummary(){
  if (!state.colors.length) return "Not specified";
  if (isSized()){ splitTotal(); return Object.keys(state.split).filter(k => +state.split[k] > 0).map(k => k + " x" + state.split[k]).join(", ") || state.colors.join(", "); }
  if (state.colors.length === 1) return state.colors[0];
  return state.colors.map(c => c + " x" + (state.split[c] || 0)).join(", ");
}
function colorImg(style, color){
  if (style.colorImgs && style.colorImgs[color]) return SSI(style.colorImgs[color], "f_fm");
  return style.imgs[0];
}
function activeUploadSlots(){
  return ["front","left","right","back"].filter(p => p === "front" || state.places.has(p));
}


// Native scroll-behavior:smooth is fast and snappy. This eases over a longer
// duration so the page glides instead of jumping, and always stops far enough
// down that the sticky header and the full step rail stay on screen.
const HEADER_H = () => (window.innerWidth <= 600 ? 60 : 70);
function railBottom(){
  const rail = document.getElementById("rail");
  if (!rail) return HEADER_H() + 70;
  return HEADER_H() + rail.getBoundingClientRect().height + 22;
}
let scrollAnim = null;
// If the visitor scrolls or swipes mid-glide, hand control straight back to them.
["wheel","touchstart","keydown"].forEach(ev =>
  window.addEventListener(ev, () => {
    if (scrollAnim){ cancelAnimationFrame(scrollAnim); scrollAnim = null; }
  }, { passive: true }));

// Gliding auto-scroll turned off: only ever an instant jump, and only where a
// caller needs the active step brought back on screen.
function easeScrollTo(targetY, duration){
  if (scrollAnim) cancelAnimationFrame(scrollAnim);
  window.scrollTo(0, Math.max(0, targetY)); return;
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches){
    window.scrollTo(0, Math.max(0, targetY));
    return;
  }
  const startY = window.scrollY;
  const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
  const endY = Math.max(0, Math.min(targetY, maxY));
  const dist = endY - startY;
  if (Math.abs(dist) < 4) return;
  const dur = duration || 850;
  const t0 = performance.now();
  // easeInOutCubic
  const ease = t => t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t + 2, 3)/2;
  function frame(now){
    const t = Math.min(1, (now - t0) / dur);
    window.scrollTo(0, startY + dist * ease(t));
    if (t < 1) scrollAnim = requestAnimationFrame(frame);
    else scrollAnim = null;
  }
  scrollAnim = requestAnimationFrame(frame);
}
// Scroll an element so it sits just beneath the pinned rail.
function easeScrollToEl(el, duration){
  if (!el) return;
  const y = window.scrollY + el.getBoundingClientRect().top - railBottom();
  easeScrollTo(y, duration);
}

// Briefly ignore taps on everything in the form except `keepSelector` while
// a layout settles. Selecting a hat collapses the grid instantly, and a
// second tap that lands mid-collapse used to hit whatever slid underneath
// it (often the "get a quote instead" link) instead of the thing the
// visitor meant to hit.
let tapLockTimer = null;
function lockTaps(ms, keepSelector){
  const root = document.getElementById("tbFormSteps");
  if (!root) return;
  root.classList.add("tap-lock");
  root.querySelectorAll(".tap-lock-keep").forEach(el => el.classList.remove("tap-lock-keep"));
  if (keepSelector) root.querySelectorAll(keepSelector).forEach(el => el.classList.add("tap-lock-keep"));
  if (tapLockTimer) clearTimeout(tapLockTimer);
  tapLockTimer = setTimeout(() => root.classList.remove("tap-lock"), ms);
}

// Call right after a synchronous DOM change (like the hat grid collapsing)
// that may have shifted `targetSel` away from where the tapped element used
// to be. Cancels out the instant jump first so nothing visibly moves under
// the visitor's thumb, locks out stray taps elsewhere for a beat, then
// eases the rest of the way into place only if it's actually needed.
function settleAfterCollapse(beforeTop, targetSel){
  const target = document.querySelector(targetSel);
  if (!target) return;
  const jump = target.getBoundingClientRect().top - beforeTop;
  if (Math.abs(jump) > 1) window.scrollBy(0, jump);
  lockTaps(380, targetSel);
}

/* ---------- step 1: hats ---------- */
/* ---------- grid filters (brand + style) ---------- */
const BRAND_OF = s => /richardson/i.test(s.brand) ? "Richardson" : /yupoong|yp classics/i.test(s.brand) ? "Yupoong"
  : /otto/i.test(s.brand) ? "Otto" : /flexfit/i.test(s.brand) ? "Flexfit" : /^10 10/.test(s.brand) ? "10 10" : /atonal/i.test(s.brand) ? "Atonal" : "Other";
const KINDS = [
  ["trucker", "Trucker", ["rich112","rich112_5p","rich112p","rich112pm","rich112pl","rich115","rich168","yp6606","yp6506","yupoong","o285","o1121","ff110m","ff6511"]],
  ["solid", "Solid back", ["otto","atonal","ff110f","yp6089","yp6789","otto120","tt6","tt5","tt7"]],
  ["rope", "Rope", ["atonal_a500r","rich256","rich258","tt5r"]],
  ["flat", "Flat bill", ["yupoong","ff110f","yp6089"]],
  ["fitted", "Fitted", ["ff6277","ff6511"]],
  ["dad", "Dad hat / unstructured", ["yp6245","rich220","o598"]],
  ["perf", "Performance", ["rich220","rich258","rich256","tt6","tt5","tt5r","tt7"]]
];
const filt = { brand: null, kind: null };
const kindHas = (k, s) => { const e = KINDS.find(x => x[0] === k); return !!e && e[2].indexOf(s.id) > -1; };
const passes = (s, f) => (!f.brand || BRAND_OF(s) === f.brand) && (!f.kind || kindHas(f.kind, s));
function renderFilters(picking){
  const host = $("hatFilters"); if (!host) return;
  host.hidden = picking;
  if (picking) return;
  const brands = [];
  sorted.forEach(s => { const b = BRAND_OF(s); if (brands.indexOf(b) === -1) brands.push(b); });
  const opt = (val, label, n, cur) => '<option value="' + (val || "") + '"' + (cur === val ? " selected" : "") + (n === 0 ? " disabled" : "") + '>' + label + (n != null ? " (" + n + ")" : "") + '</option>';
  const shown = sorted.filter(s => passes(s, filt)).length;
  host.innerHTML =
    '<label class="fsel"><span>Brand</span><select data-ftype="brand">' + opt(null, "All brands", null, filt.brand) +
      brands.map(b => opt(b, b, sorted.filter(s => passes(s, { brand: b, kind: filt.kind })).length, filt.brand)).join("") + '</select></label>' +
    '<label class="fsel"><span>Style</span><select data-ftype="kind">' + opt(null, "All styles", null, filt.kind) +
      KINDS.map(k => opt(k[0], k[1], sorted.filter(s => passes(s, { brand: filt.brand, kind: k[0] })).length, filt.kind)).join("") + '</select></label>' +
    '<div class="fcount">' + (shown ? shown + (shown === 1 ? " hat" : " hats") : "No matches") +
      ((filt.brand || filt.kind) ? ' <button type="button" data-fclear>Clear</button>' : '') + '</div>';
  host.querySelectorAll("select[data-ftype]").forEach(sel => sel.addEventListener("change", () => {
    filt[sel.dataset.ftype] = sel.value || null;
    renderHats();
  }));
  const clr = host.querySelector("[data-fclear]");
  if (clr) clr.addEventListener("click", () => { filt.brand = null; filt.kind = null; renderHats(); });
}


function renderHats(){
  const picking = !!state.style;
  const grid = $("hats");
  grid.classList.toggle("picking", picking);
  renderFilters(picking);

  grid.innerHTML = sorted.map((s, idx) => {
    const on = state.style && state.style.id === s.id;
    const badge = BADGES[s.id] ? '<div class="hat-badge">' + BADGES[s.id] + '</div>' : "";
    const low = s.tiers[s.tiers.length - 1][1];
    const five = (s.tiers.find(t => t[0] === 5) || s.tiers[0])[1];
    const ten = (s.tiers.find(t => t[0] === 10) || s.tiers[0])[1];

    if (!on){
      const lg = brandLogo(s);
      // the first row paints immediately; everything below the fold defers
      const eager = idx < 4;
      return '<div class="hat" data-hat="' + s.id + '" role="button" tabindex="0" aria-label="Select ' + nameOf(s) + ', as low as ' + money(low) + ' per hat">' + badge +
        '<div class="hat-imgwrap">' +
          '<img class="hat-img" src="' + s.imgs[0] + '" alt="' + nameOf(s) + '" loading="' + (eager ? 'eager' : 'lazy') + '" decoding="async" fetchpriority="' + (eager ? 'high' : 'low') + '">' +
          (lg ? '<img class="hat-logo" src="' + lg.src + '" alt="' + lg.alt + '" loading="lazy">' : '') +
        '</div>' +
        '<div class="hat-info">' +
          '<div class="hat-name">' + nameOf(s) + '</div>' +
          '<div class="hat-name-sm">' + shortOf(s) + '</div>' +
          '<div class="hat-brand">' + s.brand + '</div>' +
          '<div class="hat-price">As low as ' + money(low) + '/hat</div>' +
          '<div class="hat-colors"><span class="wheel"></span>' + s.colors.length + ' colors</div>' +
        '</div></div>';
    }
    const specs = specsOf(s);
    const lg = brandLogo(s);
    const shown = state.activeColor && s.colors.indexOf(state.activeColor) > -1 ? state.activeColor : null;
    const heroSrc = shown ? colorImg(s, shown) : s.imgs[0];
    return '<div class="hat on" data-hat="' + s.id + '">' + badge +
        '<div class="hat-heroimg">' +
          '<img class="hat-img" id="hatHero" src="' + heroSrc + '" alt="' + nameOf(s) + '" loading="lazy" onerror="this.onerror=null;this.src=\'' + s.imgs[0] + '\'">' +
          '<div class="hat-herocap" id="hatHeroCap">' + (shown ? shown : "Pick a color to preview") + '</div>' +
        '</div>' +
        '<div class="hat-info">' +
          '<div class="hat-titlerow">' +
            (lg ? '<img class="hat-logo-lg" src="' + lg.src + '" alt="' + lg.alt + '">' : '') +
            '<div><div class="hat-name" style="font-size:19px">' + nameOf(s) + '</div>' +
            '<div class="hat-brand">' + s.brand + '</div></div>' +
          '</div>' +
          '<div class="hat-price">' + money(five) + ' each at 5 &middot; ' + money(ten) + ' each at 10 &middot; as low as ' + money(low) + '</div>' +
          '<div class="hat-specs">' +
            '<div><b>Sizing:</b> ' + sizingOf(s) + '</div>' +
            (specs.length ? '<div><b>Details:</b> ' + specs.join(", ") + '</div>' : "") +
            '<div><b>Included:</b> front embroidery, free digitizing, free shipping to the lower 48</div>' +
          '</div>' +
          '<button type="button" class="hat-change" data-change="1">Choose a different hat</button>' +
        '</div>' +
      '<div class="hat-expand" id="colorHost"></div></div>';
  }).join("");

  grid.querySelectorAll("[data-hat]").forEach(el => {
    const pick = ev => {
      if (ev.target.closest(".hat-expand") || ev.target.closest("[data-change]")) return;
      const s = STYLES.find(x => x.id === el.dataset.hat);
      if (state.style && state.style.id === s.id) return;
      // Remember where the tapped card sat on screen before the grid
      // collapses out from under it.
      const beforeTop = el.getBoundingClientRect().top;
      state.style = s; state.colors = []; state.split = {}; state.activeColor = null;
      renderHats(); sync();
      settleAfterCollapse(beforeTop, "#tbco .hat.on");
    };
    el.addEventListener("click", pick);
    // Closed cards carry role="button"/tabindex so they're reachable and
    // operable from a keyboard, not just by mouse/touch.
    el.addEventListener("keydown", ev => {
      if (ev.key !== "Enter" && ev.key !== " ") return;
      ev.preventDefault();
      pick(ev);
    });
  });
  const chg = grid.querySelector("[data-change]");
  if (chg) chg.addEventListener("click", ev => {
    ev.stopPropagation();
    const beforeTop = chg.getBoundingClientRect().top;
    state.style = null; state.colors = []; state.split = {}; state.activeColor = null;
    renderHats(); sync();
    settleAfterCollapse(beforeTop, "#hats");
  });
  if (!picking) grid.querySelectorAll("[data-hat]").forEach(el => {
    const st = STYLES.find(x => x.id === el.dataset.hat);
    el.classList.toggle("f-hide", !!st && !passes(st, filt));
  });
  if (picking) renderColorPanel();
}

/* ---------- color dropdown ---------- */
function renderColorPanel(){
  const host = $("colorHost");
  if (!host || !state.style) return;
  const s = state.style;
  host.innerHTML =
    '<div class="colorpanel">' +
      '<h3>Choose your colors</h3>' +
      '<p class="cp-sub">Available in ' + s.colors.length + ' colors. Pick one or as many as you like, mixing costs nothing extra.</p>' +
      '<div class="dd" id="dd">' +
        '<button type="button" class="dd-btn" id="ddBtn"><span id="ddLabel">Select a color</span>' +
        '<svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></button>' +
        '<div class="dd-menu" id="ddMenu">' +
          s.colors.map((c, i) =>
            '<div class="dd-opt ' + (state.colors.indexOf(c) > -1 ? "picked" : "") + (isOut(s, c) && state.colors.indexOf(c) === -1 ? " oos" : "") + '" data-color="' + c + '">' +
              '<img src="' + colorImg(s, c) + '" alt="' + c + '" loading="' + (i < 8 ? "eager" : "lazy") + '" decoding="async" onerror="this.onerror=null;this.src=\'' + s.imgs[0] + '\'">' +
              '<span>' + c + (isOut(s, c) ? ' <em class="oos-tag">Out of stock</em>' : '') + '</span>' +
              (state.colors.indexOf(c) > -1 ? '<span class="tick">&#10003;</span>' : "") +
            '</div>').join("") +
          // lives inside #ddMenu so "sticky" pins it to the bottom of the
          // actual scrollable list, not the collapsed #dd wrapper -- that
          // mismatch was what made it float over the closed button.
          '<div class="dd-more" id="ddMore"><span>Scroll for more colors <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg></span></div>' +
        '</div>' +
      '</div>' +
      '<div class="picked-row" id="pickedRow"></div>' +
    '</div>';

  const dd = $("dd"), menu = $("ddMenu"), more = $("ddMore");
  function cue(){
    if (!menu || !more) return;
    more.classList.toggle("on", menu.scrollHeight - menu.scrollTop - menu.clientHeight > 12);
  }
  if (menu) menu.addEventListener("scroll", cue);
  $("ddBtn").addEventListener("click", e => { e.stopPropagation(); dd.classList.toggle("open"); setTimeout(cue, 20); });
  menu.addEventListener("click", e => e.stopPropagation());
  document.addEventListener("click", () => { if (dd) dd.classList.remove("open"); });

  host.querySelectorAll("[data-color]").forEach(opt => {
    opt.addEventListener("click", () => {
      const c = opt.dataset.color;
      const i = state.colors.indexOf(c);
      if (i === -1 && isOut(state.style, c)) return;
      if (i === -1){ state.colors.push(c); state.activeColor = c; }
      else {
        state.colors.splice(i,1); delete state.split[c];
        if (state.activeColor === c) state.activeColor = state.colors[state.colors.length-1] || null;
      }
      updateHero();
      renderColorPanel(); renderSplit(); sync();
    });
  });
  renderPicked();
}
// Swap the expanded card's main photo to the previewed color without re-rendering the grid.
function updateHero(){
  const img = document.getElementById("hatHero");
  const cap = document.getElementById("hatHeroCap");
  if (!img || !state.style) return;
  const c = state.activeColor;
  img.src = (c && state.style.colors.indexOf(c) > -1) ? colorImg(state.style, c) : state.style.imgs[0];
  if (cap) cap.textContent = c || "Pick a color to preview";
}

function renderPicked(){
  const row = $("pickedRow");
  if (!row) return;
  if (!state.colors.length){ row.innerHTML = ""; $("ddLabel").textContent = "Select a color"; return; }
  $("ddLabel").textContent = state.colors.length === 1 ? state.colors[0] : state.colors.length + " colors selected";
  row.innerHTML = state.colors.map(c =>
    '<span class="pchip' + (state.activeColor === c ? ' on' : '') + '" data-preview="' + c + '">' +
    '<img src="' + colorImg(state.style, c) + '" alt="' + c + '" onerror="this.onerror=null;this.src=\'' + state.style.imgs[0] + '\'">' +
    c + '<button type="button" data-remove="' + c + '" aria-label="Remove ' + c + '">&times;</button></span>').join("");
  row.querySelectorAll("[data-remove]").forEach(b => {
    b.addEventListener("click", ev => {
      ev.stopPropagation();
      const c = b.dataset.remove;
      state.colors = state.colors.filter(x => x !== c);
      delete state.split[c];
      if (state.activeColor === c) state.activeColor = state.colors[state.colors.length-1] || null;
      updateHero();
      renderColorPanel(); renderSplit(); sync();
    });
  });
  // tapping a chosen color previews it on the main photo
  row.querySelectorAll("[data-preview]").forEach(el => {
    el.addEventListener("click", () => {
      state.activeColor = el.dataset.preview;
      updateHero(); renderPicked();
    });
  });
}

/* ---------- step 2: quantity + split ---------- */
// Fitted styles (s.sizes) split each color by size; s.sizeOnly limits a size to listed colors.
const isSized = () => !!(state.style && state.style.sizes);
function sizesFor(c){
  const s = state.style;
  return s.sizes.filter(z => (!(s.sizeOnly && s.sizeOnly[z]) || s.sizeOnly[z].indexOf(c) > -1) && !sizeOut(s, c, z));
}
function splitKeys(){
  if (!isSized()) return state.colors.slice();
  const k = [];
  state.colors.forEach(c => sizesFor(c).forEach(z => k.push(c + " / " + z)));
  return k;
}
function splitTotal(){
  const keep = new Set(splitKeys());
  Object.keys(state.split).forEach(k => { if (!keep.has(k)) delete state.split[k]; });
  return Object.values(state.split).reduce((a,b) => a + (+b || 0), 0);
}
function renderSizedSplit(host){
  const total = splitTotal();
  const target = state.qty || 0;
  const bad = target && total !== target;
  const note = state.style.sizing ? '<div class="split-note">' + state.style.sizing + '</div>' : "";
  host.innerHTML =
    '<div class="split"><div class="split-head">How many of each size' + (state.colors.length > 1 ? ' and color' : '') + '?</div>' + note +
    state.colors.map(c =>
      '<div class="split-row sized"><img src="' + colorImg(state.style, c) + '" alt="' + c + '" onerror="this.onerror=null;this.src=\'' + state.style.imgs[0] + '\'">' +
      '<span class="nm">' + c + '</span><div class="split-sizes">' +
      sizesFor(c).map(z => { const k = c + " / " + z;
        return '<label><span>' + z + '</span><input type="number" min="0" inputmode="numeric" data-split="' + k + '" value="' + (state.split[k] != null ? state.split[k] : "") + '" placeholder="0"></label>'; }).join("") +
      '</div></div>').join("") +
    '<div class="split-total ' + (bad ? "bad" : "") + '"><span>Allocated</span><span>' + total +
    (target ? " of " + target : "") + (bad ? " (needs to match)" : "") + '</span></div></div>';
  host.querySelectorAll("[data-split]").forEach(inp => {
    // update the running total in place so the field being typed in keeps focus
    inp.addEventListener("input", () => {
      state.split[inp.dataset.split] = +inp.value || 0;
      const t = splitTotal(), tg = state.qty || 0, b = tg && t !== tg, el = host.querySelector(".split-total");
      if (el){ el.classList.toggle("bad", !!b); el.lastChild.textContent = t + (tg ? " of " + tg : "") + (b ? " (needs to match)" : ""); }
      sync();
    });
  });
}
function renderSplit(){
  const host = $("splitHost");
  if (!host) return;
  if (isSized() && state.colors.length){ renderSizedSplit(host); return; }
  if (state.colors.length < 2){ host.innerHTML = ""; return; }
  const total = splitTotal();
  const target = state.qty || 0;
  const bad = target && total !== target;
  host.innerHTML =
    '<div class="split"><div class="split-head">How many of each color?</div>' +
    state.colors.map(c =>
      '<div class="split-row"><img src="' + colorImg(state.style, c) + '" alt="' + c + '" onerror="this.onerror=null;this.src=\'' + state.style.imgs[0] + '\'">' +
      '<span class="nm">' + c + '</span>' +
      '<input type="number" min="0" inputmode="numeric" data-split="' + c + '" value="' + (state.split[c] != null ? state.split[c] : "") + '" placeholder="0"></div>').join("") +
    '<div class="split-total ' + (bad ? "bad" : "") + '"><span>Allocated</span><span>' + total +
    (target ? " of " + target : "") + (bad ? " (needs to match)" : "") + '</span></div></div>';
  host.querySelectorAll("[data-split]").forEach(inp => {
    inp.addEventListener("input", () => { state.split[inp.dataset.split] = +inp.value || 0; renderSplit(); sync(); });
  });
}
function evenSplit(){
  if (isSized()) return; // sizes have to be picked by the customer
  if (state.colors.length < 2 || !state.qty) return;
  const base = Math.floor(state.qty / state.colors.length);
  let rem = state.qty - base * state.colors.length;
  state.colors.forEach(c => { state.split[c] = base + (rem-- > 0 ? 1 : 0); });
}

/* ---------- step 3: design ---------- */
function renderDesign(){
  $("decos").innerHTML = DECOS.map(d =>
    '<button type="button" class="chip ' + (d.id === state.deco.id ? "on" : "") + '" data-d="' + d.id + '">' + d.label +
    (d.add ? '<span class="tag">+' + money(d.add) + '/hat</span>' : '<span class="tag inc">Included</span>') + '</button>').join("");
  $("decos").querySelectorAll("[data-d]").forEach(b =>
    b.addEventListener("click", () => { state.deco = DECOS.find(d => d.id === b.dataset.d); renderDesign(); sync(); }));

  $("places").innerHTML = PLACEMENTS.map(p =>
    '<button type="button" class="chip ' + (state.places.has(p.id) ? "on" : "") + '" data-p="' + p.id + '">' + p.label +
    (p.add ? '<span class="tag">+' + money(p.add) + '/hat</span>' : '<span class="tag inc">Included</span>') + '</button>').join("");
  $("places").querySelectorAll("[data-p]").forEach(b =>
    b.addEventListener("click", () => {
      const pl = PLACEMENTS.find(x => x.id === b.dataset.p);
      if (pl.locked) return;
      state.places.has(pl.id) ? state.places.delete(pl.id) : state.places.add(pl.id);
      renderDesign(); sync();
    }));

  const fpWrap = $("frontPosWrap");
  if (fpWrap){
    fpWrap.style.display = state.places.has("front") ? "" : "none";
    $("frontPos").innerHTML = FRONT_POSITIONS.map(p =>
      '<button type="button" class="chip ' + (p === state.frontPos ? "on" : "") + '" data-fp="' + p + '">' + p + '</button>').join("");
    $("frontPos").querySelectorAll("[data-fp]").forEach(b =>
      b.addEventListener("click", () => { state.frontPos = b.dataset.fp; renderDesign(); sync(); }));
  }
  renderUploads();
}

function renderUploads(){
  const host = $("uploads");
  if (!host) return;
  const chosen = PLACEMENTS.filter(p => state.places.has(p.id));
  host.innerHTML = chosen.map(p => {
    const f = state.files[p.id];
    return '<div class="up-slot ' + (p.id === "front" ? "req " : "") + (f ? "has-file" : "") + '">' +
      '<div class="up-slot-label">' + p.label + ' logo ' +
        (p.add ? '<span class="up-tag">+' + money(p.add) + '/hat</span>' : '<span class="up-tag inc">Included</span>') +
      '</div>' +
      '<div class="up-slot-sub">' + (
        p.id === "front" ? "Your main logo, stitched on the front panel." :
        p.id === "left"  ? "Artwork for the left side, as you look at the hat." :
        p.id === "right" ? "Artwork for the right side, as you look at the hat." :
                           "Artwork for the back of the hat.") + '</div>' +
      '<input type="file" data-up="' + p.id + '" accept=".png,.jpg,.jpeg,.pdf,.ai,.svg,image/*">' +
      (f ? '<div class="up-have">Attached: ' + f.name + '</div>' : "") +
    '</div>';
  }).join("");
  host.querySelectorAll("[data-up]").forEach(inp => {
    inp.addEventListener("change", e => {
      const file = e.target.files && e.target.files[0];
      if (file && file.size > 10 * 1024 * 1024){ alert("That file is over 10 MB. Please send a smaller file or email it to help@threadbreak.com."); e.target.value = ""; return; }
      state.files[inp.dataset.up] = file || null;
      renderUploads();
    });
  });
  // drop files for locations that are no longer selected
  ["left","right","back"].forEach(id => { if (!state.places.has(id)) state.files[id] = null; });
}

/* ---------- review ---------- */
function renderReview(){
  const each = perHat();
  const places = [...state.places].map(id => id === "front"
    ? "Front (" + state.frontPos + ")"
    : (PLACEMENTS.find(p => p.id === id) || {}).label || id);
  const rows = [
    ["Hat", state.style ? nameOf(state.style) + " (" + state.style.brand + ")" : "-"],
    ["Colors", colorSummary()],
    ["Sizing", state.style ? sizingOf(state.style) : "-"],
    ["Quantity", state.qty || "-"],
    ["Proof sent by", ($("proofMethod") && $("proofMethod").value)
      ? ($("proofMethod").value === "Text message" && $("proofPhone") && $("proofPhone").value.trim()
          ? "Text to " + $("proofPhone").value.trim() : $("proofMethod").value)
      : "-"],
    ["Decoration", state.deco.label],
    ["Placement", places.join(", ")],
    ["Price per hat", each ? money(each) : "-"],
    ["Order total", each && state.qty ? money(each * state.qty) : "-"]
  ];
  $("review").innerHTML = rows.map(r =>
    '<div class="rev-line"><span>' + r[0] + '</span><strong>' + r[1] + '</strong></div>').join("");
}

/* ---------- step machinery ---------- */
function canLeave(step){
  if (step === 1) return !!state.style && state.colors.length > 0;
  if (step === 2){
    if (!state.qty || state.qty < 5) return false;
    if (isSized() || state.colors.length > 1) return splitTotal() === state.qty;
    return true;
  }
  if (step === 3){
    const m = $("proofMethod") ? $("proofMethod").value : "";
    if (!m) return false;
    if (m === "Text message"){
      const p = $("proofPhone") ? $("proofPhone").value.replace(/\D/g, "") : "";
      if (p.length < 10) return false;
    }
    return true;
  }
  return true;
}
function goto(step){
  state.step = step;
  if (step > state.maxStep) state.maxStep = step;
  // returning to step 1 should show the hat exactly as they left it
  if (step === 1) renderHats();
  if (step === 2) renderSplit();
  if (step === 3) renderDesign();
  document.querySelectorAll("#tbco .tbstep").forEach(sec => {
    sec.classList.toggle("active", +sec.dataset.step === step);
  });
  if (step === 4) renderReview();
  renderRail();
  // Only move the page if the new step actually landed somewhere the visitor
  // can't already see (e.g. they scrolled down to re-check something, or the
  // previous step was much taller/shorter). Most Continue/Back taps don't
  // need to move the viewport at all, and forcing it every time read as the
  // page auto-scrolling on its own.
  requestAnimationFrame(() => {
    const sec = document.querySelector('#tbco .tbstep.active');
    if (!sec) return;
    const top = sec.getBoundingClientRect().top;
    const visibleFrom = railBottom();
    const visibleTo = window.innerHeight - 60;
    if (top < visibleFrom - 4 || top > visibleTo) easeScrollToEl(sec, 500);
  });
  sync();
}
// Only used by the explicit "Choose a different hat" button. Navigating back to
// step 1 must keep the chosen hat, colors, and split intact.
function resetToStep1(){
  state.style = null; state.colors = []; state.split = {}; state.activeColor = null;
  state.done.delete(1); state.maxStep = 1;
  renderHats();
}
function renderRail(){
  // shorter labels on phones so all four steps fit one line
  const narrow = window.matchMedia("(max-width: 640px)").matches;
  const names = narrow
    ? ["Hat", "Qty", "Design", "Review"]
    : ["Hat & colors", "Quantity", "Design", "Review"];
  $("rail").innerHTML = names.map((n, i) => {
    const step = i + 1;
    const cls = state.step === step ? "active" : (state.done.has(step) ? "done" : "");
    const mark = (state.done.has(step) && state.step !== step) ? "&#10003;" : step;
    return '<div class="rail-item ' + cls + '" data-goto="' + step + '"><span class="dot">' + mark + '</span>' + n + '</div>';
  }).join("");
  $("rail").querySelectorAll("[data-goto]").forEach(el => {
    const t = +el.dataset.goto;
    const reachable = t <= state.maxStep || (t === state.step + 1 && canLeave(state.step));
    el.style.opacity = reachable ? "1" : ".45";
    el.style.cursor = reachable ? "pointer" : "not-allowed";
    el.addEventListener("click", () => {
      if (!reachable) return;
      if (t > state.step){ state.done.add(state.step); if (state.colors.length > 1) evenSplit(); renderSplit(); }
      goto(t);
    });
  });
}

/* ---------- summaries + sticky bar ---------- */
function sync(){
  $("sum1").innerHTML = state.style
    ? nameOf(state.style) + (state.colors.length ? " &middot; " + (state.colors.length === 1 ? state.colors[0] : state.colors.length + " colors") : "")
    : "";
  $("sum2").textContent = state.qty ? state.qty + " hats" : "";
  $("sum3").textContent = state.deco.label;
  $("sum4").textContent = "";

  $("next1").disabled = !canLeave(1);
  $("next2").disabled = !canLeave(2);
  if ($("next3")) $("next3").disabled = !canLeave(3);

  const each = perHat();
  const pn = $("priceNow");
  if (pn){
    pn.style.display = (each && state.qty) ? "flex" : "none";
    if (each && state.qty){
      pn.innerHTML =
        '<div class="pn"><span class="pn-l">Price per hat</span><span class="pn-v">' + money(each) + '</span></div>' +
        '<div class="pn"><span class="pn-l">' + state.qty + ' hats</span><span class="pn-v">' + money(each * state.qty) + '</span></div>' +
        '<div class="pn-note">Includes front embroidery, free digitizing, and free shipping to the lower 48.</div>';
    }
  }
  const nt = nextTier();
  $("nudge").innerHTML = (nt && state.qty)
    ? '<div class="tier-nudge">Add ' + (nt[0] - state.qty) + ' more and your price drops to ' + money(nt[1]) + '/hat.</div>'
    : "";

  $("barQty").textContent = state.qty || 0;
  $("barEach").textContent = each ? money(each) : "-";
  $("barTotal").textContent = each && state.qty ? money(each * state.qty) : "-";
  $("bar").classList.toggle("show", !!state.style);
  $("barCta").textContent = state.step === 4 ? "Add to Cart" : "Continue";
  $("barCta").disabled = state.step < 4 && !canLeave(state.step);
}

/* ---------- Apps Script + cart plumbing ---------- */
function fileToB64(file){
  return new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(r.result.split(",")[1]);
    r.onerror = () => rej(new Error("read failed"));
    r.readAsDataURL(file);
  });
}
function orderMeta(){
  const per = perHat();
  const places = [...state.places].map(id => id === "front"
    ? "Front (" + state.frontPos + ")"
    : (PLACEMENTS.find(p => p.id === id) || {}).label || id);
  return {
    name: "",
    email: "",
    phone: "",
    style: state.style ? state.style.name : "",
    requestedStyle: "",
    color: colorSummary(),
    qty: state.qty,
    sizing: state.style ? sizingOf(state.style) : "",
    deco: state.deco.label,
    placements: places.join(", "),
    notes: ($("notes") && $("notes").value.trim()) || "-",
    proof: ($("proofMethod") && $("proofMethod").value) || "",
    proofPhone: ($("proofPhone") && $("proofPhone").value.trim()) || "",
    social: ($("noSocial") && $("noSocial").checked) ? "Do NOT share on social" : "OK to share on social",
    estimate: per === null ? "quote" : money(per) + "/hat, " + money(per * state.qty) + " total"
  };
}
function scriptConfigured(){ return APPS_SCRIPT_URL && APPS_SCRIPT_URL.indexOf("PASTE") !== 0; }

async function sendToDrive(type){
  if (!scriptConfigured()) return { ok:false, skipped:true, uploaded:[] };
  const uploaded = [], files = [];
  for (const p of activeUploadSlots()){
    const f = state.files[p];
    if (!f) continue;
    const label = (PLACEMENTS.find(x => x.id === p) || {}).label || p;
    files.push({ placement: label, name: f.name, mimeType: f.type || "application/octet-stream", data: await fileToB64(f) });
    uploaded.push(label);
  }
  const body = JSON.stringify({ type: type, meta: orderMeta(), files: files });

  const box = $("uploadProgress"), fill = $("upFill"), label = $("upLabel");
  const hasLogo = files.length > 0;
  const workingText = hasLogo ? "Sending your logo..." : "Submitting...";
  const doneText = hasLogo ? "Logo sent" : "Submitted";
  if (box) box.style.display = "block";
  if (label) label.textContent = workingText;
  let simPct = 8;
  if (fill) fill.style.width = simPct + "%";
  const simTimer = setInterval(() => {
    if (simPct < 90){ simPct += Math.max(1, (90 - simPct) * 0.08); if (fill) fill.style.width = simPct + "%"; }
  }, 200);

  return new Promise(resolve => {
    const finish = result => {
      clearInterval(simTimer);
      if (fill) fill.style.width = "100%";
      if (label) label.textContent = doneText;
      setTimeout(() => resolve(result), 300);
    };
    // no-cors fetch actually delivers to Apps Script (a cross-origin XHR gets
    // blocked following Apps Script's 302 redirect). We can't read the response
    // in no-cors mode, so we treat a completed send as success.
    fetch(APPS_SCRIPT_URL, {
      method: "POST",
      mode: "no-cors",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: body
    })
    .then(() => finish({ ok:true, uploaded:uploaded }))
    .catch(() => { clearInterval(simTimer); resolve({ ok:false, uploaded:uploaded }); });
  });
}

// Builds the cart add as multipart form data so logo files ride along as line
// item properties. Shopify stores each file and shows it as a link on the order.
function cartFormData(items, files){
  const fd = new FormData();
  items.forEach((it, i) => {
    fd.append("items[" + i + "][id]", it.id);
    fd.append("items[" + i + "][quantity]", it.quantity);
    Object.keys(it.properties || {}).forEach(k => fd.append("items[" + i + "][properties][" + k + "]", it.properties[k]));
  });
  Object.keys(files || {}).forEach(k => { const f = files[k]; fd.append("items[0][properties][" + k + "]", f, f.name || (k + ".png")); });
  return fd;
}
async function addToCart(items, files){
  const hasFiles = files && Object.keys(files).length > 0;
  let res = await fetch("/cart/add.js", hasFiles
    ? { method: "POST", body: cartFormData(items, files) }
    : { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ items: items }) });
  // If Shopify rejects the files (too large, odd format), still place the order
  // without them; the logo also went to Google Drive.
  if (!res.ok && hasFiles){
    console.warn("cart add with files failed, retrying without files", res.status);
    items[0].properties["Logo files"] = "Not attached in Shopify, see Google Drive upload";
    res = await fetch("/cart/add.js", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ items: items }) });
  }
  return res;
}
async function submitCheckout(){
  const btn = $("checkout");
  btn.disabled = true;
  // Give instant feedback right where the tap happened, before the first
  // await -- previously the button text only changed on the "has a logo
  // file" path, so submitting with no file attached (or a slow network)
  // left the button reading "Add to Cart" for several seconds and looking
  // unresponsive.
  btn.textContent = "Adding...";
  $("cartErr").classList.remove("show");

  const hasFiles = activeUploadSlots().some(p => state.files[p]);
  let artNote = "Customer will email logo to help@threadbreak.com";
  if (hasFiles){
    btn.textContent = "Sending logo...";
    const up = await sendToDrive("order-artwork");
    artNote = up.ok ? ("Uploaded (" + up.uploaded.join(", ") + ")") : "ACTION: email customer for logo (upload not received)";
  } else {
    await sendToDrive("order-details");
  }

  btn.textContent = "Adding...";
  const meta = orderMeta();
  const tier = tierFor(state.style, state.qty);
  const props = {
    "Hat Color(s)": meta.color,
    "Sizing": meta.sizing,
    "Decoration": meta.deco,
    "Placements": meta.placements,
    "Artwork": artNote
  };
  props["Proof delivery"] = meta.proof + (meta.proof === "Text message" && meta.proofPhone ? " to " + meta.proofPhone : "");
  if (meta.notes !== "-") props["Notes"] = meta.notes;
  const skuLine = skuSummary();
  if (skuLine) props["_S&S SKUs"] = skuLine; // underscore = hidden from the customer, shown on the order

  const items = [{ id: tier[2], quantity: state.qty, properties: props }];
  if (state.deco.variantId)
    items.push({ id: state.deco.variantId, quantity: state.qty, properties: { "Applies to": state.style.name } });
  for (const p of state.places){
    const pl = PLACEMENTS.find(x => x.id === p);
    if (pl && pl.variantId)
      items.push({ id: pl.variantId, quantity: state.qty, properties: { "Applies to": state.style.name } });
  }

  try {
    const files = {};
    for (const p of activeUploadSlots()){
      const fl = state.files[p];
      if (fl) files[((PLACEMENTS.find(x => x.id === p) || {}).label || p) + " logo"] = fl;
    }
    const res = await addToCart(items, files);
    if (!res.ok){
      // Surface what Shopify actually said so a bad variant or sold-out add-on
      // is obvious instead of a generic failure.
      let detail = "";
      try { const j = await res.json(); detail = j.description || j.message || ""; } catch(_) {}
      throw new Error(detail || ("cart add failed (" + res.status + ")"));
    }
    window.location.href = "/checkout";
  } catch (e) {
    btn.disabled = false; btn.textContent = "Add to Cart";
    const box = $("cartErr");
    const msg = (e && e.message) ? e.message : "";
    box.innerHTML = "Something went wrong adding this to your cart. Please try again, or email help@threadbreak.com and we'll sort it out."
      + (msg ? '<br><span style="font-size:12px;opacity:.8">Details: ' + msg + '</span>' : "");
    box.classList.add("show");
    box.scrollIntoView({ behavior:"smooth", block:"center" });
    console.error("[tbco] cart add failed", e, items);
  }
}

/* ---------- wire up ---------- */
function bindToggle(btnId, panelId, showText, hideText){
  const b = $(btnId), p = $(panelId);
  if (!b || !p) return;
  b.addEventListener("click", () => {
    const hidden = p.hasAttribute("hidden");
    if (hidden){ p.removeAttribute("hidden"); b.textContent = hideText; }
    else { p.setAttribute("hidden",""); b.textContent = showText; }
  });
}

$("qty").addEventListener("input", e => {
  state.qty = +e.target.value || null;
  if (state.colors.length > 1) evenSplit();
  renderSplit(); sync();
});
$("next1").addEventListener("click", () => { state.done.add(1); if (state.colors.length > 1) evenSplit(); renderSplit(); goto(2); });
$("next2").addEventListener("click", () => { state.done.add(2); goto(3); });
$("next3").addEventListener("click", () => { state.done.add(3); goto(4); });
$("checkout").addEventListener("click", submitCheckout);
$("barCta").addEventListener("click", () => {
  if (state.step === 4){ submitCheckout(); return; }
  if (!canLeave(state.step)) return;
  state.done.add(state.step);
  if (state.step === 1 && state.colors.length > 1){ evenSplit(); renderSplit(); }
  goto(Math.min(state.step + 1, 4));
});
document.querySelectorAll("#tbco [data-back]").forEach(b => {
  b.addEventListener("click", () => {
    const t = +b.dataset.back;
    goto(t);
  });
});

// Texting a proof needs a mobile number, and Shopify's checkout phone field is
// optional, so collect it here when they pick text.
(function(){
  const sel = $("proofMethod"), wrap = $("proofPhoneWrap"), hint = $("proofHint");
  if (!sel) return;
  sel.addEventListener("change", () => {
    const isText = sel.value === "Text message";
    if (wrap){ if (isText) wrap.removeAttribute("hidden"); else { wrap.setAttribute("hidden",""); if ($("proofPhone")) $("proofPhone").value = ""; } }
    if (hint) hint.textContent = isText
      ? "We'll text your mockup from (336) 585-6176 within one business day. Nothing gets stitched until you approve it."
      : "We'll email your mockup from help@threadbreak.com within one business day. Nothing gets stitched until you approve it.";
    sync();
  });
  if ($("proofPhone")) $("proofPhone").addEventListener("input", sync);
})();

bindToggle("puffBtn","puffInfo","What is 3D puff?","Hide");
bindToggle("enToggle","enExample","View example","Hide example");
bindToggle("aiToggle","aiTips","Using AI artwork? Read this","Hide AI tips");

renderHats();
renderDesign();
renderRail();
sync();
})();

</script>
