{%- comment -%} build: order-v20 {%- endcomment -%}
{%- comment -%}
  Custom Hats order page. Four-step wizard: hat+colors, quantity, design, review.
  Colors are chosen inside the selected hat card. Uploads are per placement.
  Requires the two Shopify products (Custom Embroidered Hat + Custom Hat Add-On)
  set to ACTIVE. Cart add uses /cart/add.js on the live domain.
  Artwork + order details POST to the Apps Script endpoint below.
{%- endcomment -%}
<div id="tbco">
<style>
  #tbco{position:relative;z-index:1;padding-top:6rem;max-width:100%;overflow-x:clip;font-family:'DM Sans',sans-serif;
    --purple:#5028AA;--purple2:#6234c9;--purple-dark:#3D1E85;--ink:#14121C;--ice:#F3EFFC;--white:#fff;--line:#E2E0EA;--muted:#6B6A78;--good:#1E9E5A;color:var(--ink)}
  #tbco *{box-sizing:border-box;margin:0;padding:0}
  #tbco .wrap{max-width:880px;margin:0 auto;padding:0 20px}
  /* the form itself gets more room than the prose-width hero */
  #tbco .form-wrap{max-width:1180px;margin:0 auto;padding:0 20px}
  #tbco .bar-in{max-width:1180px}
  #tbco header{position:relative;overflow:hidden;background:var(--ink);color:var(--white);padding:44px 0 20px}
  #tbco .props .gbp-link{color:inherit;text-decoration:underline;text-underline-offset:2px}
  #tbco .hero-photos{position:absolute;inset:0;display:flex;z-index:0;opacity:.5}
  #tbco .hero-photos div{flex:1;background-size:cover;background-position:center;min-width:0}
  #tbco .hero-photos div:not(:first-child){-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%);mask-image:linear-gradient(90deg,transparent,#000 12%);margin-left:-6%}
  #tbco header::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,var(--ink) 0%,rgba(20,18,28,.7) 42%,rgba(20,18,28,.32) 100%)}
  #tbco header .wrap{position:relative;z-index:2}
  @media(max-width:640px){#tbco .hero-photos div:nth-child(n+4){display:none}#tbco header::after{background:linear-gradient(180deg,rgba(20,18,28,.72),rgba(20,18,28,.9))}}
  #tbco h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(36px,6vw,58px);line-height:.95;letter-spacing:.01em;margin:0 0 10px}
  #tbco h1 em{font-style:normal;color:#7F5FD8}
  #tbco .sub{font-size:15px;line-height:1.55;color:#D9D6E4;max-width:560px}
  #tbco .props{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:12px;margin-bottom:0}
  #tbco .props span{font-size:13px;font-weight:500;color:#EDEAF7}
  #tbco .props span::before{content:"\2713";color:#7F5FD8;font-weight:700;margin-right:7px}
  /* compact and below the form, so it never pushes the hat grid down */
  #tbco .tbco-textus{display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;
    margin:14px auto 0;padding:0;background:none;border:none;text-decoration:none;color:var(--muted);
    font-size:13.5px;width:100%;text-align:center}
  #tbco .tbco-textus:hover{color:var(--purple)}
  #tbco .tbco-textus-icon{display:inline-flex;color:var(--purple);flex:none}
  #tbco .tbco-textus strong{color:var(--purple);font-weight:700;white-space:nowrap}

  /* progress rail */
  #tbco .rail{display:flex;gap:6px;margin:20px 0 18px;flex-wrap:wrap;position:sticky;top:74px;z-index:50;
    background:rgba(255,255,255,.97);backdrop-filter:blur(6px);padding:12px;border-radius:12px;
    box-shadow:0 6px 18px rgba(20,18,28,.10);border:1px solid var(--line)}
  @media(max-width:640px){
    /* compact pinned rail on phones so it never eats the screen */
    #tbco .rail{gap:5px;padding:8px;margin:20px 0 16px;top:64px}
  }
  #tbco .rail-item{flex:1 1 0;min-width:120px;display:flex;align-items:center;gap:9px;padding:11px 13px;border-radius:11px;background:#fff;border:1.5px solid var(--line);font-size:13.5px;font-weight:600;color:var(--muted);cursor:pointer;transition:.18s}
  #tbco .rail-item .dot{width:22px;height:22px;border-radius:50%;background:var(--line);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;flex:0 0 auto}
  #tbco .rail-item.done{border-color:#B7A6EE;color:var(--ink)}
  #tbco .rail-item.done .dot{background:var(--good)}
  #tbco .rail-item.active{border-color:var(--purple);color:var(--purple);box-shadow:0 4px 14px rgba(80,40,170,.12)}
  #tbco .rail-item.active .dot{background:var(--purple)}
  {%- comment -%}
    All four steps must fit one line on a phone. These come after the desktop
    rules so they win, and the labels are shortened in the markup to match.
  {%- endcomment -%}
  @media(max-width:640px){
    #tbco .rail{gap:4px;padding:7px}
    #tbco .rail-item{min-width:0;flex:1 1 0;padding:7px 3px;font-size:10.5px;gap:4px;
      flex-direction:column;justify-content:center;text-align:center;line-height:1.2;border-radius:9px}
    #tbco .rail-item .dot{width:18px;height:18px;font-size:10.5px}
  }
  @media(max-width:360px){
    #tbco .rail-item{font-size:9.5px;padding:6px 2px}
  }

  /* tap lock: briefly ignore taps elsewhere in the form while a collapse
     (picking a hat, switching hats) is settling the scroll position, so a
     fast second tap can't land on the wrong control underneath it. The
     just-selected card is exempted so color-picking isn't blocked. */
  #tbco .tap-lock > *{pointer-events:none}
  #tbco .tap-lock .tap-lock-keep{pointer-events:auto}

  /* steps */
  #tbco .tbstep{background:#fff;border:1.5px solid var(--line);border-radius:16px;margin-bottom:14px;display:none;opacity:1;transform:none;text-align:left;padding:0;scroll-margin-top:150px}
  #tbco .tbstep.active{display:block;opacity:1;transform:none;border-color:var(--purple);box-shadow:0 6px 22px rgba(80,40,170,.10)}
  #tbco .tbstep::after{content:none}
  #tbco .tbstep-head{display:flex;align-items:center;gap:13px;padding:20px 22px}
  #tbco .tbstep-num{width:28px;height:28px;border-radius:50%;background:var(--ice);color:var(--purple);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex:0 0 auto}
  #tbco .tbstep-head h2{font-family:'Bebas Neue',sans-serif;font-size:23px;letter-spacing:.02em;flex:1}
  #tbco .tbstep-sum{font-size:13px;color:var(--muted);text-align:right;max-width:45%}
  #tbco .tbstep-body{padding:0 22px 22px}
  #tbco .tbstep-hint{font-size:13.5px;color:var(--muted);margin-bottom:16px;line-height:1.55}
  #tbco .tbstep-hint strong{color:var(--ink)}

  /* hat grid */
  #tbco .hat-filters{margin:0 0 14px;display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px}
  #tbco .hat-filters[hidden]{display:none}
  #tbco .fsel{position:relative;display:flex;align-items:center;gap:6px;border:1.5px solid var(--line);border-radius:10px;background:#fff;padding:0 30px 0 11px;height:40px;flex:1 1 150px;max-width:240px}
  #tbco .fsel:focus-within{border-color:var(--purple)}
  #tbco .fsel span{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#8a85a0}
  #tbco .fsel select{appearance:none;-webkit-appearance:none;border:0;background:transparent;font:600 14px/1.2 inherit;color:#2a2638;flex:1;min-width:0;height:100%;cursor:pointer;outline:none}
  #tbco .fsel::after{content:"";position:absolute;right:12px;top:50%;width:7px;height:7px;border-right:2px solid #6f6a85;border-bottom:2px solid #6f6a85;transform:translateY(-70%) rotate(45deg);pointer-events:none}
  #tbco .fcount{font-size:13px;color:#8a85a0;white-space:nowrap}
  #tbco .fcount button{border:0;background:none;color:var(--purple);font-weight:700;cursor:pointer;padding:0 0 0 6px;font-size:13px}
  @media(max-width:640px){#tbco .fsel{max-width:none} #tbco .fcount{width:100%}}
  #tbco .hat.f-hide{display:none}
  #tbco .hats{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:13px}
  #tbco .hats.picking{grid-template-columns:1fr}
  #tbco .hat{border:1.5px solid var(--line);border-radius:13px;background:#fff;cursor:pointer;overflow:hidden;transition:.2s;position:relative;scroll-margin-top:150px}
  #tbco .hat:hover{border-color:#B7A6EE;transform:translateY(-2px)}
  #tbco .hat:focus-visible{outline:2.5px solid var(--purple);outline-offset:2px}
  #tbco .hat.on{border-color:var(--purple);box-shadow:0 6px 22px rgba(80,40,170,.18);overflow:visible;z-index:5}
  #tbco .hats.picking .hat{display:none}
  #tbco .hats.picking .hat.on{display:grid;cursor:default}
  #tbco .hats.picking .hat.on:hover{transform:none}
  #tbco .hat-img{width:100%;aspect-ratio:1/1;object-fit:contain;background:#fff;display:block}
  #tbco .hat-imgwrap{position:relative}
  /* brand mark sits on the photo in the grid */
  #tbco .hat-logo{position:absolute;bottom:8px;right:8px;height:30px;width:auto;max-width:112px;object-fit:contain;opacity:.95;
    background:rgba(255,255,255,.94);border-radius:6px;padding:4px 8px;box-shadow:0 1px 5px rgba(20,18,28,.14)}
  /* short name only on the two-up mobile grid */
  #tbco .hat-name-sm{display:none;font-weight:700;font-size:13px;line-height:1.25}
  /* expanded: brand mark moves up beside the title */
  #tbco .hat-titlerow{display:flex;align-items:flex-start;gap:12px}
  #tbco .hat-logo-lg{height:52px;width:auto;max-width:170px;object-fit:contain;flex:0 0 auto;margin-top:0}
  #tbco .hat-heroimg{width:100%;max-width:250px}
  #tbco .hat-heroimg .hat-img{width:100%;max-width:250px;height:auto}
  #tbco .hat-herocap{text-align:center;font-size:12px;font-weight:600;color:var(--purple);background:var(--ice);border-radius:8px;padding:5px 8px;margin-top:6px}
  #tbco .pchip{cursor:pointer}
  #tbco .pchip.on{border-color:var(--purple);background:var(--ice);box-shadow:0 0 0 2px rgba(80,40,170,.14)}
  #tbco .hat-info{padding:12px 14px 14px}
  #tbco .hat-name{font-weight:700;font-size:14.5px;line-height:1.25}
  #tbco .hat-brand{font-size:11.5px;color:var(--muted);margin-top:2px}
  #tbco .hat-price{margin-top:7px;font-size:13px;font-weight:700;color:var(--purple)}
  #tbco .hat-colors{display:flex;align-items:center;gap:7px;margin-top:8px;font-size:12px;color:var(--muted)}
  #tbco .wheel{width:18px;height:18px;border-radius:50%;flex:0 0 auto;border:1px solid rgba(0,0,0,.12);background:conic-gradient(#e23b3b,#e2a13b,#d7e23b,#4ce23b,#3be2c0,#3b8fe2,#7a3be2,#e23bc0,#e23b3b)}
  #tbco .hat-badge{position:absolute;top:9px;left:9px;background:var(--purple);color:#fff;font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:3px 8px;border-radius:999px;z-index:2}
  /* expanded: photo in the left column, details and colors stacked on the right */
  #tbco .hat.on{display:grid;grid-template-columns:250px minmax(0,1fr);gap:0 26px;padding:18px;align-items:start}
  #tbco .hat.on .hat-heroimg{grid-column:1;grid-row:1 / span 2;position:sticky;top:168px}
  #tbco .hat.on .hat-info{grid-column:2;grid-row:1;padding:0}
  #tbco .hat.on .hat-expand{grid-column:2;grid-row:2;border-top:none;margin-top:0;padding:0}
  #tbco .hat.on .colorpanel{margin-top:16px}
  @media(max-width:900px){
    #tbco .hat.on,#tbco .hats.picking .hat.on{grid-template-columns:1fr;padding:14px}
    #tbco .hat.on .hat-heroimg{grid-column:1;grid-row:1;position:static;max-width:260px;margin:0 auto}
    #tbco .hat.on .hat-info{grid-column:1;grid-row:2;padding-top:14px}
    #tbco .hat.on .hat-expand{grid-column:1;grid-row:3}
  }

  @media(max-width:560px){
    #tbco .hat.on,#tbco .hats.picking .hat.on{display:block;padding:0}
    #tbco .hat.on .hat-heroimg{position:static;width:100%;max-width:none}
    #tbco .hat.on .hat-img{width:100%}
    #tbco .hat.on .hat-info{padding:12px 14px 0}
    #tbco .hat.on .hat-expand{padding:0 14px 16px}
    /* two-up on phones keeps the photos small and the names above the fold */
    #tbco .hats{grid-template-columns:1fr 1fr;gap:10px}
    #tbco .hat-info{padding:10px 11px 12px}
    #tbco .hat-name{display:none}
    #tbco .hat-name-sm{display:block}
    #tbco .hat-logo{height:22px;max-width:82px;bottom:6px;right:6px;padding:3px 6px}
    #tbco .hat.on .hat-name{display:block;font-size:17px}
    #tbco .hat.on .hat-name-sm{display:none}
    #tbco .hat-heroimg{width:100%;max-width:250px}
    #tbco .hat-logo-lg{height:40px;max-width:130px}
    #tbco .hat-brand{font-size:10.5px}
    #tbco .hat-price{font-size:12px;margin-top:5px}
    #tbco .hat-colors{font-size:11px;margin-top:6px}
    #tbco .hat-badge{font-size:9.5px;padding:2px 6px;top:6px;left:6px}
  }
  #tbco .hat-change{display:inline-flex;align-items:center;gap:7px;background:#fff;border:2px solid var(--purple);border-radius:10px;padding:10px 18px;font-family:inherit;font-size:14px;font-weight:600;color:var(--purple);cursor:pointer;margin-top:14px;transition:.16s}
  #tbco .hat-change:hover{background:var(--purple);color:#fff}
  #tbco .hat-specs{margin-top:10px;font-size:12.5px;color:var(--muted);line-height:1.6}
  #tbco .hat-specs b{color:var(--ink);font-weight:600}
  #tbco .hat-expand{padding:0 16px 18px;border-top:1px solid var(--line);margin-top:4px}

  /* color dropdown */
  #tbco .colorpanel{margin-top:16px;border-radius:12px;background:var(--ice);padding:16px;position:relative;z-index:6}
  #tbco .colorpanel h3{font-size:15px;margin-bottom:4px}
  #tbco .cp-sub{font-size:12.5px;color:var(--muted);margin-bottom:13px}
  #tbco .dd{position:relative;max-width:420px}
  #tbco .dd-btn{width:100%;display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fff;border:1.5px solid var(--line);border-radius:11px;padding:11px 13px;font-family:inherit;font-size:14px;cursor:pointer;text-align:left;color:var(--ink)}
  #tbco .dd-btn:hover{border-color:#B7A6EE}
  #tbco .dd-btn .chev{transition:transform .18s;flex:0 0 auto}
  #tbco .dd.open .dd-btn .chev{transform:rotate(180deg)}
  #tbco .dd-menu{display:none;position:absolute;z-index:40;top:calc(100% + 6px);left:0;right:0;max-height:290px;overflow-y:auto;background:#fff;border:1.5px solid var(--line);border-radius:12px;box-shadow:0 14px 34px rgba(20,18,28,.16);scrollbar-width:thin}
  #tbco .dd.open .dd-menu{display:block}
  #tbco .dd-menu::-webkit-scrollbar{width:9px}
  #tbco .dd-menu::-webkit-scrollbar-thumb{background:#B7A6EE;border-radius:9px;border:2px solid #fff}
  #tbco .dd-more{display:none;position:sticky;left:0;right:0;bottom:0;height:40px;margin-bottom:-40px;z-index:41;pointer-events:none;border-radius:0 0 11px 11px;background:linear-gradient(180deg,rgba(255,255,255,0),#fff 72%);align-items:flex-end;justify-content:center;padding-bottom:6px}
  #tbco .dd.open .dd-more.on{display:flex}
  #tbco .dd-more span{font-size:11px;font-weight:700;color:var(--purple);display:flex;align-items:center;gap:5px}
  #tbco .dd-opt{display:flex;align-items:center;gap:11px;padding:9px 12px;cursor:pointer;font-size:13.5px;border-bottom:1px solid #f2f1f6}
  #tbco .dd-opt:last-of-type{border-bottom:none}
  #tbco .dd-opt:hover{background:var(--ice)}
  #tbco .dd-opt img{width:42px;height:42px;object-fit:contain;border-radius:7px;background:#fff;border:1px solid var(--line);flex:0 0 auto}
  #tbco .dd-opt.picked{background:#eee9fb}
  #tbco .dd-opt.oos{opacity:.45;cursor:not-allowed}
  #tbco .dd-opt.oos:hover{background:none}
  #tbco .oos-tag{font-style:normal;font-size:11px;font-weight:600;color:#b42318;margin-left:6px}
  #tbco .dd-opt .tick{margin-left:auto;color:var(--purple);font-weight:700}
  #tbco .picked-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}
  #tbco .pchip{display:flex;align-items:center;gap:8px;background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:6px 9px;font-size:13px}
  #tbco .pchip img{width:32px;height:32px;object-fit:contain;border-radius:6px}
  #tbco .pchip button{background:none;border:none;cursor:pointer;color:var(--muted);font-size:16px;line-height:1;padding:0 2px}
  #tbco .pchip button:hover{color:#c33}

  /* fields */
  #tbco .qty-row{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap}
  #tbco .field{display:flex;flex-direction:column;gap:6px}
  /* a class with display beats the browser default [hidden]{display:none},
     so hidden has to be forced or the phone field shows before it should */
  #tbco [hidden]{display:none !important}
  #tbco .field label{font-size:13px;font-weight:600}
  #tbco .field input,#tbco .field select,#tbco .field textarea{font-family:inherit;font-size:16px;padding:10px 12px;border:1.5px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}
  #tbco .field input:focus,#tbco .field textarea:focus{outline:none;border-color:var(--purple)}
  #tbco .qty-input{width:130px}
  #tbco .price-now{display:flex;gap:26px;flex-wrap:wrap;background:var(--ink);color:#fff;border-radius:12px;padding:14px 18px;margin-top:16px}
  #tbco .price-now .pn{display:flex;flex-direction:column}
  #tbco .price-now .pn-l{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.55)}
  #tbco .price-now .pn-v{font-family:'Bebas Neue',sans-serif;font-size:26px;line-height:1.15}
  #tbco .price-now .pn-note{margin-left:auto;align-self:center;font-size:12px;color:rgba(255,255,255,.65);max-width:220px;line-height:1.5}
  @media(max-width:520px){#tbco .price-now .pn-note{margin-left:0;flex:1 1 100%;max-width:none;margin-top:6px}}
  #tbco .tier-nudge{font-size:13px;color:var(--purple);font-weight:600;background:var(--ice);border-radius:9px;padding:9px 12px;margin-top:13px}
  #tbco .split{margin-top:18px;border:1.5px solid var(--line);border-radius:12px;overflow:hidden}
  #tbco .split-head{background:var(--ice);padding:11px 14px;font-size:13px;font-weight:700}
  #tbco .split-row{display:flex;align-items:center;gap:12px;padding:10px 14px;border-top:1px solid var(--line)}
  #tbco .split-row img{width:38px;height:38px;object-fit:contain;border-radius:7px;border:1px solid var(--line)}
  #tbco .split-row .nm{flex:1;font-size:13.5px}
  #tbco .split-row input{width:88px;font-family:inherit;font-size:16px;padding:8px 10px;border:1.5px solid var(--line);border-radius:9px}
  #tbco .split-total{display:flex;justify-content:space-between;padding:11px 14px;border-top:1.5px solid var(--line);font-size:13.5px;font-weight:700;background:#fafafa}
  #tbco .split-total.bad{color:#c33}
  #tbco .split-note{padding:8px 14px;font-size:12px;color:var(--muted);border-top:1px solid var(--line);background:#fff}
  #tbco .split-row.sized{flex-wrap:wrap}
  #tbco .split-sizes{display:flex;gap:8px;flex-wrap:wrap;flex-basis:100%;padding-left:50px}
  #tbco .split-sizes label{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:11px;font-weight:700;color:var(--muted)}
  #tbco .split-row .split-sizes input{width:66px;text-align:center}

  /* chips */
  #tbco .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
  #tbco .chip{background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:9px 14px;font-family:inherit;font-size:13.5px;cursor:pointer;transition:.15s;color:var(--ink)}
  #tbco .chip:hover{border-color:#B7A6EE}
  #tbco .chip.on{border-color:var(--purple);background:var(--ice);color:var(--purple);font-weight:600}
  #tbco .chip .tag{font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:var(--purple);color:#fff;border-radius:999px;padding:2px 8px;margin-left:7px;display:inline-block;vertical-align:1px}
  #tbco .chip .tag.inc{background:var(--good)}

  /* step 3 pieces */
  #tbco .fld{font-size:13.5px;font-weight:700;margin-top:20px;margin-bottom:7px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  #tbco .info-btn{background:none;border:1px solid var(--line);border-radius:8px;padding:4px 10px;font-family:inherit;font-size:11.5px;font-weight:600;color:var(--purple);cursor:pointer}
  #tbco .info-btn:hover{border-color:var(--purple)}
  #tbco .info-panel{margin-top:11px;background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:16px}
  #tbco .info-compare{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  #tbco .info-col{text-align:center}
  #tbco .info-col strong{display:block;margin-top:8px;font-size:13.5px}
