function fileToB64(file){
  return new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(r.result.split(",")[1]);
    r.onerror = () => rej(new Error("read failed"));
    r.readAsDataURL(file);
  });
}
function orderMeta(){
  const per = perHat();
  const meta = {
    name: $("custName")?.value.trim() || "",
    email: $("custEmail")?.value.trim() || "",
    phone: $("custPhone")?.value.trim() || "",
    style: quoteMode() ? (($("quoteStyle")?.value.trim()) || "Different style (see notes)") : state.style.name,
    requestedStyle: quoteMode() ? ($("quoteStyle").value.trim() || "Not specified, see notes") : "",
    color: quoteMode() ? ($("quoteColor")?.value.trim() || "Not specified") : colorSummary(),
    qty: state.qty,
    deco: state.deco.label,
    placements: [...state.placements].map(p=> p==="front" ? `Front (${state.frontPos})` : PLACEMENTS.find(x=>x.id===p).label).join(", "),
    notes: $("notes").value.trim() || "-",
    social: $("noSocial")?.checked ? "Do NOT share on social" : "OK to share on social",
    estimate: per === null ? "quote" : money(per) + "/hat, " + money(per*state.qty) + " total"
  };
  if (state.style.youth) meta.sizing = state.sizing;
  return meta;
}
function scriptConfigured(){ return APPS_SCRIPT_URL && !APPS_SCRIPT_URL.startsWith("PASTE"); }
async function sendToDrive(type){
  if (!scriptConfigured()) return { ok:false, skipped:true, uploaded:[] };
  const uploaded = [];
  const files = [];
  for (const p of activeUploadSlots()){
    const f = state.files[p];
    if (!f) continue;
    files.push({
      placement: PLACEMENTS.find(x=>x.id===p).label,
      name: f.name,
      mimeType: f.type || "application/octet-stream",
      data: await fileToB64(f)
    });
    uploaded.push(PLACEMENTS.find(x=>x.id===p).label);
  }
  const body = JSON.stringify({ type, meta: orderMeta(), files });

  // show the progress UI, start animated immediately so there's always motion
  const box = $("uploadProgress"), fill = $("upFill"), label = $("upLabel");
  const hasLogo = files.length > 0;
  const workingText = hasLogo ? "Sending your logo…" : (type === "quote" ? "Submitting your request…" : "Submitting…");
  const doneText = hasLogo ? "Logo sent ✓" : "Submitted ✓";
  if (box) box.style.display = "block";
  if (label) label.textContent = workingText;
  // simulated steady climb so the bar always moves, even if the browser
  // fires no upload-progress events (common for cross-origin Apps Script).
  let simPct = 8;
  if (fill){ fill.classList.remove("indeterminate"); fill.style.width = simPct + "%"; }
  const simTimer = setInterval(() => {
    // ease toward 90% and hold there until the request resolves
    if (simPct < 90){ simPct += Math.max(1, (90 - simPct) * 0.08); if (fill) fill.style.width = simPct + "%"; }
  }, 200);

  return new Promise(resolve => {
    const finish = (result) => {
      clearInterval(simTimer);
      if (fill){ fill.classList.remove("indeterminate"); fill.style.width = "100%"; }
      if (label) label.textContent = doneText;
      setTimeout(() => resolve(result), 300);
    };
    // no-cors fetch actually delivers to Apps Script (a cross-origin XHR gets
    // blocked following Apps Script's 302 redirect). We can't read the response
    // in no-cors mode, so we treat a completed send as success.
    fetch(APPS_SCRIPT_URL, {
      method: "POST",
      mode: "no-cors",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: body
    })
    .then(() => finish({ ok:true, uploaded }))
    .catch(() => { clearInterval(simTimer); resolve({ ok:false, uploaded }); });
  });
}

async function submitQuote(){
  const btn = $("sbSummaryCheckout") || $("submitBtn");
  if (btn) btn.disabled = true;
  const meta = orderMeta();
  const summary = [
    `Name: ${meta.name}`, `Email: ${meta.email}`, `Phone: ${meta.phone || "-"}`,
    `Requested style/brand: ${meta.requestedStyle}`,
    `Color(s): ${meta.color}`, `Quantity: ${meta.qty}`,
    `Decoration: ${meta.deco}`, `Placements: ${meta.placements}`,
    `Notes: ${meta.notes}`, `Social: ${meta.social}`
  ].join("\n");

  const sent = await sendToDrive("quote");
  if (btn){ btn.disabled = false; btn.textContent = "Request my quote"; }

  // close the review modal
  closeSummary();

  if (sent.ok){
    $("confTitle").textContent = "Request sent ✓";
    $("confBody").innerHTML = "Thanks " + (meta.name ? meta.name.split(" ")[0] : "") + "! We've got your request" + (sent.uploaded.length ? ", logo and all" : "") + ". We'll follow up from <strong>help@threadbreak.com</strong> once we've reviewed your request. Here's a copy of what you sent:";
  } else {
    $("confTitle").textContent = "Almost there, hit send";
    $("confBody").innerHTML = "Your quote request just opened in your email app. Press send and we'll follow up once we've reviewed it. If you have a logo, attach it to that email too. Here's your summary:";
    window.location.href = `mailto:${QUOTE_EMAIL}?subject=${encodeURIComponent("Custom Hat Quote Request")}&body=${encodeURIComponent("CUSTOM HAT QUOTE REQUEST (threadbreak.com)\n\n" + summary)}`;
  }
  $("summary").textContent = summary;

  // hide the form + sticky bar, reveal the confirmation
  const steps = $("tbFormSteps"); if (steps) steps.style.display = "none";
  const bar = $("scoreboard"); if (bar) bar.style.display = "none";
  $("confirm").classList.add("show");
  $("confirm").scrollIntoView({ behavior:"smooth", block:"center" });
}

async function submitCheckout(){
  const btn = $("sbSummaryCheckout") || $("submitBtn");
  btn.disabled = true;
  $("cartErr").classList.remove("show");

  const hasFiles = activeUploadSlots().some(p => state.files[p]);
  let artNote = "Customer will email logo to help@threadbreak.com";
  if (hasFiles){
    btn.textContent = "Sending logo…";
    const up = await sendToDrive("order-artwork");
    if (up.ok) artNote = "Uploaded ✓ (" + up.uploaded.join(", ") + ")";
    else artNote = "ACTION: email customer for logo (upload not received)";
  }

  btn.textContent = "Adding…";
  const meta = orderMeta();
  const tier = tierFor(state.style, state.qty);
  const props = { "Hat Color(s)": meta.color, "Decoration": meta.deco, "Placements": meta.placements, "Artwork": artNote };
  if (meta.sizing) props["Sizing"] = meta.sizing;
  if (meta.notes !== "-") props["Notes"] = meta.notes;
  props["Social sharing"] = meta.social;

  const items = [{ id: tier[2], quantity: state.qty, properties: props }];
  if (state.deco.variantId)
    items.push({ id: state.deco.variantId, quantity: state.qty, properties: { "Applies to": state.style.name } });
  for (const p of state.placements) {
    const pl = PLACEMENTS.find(x=>x.id===p);
    if (pl.variantId)
      items.push({ id: pl.variantId, quantity: state.qty, properties: { "Applies to": state.style.name } });
  }

  try {
    const res = await fetch("/cart/add.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ items })
    });
    if (!res.ok) throw new Error("cart add failed");
    window.location.href = "/checkout";
  } catch (e) {
    btn.disabled = false; btn.textContent = "Checkout";
    $("cartErr").classList.add("show");
    $("cartErr").scrollIntoView({ behavior:"smooth", block:"center" });
  }
}

