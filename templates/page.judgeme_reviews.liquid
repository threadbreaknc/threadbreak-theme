{%- comment -%} build: reviews-v1 {%- endcomment -%}
<div id="tbreviews">
  <style>
    #tbreviews{--ink:#14121C;--purple:#5028AA;--purple2:#6234c9;--ice:#F3EFFC;--line:#E2E0EA;--muted:#6B6A78;
      font-family:'DM Sans',sans-serif;color:var(--ink);}
    #tbreviews .rv-hero{background:linear-gradient(135deg,#14121C 0%,#241f33 100%);color:#F7F4F0;padding:150px 20px 48px;text-align:center;border-bottom:5px solid var(--purple);}
    #tbreviews .rv-hero h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(38px,7vw,60px);line-height:1.02;margin:0 0 14px;}
    #tbreviews .rv-hero p{font-size:17px;line-height:1.6;color:#C9C8D4;margin:0 auto;max-width:540px;}
    #tbreviews .rv-stars{display:block;font-size:26px;color:#F5C518;letter-spacing:3px;margin-bottom:12px;}
    #tbreviews .rv-body{max-width:1100px;margin:0 auto;padding:48px 20px 64px;}
    #tbreviews .rv-note{max-width:760px;margin:0 auto 32px;text-align:center;font-size:14.5px;color:var(--muted);line-height:1.6;}
    #tbreviews .rv-cta{background:var(--ice);border:1px solid var(--line);border-radius:16px;padding:32px 24px;text-align:center;margin-top:48px;}
    #tbreviews .rv-cta h2{font-family:'Bebas Neue',sans-serif;font-size:clamp(24px,4vw,34px);margin:0 0 10px;}
    #tbreviews .rv-cta p{font-size:15px;color:#3d3a4a;margin:0 auto 20px;max-width:460px;line-height:1.6;}
    #tbreviews .rv-btn{display:inline-block;background:var(--purple);color:#fff;text-decoration:none;font-family:'Bebas Neue',sans-serif;font-size:1.25rem;letter-spacing:.05em;padding:.8rem 2rem;border-radius:12px;transition:background .18s,transform .18s;}
    #tbreviews .rv-btn:hover{background:var(--purple2);transform:translateY(-2px);}
    /* keep the Judge.me widget from fighting the page width */
    #tbreviews .jdgm-all-reviews-page__title{display:none;}
    #tbreviews .jdgm-widget{max-width:100%;}
    @media(max-width:600px){#tbreviews .rv-hero{padding-top:165px;}}
  </style>

  <section class="rv-hero">
    <span class="rv-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
    <h1>{{ page.title | default: 'Customer Reviews' }}</h1>
    <p>Real feedback from the businesses, teams, and people who wear our hats. Store reviews and product reviews, all in one place.</p>
  </section>

  <div class="rv-body">
    {%- if page.content != blank -%}
      <div class="rv-note">{{ page.content }}</div>
    {%- endif -%}

<!-- Start of Judge.me code -->{% assign has_legacy = false %}{% if shop.metafields.judgeme.all_reviews_header.size > 20 %}{% assign has_legacy = true %}{% endif %}<div class='jdgm-widget jdgm-all-reviews-widget-v2025' data-widget='all-reviews-v2025' data-auto-install='false' data-entry-point='all_reviews_widget_v2025.js' data-entry-key='all-reviews-widget-v2025/main.js'>{% if has_legacy %}<div class='jdgm-legacy-widget-content' style='display: none;'><article class='jdgm-widget jdgm-all-reviews-widget'><style class='jdgm-temp-hiding-style'>.jdgm-all-reviews-widget{ display: none }</style>{{ shop.metafields.judgeme.all_reviews_header }}<div class='jdgm-all-reviews__body'>{% assign prefix = 'all_reviews_' %}{% for count in (0..65535) %}{% assign metafield_key = prefix | append: count %}{% assign current_metafield = shop.metafields.judgeme[metafield_key] %}{% unless current_metafield %}{% break %}{% endunless %}{{ current_metafield }}{% endfor %}</div></article></div>{% endif %}</div>{% if shop.metafields.judgeme.all_reviews_widget_v2025_data %}<script>jdgm.data ||= {}; jdgm.data.allReviewsWidgetV2025 = {{ shop.metafields.judgeme.all_reviews_widget_v2025_data }};</script>{% endif %}<!-- End of Judge.me code -->

    <div class="rv-cta">
      <h2>Ready to make your own?</h2>
      <p>Our minimum is 5 hats, with wholesale pricing beginning at ten. Free logo digitizing, a mockup before we stitch, and free shipping to the lower 48.</p>
      <a href="/pages/custom-order" class="rv-btn">Start a Custom Order</a>
    </div>
  </div>
</div>
