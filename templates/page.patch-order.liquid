<script>
(function(){
"use strict";
const $ = id => document.getElementById(id);

// ---- S&S stock (snippets/ss-stock.liquid, refreshed by a GitHub Action) ----
const STOCK_MIN = 12; // fewer than this on hand = out of stock
const STOCK = (window.TB_STOCK && window.TB_STOCK.styles) || {};
const normColor = c => String(c || "").toLowerCase().replace(/grey/g, "gray").replace(/[^a-z0-9]/g, "");
// form color name -> S&S color name, where they differ
const STOCK_ALIAS = {
  rich112: { "Royal Blue/Black": "Royal/Black", "Royal Blue/White": "Royal/White" },
  rich112p: { "Realtree/Neon Yellow": "Realtree Edge/Neon Yellow", "Realtree/Neon Pink": "Realtree Edge/Neon Pink" },
  yupoong: { "Navy Blue": "Navy", "Heather Grey/Black": "Heather/Black", "Heather Grey/White": "Heather/White", "Carolina Blue/White": "Carolina Blue/White/Caroline Blue", "Red/White": "Red/White/Red" },
  yp6606: { "Blue/Silver": "Steel Blue/Silver", "Green Camo": "Green Camo/Black" },
  rich168: { "Black Camo": "Black/Camo/Loden", "Charcoal/White/Black": "Charcoal/Black/White", "Pale Khaki/Loden": "Pale Khaki/Loden Green" },
  rich256: { "Black": "Black/Black", "Cardinal": "Cardinal/White" }
};
function stockEntry(s, c){ const st = s && STOCK[s.id]; if (!st) return null; const al = STOCK_ALIAS[s.id]; return st[normColor((al && al[c]) || c)] || null; }
// unknown color or style = treat as in stock, so a name mismatch never blocks a sale
function isOut(s, c){ const e = stockEntry(s, c); return !!e && e.qty < STOCK_MIN; }
// S&S SKU for a color (and size, for fitted), saved on the order as a hidden property
function skuFor(s, c, z){
  const e = stockEntry(s, c); if (!e || !e.skus) return "";
  if (z && e.skus[z]) return e.skus[z];
  for (const p of ["Adjustable", "M/L", "One Size", "OSFA"]) if (e.skus[p]) return e.skus[p];
  const k = Object.keys(e.skus); return k.length ? e.skus[k[0]] : "";
}
function skuSummary(){
  const s = state.style; if (!s || !STOCK[s.id]) return "";
  const parts = [];
  if (!isSized() && state.colors.length === 1){
    const c = state.colors[0]; parts.push(c + ": " + (skuFor(s, c) || "n/a") + " x" + state.qty);
  } else {
    Object.keys(state.split).forEach(k => {
      const q = +state.split[k] || 0; if (!q) return;
      let c = k, z = null;
      if (isSized() && k.lastIndexOf(" / ") > -1){ const i = k.lastIndexOf(" / "); c = k.slice(0, i); z = k.slice(i + 3); }
      parts.push(k + ": " + (skuFor(s, c, z) || "n/a") + " x" + q);
    });
  }
  return parts.join("; ");
}
function sizeOut(s, c, z){ const e = stockEntry(s, c); return !!(e && e.sizes && typeof e.sizes[z] === "number" && e.sizes[z] < STOCK_MIN); }
