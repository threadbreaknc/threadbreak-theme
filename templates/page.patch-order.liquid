{%- comment -%} build: patch-v1 {%- endcomment -%}
{%- comment -%}
  Custom Patch Hats order page. Four-step wizard mirroring page.custom-order.liquid,
  namespaced #tbpo. Reuses the same STYLES data (hat blanks + qty tiers) as the
  embroidery form; the decoration is always a laser-engraved leatherette patch
  instead of embroidery. Cart add = hat tier variant + patch-size add-on variant,
  both at order quantity. Sizes live on the "Custom Hat Add-On (per hat)" product.
{%- endcomment -%}
<div id="tbpo">
<style>
  #tbpo{position:relative;z-index:1;padding-top:6rem;max-width:100%;overflow-x:clip;font-family:'DM Sans',sans-serif;
    --purple:#5028AA;--purple2:#6234c9;--purple-dark:#3D1E85;--ink:#14121C;--ice:#F3EFFC;--white:#fff;--line:#E2E0EA;--muted:#6B6A78;--good:#1E9E5A;color:var(--ink)}
  #tbpo *{box-sizing:border-box;margin:0;padding:0}
  #tbpo .wrap{max-width:880px;margin:0 auto;padding:0 20px}
  #tbpo .form-wrap{max-width:1180px;margin:0 auto;padding:0 20px}
  #tbpo .bar-in{max-width:1180px}
  #tbpo header{position:relative;overflow:hidden;background:var(--ink);color:var(--white);padding:44px 0 20px}
  #tbpo .hero-photos{position:absolute;inset:0;display:flex;z-index:0;opacity:.5}
  #tbpo .hero-photos div{flex:1;background-size:cover;background-position:center;min-width:0}
  #tbpo .hero-photos div:not(:first-child){-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%);mask-image:linear-gradient(90deg,transparent,#000 12%);margin-left:-6%}
  #tbpo header::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,var(--ink) 0%,rgba(20,18,28,.7) 42%,rgba(20,18,28,.32) 100%)}
  #tbpo header .wrap{position:relative;z-index:2}
  @media(max-width:640px){
    #tbpo header::after{background:linear-gradient(180deg,rgba(20,18,28,.72),rgba(20,18,28,.9))}
    /* Phone: drop the hat shot and run the patch photo across the whole banner,
       zoomed in so the patches themselves are readable. Banner height unchanged. */
    /* Phone: show one photo across the whole banner, zoomed so the patch reads. */
    #tbpo .hero-photos div:nth-child(n+2){display:none}
    #tbpo .hero-photos div:first-child{flex:1 1 100%;margin-left:0;-webkit-mask-image:none;mask-image:none;background-size:cover;background-position:center 40%}
  }
  #tbpo h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(36px,6vw,58px);line-height:.95;letter-spacing:.01em;margin:0 0 10px}
  #tbpo h1 em{font-style:normal;color:#7F5FD8}
  #tbpo .sub{font-size:15px;line-height:1.55;color:#D9D6E4;max-width:560px}
  #tbpo .props{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:12px;margin-bottom:0}
  #tbpo .props span{font-size:13px;font-weight:500;color:#EDEAF7}
  #tbpo .props span::before{content:"\2713";color:#7F5FD8;font-weight:700;margin-right:7px}
  /* compact and below the form, so it never pushes the hat grid down */
  #tbpo .tbco-textus{display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;
    margin:14px auto 0;padding:0;background:none;border:none;text-decoration:none;color:var(--muted);
    font-size:13.5px;width:100%;text-align:center}
  #tbpo .tbco-textus:hover{color:var(--purple)}
  #tbpo .tbco-textus-icon{display:inline-flex;color:var(--purple);flex:none}
  #tbpo .tbco-textus strong{color:var(--purple);font-weight:700;white-space:nowrap}

  /* progress rail */
  #tbpo .rail{display:flex;gap:6px;margin:20px 0 18px;flex-wrap:wrap;position:sticky;top:74px;z-index:50;
    background:rgba(255,255,255,.97);backdrop-filter:blur(6px);padding:12px;border-radius:12px;
    box-shadow:0 6px 18px rgba(20,18,28,.10);border:1px solid var(--line)}
  @media(max-width:640px){#tbpo .rail{gap:5px;padding:8px;margin:20px 0 16px;top:64px}}
  #tbpo .rail-item{flex:1 1 0;min-width:120px;display:flex;align-items:center;gap:9px;padding:11px 13px;border-radius:11px;background:#fff;border:1.5px solid var(--line);font-size:13.5px;font-weight:600;color:var(--muted);cursor:pointer;transition:.18s}
  #tbpo .rail-item .dot{width:22px;height:22px;border-radius:50%;background:var(--line);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;flex:0 0 auto}
  #tbpo .rail-item.done{border-color:#B7A6EE;color:var(--ink)}
  #tbpo .rail-item.done .dot{background:var(--good)}
  #tbpo .rail-item.active{border-color:var(--purple);color:var(--purple);box-shadow:0 4px 14px rgba(80,40,170,.12)}
  #tbpo .rail-item.active .dot{background:var(--purple)}
  @media(max-width:640px){
    #tbpo .rail{gap:4px;padding:7px}
    #tbpo .rail-item{min-width:0;flex:1 1 0;padding:7px 3px;font-size:10.5px;gap:4px;
      flex-direction:column;justify-content:center;text-align:center;line-height:1.2;border-radius:9px}
    #tbpo .rail-item .dot{width:18px;height:18px;font-size:10.5px}
  }
  @media(max-width:360px){#tbpo .rail-item{font-size:9.5px;padding:6px 2px}}

  /* steps */
  #tbpo .tbstep{background:#fff;border:1.5px solid var(--line);border-radius:16px;margin-bottom:14px;display:none;opacity:1;transform:none;text-align:left;padding:0;scroll-margin-top:150px}
  #tbpo .tbstep.active{display:block;opacity:1;transform:none;border-color:var(--purple);box-shadow:0 6px 22px rgba(80,40,170,.10)}
  #tbpo .tbstep::after{content:none}
  #tbpo .tbstep-head{display:flex;align-items:center;gap:13px;padding:20px 22px}
  #tbpo .tbstep-num{width:28px;height:28px;border-radius:50%;background:var(--ice);color:var(--purple);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex:0 0 auto}
  #tbpo .tbstep-head h2{font-family:'Bebas Neue',sans-serif;font-size:23px;letter-spacing:.02em;flex:1}
  #tbpo .tbstep-sum{font-size:13px;color:var(--muted);text-align:right;max-width:45%}
  #tbpo .tbstep-body{padding:0 22px 22px}
  #tbpo .tbstep-hint{font-size:13.5px;color:var(--muted);margin-bottom:16px;line-height:1.55}
  #tbpo .tbstep-hint strong{color:var(--ink)}

  /* hat grid (identical to embroidery form) */
  #tbpo .hats{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:13px}
  #tbpo .hats.picking{grid-template-columns:1fr}
  #tbpo .hat{border:1.5px solid var(--line);border-radius:13px;background:#fff;cursor:pointer;overflow:hidden;transition:.2s;position:relative;scroll-margin-top:150px}
  #tbpo .hat:hover{border-color:#B7A6EE;transform:translateY(-2px)}
  #tbpo .hat.on{border-color:var(--purple);box-shadow:0 6px 22px rgba(80,40,170,.18);overflow:visible;z-index:5}
  #tbpo .hats.picking .hat{display:none}
  #tbpo .hats.picking .hat.on{display:grid;cursor:default}
  #tbpo .hats.picking .hat.on:hover{transform:none}
  #tbpo .hat-img{width:100%;aspect-ratio:1/1;object-fit:contain;background:#fff;display:block}
  #tbpo .hat-imgwrap{position:relative}
  #tbpo .hat-logo{position:absolute;bottom:8px;right:8px;height:30px;width:auto;max-width:112px;object-fit:contain;opacity:.95;
    background:rgba(255,255,255,.94);border-radius:6px;padding:4px 8px;box-shadow:0 1px 5px rgba(20,18,28,.14)}
  #tbpo .hat-name-sm{display:none;font-weight:700;font-size:13px;line-height:1.25}
  #tbpo .hat-titlerow{display:flex;align-items:flex-start;gap:12px}
  #tbpo .hat-logo-lg{height:52px;width:auto;max-width:170px;object-fit:contain;flex:0 0 auto;margin-top:0}
  #tbpo .hat-heroimg{width:100%;max-width:250px}
  #tbpo .hat-heroimg .hat-img{width:100%;max-width:250px;height:auto}
  #tbpo .hat-herocap{text-align:center;font-size:12px;font-weight:600;color:var(--purple);background:var(--ice);border-radius:8px;padding:5px 8px;margin-top:6px}
  #tbpo .pchip{cursor:pointer}
  #tbpo .pchip.on{border-color:var(--purple);background:var(--ice);box-shadow:0 0 0 2px rgba(80,40,170,.14)}
  #tbpo .hat-info{padding:12px 14px 14px}
  #tbpo .hat-name{font-weight:700;font-size:14.5px;line-height:1.25}
  #tbpo .hat-brand{font-size:11.5px;color:var(--muted);margin-top:2px}
  #tbpo .hat-price{margin-top:7px;font-size:13px;font-weight:700;color:var(--purple)}
  #tbpo .hat-colors{display:flex;align-items:center;gap:7px;margin-top:8px;font-size:12px;color:var(--muted)}
  #tbpo .wheel{width:18px;height:18px;border-radius:50%;flex:0 0 auto;border:1px solid rgba(0,0,0,.12);background:conic-gradient(#e23b3b,#e2a13b,#d7e23b,#4ce23b,#3be2c0,#3b8fe2,#7a3be2,#e23bc0,#e23b3b)}
  #tbpo .hat-badge{position:absolute;top:9px;left:9px;background:var(--purple);color:#fff;font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:3px 8px;border-radius:999px;z-index:2}
  #tbpo .hat.on{display:grid;grid-template-columns:250px minmax(0,1fr);gap:0 26px;padding:18px;align-items:start}
  #tbpo .hat.on .hat-heroimg{grid-column:1;grid-row:1 / span 2;position:sticky;top:168px}
  #tbpo .hat.on .hat-info{grid-column:2;grid-row:1;padding:0}
  #tbpo .hat.on .hat-expand{grid-column:2;grid-row:2;border-top:none;margin-top:0;padding:0}
  #tbpo .hat.on .colorpanel{margin-top:16px}
  @media(max-width:900px){
    #tbpo .hat.on,#tbpo .hats.picking .hat.on{grid-template-columns:1fr;padding:14px}
    #tbpo .hat.on .hat-heroimg{grid-column:1;grid-row:1;position:static;max-width:260px;margin:0 auto}
    #tbpo .hat.on .hat-info{grid-column:1;grid-row:2;padding-top:14px}
    #tbpo .hat.on .hat-expand{grid-column:1;grid-row:3}
  }
  @media(max-width:560px){
    #tbpo .hat.on,#tbpo .hats.picking .hat.on{display:block;padding:0}
    #tbpo .hat.on .hat-heroimg{position:static;width:100%;max-width:none}
    #tbpo .hat.on .hat-img{width:100%}
    #tbpo .hat.on .hat-info{padding:12px 14px 0}
    #tbpo .hat.on .hat-expand{padding:0 14px 16px}
    #tbpo .hats{grid-template-columns:1fr 1fr;gap:10px}
    #tbpo .hat-info{padding:10px 11px 12px}
    #tbpo .hat-name{display:none}
    #tbpo .hat-name-sm{display:block}
    #tbpo .hat-logo{height:22px;max-width:82px;bottom:6px;right:6px;padding:3px 6px}
    #tbpo .hat.on .hat-name{display:block;font-size:17px}
    #tbpo .hat.on .hat-name-sm{display:none}
    #tbpo .hat-heroimg{width:100%;max-width:250px}
    #tbpo .hat-logo-lg{height:40px;max-width:130px}
    #tbpo .hat-brand{font-size:10.5px}
    #tbpo .hat-price{font-size:12px;margin-top:5px}
    #tbpo .hat-colors{font-size:11px;margin-top:6px}
    #tbpo .hat-badge{font-size:9.5px;padding:2px 6px;top:6px;left:6px}
  }
  #tbpo .hat-change{display:inline-flex;align-items:center;gap:7px;background:#fff;border:2px solid var(--purple);border-radius:10px;padding:10px 18px;font-family:inherit;font-size:14px;font-weight:600;color:var(--purple);cursor:pointer;margin-top:14px;transition:.16s}
  #tbpo .hat-change:hover{background:var(--purple);color:#fff}
  #tbpo .hat-specs{margin-top:10px;font-size:12.5px;color:var(--muted);line-height:1.6}
  #tbpo .hat-specs b{color:var(--ink);font-weight:600}
  #tbpo .hat-expand{padding:0 16px 18px;border-top:1px solid var(--line);margin-top:4px}

  /* color dropdown */
  #tbpo .colorpanel{margin-top:16px;border-radius:12px;background:var(--ice);padding:16px;position:relative;z-index:6}
  #tbpo .colorpanel h3{font-size:15px;margin-bottom:4px}
  #tbpo .cp-sub{font-size:12.5px;color:var(--muted);margin-bottom:13px}
  #tbpo .dd{position:relative;max-width:420px}
  #tbpo .dd-btn{width:100%;display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fff;border:1.5px solid var(--line);border-radius:11px;padding:11px 13px;font-family:inherit;font-size:14px;cursor:pointer;text-align:left;color:var(--ink)}
  #tbpo .dd-btn:hover{border-color:#B7A6EE}
  #tbpo .dd-btn .chev{transition:transform .18s;flex:0 0 auto}
  #tbpo .dd.open .dd-btn .chev{transform:rotate(180deg)}
  #tbpo .dd-menu{display:none;position:absolute;z-index:40;top:calc(100% + 6px);left:0;right:0;max-height:290px;overflow-y:auto;background:#fff;border:1.5px solid var(--line);border-radius:12px;box-shadow:0 14px 34px rgba(20,18,28,.16);scrollbar-width:thin}
  #tbpo .dd.open .dd-menu{display:block}
  #tbpo .dd-menu::-webkit-scrollbar{width:9px}
  #tbpo .dd-menu::-webkit-scrollbar-thumb{background:#B7A6EE;border-radius:9px;border:2px solid #fff}
  #tbpo .dd-more{display:none;position:absolute;left:1px;right:1px;bottom:1px;z-index:41;pointer-events:none;height:44px;border-radius:0 0 11px 11px;background:linear-gradient(180deg,rgba(255,255,255,0),#fff 72%);align-items:flex-end;justify-content:center;padding-bottom:6px}
  #tbpo .dd.open .dd-more.on{display:flex}
  #tbpo .dd-more span{font-size:11px;font-weight:700;color:var(--purple);display:flex;align-items:center;gap:5px}
  #tbpo .dd-opt{display:flex;align-items:center;gap:11px;padding:9px 12px;cursor:pointer;font-size:13.5px;border-bottom:1px solid #f2f1f6}
  #tbpo .dd-opt:last-child{border-bottom:none}
  #tbpo .dd-opt:hover{background:var(--ice)}
  #tbpo .dd-opt img{width:42px;height:42px;object-fit:contain;border-radius:7px;background:#fff;border:1px solid var(--line);flex:0 0 auto}
  #tbpo .dd-opt.picked{background:#eee9fb}
  #tbpo .dd-opt.oos{opacity:.45;cursor:not-allowed}
  #tbpo .dd-opt.oos:hover{background:none}
  #tbpo .oos-tag{font-style:normal;font-size:11px;font-weight:600;color:#b42318;margin-left:6px}
  #tbpo .dd-opt .tick{margin-left:auto;color:var(--purple);font-weight:700}
  #tbpo .picked-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}
  #tbpo .pchip{display:flex;align-items:center;gap:8px;background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:6px 9px;font-size:13px}
  #tbpo .pchip img{width:32px;height:32px;object-fit:contain;border-radius:6px}
  #tbpo .pchip button{background:none;border:none;cursor:pointer;color:var(--muted);font-size:16px;line-height:1;padding:0 2px}
  #tbpo .pchip button:hover{color:#c33}

  /* fields */
  #tbpo .qty-row{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap}
  #tbpo .field{display:flex;flex-direction:column;gap:6px}
  #tbpo [hidden]{display:none !important}
  #tbpo .field label{font-size:13px;font-weight:600}
  #tbpo .field input,#tbpo .field select,#tbpo .field textarea{font-family:inherit;font-size:16px;padding:10px 12px;border:1.5px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}
  #tbpo .field input:focus,#tbpo .field textarea:focus{outline:none;border-color:var(--purple)}
  #tbpo .qty-input{width:130px}
  #tbpo .price-now{display:flex;gap:26px;flex-wrap:wrap;background:var(--ink);color:#fff;border-radius:12px;padding:14px 18px;margin-top:16px}
  #tbpo .price-now .pn{display:flex;flex-direction:column}
  #tbpo .price-now .pn-l{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.55)}
  #tbpo .price-now .pn-v{font-family:'Bebas Neue',sans-serif;font-size:26px;line-height:1.15}
  #tbpo .price-now .pn-note{margin-left:auto;align-self:center;font-size:12px;color:rgba(255,255,255,.65);max-width:220px;line-height:1.5}
  @media(max-width:520px){#tbpo .price-now .pn-note{margin-left:0;flex:1 1 100%;max-width:none;margin-top:6px}}
  #tbpo .tier-nudge{font-size:13px;color:var(--purple);font-weight:600;background:var(--ice);border-radius:9px;padding:9px 12px;margin-top:13px}
  #tbpo .split{margin-top:18px;border:1.5px solid var(--line);border-radius:12px;overflow:hidden}
  #tbpo .split-head{background:var(--ice);padding:11px 14px;font-size:13px;font-weight:700}
  #tbpo .split-row{display:flex;align-items:center;gap:12px;padding:10px 14px;border-top:1px solid var(--line)}
  #tbpo .split-row img{width:38px;height:38px;object-fit:contain;border-radius:7px;border:1px solid var(--line)}
  #tbpo .split-row .nm{flex:1;font-size:13.5px}
  #tbpo .split-row input{width:88px;font-family:inherit;font-size:16px;padding:8px 10px;border:1.5px solid var(--line);border-radius:9px}
  #tbpo .split-total{display:flex;justify-content:space-between;padding:11px 14px;border-top:1.5px solid var(--line);font-size:13.5px;font-weight:700;background:#fafafa}
  #tbpo .split-total.bad{color:#c33}
  #tbpo .split-note{padding:8px 14px;font-size:12px;color:var(--muted);border-top:1px solid var(--line);background:#fff}
  #tbpo .split-row.sized{flex-wrap:wrap}
  #tbpo .split-sizes{display:flex;gap:8px;flex-wrap:wrap;flex-basis:100%;padding-left:50px}
  #tbpo .split-sizes label{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:11px;font-weight:700;color:var(--muted)}
  #tbpo .split-row .split-sizes input{width:66px;text-align:center}

  /* chips */
  #tbpo .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
  #tbpo .chip{background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:9px 14px;font-family:inherit;font-size:13.5px;cursor:pointer;transition:.15s;color:var(--ink)}
  #tbpo .chip:hover{border-color:#B7A6EE}
  #tbpo .chip.on{border-color:var(--purple);background:var(--ice);color:var(--purple);font-weight:600}
  #tbpo .chip .tag{font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:var(--purple);color:#fff;border-radius:999px;padding:2px 8px;margin-left:7px;display:inline-block;vertical-align:1px}
  #tbpo .chip .tag.inc{background:var(--good)}
  #tbpo .size-dim{font-weight:400;color:var(--muted);font-size:12px;margin-left:4px}

  /* materials */
  #tbpo .matgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;margin-top:8px}
  /* All seven materials on a single row once there's room for them. */
  @media(min-width:900px){
    #tbpo .matgrid{grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}
    #tbpo .mat-chip{padding:7px}
    #tbpo .mat-name{font-size:11px}
  }
  #tbpo .mat-chip{display:flex;flex-direction:column;align-items:center;gap:6px;background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:10px;cursor:pointer;font-family:inherit;transition:.15s}
  #tbpo .mat-chip:hover{border-color:#B7A6EE}
  #tbpo .mat-chip.on{border-color:var(--purple);background:var(--ice);box-shadow:0 0 0 2px rgba(80,40,170,.14)}
  #tbpo .mat-swatch{width:100%;aspect-ratio:1/1;border-radius:9px;background-size:cover;background-position:center;border:1px solid var(--line)}
  #tbpo .mat-name{font-size:12.5px;font-weight:600;text-align:center;line-height:1.25}

  /* canvas preview */
  #tbpo .patch-preview{display:flex;flex-direction:column;align-items:center;gap:14px;margin-top:14px;background:var(--ice);border-radius:14px;padding:20px}
  /* Fixed display size regardless of S/M/L, only the shape changes the box's
     proportions; the actual real-world size is communicated via the size-dim
     caption on the chip and in the review, not by scaling this preview. */
  #tbpo .patch-canvas-box{position:relative;width:100%;max-width:320px;aspect-ratio:1.633/1;border-radius:14px;overflow:hidden;background:#fff;border:1.5px solid var(--line);box-shadow:0 6px 18px rgba(20,18,28,.08);transition:aspect-ratio .25s ease}
  #tbpo .patch-canvas-box canvas{width:100%;height:100%;display:block}
  #tbpo .patch-controls{width:100%;max-width:380px;display:flex;flex-direction:column;gap:10px}
  #tbpo .size-hint{font-size:12.5px;color:var(--purple);background:var(--ice);border-radius:9px;padding:9px 12px;margin-top:9px;line-height:1.5}
  #tbpo .patch-controls input[type=range]{width:100%;accent-color:var(--purple)}
  #tbpo .patch-invert{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);cursor:pointer}
  #tbpo .patch-invert input{width:16px;height:16px;accent-color:var(--purple);cursor:pointer}
  #tbpo .patch-preview .hint{max-width:380px;text-align:center}
  #tbpo .patch-preview .fld-tight{margin:2px 0 0;align-self:stretch}
  #tbpo .ctl-note{font-weight:400;font-size:11.5px;color:var(--muted);margin-left:6px}
  #tbpo .ctl-reset{align-self:flex-start;background:none;border:1px solid var(--line);border-radius:8px;padding:6px 11px;font:inherit;font-size:12.5px;color:var(--purple);cursor:pointer}
  #tbpo .ctl-reset:hover{background:#fff}
  /* upload target sits on the canvas itself instead of a separate slot */
  #tbpo .canvas-drop{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;text-align:center;padding:14px;background:var(--ice);border:1.5px dashed var(--purple);border-radius:14px;cursor:pointer;transition:.15s}
  #tbpo .canvas-drop:hover,#tbpo .canvas-drop.over{background:#EFE9FF;border-color:var(--purple2)}
  /* display:flex would otherwise beat the [hidden] attribute */
  #tbpo .canvas-drop[hidden],#tbpo .file-bar[hidden]{display:none}
  #tbpo .canvas-drop-i{font-size:24px;line-height:1;color:var(--purple);font-weight:700}
  #tbpo .canvas-drop-t{font-size:13.5px;font-weight:700;color:var(--purple)}
  #tbpo .canvas-drop-s{font-size:11.5px;color:var(--muted)}
  #tbpo .file-bar{align-self:stretch;display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:#F3FBF6;border:1px solid var(--good);border-radius:10px;padding:7px 10px}
  #tbpo .file-bar-name{flex:1;min-width:120px;font-size:12.5px;font-weight:600;color:var(--good);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #tbpo .file-bar-btn{background:#fff;border:1px solid var(--line);border-radius:7px;padding:4px 10px;font:inherit;font-size:12px;font-weight:600;color:var(--purple);cursor:pointer}
  #tbpo .file-bar-btn:hover{border-color:var(--purple)}
  #tbpo .file-bar-btn.danger{color:#c33}
  #tbpo .file-bar-btn.danger:hover{border-color:#c33}
  #tbpo .die-note{align-self:stretch;font-size:12.5px;line-height:1.5;color:var(--purple);background:#fff;border:1px solid #DCD3F6;border-left:3px solid var(--purple);border-radius:9px;padding:10px 12px}
  #tbpo .field.is-off{opacity:.45}
  #tbpo .field.is-off select{cursor:not-allowed}
  #tbpo .patch-canvas-box{cursor:grab;touch-action:none}
  #tbpo .patch-canvas-box.dragging{cursor:grabbing}
  #tbpo .patch-preview .chips{align-self:stretch;justify-content:center}
  /* Two-column layout: preview on the left, the fields that drive it on the right.
     Mobile stacks with the preview first so the canvas + threshold/invert controls
     are visible without scrolling. */
  #tbpo .patch-layout{display:flex;flex-direction:column;gap:8px}
  #tbpo .patch-layout-preview .patch-preview{margin-top:0}
  #tbpo .patch-layout-fields .fld:first-child{margin-top:14px}
  @media(min-width:900px){
    #tbpo .patch-layout{display:grid;grid-template-columns:minmax(300px,380px) 1fr;gap:26px;align-items:start}
    #tbpo .patch-layout-preview{position:sticky;top:18px}
    #tbpo .patch-layout-fields .fld:first-child{margin-top:0}
  }

  /* step 3 pieces */
  #tbpo .fld{font-size:13.5px;font-weight:700;margin-top:20px;margin-bottom:7px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  #tbpo .info-btn{background:none;border:1px solid var(--line);border-radius:8px;padding:4px 10px;font-family:inherit;font-size:11.5px;font-weight:600;color:var(--purple);cursor:pointer}
  #tbpo .info-btn:hover{border-color:var(--purple)}
  #tbpo .info-panel{margin-top:11px;background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:16px}
  #tbpo .info-note{font-size:12.5px;color:var(--muted);line-height:1.6}
  #tbpo .info-note strong{color:var(--ink)}
  #tbpo .hint{font-size:12.5px;color:var(--muted);line-height:1.6;margin-top:9px}
  #tbpo .up-slot{border:1.5px dashed var(--line);border-radius:12px;padding:14px;background:#fff;margin-top:4px}
  #tbpo .up-slot.req{border-color:var(--purple);background:var(--ice)}
  #tbpo .up-slot-label{font-size:13px;font-weight:700;display:flex;align-items:center;gap:7px;margin-bottom:4px;flex-wrap:wrap}
  #tbpo .up-tag{font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:var(--purple);color:#fff;border-radius:999px;padding:2px 8px}
  #tbpo .up-slot-sub{font-size:11.5px;color:var(--muted);margin-bottom:9px}
  #tbpo .up-slot input[type="file"]{width:100%;font-family:inherit;font-size:13px;color:var(--muted);cursor:pointer}
  #tbpo .up-slot input[type="file"]::file-selector-button{
    font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:.04em;
    background:var(--purple);color:#fff;border:none;border-radius:9px;
    padding:9px 18px;margin-right:11px;cursor:pointer;transition:background .15s,transform .15s}
  #tbpo .up-slot input[type="file"]::file-selector-button:hover{background:var(--purple2);transform:translateY(-1px)}
  #tbpo .up-slot input[type="file"]::-webkit-file-upload-button{
    font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:.04em;
    background:var(--purple);color:#fff;border:none;border-radius:9px;
    padding:9px 18px;margin-right:11px;cursor:pointer}
  #tbpo .up-slot.has-file{border-style:solid;border-color:var(--good);background:#F3FBF6}
  #tbpo .up-have{font-size:12px;color:var(--good);font-weight:600;margin-top:5px}
  #tbpo .lt-note{display:flex;gap:10px;align-items:flex-start;margin-top:16px;background:var(--ice);border:1px solid var(--line);border-left:4px solid var(--purple);border-radius:11px;padding:12px 15px}
  #tbpo .lt-note-icon{flex:none;color:var(--purple);margin-top:2px;display:inline-flex}
  #tbpo .lt-note p{font-size:12.5px;line-height:1.6;margin:0;color:#3d3a4a}
  #tbpo .lt-note strong{color:var(--purple)}
  #tbpo .lt-note a{color:var(--purple);font-weight:700}
  #tbpo .social-optout{display:flex;gap:9px;align-items:flex-start;margin-top:16px;font-size:12.5px;color:#3d3a4a;line-height:1.55}
  #tbpo .social-optout input{margin-top:2px;width:17px;height:17px;flex:none;accent-color:var(--purple);cursor:pointer}

  /* review */
  #tbpo .rev-line{display:flex;justify-content:space-between;gap:16px;padding:9px 0;border-bottom:1px solid var(--line);font-size:14px}
  #tbpo .rev-line span:first-child{color:var(--muted);flex:0 0 auto}
  #tbpo .rev-line strong{text-align:right}
  #tbpo .proof-note{display:flex;gap:12px;align-items:flex-start;background:var(--ice);border:1.5px solid var(--purple);border-left:5px solid var(--purple);border-radius:12px;padding:14px 16px;margin-top:18px}
  #tbpo .proof-note p{font-size:13px;line-height:1.55;margin:0}
  #tbpo .proof-note strong{color:var(--purple)}
  #tbpo .en-icon{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:var(--purple);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px}
  #tbpo .cart-err{display:none;margin-top:14px;background:#FDECEC;border:1.5px solid #E3A2A2;color:#8B2E2E;border-radius:10px;padding:12px 14px;font-size:13.5px}
  #tbpo .cart-err.show{display:block}
  #tbpo .upload-progress{display:none;margin-top:14px}
  #tbpo .up-bar{height:10px;background:var(--ice);border-radius:6px;overflow:hidden}
  #tbpo .up-fill{height:100%;width:0%;background:linear-gradient(90deg,var(--purple),#8B6FD4);border-radius:6px;transition:width .2s ease}
  #tbpo .up-label{font-size:12.5px;color:var(--muted);margin-top:6px}

  /* buttons */
  #tbpo .next{margin-top:20px;background:var(--purple);color:#fff;border:none;border-radius:11px;padding:13px 26px;font-family:'Bebas Neue',sans-serif;font-size:19px;letter-spacing:.04em;cursor:pointer;transition:.18s}
  #tbpo .next:hover{background:var(--purple2);transform:translateY(-1px)}
  #tbpo .next:disabled{opacity:.4;cursor:not-allowed;transform:none}
  #tbpo .back{margin-top:20px;margin-right:10px;background:none;color:var(--muted);border:1.5px solid var(--line);border-radius:11px;padding:13px 20px;font-family:'Bebas Neue',sans-serif;font-size:19px;letter-spacing:.04em;cursor:pointer}
  #tbpo .back:hover{border-color:#B7A6EE;color:var(--ink)}
  #tbpo .btn-row{display:flex;align-items:center;flex-wrap:wrap}
  #tbpo .quote-redirect{display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap;text-align:center;margin:20px 0 4px;padding:16px 20px;background:var(--ice);border:2px solid var(--purple);border-radius:12px;text-decoration:none;color:var(--ink);font-size:15px}
  #tbpo .quote-redirect strong{color:var(--purple);font-weight:700}

  /* reviews block */
  /* one compact line with stars and an arrow, same shape as the homepage */
  #tbpo .tbco-rating{display:flex;align-items:center;justify-content:center;gap:9px;flex-wrap:wrap;
    margin:30px auto 0;padding:0;background:none;border:none;text-decoration:none;
    color:var(--muted);font-size:14px;transition:color .15s}
  #tbpo .tbco-rating:hover{color:var(--ink)}
  #tbpo .tbco-rating-stars{color:#F5C518;font-size:16px;letter-spacing:2px;flex:none}
  #tbpo .tbco-rating-arrow{color:var(--purple);font-weight:700;transition:transform .15s}
  #tbpo .tbco-rating:hover .tbco-rating-arrow{transform:translateX(3px)}

  /* sticky bar */
  #tbpo .bar{position:fixed;left:0;right:0;bottom:0;background:var(--ink);color:#fff;z-index:60;transform:translateY(110%);transition:transform .28s}
  #tbpo .bar.show{transform:none}
  #tbpo .bar-in{max-width:880px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:18px}
  #tbpo .bar-stat .l{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.5)}
  #tbpo .bar-stat .v{font-family:'Bebas Neue',sans-serif;font-size:22px;line-height:1.1}
  #tbpo .bar-cta{margin-left:auto;background:var(--purple);color:#fff;border:none;border-radius:10px;padding:11px 22px;font-family:'Bebas Neue',sans-serif;font-size:17px;letter-spacing:.04em;cursor:pointer}
  #tbpo .bar-cta:hover{background:var(--purple2)}
  #tbpo .bar-cta:disabled{opacity:.45;cursor:not-allowed}
  @media(max-width:640px){
    #tbpo .bar-hide-sm{display:none}
    #tbpo .tbstep-sum{display:none}
    #tbpo .tbstep-head{padding:14px 15px}
    #tbpo .tbstep-head h2{font-size:20px}
    #tbpo .tbstep-body{padding:0 15px 16px}
    #tbpo .tbstep-hint{font-size:13px;margin-bottom:12px}
    #tbpo .tbstep{margin-bottom:10px;border-radius:14px}
    #tbpo .fld{margin-top:15px;margin-bottom:6px}
    #tbpo .hint{font-size:12px;margin-top:7px}
    #tbpo .info-panel{padding:13px}
    #tbpo .proof-note{padding:12px 13px}
    #tbpo .next,#tbpo .back{padding:12px 20px;font-size:18px;margin-top:16px}
    #tbpo .price-now{padding:12px 14px;gap:18px}
    #tbpo .price-now .pn-v{font-size:23px}
    #tbpo .up-slot{padding:12px}
    #tbpo .colorpanel{padding:13px}
    #tbpo .bar-in{padding:9px 15px;gap:14px}
    #tbpo .bar-stat .v{font-size:19px}
    #tbpo .bar-cta{padding:9px 18px;font-size:16px}
  }

</style>

<header class="tbco-hero">
  <div class="hero-photos" aria-hidden="true">
    <div style="background-image:url('https://cdn.shopify.com/s/files/1/0974/8453/7988/files/EMT_patch_hat.jpg?v=1790523398&width=1100')"></div>
    <div style="background-image:url('https://cdn.shopify.com/s/files/1/0974/8453/7988/files/Threadbreak_hats.jpg?v=1790523398&width=1100')"></div>
    <div style="background-image:url('https://cdn.shopify.com/s/files/1/0974/8453/7988/files/patch-example-panelcraft.jpg?v=1789705673&width=1100')"></div>
  </div>
  <div class="wrap">
    <h1>Your logo.<br>Laser <em>engraved.</em></h1>
    <p class="sub">Custom leatherette patch hats on name-brand blanks. Free mockup before anything hits the laser.</p>
    <div class="props">
      <span>Engraved in Burlington, NC</span>
      <span>Free shipping to the lower 48</span>
      <span>Local pickup by appointment</span>
    </div>
  </div>
</header>

<div class="wrap">

</div>

<div class="form-wrap">

  <div class="rail" id="rail"></div>

  <div id="tbFormSteps">
  <!-- STEP 1: hat + colors -->
  <section class="tbstep active" data-step="1">
    <div class="tbstep-head"><div class="tbstep-num">1</div><h2>Choose your hat</h2><div class="tbstep-sum" id="sum1"></div></div>
    <div class="tbstep-body">
      <p class="tbstep-hint">Every leatherette patch attaches to the front panel. Pick a style, then choose your colors right below it. You'll pick your patch material and shape in step 3.</p>
      <div class="hats" id="hats"></div>
      <a href="/pages/quote" class="quote-redirect">Don't see what you're looking for? <strong>Get a custom quote instead</strong></a>
      <div class="btn-row"><button type="button" class="next" id="next1" disabled>Choose Quantity</button></div>
    </div>
  </section>

  <!-- STEP 2: quantity -->
  <section class="tbstep" data-step="2">
    <div class="tbstep-head"><div class="tbstep-num">2</div><h2>How many?</h2><div class="tbstep-sum" id="sum2"></div></div>
    <div class="tbstep-body">
      <p class="tbstep-hint"><strong>5 hat minimum.</strong> Wholesale pricing starts at 10, with additional volume discounts at 24+. Mixed colors all count toward the same total.</p>
      <div class="qty-row">
        <div class="field"><label for="qty">Total quantity (5 minimum)</label><input class="qty-input" id="qty" type="number" min="5" step="1" inputmode="numeric" placeholder="5"></div>
      </div>
      <div class="price-now" id="priceNow"></div>
      <div id="nudge"></div>
      <div id="splitHost"></div>
      <div class="btn-row"><button type="button" class="back" data-back="1">Back</button><button type="button" class="next" id="next2" disabled>Design Your Patch</button></div>
    </div>
  </section>

  <!-- STEP 3: patch design -->
  <section class="tbstep" data-step="3">
    <div class="tbstep-head"><div class="tbstep-num">3</div><h2>Your patch design</h2><div class="tbstep-sum" id="sum3"></div></div>
    <div class="tbstep-body">
      <p class="tbstep-hint">Every patch is laser engraved on genuine leatherette. Pick a material, a shape, and a placement, then upload your logo to see a live preview of the engraving.</p>

      <div class="patch-layout">
        <div class="patch-layout-preview">
          <div class="patch-preview" id="patchPreviewWrap">
            <div class="patch-canvas-box" id="patchCanvasBox">
              <canvas id="patchCanvas" width="520" height="318"></canvas>
              <div class="canvas-drop" id="canvasDrop">
                <span class="canvas-drop-i" aria-hidden="true">+</span>
                <span class="canvas-drop-t">Click to upload your logo</span>
                <span class="canvas-drop-s">or drop a file here &middot; PNG, JPG, WEBP, SVG</span>
              </div>
            </div>
            <input type="file" id="logoInput" accept=".png,.jpg,.jpeg,.webp,.gif,.svg,.pdf,.ai" hidden>
            <div class="file-bar" id="fileBar" hidden>
              <span class="file-bar-name" id="logoHave"></span>
              <button type="button" class="file-bar-btn" id="replaceLogo">Replace</button>
              <button type="button" class="file-bar-btn danger" id="removeLogo">Remove</button>
            </div>
            <p class="fld fld-tight">Patch style</p>
            <div class="chips" id="shapes"></div>
            <div class="patch-controls">
              <div class="field">
                <label for="threshold">Engrave detail (threshold)</label>
                <input type="range" id="threshold" min="10" max="245" value="140">
              </div>
              <div class="field">
                <label for="logoScale">Logo size <span class="ctl-note">drag the logo in the preview to move it</span></label>
                <input type="range" id="logoScale" min="40" max="150" value="100">
              </div>
              <button type="button" class="ctl-reset" id="resetLogo">Recenter logo</button>
              <label class="patch-invert">
                <input type="checkbox" id="invertToggle">
                <span>Invert (swap engraved / material areas)</span>
              </label>
              <div class="field">
                <label for="edgeSel">Edge finish</label>
                <select id="edgeSel">
                  <option value="none">None (clean edge)</option>
                  <option value="stitch">Faux stitch line</option>
                  <option value="outline">Outline border</option>
                </select>
              </div>
            </div>
            <div class="die-note" id="dieNote" hidden>
              <strong>Heads up:</strong> the die-cut outline here is a rough approximation generated from your image. Your proof will show the real cut line, properly smoothed, with clean curves and even spacing around your artwork.
            </div>
            <p class="hint">This is a live approximation built from your logo and a sample of the material photo, not the exact final engraving. We'll email a real mockup before anything hits the laser.</p>
          </div>
        </div>

        <div class="patch-layout-fields">
          <p class="fld">Material <button type="button" class="info-btn" id="engraveBtn">How does engraving work?</button></p>
          <div class="matgrid" id="materials"></div>
          <div class="info-panel" id="engraveInfo" hidden>
            <p class="info-note">Our laser burns through the colored top layer of the leatherette to expose the black core underneath, so <strong>every engraved line comes out black</strong> no matter which material you pick. Bold, simple shapes engrave the cleanest; very fine detail or thin lines can lose crispness at small sizes.</p>
          </div>

          <p class="fld">Placement</p>
          <div class="chips" id="placements"></div>

          <p class="fld">How should we send your proof? <span style="color:#c33">*</span></p>
          <div class="field" style="max-width:340px">
            <select id="proofMethod">
              <option value="">Choose one...</option>
              <option value="Email">Email</option>
              <option value="Text message">Text message</option>
            </select>
          </div>
          <div class="field" id="proofPhoneWrap" style="max-width:340px;margin-top:12px" hidden>
            <label for="proofPhone">Mobile number for your proof <span style="color:#c33">*</span></label>
            <input type="tel" id="proofPhone" inputmode="tel" autocomplete="tel" placeholder="(336) 555-0123">
          </div>
          <p class="hint" id="proofHint">We'll send your mockup within one business day. Nothing gets engraved until you approve it.</p>

          <div class="field" style="margin-top:18px"><label for="notes">Notes</label><textarea id="notes" rows="3" placeholder="Placement preferences, deadlines, anything else we should know"></textarea></div>

        </div>
      </div>

      <div class="lt-note" role="note">
        <span class="lt-note-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
        <p><strong>Current lead time: 3-4 weeks</strong> after you approve your proof. Need them sooner? <a href="mailto:help@threadbreak.com?subject=Rush%20order%20request">Email us</a> before you order and we'll see what we can do.</p>
      </div>

      <div class="btn-row"><button type="button" class="back" data-back="2">Back</button><button type="button" class="next" id="next3">Review Order</button></div>
    </div>
  </section>

  <!-- STEP 4: review -->
  <section class="tbstep" data-step="4">
    <div class="tbstep-head"><div class="tbstep-num">4</div><h2>Review</h2><div class="tbstep-sum" id="sum4"></div></div>
    <div class="tbstep-body">
      <div id="review"></div>

      <div class="proof-note">
        <span class="en-icon" aria-hidden="true">!</span>
        <div><p><strong>Keep an eye on your email.</strong> We'll send your digital mockup from help@threadbreak.com within one business day. We can't start production until you approve it, so please watch your inbox and spam folder.</p></div>
      </div>

      <div class="upload-progress" id="uploadProgress">
        <div class="up-bar"><div class="up-fill" id="upFill"></div></div>
        <div class="up-label" id="upLabel">Working...</div>
      </div>
      <div class="cart-err" id="cartErr">Something went wrong adding this to your cart. Please try again, or email help@threadbreak.com and we'll sort it out.</div>

      <div class="btn-row"><button type="button" class="back" data-back="3">Back</button><button type="button" class="next" id="checkout">Add to Cart</button></div>
      <p class="hint">Current lead time is 3-4 weeks after mockup approval, plus shipping transit. Need them sooner? Email help@threadbreak.com before you order.</p>
    </div>
  </section>
  </div>
  <a href="/pages/reviews" class="tbco-rating">
    {%- assign jm = shop.metafields.judgeme -%}
    <span class="tbco-rating-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
    <span>{{ jm.all_reviews_rating | default: 5.0 | round: 1 }}/5 from {{ jm.all_reviews_count | default: 45 }} verified reviews</span>
    <span class="tbco-rating-arrow" aria-hidden="true">&rarr;</span>
  </a>

  <a href="sms:+13365856176" class="tbco-textus">
    <span class="tbco-textus-icon" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
    </span>
    Questions before you order? <strong>Text us: (336) 585-6176</strong>
  </a>


</div>

