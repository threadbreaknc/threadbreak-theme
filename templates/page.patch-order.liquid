                  <option value="none">None (clean edge)</option>
                  <option value="stitch">Faux stitch line</option>
                  <option value="outline">Outline border</option>
                </select>
              </div>
            </div>
            <p class="hint">This is a live approximation built from your logo and a sample of the material photo, not the exact final engraving. We'll email a real mockup before anything hits the laser.</p>
          </div>
        </div>

        <div class="patch-layout-fields">
          <p class="fld">Your logo / artwork</p>
          <div class="up-slot req" id="logoSlot">
