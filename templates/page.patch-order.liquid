<script>
(function(){
"use strict";
const $ = id => document.getElementById(id);
const money = n => "$" + (Math.round(n * 100) / 100).toFixed(2).replace(/\.00$/, "");

// Brand-alphabetical, but the popular Richardson 112s lead their brand group.
const RANK = { rich112: 0, rich112_5p: 1, rich112p: 2 };
const sorted = STYLES.slice().sort((a, b) => {
  const brand = a.brand.split(" ")[0].localeCompare(b.brand.split(" ")[0]);
  if (brand !== 0) return brand;
  const ra = RANK[a.id] != null ? RANK[a.id] : 50;
  const rb = RANK[b.id] != null ? RANK[b.id] : 50;
  if (ra !== rb) return ra - rb;
  return a.brand.localeCompare(b.brand);
});

const BADGES = { rich112: "Most popular", otto: "Best value", atonal_a500r: "Premium rope" };

const CLEAN_NAME = {
  otto: "Otto 5-Panel Mid Profile",
  atonal: "Atonal Camo A-Frame",
  atonal_a500r: "Atonal Rope Snapback",
  rich112: "Richardson 6-Panel Trucker",
  rich112_5p: "Richardson 5-Panel Trucker",
  rich112p: "Richardson Printed 5-Panel",
  yupoong: "Yupoong Flat Bill Trucker",
  yp6606: "Yupoong Retro Trucker",
  rich168: "Richardson 7-Panel Trucker",
  rich256: "Richardson Umpqua Rope Hat",
  otto120: "Otto Comfy Fit 5-Panel"
};
const nameOf = s => CLEAN_NAME[s.id] || s.name;

const SHORT_NAME = {
  otto: "5-Panel Mid Profile",
  atonal: "Camo A-Frame",
  atonal_a500r: "Rope Snapback",
  rich112: "6-Panel Trucker",
  rich112_5p: "5-Panel Trucker",
  rich112p: "Printed 5-Panel",
  yupoong: "Flat Bill Trucker",
  yp6606: "Retro Trucker",
  rich168: "7-Panel Trucker",
  rich256: "Umpqua Rope Hat",
  otto120: "Comfy Fit 5-Panel"
};
const shortOf = s => SHORT_NAME[s.id] || nameOf(s);

const BRAND_LOGOS = [
  { test: /richardson/i, src: "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/richardson.png?v=1787437321", alt: "Richardson" },
  { test: /yupoong|yp classics/i, src: "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/yupoong.png?v=1787437321", alt: "Yupoong" },
  { test: /atonal/i, src: "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/atonal.png?v=1787437321", alt: "Atonal" },
  { test: /otto/i, src: "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/otoo.png?v=1787437321", alt: "Otto" }
];
function brandLogo(s){
  const hit = BRAND_LOGOS.find(b => b.test.test(s.brand) || b.test.test(s.name));
  return hit || null;
}
const sizingOf = s => (/^rich/i.test(s.id) || /richardson/i.test(s.brand))
  ? "One size fits most (standard M/L)" : "One size fits most";
const specsOf = s => (s.desc || "").split("·").map(x => x.trim()).filter(x => x && !/size|fits/i.test(x));

const state = {
  style: null, colors: [], split: {}, qty: null, activeColor: null,
  material: MATERIALS[0], shape: SHAPES[0], placement: PLACEMENTS[0],
  // Size defaults to the cheapest option so step 2 can quote a real price before
  // the customer reaches step 3; sizeChosen tracks the still-required pick.
  size: SIZES[0], sizeChosen: false,
  logoFile: null, logoImage: null, threshold: 140, invert: false, edge: "none",
  // logo transform: scale is a fraction of the fitted size, x/y are offsets as a
  // fraction of the canvas (0,0 = centered)
  logoScale: 1, logoX: 0, logoY: 0,
  step: 1, maxStep: 1, done: new Set()
};

/* ---------- pricing ---------- */
function tierFor(style, qty){
  if (!style || !qty) return null;
  let t = style.tiers[0];
  for (const tier of style.tiers) if (qty >= tier[0]) t = tier;
  return t;
}
function perHat(){
  const t = tierFor(state.style, state.qty);
  if (!t) return null;
  return t[1] + state.size.add;
}
function nextTier(){
  if (!state.style || !state.qty) return null;
  for (const t of state.style.tiers) if (t[0] > state.qty) return t;
  return null;
}
function colorSummary(){
  if (!state.colors.length) return "Not specified";
  if (state.colors.length === 1) return state.colors[0];
  return state.colors.map(c => c + " x" + (state.split[c] || 0)).join(", ");
}
function colorImg(style, color){
  if (style.colorImgs && style.colorImgs[color]) return style.colorImgs[color];
  return style.imgs[0];
}

// Native scroll-behavior:smooth is fast and snappy. This eases over a longer
// duration so the page glides instead of jumping, and always stops far enough
// down that the sticky header and the full step rail stay on screen.
const HEADER_H = () => (window.innerWidth <= 600 ? 60 : 70);
function railBottom(){
  const rail = document.getElementById("rail");
  if (!rail) return HEADER_H() + 70;
  return HEADER_H() + rail.getBoundingClientRect().height + 22;
}
let scrollAnim = null;
["wheel","touchstart","keydown"].forEach(ev =>
  window.addEventListener(ev, () => {
    if (scrollAnim){ cancelAnimationFrame(scrollAnim); scrollAnim = null; }
  }, { passive: true }));

function easeScrollTo(targetY, duration){
  if (scrollAnim) cancelAnimationFrame(scrollAnim);
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches){
    window.scrollTo(0, Math.max(0, targetY));
    return;
  }
  const startY = window.scrollY;
  const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
  const endY = Math.max(0, Math.min(targetY, maxY));
  const dist = endY - startY;
  if (Math.abs(dist) < 4) return;
  const dur = duration || 850;
  const t0 = performance.now();
  const ease = t => t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t + 2, 3)/2;
  function frame(now){
    const t = Math.min(1, (now - t0) / dur);
    window.scrollTo(0, startY + dist * ease(t));
    if (t < 1) scrollAnim = requestAnimationFrame(frame);
    else scrollAnim = null;
  }
  scrollAnim = requestAnimationFrame(frame);
}
function easeScrollToEl(el, duration){
  if (!el) return;
  const y = window.scrollY + el.getBoundingClientRect().top - railBottom();
  easeScrollTo(y, duration);
}

/* ---------- step 1: hats ---------- */
function renderHats(){
  const picking = !!state.style;
  const grid = $("hats");
  grid.classList.toggle("picking", picking);

  grid.innerHTML = sorted.map((s, idx) => {
    const on = state.style && state.style.id === s.id;
    const badge = BADGES[s.id] ? '<div class="hat-badge">' + BADGES[s.id] + '</div>' : "";
    const low = s.tiers[s.tiers.length - 1][1];
    const five = (s.tiers.find(t => t[0] === 5) || s.tiers[0])[1];
    const ten = (s.tiers.find(t => t[0] === 10) || s.tiers[0])[1];

    if (!on){
      const lg = brandLogo(s);
      const eager = idx < 4;
      return '<div class="hat" data-hat="' + s.id + '">' + badge +
        '<div class="hat-imgwrap">' +
          '<img class="hat-img" src="' + s.imgs[0] + '" alt="' + nameOf(s) + '" loading="' + (eager ? 'eager' : 'lazy') + '" decoding="async" fetchpriority="' + (eager ? 'high' : 'low') + '">' +
          (lg ? '<img class="hat-logo" src="' + lg.src + '" alt="' + lg.alt + '" loading="lazy">' : '') +
        '</div>' +
        '<div class="hat-info">' +
          '<div class="hat-name">' + nameOf(s) + '</div>' +
          '<div class="hat-name-sm">' + shortOf(s) + '</div>' +
          '<div class="hat-brand">' + s.brand + '</div>' +
          '<div class="hat-price">As low as ' + money(low) + '/hat</div>' +
          '<div class="hat-colors"><span class="wheel"></span>' + s.colors.length + ' colors</div>' +
        '</div></div>';
    }
    const specs = specsOf(s);
    const lg = brandLogo(s);
    const shown = state.activeColor && s.colors.indexOf(state.activeColor) > -1 ? state.activeColor : null;
    const heroSrc = shown ? colorImg(s, shown) : s.imgs[0];
    return '<div class="hat on" data-hat="' + s.id + '">' + badge +
        '<div class="hat-heroimg">' +
          '<img class="hat-img" id="hatHero" src="' + heroSrc + '" alt="' + nameOf(s) + '" loading="lazy" onerror="this.onerror=null;this.src=\'' + s.imgs[0] + '\'">' +
          '<div class="hat-herocap" id="hatHeroCap">' + (shown ? shown : "Pick a color to preview") + '</div>' +
        '</div>' +
        '<div class="hat-info">' +
          '<div class="hat-titlerow">' +
            (lg ? '<img class="hat-logo-lg" src="' + lg.src + '" alt="' + lg.alt + '">' : '') +
            '<div><div class="hat-name" style="font-size:19px">' + nameOf(s) + '</div>' +
            '<div class="hat-brand">' + s.brand + '</div></div>' +
          '</div>' +
          '<div class="hat-price">' + money(five) + ' each at 5 &middot; ' + money(ten) + ' each at 10 &middot; as low as ' + money(low) + '</div>' +
          '<div class="hat-specs">' +
            '<div><b>Sizing:</b> ' + sizingOf(s) + '</div>' +
            (specs.length ? '<div><b>Details:</b> ' + specs.join(", ") + '</div>' : "") +
            '<div><b>Included:</b> free proof mockup, free shipping to the lower 48</div>' +
          '</div>' +
          '<button type="button" class="hat-change" data-change="1">Choose a different hat</button>' +
        '</div>' +
      '<div class="hat-expand" id="colorHost"></div></div>';
  }).join("");

  grid.querySelectorAll("[data-hat]").forEach(el => {
    el.addEventListener("click", ev => {
      if (ev.target.closest(".hat-expand") || ev.target.closest("[data-change]")) return;
      const s = STYLES.find(x => x.id === el.dataset.hat);
      if (state.style && state.style.id === s.id) return;
      state.style = s; state.colors = []; state.split = {}; state.activeColor = null;
      renderHats(); sync();
      requestAnimationFrame(() => easeScrollToEl(document.querySelector("#tbpo .hat.on"), 900));
    });
  });
  const chg = grid.querySelector("[data-change]");
  if (chg) chg.addEventListener("click", ev => {
    ev.stopPropagation();
    state.style = null; state.colors = []; state.split = {}; state.activeColor = null;
    renderHats(); sync();
    requestAnimationFrame(() => easeScrollToEl(document.getElementById("hats"), 900));
  });
  if (picking) renderColorPanel();
}

/* ---------- color dropdown ---------- */
function renderColorPanel(){
  const host = $("colorHost");
  if (!host || !state.style) return;
  const s = state.style;
  host.innerHTML =
    '<div class="colorpanel">' +
      '<h3>Choose your colors</h3>' +
      '<p class="cp-sub">Available in ' + s.colors.length + ' colors. Pick one or as many as you like, mixing costs nothing extra.</p>' +
      '<div class="dd" id="dd">' +
        '<button type="button" class="dd-btn" id="ddBtn"><span id="ddLabel">Select a color</span>' +
        '<svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg></button>' +
        '<div class="dd-more" id="ddMore"><span>Scroll for more colors <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg></span></div>' +
        '<div class="dd-menu" id="ddMenu">' +
          s.colors.map(c =>
            '<div class="dd-opt ' + (state.colors.indexOf(c) > -1 ? "picked" : "") + '" data-color="' + c + '">' +
              '<img src="' + colorImg(s, c) + '" alt="' + c + '" loading="lazy" onerror="this.onerror=null;this.src=\'' + s.imgs[0] + '\'">' +
              '<span>' + c + '</span>' +
              (state.colors.indexOf(c) > -1 ? '<span class="tick">&#10003;</span>' : "") +
            '</div>').join("") +
        '</div>' +
      '</div>' +
      '<div class="picked-row" id="pickedRow"></div>' +
    '</div>';

  const dd = $("dd"), menu = $("ddMenu"), more = $("ddMore");
  function cue(){
    if (!menu || !more) return;
    more.classList.toggle("on", menu.scrollHeight - menu.scrollTop - menu.clientHeight > 12);
  }
  if (menu) menu.addEventListener("scroll", cue);
  $("ddBtn").addEventListener("click", e => { e.stopPropagation(); dd.classList.toggle("open"); setTimeout(cue, 20); });
  menu.addEventListener("click", e => e.stopPropagation());
  document.addEventListener("click", () => { if (dd) dd.classList.remove("open"); });

  host.querySelectorAll("[data-color]").forEach(opt => {
    opt.addEventListener("click", () => {
      const c = opt.dataset.color;
      const i = state.colors.indexOf(c);
      if (i === -1){ state.colors.push(c); state.activeColor = c; }
      else {
        state.colors.splice(i,1); delete state.split[c];
        if (state.activeColor === c) state.activeColor = state.colors[state.colors.length-1] || null;
      }
      updateHero();
      renderColorPanel(); renderSplit(); sync();
    });
  });
  renderPicked();
}
function updateHero(){
  const img = document.getElementById("hatHero");
  const cap = document.getElementById("hatHeroCap");
  if (!img || !state.style) return;
  const c = state.activeColor;
  img.src = (c && state.style.colors.indexOf(c) > -1) ? colorImg(state.style, c) : state.style.imgs[0];
  if (cap) cap.textContent = c || "Pick a color to preview";
}

function renderPicked(){
  const row = $("pickedRow");
  if (!row) return;
  if (!state.colors.length){ row.innerHTML = ""; $("ddLabel").textContent = "Select a color"; return; }
  $("ddLabel").textContent = state.colors.length === 1 ? state.colors[0] : state.colors.length + " colors selected";
  row.innerHTML = state.colors.map(c =>
    '<span class="pchip' + (state.activeColor === c ? ' on' : '') + '" data-preview="' + c + '">' +
    '<img src="' + colorImg(state.style, c) + '" alt="' + c + '" onerror="this.onerror=null;this.src=\'' + state.style.imgs[0] + '\'">' +
    c + '<button type="button" data-remove="' + c + '" aria-label="Remove ' + c + '">&times;</button></span>').join("");
  row.querySelectorAll("[data-remove]").forEach(b => {
    b.addEventListener("click", ev => {
      ev.stopPropagation();
      const c = b.dataset.remove;
      state.colors = state.colors.filter(x => x !== c);
      delete state.split[c];
      if (state.activeColor === c) state.activeColor = state.colors[state.colors.length-1] || null;
      updateHero();
      renderColorPanel(); renderSplit(); sync();
    });
  });
  row.querySelectorAll("[data-preview]").forEach(el => {
    el.addEventListener("click", () => {
      state.activeColor = el.dataset.preview;
      updateHero(); renderPicked();
    });
  });
}

/* ---------- step 2: quantity + split ---------- */
function renderSplit(){
  const host = $("splitHost");
  if (!host) return;
  if (state.colors.length < 2){ host.innerHTML = ""; return; }
  const total = Object.values(state.split).reduce((a,b) => a + (+b || 0), 0);
  const target = state.qty || 0;
  const bad = target && total !== target;
  host.innerHTML =
    '<div class="split"><div class="split-head">How many of each color?</div>' +
    state.colors.map(c =>
      '<div class="split-row"><img src="' + colorImg(state.style, c) + '" alt="' + c + '" onerror="this.onerror=null;this.src=\'' + state.style.imgs[0] + '\'">' +
      '<span class="nm">' + c + '</span>' +
      '<input type="number" min="0" inputmode="numeric" data-split="' + c + '" value="' + (state.split[c] != null ? state.split[c] : "") + '" placeholder="0"></div>').join("") +
    '<div class="split-total ' + (bad ? "bad" : "") + '"><span>Allocated</span><span>' + total +
    (target ? " of " + target : "") + (bad ? " (needs to match)" : "") + '</span></div></div>';
  host.querySelectorAll("[data-split]").forEach(inp => {
    inp.addEventListener("input", () => { state.split[inp.dataset.split] = +inp.value || 0; renderSplit(); sync(); });
  });
}
function evenSplit(){
  if (state.colors.length < 2 || !state.qty) return;
  const base = Math.floor(state.qty / state.colors.length);
  let rem = state.qty - base * state.colors.length;
  state.colors.forEach(c => { state.split[c] = base + (rem-- > 0 ? 1 : 0); });
}

/* ---------- material preload + uniform-strip sampling ---------- */
const matImageCache = {}, matRegionCache = {}, matPatternCanvasCache = {};
function findUniformRegion(img){
  const w = img.naturalWidth, h = img.naturalHeight;
  if (!w || !h) return { x:0, y:0, w:1, h:1 };
  const c = document.createElement("canvas");
  c.width = w; c.height = h;
  const ctx = c.getContext("2d");
  ctx.drawImage(img, 0, 0);
  // Sample the central 80% of the photo in a grid, avoiding any edge framing.
  const marginX = Math.round(w * 0.1), marginY = Math.round(h * 0.1);
  const areaW = w - marginX * 2, areaH = h - marginY * 2;
  const cols = 6, rows = 6;
  const cw = Math.max(8, Math.floor(areaW / cols)), ch = Math.max(8, Math.floor(areaH / rows));
  let best = null;
  for (let ry = 0; ry < rows; ry++){
    for (let rx = 0; rx < cols; rx++){
      const x = marginX + rx * cw, y = marginY + ry * ch;
      if (x + cw > w || y + ch > h) continue;
      let data;
      try { data = ctx.getImageData(x, y, cw, ch).data; } catch(e){ continue; }
      let n = 0, sum = 0, sumsq = 0;
      for (let i = 0; i < data.length; i += 16){
        const l = 0.299*data[i] + 0.587*data[i+1] + 0.114*data[i+2];
        sum += l; sumsq += l*l; n++;
      }
      if (!n) continue;
      const mean = sum / n;
      const variance = Math.max(0, sumsq / n - mean * mean);
      if (!best || variance < best.variance) best = { x, y, w: cw, h: ch, variance, mean };
    }
  }
  return best || { x: marginX, y: marginY, w: areaW || w, h: areaH || h };
}
// Fractional {cx,cy,w,h} -> pixel region, clamped inside the photo.
function explicitRegion(img, f){
  const W = img.naturalWidth, H = img.naturalHeight;
  const w = Math.max(8, Math.round(W * f.w)), h = Math.max(8, Math.round(H * f.h));
  let x = Math.round(W * f.cx - w / 2), y = Math.round(H * f.cy - h / 2);
  x = Math.max(0, Math.min(W - w, x));
  y = Math.max(0, Math.min(H - h, y));
  return { x: x, y: y, w: w, h: h };
}
function regionCanvas(img, region){
  const c = document.createElement("canvas");
  c.width = Math.max(1, region.w); c.height = Math.max(1, region.h);
  const ctx = c.getContext("2d");
  ctx.drawImage(img, region.x, region.y, region.w, region.h, 0, 0, region.w, region.h);
  return c;
}
function preloadMaterials(){
  MATERIALS.forEach(m => {
    const img = new Image();
    img.crossOrigin = "anonymous";
    img.onload = () => {
      matImageCache[m.id] = img;
      try {
        const region = m.sample ? explicitRegion(img, m.sample) : findUniformRegion(img);
        matRegionCache[m.id] = region;
        matPatternCanvasCache[m.id] = regionCanvas(img, region);
      } catch(e){ /* CORS or decode failure: fall back to flat swatch color below */ }
      if (state.material.id === m.id) renderPatchPreview();
    };
    img.onerror = () => {};
    img.src = m.swatch;
  });
}

/* ---------- canvas engraving preview ---------- */
function roundRectPath(ctx, x, y, w, h, r){
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
}
function clipPath(ctx, shape, w, h, inset){
  ctx.beginPath();
  if (shape === "circle"){
    const r = Math.min(w, h) / 2 - inset;
    ctx.arc(w / 2, h / 2, r, 0, Math.PI * 2);
  } else if (shape === "rounded"){
    const rad = Math.min(w, h) * 0.14;
    roundRectPath(ctx, inset, inset, w - 2 * inset, h - 2 * inset, rad);
  } else {
    ctx.rect(inset, inset, w - 2 * inset, h - 2 * inset);
  }
  ctx.closePath();
}
// Single source of truth for where the artwork sits, so the engraved ink and the
// die-cut silhouette are always derived from the exact same placement.
function drawLogoInto(ctx, img, outW, outH){
  const pad = 0.86 * (state.logoScale || 1);
  const scale = Math.min((outW * pad) / img.naturalWidth, (outH * pad) / img.naturalHeight);
  const dw = img.naturalWidth * scale, dh = img.naturalHeight * scale;
  const dx = (outW - dw) / 2 + outW * (state.logoX || 0);
  const dy = (outH - dh) / 2 + outH * (state.logoY || 0);
  ctx.drawImage(img, dx, dy, dw, dh);
}
// Threshold the logo to pure black/white ink on transparency, letterboxed to fit.
function buildInkMask(img, threshold, invert, outW, outH){
  const c = document.createElement("canvas");
  c.width = outW; c.height = outH;
  const ctx = c.getContext("2d");
  ctx.clearRect(0, 0, outW, outH);
  drawLogoInto(ctx, img, outW, outH);
  let imgd;
  try { imgd = ctx.getImageData(0, 0, outW, outH); } catch(e){ return c; }
  const d = imgd.data;
  for (let i = 0; i < d.length; i += 4){
    const a = d[i + 3];
    let ink = false;
    if (a >= 10){
      const l = 0.299*d[i] + 0.587*d[i+1] + 0.114*d[i+2];
      ink = invert ? (l > threshold) : (l < threshold);
    }
    if (ink){ d[i] = 0; d[i+1] = 0; d[i+2] = 0; d[i+3] = 255; }
    else { d[i] = 0; d[i+1] = 0; d[i+2] = 0; d[i+3] = 0; }
  }
  ctx.putImageData(imgd, 0, 0);
  return c;
}
// Silhouette of the artwork itself: anything that isn't transparent and isn't
// near-white. Used for the die cut, so the cut follows the logo regardless of
// which way the engrave threshold/invert is currently set.
function buildSilhouette(img, outW, outH){
  const c = document.createElement("canvas");
  c.width = outW; c.height = outH;
  const ctx = c.getContext("2d");
  drawLogoInto(ctx, img, outW, outH);
  let id;
  try { id = ctx.getImageData(0, 0, outW, outH); } catch(e){ return c; }
  const d = id.data;
  for (let i = 0; i < d.length; i += 4){
    const a = d[i + 3];
    const l = 0.299*d[i] + 0.587*d[i+1] + 0.114*d[i+2];
    const on = a >= 12 && l < 242;
    d[i] = 0; d[i+1] = 0; d[i+2] = 0; d[i+3] = on ? 255 : 0;
  }
  ctx.putImageData(id, 0, 0);
  return c;
}
// Grow a solid mask outward by r pixels. Separable max filter (two passes), so
// it is exact and can never dilute a thin shape away the way a blur does.
function dilateMask(src, r){
  const w = src.width, h = src.height;
  const out = document.createElement("canvas");
  out.width = w; out.height = h;
  const octx = out.getContext("2d");
  if (r < 1){ octx.drawImage(src, 0, 0); return out; }
  let id;
  try { id = src.getContext("2d").getImageData(0, 0, w, h); } catch(e){ octx.drawImage(src, 0, 0); return out; }
  const a = new Uint8Array(w * h), tmp = new Uint8Array(w * h);
  const d = id.data;
  for (let i = 0, j = 0; j < w * h; i += 4, j++) a[j] = d[i + 3] > 8 ? 1 : 0;
  // horizontal pass
  for (let y = 0; y < h; y++){
    const row = y * w;
    for (let x = 0; x < w; x++){
      let on = 0;
      const x0 = Math.max(0, x - r), x1 = Math.min(w - 1, x + r);
      for (let k = x0; k <= x1; k++) if (a[row + k]){ on = 1; break; }
      tmp[row + x] = on;
    }
  }
  // vertical pass
  for (let x = 0; x < w; x++){
    for (let y = 0; y < h; y++){
      let on = 0;
      const y0 = Math.max(0, y - r), y1 = Math.min(h - 1, y + r);
      for (let k = y0; k <= y1; k++) if (tmp[k * w + x]){ on = 1; break; }
      a[y * w + x] = on;
    }
  }
  const od = octx.createImageData(w, h);
  const p = od.data;
  for (let i = 0, j = 0; j < w * h; i += 4, j++){
    p[i] = 0; p[i+1] = 0; p[i+2] = 0; p[i+3] = a[j] ? 255 : 0;
  }
  octx.putImageData(od, 0, 0);
  return out;
}
// Round the corners of an already-solid mask: blur by r, then remap alpha with a
// steep ramp instead of a hard cutoff. The ramp is the important part — a binary
// 0/255 mask gives the aliased, stair-stepped cut edge; a ~2px ramp reads smooth.
function roundMask(src, r){
  const w = src.width, h = src.height;
  const c = document.createElement("canvas");
  c.width = w; c.height = h;
  const ctx = c.getContext("2d");
  if (r < 1){ ctx.drawImage(src, 0, 0); return c; }
  ctx.filter = "blur(" + r + "px)";
  ctx.drawImage(src, 0, 0);
  ctx.filter = "none";
  let id;
  try { id = ctx.getImageData(0, 0, w, h); } catch(e){ return c; }
  const d = id.data;
  const lo = 104, hi = 152, span = hi - lo;
  let any = false;
  for (let i = 0; i < d.length; i += 4){
    const a = d[i + 3];
    let out;
    if (a <= lo) out = 0;
    else if (a >= hi){ out = 255; any = true; }
    else { out = Math.round(((a - lo) / span) * 255); any = true; }
    d[i] = 0; d[i+1] = 0; d[i+2] = 0; d[i+3] = out;
  }
  if (!any){ const c2 = document.createElement("canvas"); c2.width = w; c2.height = h; c2.getContext("2d").drawImage(src, 0, 0); return c2; }
  ctx.putImageData(id, 0, 0);
  return c;
}
// The die-cut silhouette: logo outline + padding, corners softened.
let dieSilCache = null;
function dieCutSilhouette(logoImg, W, H){
  if (!logoImg) return null;
  // Only depends on the artwork and the canvas size, not the threshold slider,
  // so cache it — the dilation pass is the expensive part of a render.
  const key = W + "x" + H + ":" + state.logoScale + ":" + state.logoX + ":" + state.logoY;
  if (dieSilCache && dieSilCache.img === logoImg && dieSilCache.key === key) return dieSilCache.canvas;
  const sil = buildSilhouette(logoImg, W, H);
  const base = Math.min(W, H);
  // Padding is deliberately small — just enough leather to hold the shape.
  const pad = Math.max(2, Math.round(base * 0.018));
  // The rounding radius is set independently of the padding, so the corners stay
  // soft even though the border is thin. Dilate past the target by the radius,
  // then the blur+ramp pass rounds and settles it back to `pad`.
  const round = Math.max(4, Math.round(base * 0.038));
  const grown = dilateMask(sil, pad + round);
  const out = roundMask(grown, round);
  dieSilCache = { img: logoImg, key: key, canvas: out };
  return out;
}
// Tight bounding box of the thresholded ink, so a die cut can hug the artwork.
function inkBounds(inkCanvas){
  const w = inkCanvas.width, h = inkCanvas.height;
  let id;
  try { id = inkCanvas.getContext("2d").getImageData(0, 0, w, h); } catch(e){ return null; }
  const d = id.data;
  let minX = w, minY = h, maxX = -1, maxY = -1;
  for (let y = 0; y < h; y++){
    const row = y * w * 4;
    for (let x = 0; x < w; x++){
      if (d[row + x * 4 + 3] > 8){
        if (x < minX) minX = x;
        if (x > maxX) maxX = x;
        if (y < minY) minY = y;
        if (y > maxY) maxY = y;
      }
    }
  }
  if (maxX < 0) return null;
  return { x: minX, y: minY, w: maxX - minX + 1, h: maxY - minY + 1 };
}
// Die cut = the artwork's bounding box plus a little padding, with rounded corners.
function computeDieCutRect(ink, W, H){
  const b = ink ? inkBounds(ink) : null;
  const padBase = Math.min(W, H);
  const pad = Math.max(8, Math.round(padBase * 0.06));
  let x, y, w, h;
  if (b){
    x = b.x - pad; y = b.y - pad; w = b.w + pad * 2; h = b.h + pad * 2;
  } else {
    x = W * 0.12; y = H * 0.12; w = W * 0.76; h = H * 0.76;
  }
  // keep it inside the canvas
  const inset = 4;
  if (x < inset){ w += x - inset; x = inset; }
  if (y < inset){ h += y - inset; y = inset; }
  if (x + w > W - inset) w = W - inset - x;
  if (y + h > H - inset) h = H - inset - y;
  w = Math.max(12, w); h = Math.max(12, h);
  const r = Math.max(6, Math.round(Math.min(w, h) * 0.16));
  return { x: x, y: y, w: w, h: h, r: r };
}
function shapeMask(shape, W, H, ink, dieRect, dieSil){
  const c = document.createElement("canvas");
  c.width = W; c.height = H;
  const ctx = c.getContext("2d");
  ctx.fillStyle = "#000";
  if (shape === "diecut"){
    if (dieSil){ ctx.drawImage(dieSil, 0, 0); return c; }
    // no artwork yet: rounded-rect placeholder so the material still shows
    const r = dieRect || computeDieCutRect(ink, W, H);
    ctx.beginPath();
    roundRectPath(ctx, r.x, r.y, r.w, r.h, r.r);
    ctx.closePath();
    ctx.fill();
    return c;
  }
  clipPath(ctx, shape, W, H, 8);
  ctx.fill();
  return c;
}
function compositeLayer(paintFn, mask){
  const c = document.createElement("canvas");
  c.width = mask.width; c.height = mask.height;
  const ctx = c.getContext("2d");
  paintFn(ctx);
  ctx.globalCompositeOperation = "destination-in";
  ctx.drawImage(mask, 0, 0);
  return c;
}
function drawPlaceholderText(ctx, W, H){
  ctx.save();
  ctx.fillStyle = "rgba(20,18,28,.5)";
  ctx.font = "600 15px DM Sans, sans-serif";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("Upload your logo to preview", W / 2, H / 2);
  ctx.restore();
}
// Optional decorative edge: a dashed "stitch" line or a solid outline, inset just
// inside the patch edge. Works for the geometric shapes and for the die cut rect.
function drawShapeBorder(ctx, mode, shape, W, H, dieRect, dieSil){
  if (mode === "none") return;
  const base = Math.min(W, H);
  const lw = mode === "stitch" ? Math.max(2, base * 0.0095) : Math.max(2.5, base * 0.013);
  // Die cut with real artwork has no geometric edge to stroke, so inset-stroke
  // its own silhouette: shrink the mask by the line width and subtract.
  if (shape === "diecut" && dieSil){
    const inset = Math.round(lw * 1.6);
    const ring = document.createElement("canvas");
    ring.width = W; ring.height = H;
    const rctx = ring.getContext("2d");
    rctx.drawImage(dieSil, 0, 0);
    rctx.globalCompositeOperation = "destination-out";
    rctx.drawImage(erodeMask(dieSil, inset), 0, 0);
    rctx.globalCompositeOperation = "source-in";
    rctx.fillStyle = "#141117";
    rctx.fillRect(0, 0, W, H);
    if (mode === "stitch"){
      // punch dashes out of the ring to read as stitching
      rctx.globalCompositeOperation = "destination-out";
      const step = Math.max(8, base * 0.038), gap = step * 0.42;
      for (let d = 0; d < W + H; d += step){
        rctx.save();
        rctx.lineWidth = gap;
        rctx.strokeStyle = "#000";
        rctx.beginPath();
        rctx.moveTo(d, 0); rctx.lineTo(d - H, H);
        rctx.stroke();
        rctx.restore();
      }
    }
    ctx.drawImage(ring, 0, 0);
    return;
  }
  ctx.save();
  ctx.beginPath();
  if (shape === "diecut"){
    const r = dieRect || computeDieCutRect(null, W, H);
    const i = Math.max(3, Math.round(base * 0.018));
    roundRectPath(ctx, r.x + i, r.y + i, Math.max(8, r.w - i * 2), Math.max(8, r.h - i * 2), Math.max(4, r.r - i));
    ctx.closePath();
  } else {
    clipPath(ctx, shape, W, H, Math.round(base * 0.045));
  }
  ctx.strokeStyle = "#141117";
  ctx.lineWidth = lw;
  if (mode === "stitch"){
    ctx.setLineDash([Math.max(5, base * 0.028), Math.max(4, base * 0.02)]);
    ctx.lineCap = "round";
  } else {
    ctx.setLineDash([]);
  }
  ctx.stroke();
  ctx.restore();
}
// Shrink a solid mask inward by r pixels (dilate its complement).
function erodeMask(src, r){
  const w = src.width, h = src.height;
  const inv = document.createElement("canvas");
  inv.width = w; inv.height = h;
  const ictx = inv.getContext("2d");
  ictx.fillStyle = "#000";
  ictx.fillRect(0, 0, w, h);
  ictx.globalCompositeOperation = "destination-out";
  ictx.drawImage(src, 0, 0);
  const grown = dilateMask(inv, r);
  const out = document.createElement("canvas");
  out.width = w; out.height = h;
  const octx = out.getContext("2d");
  octx.drawImage(src, 0, 0);
  octx.globalCompositeOperation = "destination-out";
  octx.drawImage(grown, 0, 0);
  return out;
}
function renderPatchPreview(){
  const canvas = $("patchCanvas");
  if (!canvas) return;
  const ctx = canvas.getContext("2d");
  const W = canvas.width, H = canvas.height;
  ctx.clearRect(0, 0, W, H);

  const logoImg = state.logoImage;
  const ink = logoImg ? buildInkMask(logoImg, state.threshold, state.invert, W, H) : null;
  const isDie = state.shape.id === "diecut";
  const dieSil = isDie ? dieCutSilhouette(logoImg, W, H) : null;
  const dieRect = isDie && !dieSil ? computeDieCutRect(ink, W, H) : null;
  const mask = shapeMask(state.shape.id, W, H, ink, dieRect, dieSil);

  const matImg = matImageCache[state.material.id];
  const patternSrc = matPatternCanvasCache[state.material.id];
  const matLayer = compositeLayer(mctx => {
    if (matImg && patternSrc){
      // One sample scaled to cover the whole patch. Tiling it produced visible
      // seams where four copies met, so we cover-fit a single crop instead.
      const sw = patternSrc.width, sh = patternSrc.height;
      const scale = Math.max(W / sw, H / sh);
      const dw = sw * scale, dh = sh * scale;
      mctx.drawImage(patternSrc, (W - dw) / 2, (H - dh) / 2, dw, dh);
    } else {
      mctx.fillStyle = "#cfc9dd";
      mctx.fillRect(0, 0, W, H);
    }
  }, mask);
  ctx.drawImage(matLayer, 0, 0);

  if (ink){
    const inkLayer = compositeLayer(ictx => { ictx.drawImage(ink, 0, 0); }, mask);
    ctx.drawImage(inkLayer, 0, 0);
  } else {
    drawPlaceholderText(ctx, W, H);
  }

  drawShapeBorder(ctx, effectiveEdge(), state.shape.id, W, H, dieRect, dieSil);
}

/* ---------- step 3: patch design ---------- */
function renderMaterials(){
  const host = $("materials");
  if (!host) return;
  host.innerHTML = MATERIALS.map(m =>
    '<button type="button" class="mat-chip ' + (m.id === state.material.id ? "on" : "") + '" data-mat="' + m.id + '">' +
      '<span class="mat-swatch" style="background-image:url(\'' + m.swatch + '\')"></span>' +
      '<span class="mat-name">' + m.name + '</span>' +
    '</button>').join("");
  host.querySelectorAll("[data-mat]").forEach(b => {
    b.addEventListener("click", () => {
      state.material = MATERIALS.find(x => x.id === b.dataset.mat);
      renderMaterials(); renderPatchPreview(); sync();
    });
  });
}
// Real-world caption for a size under the currently selected shape: rectangle/
// rounded/die-cut show width x height (derived from the shape's ratio), circle
// shows a diameter.
function sizeDimLabel(size, shape){
  const w = size.wide;
  if (shape.id === "circle") return w + '" diameter';
  const h = Math.round((w / shape.ratio) * 100) / 100;
  const hStr = (Math.round(h * 100) / 100).toString();
  return (shape.id === "diecut" ? "up to " : "") + w + '" x ' + hStr + '"';
}
// A die cut has no border to decorate — the cut line IS the edge — so the edge
// finish control is disabled (and treated as "none") whenever die cut is picked.
function isDieCut(){ return state.shape.id === "diecut"; }
function syncEdgeControl(){
  const sel = $("edgeSel");
  if (!sel) return;
  const die = isDieCut();
  sel.disabled = die;
  sel.value = die ? "none" : state.edge;
  const wrap = sel.closest(".field");
  if (wrap) wrap.classList.toggle("is-off", die);
}
function effectiveEdge(){ return isDieCut() ? "none" : state.edge; }
function renderShapes(){
  const host = $("shapes");
  if (!host) return;
  host.innerHTML = SHAPES.map(s =>
    '<button type="button" class="chip ' + (s.id === state.shape.id ? "on" : "") + '" data-shape="' + s.id + '">' + s.label + '</button>').join("");
  host.querySelectorAll("[data-shape]").forEach(b => {
    b.addEventListener("click", () => {
      state.shape = SHAPES.find(x => x.id === b.dataset.shape);
      renderShapes(); renderSizes(); syncEdgeControl(); applyCanvasShape(); sync();
    });
  });
}
function edgeLabel(){
  const e = effectiveEdge();
  return e === "stitch" ? "Faux stitch line" : (e === "outline" ? "Outline border" : (isDieCut() ? "None (die cut edge)" : "None"));
}
function renderPlacements(){
  const host = $("placements");
  if (!host) return;
  host.innerHTML = PLACEMENTS.map(p =>
    '<button type="button" class="chip ' + (p.id === state.placement.id ? "on" : "") + '" data-place="' + p.id + '">' + p.label + '</button>').join("");
  host.querySelectorAll("[data-place]").forEach(b => {
    b.addEventListener("click", () => {
      state.placement = PLACEMENTS.find(x => x.id === b.dataset.place);
      renderPlacements(); renderSizeHint(); sync();
    });
  });
}
// Left/right panels are narrow, so a Large non-circle patch usually won't sit
// right there — nudge toward Small or Medium unless it's a circle.
function renderSizeHint(){
  const host = $("sizeHint");
  if (!host) return;
  const onSide = state.placement && state.placement.id !== "front";
  const show = onSide && state.shape.id !== "circle";
  host.innerHTML = show
    ? '<div class="size-hint">Left and right panels are narrow — we typically recommend Small or Medium there unless you\'re doing a circle.</div>'
    : "";
}
function renderSizes(){
  const host = $("sizes");
  if (!host) return;
  host.innerHTML = SIZES.map(s =>
    '<button type="button" class="chip ' + (state.sizeChosen && s.id === state.size.id ? "on" : "") + '" data-size="' + s.id + '">' + s.label +
    ' <span class="size-dim">(' + sizeDimLabel(s, state.shape) + ')</span><span class="tag">+' + money(s.add) + '/hat</span></button>').join("");
  host.querySelectorAll("[data-size]").forEach(b => {
    b.addEventListener("click", () => {
      state.size = SIZES.find(x => x.id === b.dataset.size);
      state.sizeChosen = true;
      renderSizes(); sync();
    });
  });
  renderSizeHint();
}
// Resize the canvas's actual pixel buffer (and the box's aspect-ratio) to match
// the selected shape's real proportions, so a rectangle patch previews as a
// rectangle instead of always being forced into a square. The box's on-screen
// size stays fixed regardless of which S/M/L size is chosen (only shape changes it).
function applyCanvasShape(){
  const canvas = $("patchCanvas"), box = $("patchCanvasBox");
  if (!canvas || !box) return;
  const ratio = state.shape.ratio || 1;
  const base = 520;
  let w, h;
  if (ratio >= 1){ w = base; h = Math.round(base / ratio); }
  else { h = base; w = Math.round(base * ratio); }
  canvas.width = w; canvas.height = h;
  box.style.aspectRatio = w + " / " + h;
  renderPatchPreview();
}
function renderPatchDesign(){
  renderMaterials(); renderShapes(); renderPlacements(); renderSizes(); syncEdgeControl(); applyCanvasShape();
}

/* ---------- review ---------- */
function renderReview(){
  const each = perHat();
  const rows = [
    ["Hat", state.style ? nameOf(state.style) + " (" + state.style.brand + ")" : "-"],
    ["Colors", colorSummary()],
    ["Sizing", state.style ? sizingOf(state.style) : "-"],
    ["Quantity", state.qty || "-"],
    ["Proof sent by", ($("proofMethod") && $("proofMethod").value)
      ? ($("proofMethod").value === "Text message" && $("proofPhone") && $("proofPhone").value.trim()
          ? "Text to " + $("proofPhone").value.trim() : $("proofMethod").value)
      : "-"],
    ["Patch material", state.material.name],
    ["Patch shape", state.shape.label],
    ["Placement", state.placement.label],
    ["Edge finish", edgeLabel()],
    ["Patch size", state.sizeChosen ? (state.size.label + " (" + sizeDimLabel(state.size, state.shape) + ")") : "-"],
    ["Price per hat", each ? money(each) : "-"],
    ["Order total", each && state.qty ? money(each * state.qty) : "-"]
  ];
  $("review").innerHTML = rows.map(r =>
    '<div class="rev-line"><span>' + r[0] + '</span><strong>' + r[1] + '</strong></div>').join("");
}

/* ---------- step machinery ---------- */
function canLeave(step){
  if (step === 1) return !!state.style && state.colors.length > 0;
  if (step === 2){
    if (!state.qty || state.qty < 5) return false;
    if (state.colors.length > 1){
      const t = Object.values(state.split).reduce((a,b) => a + (+b || 0), 0);
      return t === state.qty;
    }
    return true;
  }
  if (step === 3){
    if (!state.sizeChosen) return false;
    const m = $("proofMethod") ? $("proofMethod").value : "";
    if (!m) return false;
    if (m === "Text message"){
      const p = $("proofPhone") ? $("proofPhone").value.replace(/\D/g, "") : "";
      if (p.length < 10) return false;
    }
    return true;
  }
  return true;
}
function goto(step){
  state.step = step;
  if (step > state.maxStep) state.maxStep = step;
  if (step === 1) renderHats();
  if (step === 2) renderSplit();
  if (step === 3) renderPatchDesign();
  document.querySelectorAll("#tbpo .tbstep").forEach(sec => {
    sec.classList.toggle("active", +sec.dataset.step === step);
  });
  if (step === 4) renderReview();
  renderRail();
  requestAnimationFrame(() => {
    const sec = document.querySelector('#tbpo .tbstep.active');
    if (sec) easeScrollToEl(sec, 800);
  });
  sync();
}
function renderRail(){
  const narrow = window.matchMedia("(max-width: 640px)").matches;
  const names = narrow
    ? ["Hat", "Qty", "Design", "Review"]
    : ["Hat & colors", "Quantity", "Patch design", "Review"];
  $("rail").innerHTML = names.map((n, i) => {
    const step = i + 1;
    const cls = state.step === step ? "active" : (state.done.has(step) ? "done" : "");
    const mark = (state.done.has(step) && state.step !== step) ? "&#10003;" : step;
    return '<div class="rail-item ' + cls + '" data-goto="' + step + '"><span class="dot">' + mark + '</span>' + n + '</div>';
  }).join("");
  $("rail").querySelectorAll("[data-goto]").forEach(el => {
    const t = +el.dataset.goto;
    const reachable = t <= state.maxStep || (t === state.step + 1 && canLeave(state.step));
    el.style.opacity = reachable ? "1" : ".45";
    el.style.cursor = reachable ? "pointer" : "not-allowed";
    el.addEventListener("click", () => {
      if (!reachable) return;
      if (t > state.step){ state.done.add(state.step); if (state.colors.length > 1) evenSplit(); renderSplit(); }
      goto(t);
    });
  });
}

/* ---------- summaries + sticky bar ---------- */
function sync(){
  $("sum1").innerHTML = state.style
    ? nameOf(state.style) + (state.colors.length ? " &middot; " + (state.colors.length === 1 ? state.colors[0] : state.colors.length + " colors") : "")
    : "";
  $("sum2").textContent = state.qty ? state.qty + " hats" : "";
  $("sum3").innerHTML = state.material.name + " &middot; " + state.shape.label + " &middot; " + state.placement.label + (effectiveEdge() !== "none" ? " &middot; " + edgeLabel() : "") + (state.sizeChosen ? " &middot; " + state.size.label : "");
  $("sum4").textContent = "";

  $("next1").disabled = !canLeave(1);
  $("next2").disabled = !canLeave(2);
  if ($("next3")) $("next3").disabled = !canLeave(3);

  const each = perHat();
  const pn = $("priceNow");
  if (pn){
    pn.style.display = (each && state.qty) ? "flex" : "none";
    if (each && state.qty){
      pn.innerHTML =
        '<div class="pn"><span class="pn-l">Price per hat</span><span class="pn-v">' + money(each) + '</span></div>' +
        '<div class="pn"><span class="pn-l">' + state.qty + ' hats</span><span class="pn-v">' + money(each * state.qty) + '</span></div>' +
        '<div class="pn-note">' + (state.sizeChosen ? 'Includes the ' + state.size.label.toLowerCase() : 'Based on the small') + ' leatherette patch, laser engraved in black, and free shipping to the lower 48.</div>';
    }
  }
  const nt = nextTier();
  $("nudge").innerHTML = (nt && state.qty)
    ? '<div class="tier-nudge">Add ' + (nt[0] - state.qty) + ' more and your price drops to ' + money(nt[1] + state.size.add) + '/hat.</div>'
    : "";

  $("barQty").textContent = state.qty || 0;
  $("barEach").textContent = each ? money(each) : "-";
  $("barTotal").textContent = each && state.qty ? money(each * state.qty) : "-";
  $("bar").classList.toggle("show", !!state.style);
  $("barCta").textContent = state.step === 4 ? "Add to Cart" : "Continue";
  $("barCta").disabled = state.step < 4 && !canLeave(state.step);
}

/* ---------- Apps Script + cart plumbing ---------- */
function fileToB64(file){
  return new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(r.result.split(",")[1]);
    r.onerror = () => rej(new Error("read failed"));
    r.readAsDataURL(file);
  });
}
function orderMeta(){
  const per = perHat();
  return {
    name: "", email: "", phone: "",
    style: state.style ? state.style.name : "",
    color: colorSummary(),
    qty: state.qty,
    sizing: state.style ? sizingOf(state.style) : "",
    material: state.material.name,
    shape: state.shape.label,
    placement: state.placement.label,
    edge: edgeLabel(),
    patchSize: state.sizeChosen ? (state.size.label + " (" + sizeDimLabel(state.size, state.shape) + ")") : "",
    notes: ($("notes") && $("notes").value.trim()) || "-",
    proof: ($("proofMethod") && $("proofMethod").value) || "",
    proofPhone: ($("proofPhone") && $("proofPhone").value.trim()) || "",
    social: ($("noSocial") && $("noSocial").checked) ? "Do NOT share on social" : "OK to share on social",
    estimate: per === null ? "quote" : money(per) + "/hat, " + money(per * state.qty) + " total",
    // production detail: everything needed to rebuild this patch exactly
    colorSplit: state.colors.length > 1 ? JSON.stringify(state.split) : "",
    patchSizeLabel: state.sizeChosen ? state.size.label : "Small (default)",
    patchDims: state.size ? sizeDimLabel(state.size, state.shape) : "",
    sizeUpcharge: state.size ? money(state.size.add) + "/hat" : "",
    perHat: per === null ? "" : money(per),
    orderTotal: (per === null || !state.qty) ? "" : money(per * state.qty),
    tierPrice: (function(){ const t = tierFor(state.style, state.qty); return t ? money(t[1]) : ""; })(),
    hatVariantId: (function(){ const t = tierFor(state.style, state.qty); return t ? String(t[2]) : ""; })(),
    sizeVariantId: state.size ? String(state.size.variantId) : "",
    threshold: String(state.threshold),
    invert: state.invert ? "Yes" : "No",
    logoScale: Math.round((state.logoScale || 1) * 100) + "%",
    logoOffset: Math.round((state.logoX || 0) * 100) + "%, " + Math.round((state.logoY || 0) * 100) + "%",
    logoFileName: state.logoFile ? state.logoFile.name : "",
    hasMockup: "",
    submittedAt: new Date().toISOString(),
    pageUrl: (typeof window !== "undefined" && window.location) ? window.location.href : ""
  };
}
function scriptConfigured(){ return APPS_SCRIPT_URL && APPS_SCRIPT_URL.indexOf("PASTE") !== 0; }

// Snapshot of exactly what the customer saw when they hit Add to Cart. Can throw
// if the material photo tainted the canvas, so it degrades to "no mockup".
function mockupB64(){
  const canvas = $("patchCanvas");
  if (!canvas || !state.logoImage) return null;
  try {
    const url = canvas.toDataURL("image/png");
    if (!url || url.indexOf(",") < 0) return null;
    return url.split(",")[1];
  } catch(e){ return null; }
}
async function sendToDrive(type){
  if (!scriptConfigured()) return { ok:false, skipped:true, uploaded:[] };
  const uploaded = [], files = [];
  if (state.logoFile){
    files.push({ kind: "artwork", placement: state.placement.label, name: state.logoFile.name, mimeType: state.logoFile.type || "application/octet-stream", data: await fileToB64(state.logoFile) });
    uploaded.push(state.placement.label);
  }
  const shot = mockupB64();
  if (shot){
    files.push({ kind: "mockup", placement: state.placement.label, name: "mockup-preview.png", mimeType: "image/png", data: shot });
    uploaded.push("mockup");
  }
  const meta = orderMeta();
  meta.hasMockup = shot ? "Yes" : "No";
  const body = JSON.stringify({ type: type, meta: meta, files: files });

  const box = $("uploadProgress"), fill = $("upFill"), label = $("upLabel");
  const hasLogo = files.length > 0;
  const workingText = hasLogo ? "Sending your logo..." : "Submitting...";
  const doneText = hasLogo ? "Logo sent" : "Submitted";
  if (box) box.style.display = "block";
  if (label) label.textContent = workingText;
  let simPct = 8;
  if (fill) fill.style.width = simPct + "%";
  const simTimer = setInterval(() => {
    if (simPct < 90){ simPct += Math.max(1, (90 - simPct) * 0.08); if (fill) fill.style.width = simPct + "%"; }
  }, 200);

  return new Promise(resolve => {
    const finish = result => {
      clearInterval(simTimer);
      if (fill) fill.style.width = "100%";
      if (label) label.textContent = doneText;
      setTimeout(() => resolve(result), 300);
    };
    fetch(APPS_SCRIPT_URL, {
      method: "POST",
      mode: "no-cors",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: body
    })
    .then(() => finish({ ok:true, uploaded:uploaded }))
    .catch(() => { clearInterval(simTimer); resolve({ ok:false, uploaded:uploaded }); });
  });
}

async function submitCheckout(){
  const btn = $("checkout");
  btn.disabled = true;
  $("cartErr").classList.remove("show");

  let artNote = "Customer will email logo to help@threadbreak.com";
  if (state.logoFile){
    btn.textContent = "Sending logo...";
    const up = await sendToDrive("patch-order-artwork");
    artNote = up.ok ? ("Uploaded (" + up.uploaded.join(", ") + ")") : "ACTION: email customer for logo (upload not received)";
  } else {
    await sendToDrive("patch-order-details");
  }

  btn.textContent = "Adding...";
  const meta = orderMeta();
  const tier = tierFor(state.style, state.qty);
  const props = {
    "Hat Color(s)": meta.color,
    "Sizing": meta.sizing,
    "Decoration": "Leatherette patch (laser engraved, black)",
    "Patch material": meta.material,
    "Patch shape": meta.shape,
    "Placement": meta.placement,
    "Edge finish": meta.edge,
    "Patch size": meta.patchSize,
    "Artwork": artNote,
    "Logo size": meta.logoScale,
    "Logo offset": meta.logoOffset
  };
  props["Proof delivery"] = meta.proof + (meta.proof === "Text message" && meta.proofPhone ? " to " + meta.proofPhone : "");
  if (meta.notes !== "-") props["Notes"] = meta.notes;
  props["Social sharing"] = meta.social;

  const items = [
    { id: tier[2], quantity: state.qty, properties: props },
    { id: state.size.variantId, quantity: state.qty, properties: { "Applies to": state.style.name, "Patch size": state.size.label } }
  ];

  try {
    const res = await fetch("/cart/add.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ items: items })
    });
    if (!res.ok){
      let detail = "";
      try { const j = await res.json(); detail = j.description || j.message || ""; } catch(_) {}
      throw new Error(detail || ("cart add failed (" + res.status + ")"));
    }
    window.location.href = "/checkout";
  } catch (e) {
    btn.disabled = false; btn.textContent = "Add to Cart";
    const box = $("cartErr");
    const msg = (e && e.message) ? e.message : "";
    box.innerHTML = "Something went wrong adding this to your cart. Please try again, or email help@threadbreak.com and we'll sort it out."
      + (msg ? '<br><span style="font-size:12px;opacity:.8">Details: ' + msg + '</span>' : "");
    box.classList.add("show");
    box.scrollIntoView({ behavior:"smooth", block:"center" });
    console.error("[tbpo] cart add failed", e, items);
  }
}

/* ---------- wire up ---------- */
function bindToggle(btnId, panelId, showText, hideText){
  const b = $(btnId), p = $(panelId);
  if (!b || !p) return;
  b.addEventListener("click", () => {
    const hidden = p.hasAttribute("hidden");
    if (hidden){ p.removeAttribute("hidden"); b.textContent = hideText; }
    else { p.setAttribute("hidden",""); b.textContent = showText; }
  });
}

$("qty").addEventListener("input", e => {
  state.qty = +e.target.value || null;
  if (state.colors.length > 1) evenSplit();
  renderSplit(); sync();
});
$("next1").addEventListener("click", () => { state.done.add(1); if (state.colors.length > 1) evenSplit(); renderSplit(); goto(2); });
$("next2").addEventListener("click", () => { state.done.add(2); goto(3); });
$("next3").addEventListener("click", () => { state.done.add(3); goto(4); });
$("checkout").addEventListener("click", submitCheckout);
$("barCta").addEventListener("click", () => {
  if (state.step === 4){ submitCheckout(); return; }
  if (!canLeave(state.step)) return;
  state.done.add(state.step);
  if (state.step === 1 && state.colors.length > 1){ evenSplit(); renderSplit(); }
  goto(Math.min(state.step + 1, 4));
});
document.querySelectorAll("#tbpo [data-back]").forEach(b => {
  b.addEventListener("click", () => {
    const t = +b.dataset.back;
    goto(t);
  });
});

$("logoInput").addEventListener("change", e => {
  const file = e.target.files && e.target.files[0];
  const slot = $("logoSlot"), have = $("logoHave");
  if (!file){
    state.logoFile = null; state.logoImage = null;
    if (slot) slot.classList.remove("has-file");
    if (have){ have.hidden = true; have.textContent = ""; }
    renderPatchPreview();
    return;
  }
  if (file.size > 10 * 1024 * 1024){
    alert("That file is over 10 MB. Please send a smaller file or email it to help@threadbreak.com.");
    e.target.value = ""; return;
  }
  state.logoFile = file;
  // new artwork starts centered at full size
  state.logoScale = 1; state.logoX = 0; state.logoY = 0;
  if ($("logoScale")) $("logoScale").value = 100;
  if (slot) slot.classList.add("has-file");
  if (have){ have.hidden = false; have.textContent = "Attached: " + file.name; }

  if (/^image\/(png|jpe?g|webp|gif|svg\+xml)$/i.test(file.type) || /\.(png|jpe?g|webp|gif|svg)$/i.test(file.name)){
    const reader = new FileReader();
    reader.onload = ev => {
      const img = new Image();
      img.onload = () => { state.logoImage = img; renderPatchPreview(); };
      img.onerror = () => { state.logoImage = null; renderPatchPreview(); };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  } else {
    state.logoImage = null;
    renderPatchPreview();
  }
});
$("threshold").addEventListener("input", e => { state.threshold = +e.target.value; renderPatchPreview(); });
$("invertToggle").addEventListener("change", e => { state.invert = e.target.checked; renderPatchPreview(); });
$("edgeSel").addEventListener("change", e => { state.edge = e.target.value; renderPatchPreview(); sync(); });
$("logoScale").addEventListener("input", e => { state.logoScale = +e.target.value / 100; renderPatchPreview(); });
$("resetLogo").addEventListener("click", () => {
  state.logoScale = 1; state.logoX = 0; state.logoY = 0;
  $("logoScale").value = 100;
  renderPatchPreview();
});
// Drag the artwork around inside the patch. Offsets are stored as a fraction of
// the canvas so they survive the canvas resizing when the shape changes.
(function enableLogoDrag(){
  const box = $("patchCanvasBox");
  if (!box) return;
  let drag = null;
  box.addEventListener("pointerdown", e => {
    if (!state.logoImage) return;
    const r = box.getBoundingClientRect();
    drag = { px: e.clientX, py: e.clientY, ox: state.logoX, oy: state.logoY, w: r.width, h: r.height };
    box.classList.add("dragging");
    box.setPointerCapture(e.pointerId);
  });
  box.addEventListener("pointermove", e => {
    if (!drag) return;
    state.logoX = Math.max(-0.45, Math.min(0.45, drag.ox + (e.clientX - drag.px) / drag.w));
    state.logoY = Math.max(-0.45, Math.min(0.45, drag.oy + (e.clientY - drag.py) / drag.h));
    renderPatchPreview();
  });
  const end = e => {
    if (!drag) return;
    drag = null;
    box.classList.remove("dragging");
    try { box.releasePointerCapture(e.pointerId); } catch(_){}
  };
  box.addEventListener("pointerup", end);
  box.addEventListener("pointercancel", end);
})();

// Texting a proof needs a mobile number, and Shopify's checkout phone field is
// optional, so collect it here when they pick text.
(function(){
  const sel = $("proofMethod"), wrap = $("proofPhoneWrap"), hint = $("proofHint");
  if (!sel) return;
  sel.addEventListener("change", () => {
    const isText = sel.value === "Text message";
    if (wrap){ if (isText) wrap.removeAttribute("hidden"); else { wrap.setAttribute("hidden",""); if ($("proofPhone")) $("proofPhone").value = ""; } }
    if (hint) hint.textContent = isText
      ? "We'll text your mockup from (336) 585-6176 within one business day. Nothing gets engraved until you approve it."
      : "We'll email your mockup from help@threadbreak.com within one business day. Nothing gets engraved until you approve it.";
    sync();
  });
  if ($("proofPhone")) $("proofPhone").addEventListener("input", sync);
})();

bindToggle("engraveBtn","engraveInfo","How does engraving work?","Hide");

renderHats();
preloadMaterials();
renderPatchDesign();
renderRail();
sync();
})();

</script>
