  #tbpo .bar-stat .v{font-family:'Bebas Neue',sans-serif;font-size:22px;line-height:1.1}
  #tbpo .bar-cta{margin-left:auto;background:var(--purple);color:#fff;border:none;border-radius:10px;padding:11px 22px;font-family:'Bebas Neue',sans-serif;font-size:17px;letter-spacing:.04em;cursor:pointer}
  #tbpo .bar-cta:hover{background:var(--purple2)}
  #tbpo .bar-cta:disabled{opacity:.45;cursor:not-allowed}
  @media(max-width:640px){
