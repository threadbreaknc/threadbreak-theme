  <div class="bar-in">
    <div class="bar-stat"><div class="l">Qty</div><div class="v" id="barQty">0</div></div>
    <div class="bar-stat bar-hide-sm"><div class="l">Per hat</div><div class="v" id="barEach">-</div></div>
    <div class="bar-stat"><div class="l">Total</div><div class="v" id="barTotal">-</div></div>
    <button type="button" class="bar-cta" id="barCta">Continue</button>
