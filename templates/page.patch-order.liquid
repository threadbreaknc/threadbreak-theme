{%- comment -%} build: patch-v1 {%- endcomment -%}
{%- comment -%}
  Custom Patch Hats order page. Four-step wizard mirroring page.custom-order.liquid,
  namespaced #tbpo. Reuses the same STYLES data (hat blanks + qty tiers) as the
  embroidery form; the decoration is always a laser-engraved leatherette patch
  instead of embroidery. Cart add = hat tier variant + patch-size add-on variant,
  both at order quantity. Sizes live on the "Custom Hat Add-On (per hat)" product.
{%- endcomment -%}
<div id="tbpo">
<style>
  #tbpo{position:relative;z-index:1;padding-top:6rem;max-width:100%;overflow-x:clip;font-family:'DM Sans',sans-serif;
    --purple:#5028AA;--purple2:#6234c9;--purple-dark:#3D1E85;--ink:#14121C;--ice:#F3EFFC;--white:#fff;--line:#E2E0EA;--muted:#6B6A78;--good:#1E9E5A;color:var(--ink)}
  #tbpo *{box-sizing:border-box;margin:0;padding:0}
  #tbpo .wrap{max-width:880px;margin:0 auto;padding:0 20px}
  #tbpo .form-wrap{max-width:1180px;margin:0 auto;padding:0 20px}
  #tbpo .bar-in{max-width:1180px}
  #tbpo header{position:relative;overflow:hidden;background:var(--ink);color:var(--white);padding:44px 0 20px}
  #tbpo .hero-photos{position:absolute;inset:0;display:flex;z-index:0;opacity:.5}
  #tbpo .hero-photos div{flex:1;background-size:cover;background-position:center;min-width:0}
  #tbpo .hero-photos div:not(:first-child){-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%);mask-image:linear-gradient(90deg,transparent,#000 12%);margin-left:-6%}
  #tbpo header::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,var(--ink) 0%,rgba(20,18,28,.7) 42%,rgba(20,18,28,.32) 100%)}
  #tbpo header .wrap{position:relative;z-index:2}
  @media(max-width:640px){
    #tbpo header::after{background:linear-gradient(180deg,rgba(20,18,28,.72),rgba(20,18,28,.9))}
    /* Phone: drop the hat shot and run the patch photo across the whole banner,
       zoomed in so the patches themselves are readable. Banner height unchanged. */
    #tbpo .hero-photos div:first-child,
    #tbpo .hero-photos div:nth-child(n+3){display:none}
    #tbpo .hero-photos div:nth-child(2){flex:1 1 100%;margin-left:0;-webkit-mask-image:none;mask-image:none;background-size:auto 165%;background-position:center 45%}
  }
  #tbpo h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(36px,6vw,58px);line-height:.95;letter-spacing:.01em;margin:0 0 10px}
  #tbpo h1 em{font-style:normal;color:#7F5FD8}
  #tbpo .sub{font-size:15px;line-height:1.55;color:#D9D6E4;max-width:560px}
  #tbpo .props{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:12px;margin-bottom:0}
  #tbpo .props span{font-size:13px;font-weight:500;color:#EDEAF7}
  #tbpo .props span::before{content:"\2713";color:#7F5FD8;font-weight:700;margin-right:7px}
  #tbpo .tbco-textus{display:flex;align-items:center;justify-content:center;gap:10px;text-align:center;margin:40px 0 22px;padding:15px 22px;background:var(--purple);border:1.5px solid var(--purple);border-radius:12px;text-decoration:none;color:#fff;font-size:14.5px}
  #tbpo .tbco-textus-icon{display:inline-flex;color:#fff;flex:none}
  #tbpo .tbco-textus strong{color:#fff;font-weight:700;white-space:nowrap}

  /* progress rail */
  #tbpo .rail{display:flex;gap:6px;margin:20px 0 18px;flex-wrap:wrap;position:sticky;top:74px;z-index:50;
    background:rgba(255,255,255,.97);backdrop-filter:blur(6px);padding:12px;border-radius:12px;
    box-shadow:0 6px 18px rgba(20,18,28,.10);border:1px solid var(--line)}
  @media(max-width:640px){#tbpo .rail{gap:5px;padding:8px;margin:20px 0 16px;top:64px}}
  #tbpo .rail-item{flex:1 1 0;min-width:120px;display:flex;align-items:center;gap:9px;padding:11px 13px;border-radius:11px;background:#fff;border:1.5px solid var(--line);font-size:13.5px;font-weight:600;color:var(--muted);cursor:pointer;transition:.18s}
  #tbpo .rail-item .dot{width:22px;height:22px;border-radius:50%;background:var(--line);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;flex:0 0 auto}
  #tbpo .rail-item.done{border-color:#B7A6EE;color:var(--ink)}
  #tbpo .rail-item.done .dot{background:var(--good)}
  #tbpo .rail-item.active{border-color:var(--purple);color:var(--purple);box-shadow:0 4px 14px rgba(80,40,170,.12)}
  #tbpo .rail-item.active .dot{background:var(--purple)}
  @media(max-width:640px){
    #tbpo .rail{gap:4px;padding:7px}
    #tbpo .rail-item{min-width:0;flex:1 1 0;padding:7px 3px;font-size:10.5px;gap:4px;
      flex-direction:column;justify-content:center;text-align:center;line-height:1.2;border-radius:9px}
    #tbpo .rail-item .dot{width:18px;height:18px;font-size:10.5px}
  }
  @media(max-width:360px){#tbpo .rail-item{font-size:9.5px;padding:6px 2px}}

  /* steps */
  #tbpo .tbstep{background:#fff;border:1.5px solid var(--line);border-radius:16px;margin-bottom:14px;display:none;opacity:1;transform:none;text-align:left;padding:0;scroll-margin-top:150px}
  #tbpo .tbstep.active{display:block;opacity:1;transform:none;border-color:var(--purple);box-shadow:0 6px 22px rgba(80,40,170,.10)}
  #tbpo .tbstep::after{content:none}
  #tbpo .tbstep-head{display:flex;align-items:center;gap:13px;padding:20px 22px}
  #tbpo .tbstep-num{width:28px;height:28px;border-radius:50%;background:var(--ice);color:var(--purple);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex:0 0 auto}
  #tbpo .tbstep-head h2{font-family:'Bebas Neue',sans-serif;font-size:23px;letter-spacing:.02em;flex:1}
  #tbpo .tbstep-sum{font-size:13px;color:var(--muted);text-align:right;max-width:45%}
  #tbpo .tbstep-body{padding:0 22px 22px}
  #tbpo .tbstep-hint{font-size:13.5px;color:var(--muted);margin-bottom:16px;line-height:1.55}
  #tbpo .tbstep-hint strong{color:var(--ink)}

  /* hat grid (identical to embroidery form) */
  #tbpo .hats{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:13px}
  #tbpo .hats.picking{grid-template-columns:1fr}
  #tbpo .hat{border:1.5px solid var(--line);border-radius:13px;background:#fff;cursor:pointer;overflow:hidden;transition:.2s;position:relative;scroll-margin-top:150px}
  #tbpo .hat:hover{border-color:#B7A6EE;transform:translateY(-2px)}
  #tbpo .hat.on{border-color:var(--purple);box-shadow:0 6px 22px rgba(80,40,170,.18);overflow:visible;z-index:5}
  #tbpo .hats.picking .hat{display:none}
  #tbpo .hats.picking .hat.on{display:grid;cursor:default}
  #tbpo .hats.picking .hat.on:hover{transform:none}
  #tbpo .hat-img{width:100%;aspect-ratio:1/1;object-fit:contain;background:#fff;display:block}
  #tbpo .hat-imgwrap{position:relative}
  #tbpo .hat-logo{position:absolute;bottom:8px;right:8px;height:30px;width:auto;max-width:112px;object-fit:contain;opacity:.95;
    background:rgba(255,255,255,.94);border-radius:6px;padding:4px 8px;box-shadow:0 1px 5px rgba(20,18,28,.14)}
  #tbpo .hat-name-sm{display:none;font-weight:700;font-size:13px;line-height:1.25}
  #tbpo .hat-titlerow{display:flex;align-items:flex-start;gap:12px}
  #tbpo .hat-logo-lg{height:52px;width:auto;max-width:170px;object-fit:contain;flex:0 0 auto;margin-top:0}
  #tbpo .hat-heroimg{width:100%;max-width:250px}
  #tbpo .hat-heroimg .hat-img{width:100%;max-width:250px;height:auto}
  #tbpo .hat-herocap{text-align:center;font-size:12px;font-weight:600;color:var(--purple);background:var(--ice);border-radius:8px;padding:5px 8px;margin-top:6px}
  #tbpo .pchip{cursor:pointer}
  #tbpo .pchip.on{border-color:var(--purple);background:var(--ice);box-shadow:0 0 0 2px rgba(80,40,170,.14)}
  #tbpo .hat-info{padding:12px 14px 14px}
  #tbpo .hat-name{font-weight:700;font-size:14.5px;line-height:1.25}
  #tbpo .hat-brand{font-size:11.5px;color:var(--muted);margin-top:2px}
  #tbpo .hat-price{margin-top:7px;font-size:13px;font-weight:700;color:var(--purple)}
  #tbpo .hat-colors{display:flex;align-items:center;gap:7px;margin-top:8px;font-size:12px;color:var(--muted)}
  #tbpo .wheel{width:18px;height:18px;border-radius:50%;flex:0 0 auto;border:1px solid rgba(0,0,0,.12);background:conic-gradient(#e23b3b,#e2a13b,#d7e23b,#4ce23b,#3be2c0,#3b8fe2,#7a3be2,#e23bc0,#e23b3b)}
  #tbpo .hat-badge{position:absolute;top:9px;left:9px;background:var(--purple);color:#fff;font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:3px 8px;border-radius:999px;z-index:2}
  #tbpo .hat.on{display:grid;grid-template-columns:250px minmax(0,1fr);gap:0 26px;padding:18px;align-items:start}
  #tbpo .hat.on .hat-heroimg{grid-column:1;grid-row:1 / span 2;position:sticky;top:168px}
  #tbpo .hat.on .hat-info{grid-column:2;grid-row:1;padding:0}
  #tbpo .hat.on .hat-expand{grid-column:2;grid-row:2;border-top:none;margin-top:0;padding:0}
  #tbpo .hat.on .colorpanel{margin-top:16px}
  @media(max-width:900px){
    #tbpo .hat.on,#tbpo .hats.picking .hat.on{grid-template-columns:1fr;padding:14px}
    #tbpo .hat.on .hat-heroimg{grid-column:1;grid-row:1;position:static;max-width:260px;margin:0 auto}
    #tbpo .hat.on .hat-info{grid-column:1;grid-row:2;padding-top:14px}
    #tbpo .hat.on .hat-expand{grid-column:1;grid-row:3}
  }
  @media(max-width:560px){
    #tbpo .hat.on,#tbpo .hats.picking .hat.on{display:block;padding:0}
    #tbpo .hat.on .hat-heroimg{position:static;width:100%;max-width:none}
    #tbpo .hat.on .hat-img{width:100%}
    #tbpo .hat.on .hat-info{padding:12px 14px 0}
    #tbpo .hat.on .hat-expand{padding:0 14px 16px}
    #tbpo .hats{grid-template-columns:1fr 1fr;gap:10px}
    #tbpo .hat-info{padding:10px 11px 12px}
    #tbpo .hat-name{display:none}
    #tbpo .hat-name-sm{display:block}
    #tbpo .hat-logo{height:22px;max-width:82px;bottom:6px;right:6px;padding:3px 6px}
    #tbpo .hat.on .hat-name{display:block;font-size:17px}
    #tbpo .hat.on .hat-name-sm{display:none}
    #tbpo .hat-heroimg{width:100%;max-width:250px}
    #tbpo .hat-logo-lg{height:40px;max-width:130px}
    #tbpo .hat-brand{font-size:10.5px}
    #tbpo .hat-price{font-size:12px;margin-top:5px}
    #tbpo .hat-colors{font-size:11px;margin-top:6px}
    #tbpo .hat-badge{font-size:9.5px;padding:2px 6px;top:6px;left:6px}
  }
  #tbpo .hat-change{display:inline-flex;align-items:center;gap:7px;background:#fff;border:2px solid var(--purple);border-radius:10px;padding:10px 18px;font-family:inherit;font-size:14px;font-weight:600;color:var(--purple);cursor:pointer;margin-top:14px;transition:.16s}
  #tbpo .hat-change:hover{background:var(--purple);color:#fff}
  #tbpo .hat-specs{margin-top:10px;font-size:12.5px;color:var(--muted);line-height:1.6}
  #tbpo .hat-specs b{color:var(--ink);font-weight:600}
  #tbpo .hat-expand{padding:0 16px 18px;border-top:1px solid var(--line);margin-top:4px}

  /* color dropdown */
  #tbpo .colorpanel{margin-top:16px;border-radius:12px;background:var(--ice);padding:16px;position:relative;z-index:6}
  #tbpo .colorpanel h3{font-size:15px;margin-bottom:4px}
  #tbpo .cp-sub{font-size:12.5px;color:var(--muted);margin-bottom:13px}
  #tbpo .dd{position:relative;max-width:420px}
  #tbpo .dd-btn{width:100%;display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fff;border:1.5px solid var(--line);border-radius:11px;padding:11px 13px;font-family:inherit;font-size:14px;cursor:pointer;text-align:left;color:var(--ink)}
  #tbpo .dd-btn:hover{border-color:#B7A6EE}
  #tbpo .dd-btn .chev{transition:transform .18s;flex:0 0 auto}
  #tbpo .dd.open .dd-btn .chev{transform:rotate(180deg)}
  #tbpo .dd-menu{display:none;position:absolute;z-index:40;top:calc(100% + 6px);left:0;right:0;max-height:290px;overflow-y:auto;background:#fff;border:1.5px solid var(--line);border-radius:12px;box-shadow:0 14px 34px rgba(20,18,28,.16);scrollbar-width:thin}
  #tbpo .dd.open .dd-menu{display:block}
  #tbpo .dd-menu::-webkit-scrollbar{width:9px}
  #tbpo .dd-menu::-webkit-scrollbar-thumb{background:#B7A6EE;border-radius:9px;border:2px solid #fff}
  #tbpo .dd-more{display:none;position:absolute;left:1px;right:1px;bottom:1px;z-index:41;pointer-events:none;height:44px;border-radius:0 0 11px 11px;background:linear-gradient(180deg,rgba(255,255,255,0),#fff 72%);align-items:flex-end;justify-content:center;padding-bottom:6px}
  #tbpo .dd.open .dd-more.on{display:flex}
  #tbpo .dd-more span{font-size:11px;font-weight:700;color:var(--purple);display:flex;align-items:center;gap:5px}
  #tbpo .dd-opt{display:flex;align-items:center;gap:11px;padding:9px 12px;cursor:pointer;font-size:13.5px;border-bottom:1px solid #f2f1f6}
  #tbpo .dd-opt:last-child{border-bottom:none}
  #tbpo .dd-opt:hover{background:var(--ice)}
  #tbpo .dd-opt img{width:42px;height:42px;object-fit:contain;border-radius:7px;background:#fff;border:1px solid var(--line);flex:0 0 auto}
  #tbpo .dd-opt.picked{background:#eee9fb}
  #tbpo .dd-opt .tick{margin-left:auto;color:var(--purple);font-weight:700}
  #tbpo .picked-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}
  #tbpo .pchip{display:flex;align-items:center;gap:8px;background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:6px 9px;font-size:13px}
  #tbpo .pchip img{width:32px;height:32px;object-fit:contain;border-radius:6px}
  #tbpo .pchip button{background:none;border:none;cursor:pointer;color:var(--muted);font-size:16px;line-height:1;padding:0 2px}
  #tbpo .pchip button:hover{color:#c33}

  /* fields */
  #tbpo .qty-row{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap}
  #tbpo .field{display:flex;flex-direction:column;gap:6px}
  #tbpo [hidden]{display:none !important}
  #tbpo .field label{font-size:13px;font-weight:600}
  #tbpo .field input,#tbpo .field select,#tbpo .field textarea{font-family:inherit;font-size:16px;padding:10px 12px;border:1.5px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}
  #tbpo .field input:focus,#tbpo .field textarea:focus{outline:none;border-color:var(--purple)}
  #tbpo .qty-input{width:130px}
  #tbpo .price-now{display:flex;gap:26px;flex-wrap:wrap;background:var(--ink);color:#fff;border-radius:12px;padding:14px 18px;margin-top:16px}
  #tbpo .price-now .pn{display:flex;flex-direction:column}
  #tbpo .price-now .pn-l{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.55)}
  #tbpo .price-now .pn-v{font-family:'Bebas Neue',sans-serif;font-size:26px;line-height:1.15}
  #tbpo .price-now .pn-note{margin-left:auto;align-self:center;font-size:12px;color:rgba(255,255,255,.65);max-width:220px;line-height:1.5}
  @media(max-width:520px){#tbpo .price-now .pn-note{margin-left:0;flex:1 1 100%;max-width:none;margin-top:6px}}
  #tbpo .tier-nudge{font-size:13px;color:var(--purple);font-weight:600;background:var(--ice);border-radius:9px;padding:9px 12px;margin-top:13px}
  #tbpo .split{margin-top:18px;border:1.5px solid var(--line);border-radius:12px;overflow:hidden}
  #tbpo .split-head{background:var(--ice);padding:11px 14px;font-size:13px;font-weight:700}
  #tbpo .split-row{display:flex;align-items:center;gap:12px;padding:10px 14px;border-top:1px solid var(--line)}
  #tbpo .split-row img{width:38px;height:38px;object-fit:contain;border-radius:7px;border:1px solid var(--line)}
  #tbpo .split-row .nm{flex:1;font-size:13.5px}
  #tbpo .split-row input{width:88px;font-family:inherit;font-size:16px;padding:8px 10px;border:1.5px solid var(--line);border-radius:9px}
  #tbpo .split-total{display:flex;justify-content:space-between;padding:11px 14px;border-top:1.5px solid var(--line);font-size:13.5px;font-weight:700;background:#fafafa}
  #tbpo .split-total.bad{color:#c33}

  /* chips */
  #tbpo .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
  #tbpo .chip{background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:9px 14px;font-family:inherit;font-size:13.5px;cursor:pointer;transition:.15s;color:var(--ink)}
  #tbpo .chip:hover{border-color:#B7A6EE}
  #tbpo .chip.on{border-color:var(--purple);background:var(--ice);color:var(--purple);font-weight:600}
  #tbpo .chip .tag{font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:var(--purple);color:#fff;border-radius:999px;padding:2px 8px;margin-left:7px;display:inline-block;vertical-align:1px}
  #tbpo .chip .tag.inc{background:var(--good)}
  #tbpo .size-dim{font-weight:400;color:var(--muted);font-size:12px;margin-left:4px}

  /* materials */
  #tbpo .matgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;margin-top:8px}
  /* All seven materials on a single row once there's room for them. */
  @media(min-width:900px){
    #tbpo .matgrid{grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}
    #tbpo .mat-chip{padding:7px}
    #tbpo .mat-name{font-size:11px}
  }
  #tbpo .mat-chip{display:flex;flex-direction:column;align-items:center;gap:6px;background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:10px;cursor:pointer;font-family:inherit;transition:.15s}
  #tbpo .mat-chip:hover{border-color:#B7A6EE}
  #tbpo .mat-chip.on{border-color:var(--purple);background:var(--ice);box-shadow:0 0 0 2px rgba(80,40,170,.14)}
  #tbpo .mat-swatch{width:100%;aspect-ratio:1/1;border-radius:9px;background-size:cover;background-position:center;border:1px solid var(--line)}
  #tbpo .mat-name{font-size:12.5px;font-weight:600;text-align:center;line-height:1.25}

  /* canvas preview */
  #tbpo .patch-preview{display:flex;flex-direction:column;align-items:center;gap:14px;margin-top:14px;background:var(--ice);border-radius:14px;padding:20px}
  /* Fixed display size regardless of S/M/L — only the shape changes the box's
     proportions; the actual real-world size is communicated via the size-dim
     caption on the chip and in the review, not by scaling this preview. */
  #tbpo .patch-canvas-box{width:100%;max-width:320px;aspect-ratio:1.633/1;border-radius:14px;overflow:hidden;background:#fff;border:1.5px solid var(--line);box-shadow:0 6px 18px rgba(20,18,28,.08);transition:aspect-ratio .25s ease}
  #tbpo .patch-canvas-box canvas{width:100%;height:100%;display:block}
  #tbpo .patch-controls{width:100%;max-width:380px;display:flex;flex-direction:column;gap:10px}
  #tbpo .size-hint{font-size:12.5px;color:var(--purple);background:var(--ice);border-radius:9px;padding:9px 12px;margin-top:9px;line-height:1.5}
  #tbpo .patch-controls input[type=range]{width:100%;accent-color:var(--purple)}
  #tbpo .patch-invert{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);cursor:pointer}
  #tbpo .patch-invert input{width:16px;height:16px;accent-color:var(--purple);cursor:pointer}
  #tbpo .patch-preview .hint{max-width:380px;text-align:center}
  #tbpo .patch-preview .fld-tight{margin:2px 0 0;align-self:stretch}
  #tbpo .ctl-note{font-weight:400;font-size:11.5px;color:var(--muted);margin-left:6px}
  #tbpo .ctl-reset{align-self:flex-start;background:none;border:1px solid var(--line);border-radius:8px;padding:6px 11px;font:inherit;font-size:12.5px;color:var(--purple);cursor:pointer}
  #tbpo .ctl-reset:hover{background:#fff}
  #tbpo .field.is-off{opacity:.45}
  #tbpo .field.is-off select{cursor:not-allowed}
  #tbpo .patch-canvas-box{cursor:grab;touch-action:none}
  #tbpo .patch-canvas-box.dragging{cursor:grabbing}
  #tbpo .patch-preview .chips{align-self:stretch;justify-content:center}
  /* Two-column layout: preview on the left, the fields that drive it on the right.
     Mobile stacks with the preview first so the canvas + threshold/invert controls
     are visible without scrolling. */
  #tbpo .patch-layout{display:flex;flex-direction:column;gap:8px}
  #tbpo .patch-layout-preview .patch-preview{margin-top:0}
  #tbpo .patch-layout-fields .fld:first-child{margin-top:14px}
  @media(min-width:900px){
    #tbpo .patch-layout{display:grid;grid-template-columns:minmax(300px,380px) 1fr;gap:26px;align-items:start}
    #tbpo .patch-layout-preview{position:sticky;top:18px}
    #tbpo .patch-layout-fields .fld:first-child{margin-top:0}
