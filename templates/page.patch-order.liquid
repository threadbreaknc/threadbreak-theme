// Drag the artwork around inside the patch. Offsets are stored as a fraction of
// the canvas so they survive the canvas resizing when the shape changes.
(function enableLogoDrag(){
  const box = $("patchCanvasBox");
  if (!box) return;
  let drag = null;
  box.addEventListener("pointerdown", e => {
    if (!state.logoImage) return;
    const r = box.getBoundingClientRect();
    drag = { px: e.clientX, py: e.clientY, ox: state.logoX, oy: state.logoY, w: r.width, h: r.height };
    box.classList.add("dragging");
    box.setPointerCapture(e.pointerId);
  });
  box.addEventListener("pointermove", e => {
    if (!drag) return;
    state.logoX = Math.max(-0.45, Math.min(0.45, drag.ox + (e.clientX - drag.px) / drag.w));
    state.logoY = Math.max(-0.45, Math.min(0.45, drag.oy + (e.clientY - drag.py) / drag.h));
    renderPatchPreview();
  });
  const end = e => {
    if (!drag) return;
    drag = null;
    box.classList.remove("dragging");
    try { box.releasePointerCapture(e.pointerId); } catch(_){}
  };
  box.addEventListener("pointerup", end);
  box.addEventListener("pointercancel", end);
})();

// Texting a proof needs a mobile number, and Shopify's checkout phone field is
// optional, so collect it here when they pick text.
(function(){
  const sel = $("proofMethod"), wrap = $("proofPhoneWrap"), hint = $("proofHint");
  if (!sel) return;
  sel.addEventListener("change", () => {
    const isText = sel.value === "Text message";
    if (wrap){ if (isText) wrap.removeAttribute("hidden"); else { wrap.setAttribute("hidden",""); if ($("proofPhone")) $("proofPhone").value = ""; } }
    if (hint) hint.textContent = isText
      ? "We'll text your mockup from (336) 585-6176 within one business day. Nothing gets engraved until you approve it."
      : "We'll email your mockup from help@threadbreak.com within one business day. Nothing gets engraved until you approve it.";
    sync();
  });
  if ($("proofPhone")) $("proofPhone").addEventListener("input", sync);
})();

bindToggle("engraveBtn","engraveInfo","How does engraving work?","Hide");

renderHats();
preloadMaterials();
renderPatchDesign();
renderRail();
sync();
})();

</script>
<!-- Tap-to-enlarge viewer for the selected hat's photo. Opens in place, never a new tab. -->
<style>
  .hat-heroimg{position:relative}
  .hat-heroimg #hatHero{cursor:zoom-in}
  .hat-views{display:flex;gap:8px;justify-content:center;margin:8px 0 2px}
  .hat-views .hv{display:flex;flex-direction:column;align-items:center;gap:3px;border:1.5px solid #e4e1ee;background:#fff;border-radius:10px;padding:4px 4px 3px;cursor:pointer;font:600 11px/1 inherit;color:#5b5670}
  .hat-views .hv img{width:56px;height:56px;object-fit:contain;display:block}
  .hat-views .hv.on{border-color:#5028AA;color:#5028AA}
  .tblb-hint{position:absolute;top:8px;right:8px;width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.94);
    box-shadow:0 1px 5px rgba(20,18,28,.18);display:flex;align-items:center;justify-content:center;pointer-events:none;color:#4B2BB3}
  .tblb{position:fixed;inset:0;z-index:10000;background:rgba(14,12,22,.86);display:none;align-items:center;justify-content:center;
    padding:56px 16px 72px;-webkit-tap-highlight-color:transparent;touch-action:pan-y}
  .tblb.open{display:flex}
  .tblb-img{max-width:min(92vw,900px);max-height:calc(100vh - 150px);width:auto;height:auto;border-radius:14px;background:#fff;
    box-shadow:0 10px 40px rgba(0,0,0,.4);object-fit:contain;user-select:none;-webkit-user-drag:none}
  .tblb-cap{position:absolute;left:0;right:0;bottom:22px;text-align:center;color:#fff;font-weight:600;font-size:15px;line-height:1.3}
  .tblb-cap small{display:block;font-weight:400;opacity:.7;font-size:12px;margin-top:3px}
  .tblb-btn{position:absolute;border:0;background:rgba(255,255,255,.95);color:#1a1726;width:44px;height:44px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 2px 10px rgba(0,0,0,.25)}
  .tblb-btn:hover{background:#fff}
  .tblb-close{top:14px;right:14px}
  .tblb-prev{left:14px;top:50%;transform:translateY(-50%)}
  .tblb-next{right:14px;top:50%;transform:translateY(-50%)}
  .tblb.single .tblb-prev,.tblb.single .tblb-next{display:none}
  @media(max-width:600px){.tblb-prev{left:6px}.tblb-next{right:6px}.tblb-btn{width:40px;height:40px}}
  body.tblb-lock{overflow:hidden}
</style>
<div class="tblb" id="tblb" role="dialog" aria-modal="true" aria-label="Hat photo" hidden>
  <button type="button" class="tblb-btn tblb-close" aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  <button type="button" class="tblb-btn tblb-prev" aria-label="Previous color"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
  <img class="tblb-img" alt="">
  <button type="button" class="tblb-btn tblb-next" aria-label="Next color"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
  <div class="tblb-cap"></div>
</div>
<script>
(function(){
  "use strict";
  var box = document.getElementById("tblb");
  if (!box || typeof STYLES === "undefined") return;
  document.body.appendChild(box);
  var imgEl = box.querySelector(".tblb-img"), capEl = box.querySelector(".tblb-cap");
  var list = [], i = 0, name = "", lastFocus = null;
  var base = function(u){ return String(u || "").split("?")[0]; };

  // Magnifier badge on the expanded card's photo, re-added whenever the grid re-renders.
  var ICON = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M11 8v6M8 11h6"/></svg>';
  function badge(){
    var h = document.getElementById("hatHero");
    if (h && h.parentNode && !h.parentNode.querySelector(".tblb-hint")){
      var b = document.createElement("span"); b.className = "tblb-hint"; b.innerHTML = ICON; b.setAttribute("aria-hidden","true");
      h.parentNode.appendChild(b);
      h.setAttribute("title","Tap to enlarge");
    }
  }
  // Front / Side / Back thumbnails under the expanded card's photo (S&S hats with colorViews)
  function views(){
    var h = document.getElementById("hatHero"); if (!h) return;
    var wrap = h.parentNode, card = h.closest("[data-hat]");
    var s = card && STYLES.find(function(x){ return x.id === card.dataset.hat; });
    var cap = document.getElementById("hatHeroCap");
    var col = cap ? cap.textContent.trim() : "";
    var vw = viewList(s, col);
    var strip = wrap.querySelector(".hat-views");
    var key = (s ? s.id : "") + "|" + (vw ? col : "");
    if (strip && strip.dataset.key === key) return;
    if (strip) strip.remove();
    if (!vw) return;
    strip = document.createElement("div"); strip.className = "hat-views"; strip.dataset.key = key;
    vw.forEach(function(u, k){
      var b = document.createElement("button"); b.type = "button"; b.className = "hv" + (k === 0 ? " on" : "");
      b.setAttribute("aria-label", ["Front","Side","Back"][k] + " view");
      b.innerHTML = '<img src="' + u.replace("_fl.", "_fm.") + '" alt="" loading="lazy"><span>' + ["Front","Side","Back"][k] + '</span>';
      b.addEventListener("click", function(e){
        e.stopPropagation();
        h.src = u;
        strip.querySelectorAll(".hv").forEach(function(x){ x.classList.toggle("on", x === b); });
      });
      strip.appendChild(b);
    });
    wrap.appendChild(strip);
  }
  new MutationObserver(function(){ badge(); views(); }).observe(document.body, { childList:true, subtree:true, characterData:true });
  badge(); views();

  function show(){
    var it = list[i]; if (!it) return;
    imgEl.src = it.src; imgEl.alt = name + (it.cap ? " in " + it.cap : "");
    capEl.innerHTML = "";
    capEl.appendChild(document.createTextNode(it.cap || name));
    if (list.length > 1){
      var sm = document.createElement("small");
      sm.textContent = name + " · " + (i + 1) + " of " + list.length;
      capEl.appendChild(sm);
    }
    [i - 1, i + 1].forEach(function(k){ var n = list[(k + list.length) % list.length]; if (n){ var p = new Image(); p.src = n.src; } });
  }
  function open(hero){
    var card = hero.closest("[data-hat]");
    var s = card && STYLES.find(function(x){ return x.id === card.dataset.hat; });
    if (!s) return;
    name = card.querySelector(".hat-name") ? card.querySelector(".hat-name").textContent : s.name;
    var capNow = document.getElementById("hatHeroCap");
    var colNow = capNow ? capNow.textContent.trim() : "";
    var vw = viewList(s, colNow);
    if (vw){
      list = vw.map(function(u, k){ return { src: u, cap: colNow + " \u00b7 " + ["Front","Side","Back"][k] }; });
    } else {
      list = (s.colors || []).filter(function(c){ return s.colorImgs && s.colorImgs[c]; })
        .map(function(c){ return { src: SSI(s.colorImgs[c], "f_fl"), cap: c }; });
    }
    if (!list.length) list = (s.imgs || []).map(function(u){ return { src: u, cap: "" }; });
    var cur = base(hero.currentSrc || hero.src);
    i = Math.max(0, list.findIndex(function(x){ return base(x.src) === cur; }));
    if (list.findIndex(function(x){ return base(x.src) === cur; }) < 0) list.unshift({ src: hero.src, cap: "" }), i = 0;
    box.classList.toggle("single", list.length < 2);
    show();
    lastFocus = document.activeElement;
    box.hidden = false; box.classList.add("open"); document.body.classList.add("tblb-lock");
    box.querySelector(".tblb-close").focus({ preventScroll:true });
  }
  function close(){
    box.classList.remove("open"); box.hidden = true; document.body.classList.remove("tblb-lock");
    if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll:true });
  }
  function step(d){ if (list.length < 2) return; i = (i + d + list.length) % list.length; show(); }

  document.addEventListener("click", function(e){
    var h = e.target.closest && e.target.closest("#hatHero");
    if (!h) return;
    e.preventDefault(); e.stopPropagation();
    open(h);
  }, true);
  box.addEventListener("click", function(e){
    if (e.target.closest(".tblb-prev")) return step(-1);
    if (e.target.closest(".tblb-next")) return step(1);
    if (e.target.closest(".tblb-close") || e.target === box) return close();
  });
  document.addEventListener("keydown", function(e){
    if (!box.classList.contains("open")) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowLeft") step(-1);
    else if (e.key === "ArrowRight") step(1);
  });
  var x0 = null;
  box.addEventListener("touchstart", function(e){ x0 = e.touches[0].clientX; }, { passive:true });
  box.addEventListener("touchend", function(e){
    if (x0 == null) return; var dx = e.changedTouches[0].clientX - x0; x0 = null;
    if (Math.abs(dx) > 45) step(dx < 0 ? 1 : -1);
  }, { passive:true });
})();
</script>



