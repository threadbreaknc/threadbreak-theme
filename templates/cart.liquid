{%- if cart.item_count > 0 -%}
<style>
  .cart-item-qty-locked{display:inline-flex;align-items:center;padding:6px 14px;background:#F3EFFC;border:1.5px solid #E2E0EA;border-radius:8px}
  .qty-locked-label{font-weight:600;color:#14121C;font-size:0.95rem}
  .qty-locked-note{display:block;font-size:0.72rem;color:#6B6A78;margin-top:5px;max-width:260px;line-height:1.35}
</style>
<div class="cart-page">
  <div class="about-sparkles" id="about-sparkles" aria-hidden="true"></div>

  <section class="cart-hero">
    <div class="cart-hero-content">
      <p class="eyebrow">Almost There.</p>
      <h1>Your Cart.</h1>
      <p class="cart-hero-nudge">You're almost there. Free shipping on every order.</p>
    </div>
    <div class="cart-progress-wrap">
      <p class="cart-progress-label">{{ cart.item_count }} item{% if cart.item_count > 1 %}s{% endif %} in your cart &middot; embroidered to order, ships in 2-5 business days</p>
      <div class="cart-progress-bar"><div class="cart-progress-fill"></div></div>
    </div>
  </section>

  {%- form 'cart', cart, id: 'cart-form' -%}
  <section class="cart-section">

    <div class="cart-items">
      {%- for item in cart.items -%}
        <div class="cart-item">
          <div class="cart-item-img">
            <img src="{{ item.image | img_url: '200x200', crop: 'center' }}" alt="{{ item.title | escape }}">
          </div>
          <div class="cart-item-info">
            <a href="{{ item.url }}" class="cart-item-name">{{ item.product.title }}</a>
            {%- unless item.variant.title == 'Default Title' -%}
              <p class="cart-item-variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            <div class="cart-item-bottom">
              {%- assign is_tier_locked = false -%}
              {%- if item.product.type == 'Custom Hats' or item.product.tags contains 'custom-order-form' -%}
                {%- assign is_tier_locked = true -%}
              {%- endif -%}
              {%- if is_tier_locked -%}
                <div class="cart-item-qty cart-item-qty-locked">
                  <span class="qty-locked-label">Qty: {{ item.quantity }}</span>
                  <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                </div>
                <span class="qty-locked-note">Custom order quantity is set on the order form. To change it, remove this and rebuild your order.</span>
              {%- else -%}
                <div class="cart-item-qty">
                  <button type="button" class="qty-btn cart-qty-minus" data-line="{{ forloop.index }}">−</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="qty-input cart-qty-input" data-line="{{ forloop.index }}">
                  <button type="button" class="qty-btn cart-qty-plus" data-line="{{ forloop.index }}">+</button>
                </div>
              {%- endif -%}
              <span class="cart-item-total">{{ item.line_price | money }}</span>
              <a href="{{ item.url_to_remove }}" class="cart-item-remove">✕</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="cart-summary">
      <div class="cart-summary-inner">
        <div class="cart-summary-row">
          <span>Subtotal</span>
          <span class="cart-total-price">{{ cart.total_price | money }}</span>
        </div>
        <div class="cart-summary-row">
          <span>Shipping</span>
          <span class="cart-shipping-free">FREE</span>
        </div>
        <button type="submit" name="checkout" class="btn btn-fill cart-checkout-btn">Complete Order →</button>
        <a href="/collections/pre-made-hats" class="cart-continue">← Keep Shopping</a>

      </div>
    </div>

  </section>
  {%- endform -%}

</div>

{%- else -%}

<div class="cart-page">
  <section class="cart-empty">
    <div class="cart-empty-content">
      <h1>Your cart is empty.</h1>
      <p>Looks like you haven't added anything yet. Let's fix that.</p>
      <a href="/collections/pre-made-hats" class="btn btn-fill">Shop Hats</a>
    </div>
  </section>
</div>

{%- endif -%}
