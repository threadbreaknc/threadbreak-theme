{%- if cart.item_count > 0 -%}
<style>
  .cart-item-qty-locked{display:inline-flex;align-items:center;padding:6px 14px;background:#F3EFFC;border:1.5px solid #E2E0EA;border-radius:8px}
  .qty-locked-label{font-weight:600;color:#14121C;font-size:0.95rem}
  .cart-tier-qty.busy{opacity:.5;pointer-events:none}
  .qty-locked-note a{color:#5028AA;font-weight:600}
  .qty-locked-note{display:block;font-size:0.72rem;color:#6B6A78;margin-top:5px;max-width:260px;line-height:1.35}
  .bf-cart-pick label{display:flex;align-items:center;gap:8px;font-size:.82rem;font-weight:700;color:#14121C}
  .bf-cart-pick select{height:36px;border:1.5px solid #E2E0EA;border-radius:8px;padding:0 8px;font:inherit;font-weight:500;background:#fff}
  .bf-cart-free{font-weight:800;color:#5028AA}
  .bf-cart-free s{color:#9a98a6;font-weight:500;margin-right:4px}
</style>
<div class="cart-page">
  <div class="about-sparkles" id="about-sparkles" aria-hidden="true"></div>

  <section class="cart-hero">
    <div class="cart-hero-content">
      <p class="eyebrow">Almost There.</p>
      <h1>Your Cart.</h1>
      <p class="cart-hero-nudge">You're almost there. Free shipping to the lower 48.</p>
    </div>
    <div class="cart-progress-wrap">
      {%- comment -%}
        cart.item_count sums quantity across every line (a qty-24 custom
        order plus one hat reads as "25 items"), which doesn't match what
        the customer sees below. cart.items.size counts cart lines instead,
        matching the rows actually listed.
      {%- endcomment -%}
      <p class="cart-progress-label">{{ cart.items.size }} item{% if cart.items.size > 1 %}s{% endif %} in your cart &middot; you're one step from done</p>
      <div class="cart-progress-bar"><div class="cart-progress-fill"></div></div>
    </div>
  </section>

  {%- form 'cart', cart, id: 'cart-form' -%}
  <section class="cart-section">

    <div class="cart-items">
      {%- for item in cart.items -%}
        <div class="cart-item">
          <div class="cart-item-img">
            <img src="{{ item.image | img_url: '200x200', crop: 'center' }}" alt="{{ item.title | escape }}">
          </div>
          <div class="cart-item-info">
            <a href="{{ item.url }}" class="cart-item-name">{{ item.product.title }}</a>
            {%- unless item.variant.title == 'Default Title' -%}
              <p class="cart-item-variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            {%- if item.product.tags contains 'mx-plate-hat' -%}
              <ul class="cart-item-props" style="list-style:none;margin:8px 0 0;padding:0;font-size:0.78rem;line-height:1.55;color:#6B6A78;">
                {%- for p in item.properties -%}
                  {%- assign pk = p.first | slice: 0, 1 -%}
                  {%- if pk != '_' and p.last != blank -%}
                    <li><strong style="color:#14121C;">{{ p.first }}:</strong> {{ p.last }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <div class="cart-item-bottom">
              {%- assign is_tier_locked = false -%}
              {%- if item.product.type == 'Custom Hats' or item.product.tags contains 'custom-order-form' -%}
                {%- assign is_tier_locked = true -%}
              {%- endif -%}
              {%- assign is_bf = false -%}
              {%- if item.product.handle == 'black-friday-bonus' -%}{%- assign is_bf = true -%}{%- endif -%}
              {%- if is_bf -%}
                <div class="bf-cart-pick">
                  <label>Color
                    <select class="bf-color" data-key="{{ item.key }}" data-kind="{% if item.variant.title contains 'Beanie' %}beanie{% else %}patch{% endif %}" data-props="{{ item.properties | json | escape }}" data-current="{{ item.properties['Color'] | escape }}"></select>
                  </label>
                  <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                </div>
                <span class="qty-locked-note">Black Friday bonus. Same logo as your hats, on your mockup.</span>
              {%- elsif is_tier_locked -%}
                {%- assign hat_colors = item.properties['Hat Color(s)'] | default: '' -%}
                {%- assign multi_color = false -%}
                {%- if hat_colors contains ' x' -%}{%- assign multi_color = true -%}{%- endif -%}
                {%- if multi_color -%}
                  <div class="cart-item-qty cart-item-qty-locked">
                    <span class="qty-locked-label">Qty: {{ item.quantity }}</span>
                    <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                  </div>
                  <span class="qty-locked-note">This order is split across colors ({{ hat_colors }}). To change quantities, remove it and <a href="{{ item.url | split: '?' | first | replace: '/products/custom-embroidered-hat', '/pages/custom-order' | replace: '/products/custom-patch-hat', '/pages/custom-patch-hats' | replace: '/products/custom-dtf-print-hat', '/pages/custom-dtf-hats' }}">rebuild it</a>.</span>
                {%- else -%}
                  {%- comment -%}
                    Custom order lines are priced by quantity tier (5-9, 10-23, 24-47, 48-95, 96+),
                    so changing the quantity swaps the line to the matching tier variant and keeps
                    the add-on lines (extra locations, 3D puff) in step. See the script below.
                  {%- endcomment -%}
                  <div class="cart-item-qty cart-tier-qty" data-key="{{ item.key }}" data-handle="{{ item.product.handle }}" data-style="{{ item.variant.option1 | escape }}" data-props="{{ item.properties | json | escape }}">
                    <button type="button" class="qty-btn" data-tq="-1" aria-label="Fewer">−</button>
                    <input type="number" class="qty-input" value="{{ item.quantity }}" min="5" inputmode="numeric" aria-label="Quantity">
                    <button type="button" class="qty-btn" data-tq="1" aria-label="More">+</button>
                    <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                  </div>
                  <span class="qty-locked-note cart-tier-note">5 minimum. Price per hat updates with quantity.</span>
                {%- endif -%}
              {%- else -%}
                <div class="cart-item-qty">
                  <button type="button" class="qty-btn cart-qty-minus" data-line="{{ forloop.index }}">−</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="qty-input cart-qty-input" data-line="{{ forloop.index }}">
                  <button type="button" class="qty-btn cart-qty-plus" data-line="{{ forloop.index }}">+</button>
                </div>
              {%- endif -%}
              {%- if is_bf -%}
                <span class="cart-item-total bf-cart-free"><s>{{ item.variant.compare_at_price | money }}</s> FREE</span>
              {%- else -%}
              <span class="cart-item-total">{{ item.line_price | money }}</span>
              {%- endif -%}
              {%- comment -%}
                Remove by line item key, not by position. A line number goes stale as
                soon as the cart changes, and the GET /cart/change?line= fallback is
                not reliably accepted, which is what produced the "no valid id or line
                parameter" error page. url_to_remove is Shopify's own key-based link.
              {%- endcomment -%}
              <a href="{{ item.url_to_remove }}"
                 class="cart-item-remove"
                 data-remove-key="{{ item.key }}"
                 aria-label="Remove {{ item.product.title | escape }}">✕</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="cart-summary">
      <div class="cart-summary-inner">
        <div class="cart-summary-row">
          <span>Subtotal</span>
          <span class="cart-total-price">{{ cart.total_price | money }}</span>
        </div>
        <div class="cart-summary-row">
          <span>Shipping</span>
          <span class="cart-shipping-free">FREE</span>
        </div>
        <button type="submit" name="checkout" class="btn btn-fill cart-checkout-btn">Complete Order →</button>
        <a href="/collections/pre-made-hats" class="cart-continue">← Keep Shopping</a>

      </div>
    </div>

  </section>
  {%- endform -%}

</div>

{%- else -%}

<div class="cart-page">
  <section class="cart-empty">
    <div class="cart-empty-content">
      <h1>Your cart is empty.</h1>
      <p>Looks like you haven't added anything yet. Let's fix that.</p>
      <a href="/collections/pre-made-hats" class="btn btn-fill">Shop Hats</a>
    </div>
  </section>
</div>

{%- endif -%}

<script>
// Black Friday bonus: keep the free line in step with the embroidered hats in the cart
// (custom order form lines + 10/24/48 hat packages; beanies, patch and DTF orders don't count).
(function(){
  var BF = window.TB_BF; if (!BF) return;
  var post = function(url, body){ return fetch(url, { method: "POST", headers: { "Content-Type": "application/json", "Accept": "application/json" }, body: JSON.stringify(body) }).then(function(r){ if (!r.ok) throw new Error(url + " " + r.status); return r.json(); }); };
  document.querySelectorAll(".bf-color").forEach(function(sel){
    var list = BF.colors[sel.dataset.kind] || [], cur = sel.dataset.current;
    sel.innerHTML = list.map(function(c){ return "<option" + (c === cur ? " selected" : "") + ">" + c + "</option>"; }).join("");
    sel.addEventListener("change", function(){
      var props = {}; try { props = JSON.parse(sel.dataset.props || "{}"); } catch (e) {}
      props["Color"] = sel.value; sel.disabled = true;
      post("/cart/change.js", { id: sel.dataset.key, quantity: 1, properties: props }).then(function(){ window.location.reload(); }).catch(function(){ sel.disabled = false; });
    });
  });
  fetch("/cart.js").then(function(r){ return r.json(); }).then(function(cart){
    var q = 0, lines = [], hatColor = "";
    cart.items.forEach(function(it){
      if (it.handle === "black-friday-bonus"){ lines.push(it); return; }
      if ((it.handle === "custom-embroidered-hat" && !/beanie/i.test(it.variant_title || "")) || it.handle === "custom-patch-hat"){ q += it.quantity; if (!hatColor && it.properties) hatColor = String(it.properties["Hat Color(s)"] || "").split(/ x|,/)[0].trim(); }
      else if (it.product_type === "Custom Hat Bundle"){ q += (parseInt(it.product_title, 10) || 0) * it.quantity; }
    });
    var want = BF.active() ? BF.bonusFor(q) : null;
    var ok = want ? (lines.length === 1 && lines[0].variant_id === want.id && lines[0].quantity === 1) : !lines.length;
    if (ok) return;
    var updates = {}; lines.forEach(function(l){ updates[l.key] = 0; });
    var step = lines.length ? post("/cart/update.js", { updates: updates }) : Promise.resolve();
    step.then(function(){
      if (!want) return;
      var list = BF.colors[want.kind], old = lines[0] && lines[0].properties && lines[0].properties["Color"];
      var color = (old && list.indexOf(old) > -1) ? old : (list.indexOf(hatColor) > -1 ? hatColor : list[0]);
      return post("/cart/add.js", { items: [{ id: want.id, quantity: 1, properties: { "Color": color, "Logo": "Same as hat order", "_bf": "1" } }] });
    }).then(function(){ window.location.reload(); }).catch(function(e){ try { console.warn("bf bonus", e); } catch (x) {} });
  });
})();

// Tier-priced custom order lines: change quantity in the cart.
(function(){
  var post = function(url, body){ return fetch(url, { method: "POST", headers: { "Content-Type": "application/json", "Accept": "application/json" }, body: JSON.stringify(body) }).then(function(r){ if (!r.ok) throw new Error(url + " " + r.status); return r.json(); }); };
  document.querySelectorAll(".cart-tier-qty").forEach(function(box){
    var input = box.querySelector(".qty-input"), note = box.parentNode.querySelector(".cart-tier-note");
    var start = +input.value, busy = false, timer = null;
    function apply(){
      var q = Math.round(+input.value || 0);
      if (q < 5){ q = 5; input.value = 5; }
      if (q === start || busy) return;
      busy = true; box.classList.add("busy"); if (note) note.textContent = "Updating...";
      var props = {}; try { props = JSON.parse(box.dataset.props || "{}"); } catch (e) {}
      var style = box.dataset.style;
      var base = "/products/" + box.dataset.handle + "?view=tbvariant";
      var getJ = function(u){ return fetch(u).then(function(r){ if (!r.ok) throw new Error(u + " " + r.status); return r.json(); }); };
      Promise.all([ getJ(base), getJ("/cart.js") ]).then(function(res){
        var info = res[0], cart = res[1];
        var line = cart.items.find(function(it){ return it.key === box.dataset.key; });
        if (!line) throw new Error("line gone");
        // pick the tier for this quantity by its starting number ("5–9 hats", "96–143 hats", "96+ hats")
        var sv = (info.options[0] || []).find(function(o){ return o.name === style; });
        var tiers = (info.options[1] || []).map(function(o){ return { id: o.id, name: o.name, min: parseInt(o.name, 10) || 0 }; })
          .filter(function(t){ return t.min >= 5 && t.min <= q; }).sort(function(a, b){ return b.min - a.min; });
        if (!sv || !tiers.length) throw new Error("no tier");
        var tryTier = function(k){
          if (k >= tiers.length) throw new Error("no tier variant");
          return getJ(base + "&option_values=" + sv.id + "," + tiers[k].id).then(function(d){
            var v = d.variant;
            return (v && v.option1 === style && v.option2 === tiers[k].name) ? v : tryTier(k + 1);
          });
        };
        return tryTier(0).then(function(v){
          // add-on lines (extra locations, puff) for this hat follow the new quantity
          var updates = {};
          cart.items.forEach(function(it){ if (it.key !== box.dataset.key && it.properties && it.properties["Applies to"] === style && it.quantity === start) updates[it.key] = q; });
          var addons = function(){ return Object.keys(updates).length ? post("/cart/update.js", { updates: updates }) : null; };
          if (v.id === line.variant_id) return post("/cart/change.js", { id: box.dataset.key, quantity: q }).then(addons);
          // add the new tier first, then drop the old line, so nothing is lost if a step fails
          return post("/cart/add.js", { items: [{ id: v.id, quantity: q, properties: line.properties || props }] })
            .then(function(){ return post("/cart/change.js", { id: box.dataset.key, quantity: 0 }); })
            .then(addons);
        });
      }).then(function(){ window.location.reload(); })
        .catch(function(err){ try { console.warn("cart qty", err); } catch(e){} busy = false; box.classList.remove("busy"); input.value = start; if (note) note.textContent = "Couldn't update. Remove it and rebuild your order, or email help@threadbreak.com."; });
    }
    box.querySelectorAll("[data-tq]").forEach(function(b){ b.addEventListener("click", function(){ input.value = Math.max(5, (+input.value || 0) + (+b.dataset.tq)); clearTimeout(timer); timer = setTimeout(apply, 700); }); });
    input.addEventListener("change", apply);
  });
})();

(function(){
  // Remove by line item key. A positional index goes stale the moment the cart
  // changes, and the plain GET /cart/change?line= fallback is what produced the
  // "no valid id or line parameter" error page.
  document.querySelectorAll('.cart-item-remove[data-remove-key]').forEach(function(link){
    link.addEventListener('click', function(e){
      e.preventDefault();
      if (link.dataset.busy) return;
      link.dataset.busy = '1';
      link.style.opacity = '.4';
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: link.dataset.removeKey, quantity: 0 })
      })
      .then(function(res){
        if (!res.ok) throw new Error('remove failed');
        window.location.href = '/cart';
      })
      .catch(function(){
        // fall back to the plain link if the API call fails
        window.location.href = link.getAttribute('href');
      });
    });
  });
})();
</script>
