<div class="collection-page">

  <!-- HERO -->
  <section class="collection-hero">
    <div class="collection-hero-bg"></div>
    <div class="collection-hero-content">
      <h1>{{ collection.title | upcase }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-hero-sub">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </section>

  <!-- SORT + COUNT BAR -->
  <div class="collection-bar">
    <p class="collection-count">{{ collection.products_count }} Products</p>
    {%- comment -%}
      Brand filter for hat packages, with the brand marks shown in the list. A
      native select cannot render images, so this is a small custom dropdown.
      Sort is hidden here since the collection is already ordered by price.
    {%- endcomment -%}
    {%- assign is_pkg = false -%}
    {%- if collection.handle == "custom-hat-packages" -%}{%- assign is_pkg = true -%}{%- endif -%}
    {%- if is_pkg -%}
      {%- assign vendor_list = "" -%}
      {%- for product in collection.products -%}
        {%- unless vendor_list contains product.vendor -%}
          {%- assign vendor_list = vendor_list | append: product.vendor | append: "|" -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- assign vendors = vendor_list | split: "|" | sort -%}
      <div class="brand-dd" id="brandDD">
        <button type="button" class="brand-dd-btn" id="brandDDBtn" aria-expanded="false">
          <span class="brand-dd-current">All brands</span>
          <svg class="brand-dd-chev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="brand-dd-menu" id="brandDDMenu" hidden>
          <button type="button" class="brand-dd-opt on" data-brand="all"><span>All brands</span></button>
          {%- for v in vendors -%}
            {%- if v != blank -%}
              {%- assign vl = v | downcase -%}
              {%- assign blogo = "" -%}
              {%- if vl contains "richardson" -%}{%- assign blogo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/richardson.png?v=1787437321" -%}
              {%- elsif vl contains "yupoong" -%}{%- assign blogo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/yupoong.png?v=1787437321" -%}
              {%- elsif vl contains "atonal" -%}{%- assign blogo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/atonal.png?v=1787437321" -%}
              {%- elsif vl contains "otto" -%}{%- assign blogo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/otoo.png?v=1787437321" -%}
              {%- endif -%}
              <button type="button" class="brand-dd-opt" data-brand="{{ v | escape }}">
                {%- if blogo != blank -%}<img src="{{ blogo }}" alt="{{ v }}" loading="lazy">{%- endif -%}
                <span>{{ v }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
    <form class="collection-sort">
      <label for="sort-by" class="sort-label">Sort</label>
      <select name="sort_by" id="sort-by" class="sort-select" onchange="this.form.submit()">
        <option value="best-selling" {% if collection.sort_by == 'best-selling' or collection.sort_by == blank %}selected{% endif %}>Popular</option>
        <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
        <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>Name A-Z</option>
        <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price Low-High</option>
        <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price High-Low</option>
      </select>
    </form>
    {%- endif -%}
  </div>

  <!-- PRODUCT GRID -->
  <div class="collection-grid">
    {%- for product in collection.products -%}
      <div class="coll-card" data-vendor="{{ product.vendor | escape }}">
        <a href="{{ product.url }}" class="coll-card-link">
          <div class="coll-img-wrap">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}"
                alt="{{ product.title | escape }}"
                class="coll-img"
                loading="lazy"
              >
            {%- else -%}
              <div class="coll-img-placeholder">🧢</div>
            {%- endif -%}
            {%- if product.compare_at_price > product.price -%}
              <div class="coll-badge coll-badge-sale">Sale</div>
            {%- endif -%}
            {%- unless product.available -%}
              <div class="coll-badge coll-badge-sold">Sold Out</div>
            {%- endunless -%}
            {%- comment -%} brand mark for hat packages {%- endcomment -%}
            {%- if product.type == "Custom Hat Bundle" -%}
              {%- assign vt = product.vendor | append: " " | append: product.title | downcase -%}
              {%- assign blogo = "" -%}{%- assign balt = "" -%}
              {%- if vt contains "richardson" -%}
                {%- assign blogo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/richardson.png?v=1787437321" -%}{%- assign balt = "Richardson" -%}
              {%- elsif vt contains "yupoong" or vt contains "yp classics" -%}
                {%- assign blogo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/yupoong.png?v=1787437321" -%}{%- assign balt = "Yupoong" -%}
              {%- elsif vt contains "atonal" -%}
                {%- assign blogo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/atonal.png?v=1787437321" -%}{%- assign balt = "Atonal" -%}
              {%- elsif vt contains "otto" -%}
                {%- assign blogo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/otoo.png?v=1787437321" -%}{%- assign balt = "Otto" -%}
              {%- endif -%}
              {%- if blogo != blank -%}
                <img class="coll-brand" src="{{ blogo }}" alt="{{ balt }}" loading="lazy">
              {%- endif -%}
            {%- endif -%}
          </div>
          <div class="coll-info">
            <h3 class="coll-name">{{ product.title }}</h3>
            <div class="coll-meta">
              <span class="coll-price">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <s class="coll-price-was">{{ product.compare_at_price | money }}</s>
              {%- endif -%}
              {%- comment -%}
                Colour count for bundle products. Each variant is one colour, so the
                variant count is the colour count and works reliably on collection pages.
              {%- endcomment -%}
              {%- if product.type == "Custom Hat Bundle" and product.variants.size > 1 -%}
                <span class="coll-colors"><span class="coll-wheel"></span>{{ product.variants.size }} colors</span>
              {%- endif -%}
              {%- if product.variants.size > 1 -%}
                <span class="coll-variants">{{ product.variants.size }} styles</span>
              {%- endif -%}
            </div>
          </div>
        </a>
        {%- comment -%}
          Custom hat packages need a color, a logo file and a placement, so a
          one-click add would create an unfulfillable order. Send them to the
          product page instead.
        {%- endcomment -%}
        {%- if product.type == "Custom Hat Bundle" -%}
          <a href="{{ product.url }}" class="coll-atc coll-atc-link">Customize This Package</a>
        {%- elsif product.available -%}
          <button class="coll-atc" data-variant="{{ product.variants.first.id }}" onclick="collAddToCart(event, this)">Add to Cart</button>
        {%- else -%}
          <button class="coll-atc coll-atc-disabled" disabled>Sold Out</button>
        {%- endif -%}
      </div>
    {%- else -%}
      <p class="collection-empty">No products found.</p>
    {%- endfor -%}
  </div>

  <div id="coll-toast" class="fp-toast">Added to cart ✓</div>

  <script>
  async function collAddToCart(e, btn) {
    e.preventDefault();
    e.stopPropagation();
    var variantId = btn.getAttribute('data-variant');
    var prev = btn.textContent;
    btn.textContent = 'Adding...';
    btn.disabled = true;
    try {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      });
      btn.textContent = 'Added ✓';
      var cartData = await fetch('/cart.js').then(function(r) { return r.json(); });
      var cartLink = document.getElementById('nav-cart-link');
      var countEl = document.getElementById('nav-cart-count');
      if (countEl) countEl.textContent = cartData.item_count;
      if (cartLink) {
        cartLink.classList.remove('nav-cart-hidden');
        cartLink.classList.add('nav-cart-visible');
        cartLink.classList.remove('cart-glow');
        void cartLink.offsetWidth;
        cartLink.classList.add('cart-glow');
        setTimeout(function() { cartLink.classList.remove('cart-glow'); }, 900);
      }
      var toast = document.getElementById('coll-toast');
      if (toast) {
        toast.classList.add('fp-toast-show');
        setTimeout(function() { toast.classList.remove('fp-toast-show'); }, 2500);
      }
      setTimeout(function() { btn.textContent = prev; btn.disabled = false; }, 2200);
    } catch(err) {
      btn.textContent = prev;
      btn.disabled = false;
    }
  }
  </script>

  <!-- CTA BAND -->
  <section class="collection-cta">
    <p class="eyebrow reveal">Can't find what you're looking for?</p>
    <h2 class="reveal reveal-d1">Get Something<br>Custom Made.</h2>
    <p class="reveal reveal-d2">Send us your logo and we'll build something unique. 5 hat minimum, wholesale pricing starts at 10.</p>
    <a href="/pages/custom-order" class="btn btn-fill reveal reveal-d3">Start a Custom Order →</a>
    <p class="cta-alt reveal reveal-d3">Need a style not listed? <a href="/pages/quote">Request a quote</a>.</p>
  </section>

</div>

<script>
(function(){
  var dd = document.getElementById('brandDD');
  if (!dd) return;
  var btn = document.getElementById('brandDDBtn');
  var menu = document.getElementById('brandDDMenu');
  var label = dd.querySelector('.brand-dd-current');
  var cards = document.querySelectorAll('.coll-card[data-vendor]');
  var countEl = document.querySelector('.collection-count');

  function close(){ menu.setAttribute('hidden',''); btn.setAttribute('aria-expanded','false'); }
  btn.addEventListener('click', function(e){
    e.stopPropagation();
    var open = !menu.hasAttribute('hidden');
    if (open) close();
    else { menu.removeAttribute('hidden'); btn.setAttribute('aria-expanded','true'); }
  });
  document.addEventListener('click', close);
  menu.addEventListener('click', function(e){ e.stopPropagation(); });

  menu.querySelectorAll('.brand-dd-opt').forEach(function(opt){
    opt.addEventListener('click', function(){
      var brand = opt.dataset.brand, shown = 0;
      menu.querySelectorAll('.brand-dd-opt').forEach(function(o){ o.classList.toggle('on', o === opt); });
      label.textContent = opt.querySelector('span').textContent;
      cards.forEach(function(card){
        var show = brand === 'all' || card.dataset.vendor === brand;
        card.style.display = show ? '' : 'none';
        if (show) shown++;
      });
      if (countEl) countEl.textContent = shown + (shown === 1 ? ' Product' : ' Products');
      close();
    });
  });
})();
</script>
