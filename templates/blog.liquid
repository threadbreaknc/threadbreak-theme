{%- comment -%} Guides index: list of articles in this blog. {%- endcomment -%}
<style>
  .tbblog{--purple:#5028AA;--ink:#14121C;--muted:#5c5a68;--line:#E2E0EA;--ice:#F4F1FB;background:#fff;color:var(--ink);font-family:'DM Sans',system-ui,sans-serif}
  .tbblog-wrap{max-width:1000px;margin:0 auto;padding:8.5rem 20px 4rem}
  .tbblog h1{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(2.6rem,7vw,4.2rem);line-height:1;margin:0 0 10px}
  .tbblog-sub{font-size:17px;line-height:1.6;color:var(--muted);max-width:640px;margin:0 0 30px}
  .tbblog-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
  .tbblog-card{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:14px;overflow:hidden;text-decoration:none;color:var(--ink);background:#fff;transition:border-color .15s}
  .tbblog-card:hover{border-color:var(--purple)}
  .tbblog-card img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;background:var(--ice)}
  .tbblog-card .ph{aspect-ratio:16/9;background:var(--ice)}
  .tbblog-card div.t{padding:16px}
  .tbblog-card h2{font-size:18px;line-height:1.3;margin:0 0 8px}
  .tbblog-card p{font-size:14.5px;line-height:1.55;color:var(--muted);margin:0}
  .tbblog-empty{color:var(--muted)}
  .tbblog-card{box-shadow:0 10px 26px -20px rgba(20,18,28,.5)}
  .tbblog-card .kick{display:block;font-size:11.5px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--purple);margin-bottom:6px}
  .tbblog-card .more{display:inline-block;margin-top:10px;font-size:14px;font-weight:800;color:var(--purple)}
  @media(min-width:760px){
    .tbblog-card:first-child{grid-column:1/-1;flex-direction:row}
    .tbblog-card:first-child img,.tbblog-card:first-child .ph{width:56%;aspect-ratio:auto;min-height:320px}
    .tbblog-card:first-child div.t{padding:30px;align-self:center;flex:1}
    .tbblog-card:first-child h2{font-size:28px}
    .tbblog-card:first-child p{font-size:16px}
  }
  .tbblog-pg{margin-top:26px;display:flex;gap:14px;font-weight:600}
  .tbblog-pg a{color:var(--purple)}
</style>
<section class="tbblog">
  <div class="tbblog-wrap">
    <h1>{{ blog.title }}</h1>
    <p class="tbblog-sub">Straight answers on custom hats: what they cost, which hats to pick, embroidery vs leather patches, and how to get your logo ready. From our shop in Burlington, NC.</p>
    {%- paginate blog.articles by 24 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="tbblog-grid">
          {%- for a in blog.articles -%}
            <a class="tbblog-card" href="{{ a.url }}">
              {%- if a.image -%}<img src="{{ a.image | image_url: width: 1100 }}" alt="{{ a.image.alt | default: a.title | escape }}" loading="lazy" width="1100" height="619">{%- else -%}<div class="ph"></div>{%- endif -%}
              <div class="t"><span class="kick">Hat guide</span><h2>{{ a.title }}</h2><p>{{ a.excerpt_or_content | strip_html | truncate: 150 }}</p><span class="more">Read the guide &rarr;</span></div>
            </a>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="tbblog-pg">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">&larr; Newer</a>{% endif %}{% if paginate.next %}<a href="{{ paginate.next.url }}">Older &rarr;</a>{% endif %}</nav>
        {%- endif -%}
      {%- else -%}
        <p class="tbblog-empty">New guides are on the way.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
