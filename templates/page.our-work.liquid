<script>
(function(){
  var root = document.getElementById("tbwork");
  if (!root) return;

  // 1) autoplay previews only while on screen (silent, looping)
  var previews = root.querySelectorAll("video[data-preview]");
  if ("IntersectionObserver" in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        var v = e.target;
        if (e.isIntersecting){ v.play().catch(function(){}); }
        else { v.pause(); }
      });
    }, { threshold: 0.35 });
    previews.forEach(function(v){ io.observe(v); });
  } else {
    // old browsers: just load + play
    previews.forEach(function(v){ v.play().catch(function(){}); });
  }

  // 2) click expand -> lightbox with sound
  var lb = document.getElementById("tbwork-lb");
  var lbVideo = document.getElementById("tbwork-lb-video");
  function openLb(src){
    lbVideo.src = src;
    lbVideo.muted = false;
    lb.classList.add("open");
    lbVideo.play().catch(function(){});
  }
  function closeLb(){
    lb.classList.remove("open");
    lbVideo.pause();
    lbVideo.removeAttribute("src");
    lbVideo.load();
  }
  root.querySelectorAll(".tile-expand").forEach(function(btn){
    btn.addEventListener("click", function(){ openLb(btn.dataset.src); });
  });
  lb.querySelector(".lb-close").addEventListener("click", closeLb);
  lb.addEventListener("click", function(e){ if (e.target === lb) closeLb(); });
  document.addEventListener("keydown", function(e){ if (e.key === "Escape") closeLb(); });
})();
</script>
