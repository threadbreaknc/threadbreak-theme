{%- comment -%} build: work-v3 {%- endcomment -%}
<div id="tbwork">
  <style>
    #tbwork{--ink:#14121C;--purple:#5028AA;--ice:#F4F3F7;--line:#E2E0EA;--muted:#6B6A78;--white:#fff;
      max-width:1200px;margin:0 auto;padding:120px 20px 80px;font-family:'DM Sans',sans-serif;color:var(--ink)}
    #tbwork .work-hero{text-align:center;padding:56px 16px 40px}
    @media(max-width:700px){#tbwork{padding-top:100px}}
    #tbwork .work-eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:13px;font-weight:700;color:var(--purple);margin:0 0 10px}
    #tbwork .work-hero h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(40px,8vw,68px);line-height:.98;margin:0 0 14px;letter-spacing:.01em}
    #tbwork .work-hero p{font-size:17px;color:var(--muted);max-width:560px;margin:0 auto;line-height:1.55}
    /* hero CTA buttons */
    #tbwork .hero-cta-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:28px}
    #tbwork .btn-primary{display:inline-block;background:var(--purple);color:#fff;text-decoration:none;
      font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:.04em;padding:15px 36px;border-radius:11px;
      box-shadow:0 6px 20px rgba(80,40,170,.28);transition:transform .15s,background .15s}
    #tbwork .btn-primary:hover{background:#6234c9;transform:translateY(-2px)}
    #tbwork .btn-ghost{display:inline-block;background:transparent;color:var(--purple);text-decoration:none;border:2px solid var(--line);
      font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:.04em;padding:13px 30px;border-radius:11px;transition:border-color .15s,color .15s}
    #tbwork .btn-ghost:hover{border-color:var(--purple)}
    /* sticky mobile CTA bar */
    #tbwork-sticky{display:none}
    @media(max-width:700px){
      #tbwork-sticky{display:block;position:fixed;left:0;right:0;bottom:0;z-index:900;
        background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-top:1px solid var(--line);
        padding:10px 16px calc(10px + env(safe-area-inset-bottom))}
      #tbwork-sticky a{display:block;text-align:center;background:var(--purple);color:#fff;text-decoration:none;
        font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:.04em;padding:14px;border-radius:10px}
      #tbwork{padding-bottom:110px}
    }

    /* masonry-style responsive grid */
    /* robust CSS grid (columns masonry was letting tiles escape) */
    #tbwork .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;align-items:start}
    @media(max-width:900px){#tbwork .gallery{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:560px){#tbwork .gallery{grid-template-columns:1fr}}
    #tbwork .tile{margin:0;border-radius:14px;overflow:hidden;background:var(--ice);
      border:1px solid var(--line);position:relative;display:block}
    #tbwork .tile img,#tbwork .tile video{width:100%;height:100%;display:block;object-fit:cover;aspect-ratio:4/5}
    #tbwork .tile.vid{background:#14121C}
    #tbwork .tile.vid video{aspect-ratio:4/5;object-fit:cover;background:#14121C}
    #tbwork .tile .cap{position:absolute;left:0;right:0;bottom:0;padding:20px 14px 12px;font-size:14px;font-weight:600;color:#fff;
      background:linear-gradient(transparent,rgba(0,0,0,.75));z-index:2;pointer-events:none}
    #tbwork .tile .cap span{display:block;font-weight:400;color:rgba(255,255,255,.85);font-size:13px;margin-top:2px}

    /* CTA band */
    #tbwork .work-cta{margin-top:56px;text-align:center;background:var(--ink);color:#fff;border-radius:18px;padding:44px 24px}
    #tbwork .work-cta h2{font-family:'Bebas Neue',sans-serif;font-size:clamp(28px,5vw,40px);margin:0 0 10px;letter-spacing:.01em}
    #tbwork .work-cta p{color:#C9C6D6;margin:0 auto 22px;max-width:460px;line-height:1.55}
    #tbwork .work-cta a{display:inline-block;background:var(--purple);color:#fff;text-decoration:none;
      font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:.04em;padding:13px 30px;border-radius:10px;
      transition:transform .15s,background .15s}
    #tbwork .work-cta a:hover{background:#6234c9;transform:translateY(-1px)}
    #tbwork .ig-link{display:inline-flex;align-items:center;gap:8px;margin-top:30px;color:var(--purple);
      font-weight:700;text-decoration:none;font-size:15px}
    #tbwork .ig-link:hover{text-decoration:underline}

    /* video preview + expand button */
    #tbwork .tile.vid{cursor:default}
    #tbwork .tile-expand{position:absolute;inset:0;width:100%;height:100%;border:none;background:transparent;cursor:pointer;padding:0}
    #tbwork .tile-expand::after{content:"";position:absolute;bottom:12px;right:12px;width:38px;height:38px;border-radius:50%;
      background:rgba(20,18,28,.72);
      background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='white'><path d='M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z'/></svg>");
      background-size:18px;background-repeat:no-repeat;background-position:center;transition:transform .15s}
    #tbwork .tile-expand:hover::after{transform:scale(1.08)}

    /* lightbox */
    #tbwork-lb{position:fixed;inset:0;z-index:9999;background:rgba(10,8,16,.92);display:none;align-items:center;justify-content:center;padding:20px}
    #tbwork-lb.open{display:flex}
    #tbwork-lb video{max-width:min(900px,94vw);max-height:88vh;width:auto;height:auto;border-radius:12px;background:#000}
    #tbwork-lb .lb-close{position:absolute;top:18px;right:20px;width:44px;height:44px;border-radius:50%;border:none;
      background:rgba(255,255,255,.14);color:#fff;font-size:26px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center}
    #tbwork-lb .lb-close:hover{background:rgba(255,255,255,.26)}
  </style>

