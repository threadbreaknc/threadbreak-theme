<div class="page-content" style="padding:10rem 6rem 6rem;max-width:900px;margin:0 auto;">
  <h1 class="page-title" style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,5rem);margin-bottom:2rem;letter-spacing:0.02em;">{{ page.title }}</h1>
  <div class="page-body" style="font-size:1rem;line-height:1.8;color:var(--text-muted);">
    {{ page.content }}
  </div>
</div>
