{%- comment -%} build: industry-smallbiz-v1 {%- endcomment -%}
<div id="tbindustry">
  <style>
    #tbindustry{--ink:#14121C;--purple:#5028AA;--purple2:#6234c9;--ice:#F3EFFC;--line:#E2E0EA;--muted:#6B6A78;--white:#fff;
      font-family:'DM Sans',sans-serif;color:var(--ink);}
    #tbindustry *{box-sizing:border-box;margin:0;padding:0}
    #tbindustry .ind-hero{background:linear-gradient(135deg,#14121C 0%,#241f33 100%);color:#F7F4F0;padding:150px 20px 70px;text-align:center;border-bottom:5px solid var(--purple);}
    #tbindustry .ind-hero-inner{max-width:760px;margin:0 auto;}
    #tbindustry .ind-eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:13px;font-weight:700;color:var(--purple2);margin:0 0 14px;}
    #tbindustry .ind-hero h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(38px,7vw,64px);line-height:1.02;margin:0 0 18px;}
    #tbindustry .ind-hero p{font-size:17px;line-height:1.6;color:#C9C8D4;margin:0 auto 26px;max-width:560px;}
    #tbindustry .ind-cta{display:inline-flex;align-items:center;gap:8px;background:var(--purple);color:#fff;text-decoration:none;font-family:'Bebas Neue',sans-serif;font-size:1.35rem;letter-spacing:.05em;padding:.85rem 2.2rem;border-radius:12px;transition:background .18s,transform .18s;box-shadow:0 6px 24px rgba(80,40,170,.4);}
    #tbindustry .ind-cta:hover{background:var(--purple2);transform:translateY(-2px);}
    #tbindustry .ind-cta-sub{display:block;margin-top:14px;font-size:13px;color:#9a97a8;}
    #tbindustry .ind-section{max-width:960px;margin:0 auto;padding:64px 20px;}
    #tbindustry .ind-section h2{font-family:'Bebas Neue',sans-serif;font-size:clamp(28px,4.5vw,40px);line-height:1.05;margin:0 0 20px;color:var(--ink);}
    #tbindustry .ind-section p{font-size:16px;line-height:1.7;color:#3d3a4a;margin:0 0 16px;}
    #tbindustry .ind-points{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px;margin-top:8px;}
    #tbindustry .ind-point{background:var(--ice);border:1px solid var(--line);border-radius:14px;padding:24px;}
    #tbindustry .ind-point h3{font-size:17px;font-weight:700;margin:0 0 8px;color:var(--purple);}
    #tbindustry .ind-point p{font-size:14.5px;line-height:1.6;color:#3d3a4a;margin:0;}
    #tbindustry .ind-hats{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin-top:8px;}
    #tbindustry .ind-hat{border:1.5px solid var(--line);border-radius:14px;padding:22px;background:#fff;}
    #tbindustry .ind-hat strong{display:block;font-size:16px;margin-bottom:6px;}
    #tbindustry .ind-hat span{font-size:14px;color:var(--muted);line-height:1.55;}
    #tbindustry .ind-band{background:var(--ice);}
    #tbindustry .ind-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-top:8px;}
    #tbindustry .ind-step{padding:4px;}
    #tbindustry .ind-step .num{font-family:'Bebas Neue',sans-serif;font-size:1.6rem;color:var(--purple);margin-bottom:6px;}
    #tbindustry .ind-step strong{display:block;font-size:16px;margin-bottom:6px;}
    #tbindustry .ind-step span{font-size:14.5px;color:#3d3a4a;line-height:1.6;}
    #tbindustry .ind-final{text-align:center;background:linear-gradient(135deg,#14121C 0%,#241f33 100%);color:#F7F4F0;padding:64px 20px;}
    #tbindustry .ind-final h2{color:#fff;}
    #tbindustry .ind-final p{color:#C9C8D4;max-width:520px;margin:0 auto 26px;}
    @media(max-width:700px){#tbindustry .ind-hero{padding-top:120px;}}
    #tbindustry .ind-gallery{max-width:760px;margin:0 auto;padding:40px 20px 0;}
    #tbindustry .ind-gallery-row{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
    #tbindustry .ind-gallery-row img{width:100%;max-width:340px;aspect-ratio:4/3;object-fit:cover;border-radius:14px;border:1px solid var(--line);box-shadow:0 6px 20px rgba(20,18,28,.12);}
    @media(max-width:600px){#tbindustry .ind-gallery-row img{max-width:100%;}}
  </style>

  <section class="ind-hero">
    <div class="ind-hero-inner">
      <p class="ind-eyebrow">Custom Embroidered Hats</p>
      <h1>Custom Hats for Small Businesses</h1>
      <p>Branded hats are one of the most affordable ways to look established and get your name out there. Custom embroidered caps with your logo, made in-house in Burlington, NC, with no minimum and free shipping, so it works whether you need two hats or two hundred.</p>
      <a href="/pages/custom-order" class="ind-cta">Start a Custom Order</a>
      <span class="ind-cta-sub">Order as few as 1 hat &middot; free shipping &middot; free logo digitizing</span>
    </div>
  </section>

  <div class="ind-gallery">
    <div class="ind-gallery-row">
      <img src="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG-6154.jpg?v=1786922824&width=680&format=webp" alt="Custom embroidered hat for a small business" loading="lazy">
      <img src="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/6CB0AC79-A34F-4B4D-AD9D-FBAEF30942E3.jpg?v=1786337802&width=680&format=webp" alt="Custom embroidered hat for a small business" loading="lazy">
    </div>
  </div>

  <section class="ind-section">
    <h2>Look bigger than you are</h2>
    <p>A clean, embroidered hat with your logo makes a small business look professional and legit, at your shop, at the market, on a job, or out in the community. It is walking advertising every time you or your team wears one, and it turns customers into fans when you sell or hand them out. We make it easy and affordable to get started: no minimum order, free logo digitizing, and volume pricing that kicks in as you grow. Start with a few, reorder more whenever you need them.</p>
    <div class="ind-points">
      <div class="ind-point">
        <h3>No minimum to start</h3>
        <p>Order a single hat to test it, or a batch for the whole team. Pricing drops as your quantity goes up.</p>
      </div>
      <div class="ind-point">
        <h3>Free logo setup</h3>
        <p>Send your logo in any format. We digitize it for embroidery at no charge and send a free proof first.</p>
      </div>
      <div class="ind-point">
        <h3>Easy reorders</h3>
        <p>Once your logo is on file, reorders are fast and consistent. Restock or add hats as you hire and grow.</p>
      </div>
    </div>
  </section>

  <section class="ind-section ind-band">
    <div style="max-width:960px;margin:0 auto;">
      <h2>Popular picks for small businesses</h2>
      <p>Versatile, budget-friendly blanks that make your brand look sharp. Not sure what fits? Start an order and we'll help.</p>
      <div class="ind-hats">
        <div class="ind-hat"><strong>Richardson 112 Trucker</strong><span>The most popular trucker in the country. A safe, professional choice that works for almost any business.</span></div>
        <div class="ind-hat"><strong>Otto 5-Panel Mid Profile</strong><span>Budget-friendly all-cotton cap in tons of colors. Great for keeping per-hat cost low on bigger runs.</span></div>
        <div class="ind-hat"><strong>Yupoong 6006 Flat Bill</strong><span>Structured flat-brim snapback for a modern, branded look that stands out.</span></div>
        <div class="ind-hat"><strong>Yupoong 6606 Retro Trucker</strong><span>Affordable retro trucker with wide appeal. A fan favorite for merch and giveaways.</span></div>
      </div>
    </div>
  </section>

  <section class="ind-section">
    <h2>How it works</h2>
    <div class="ind-steps">
      <div class="ind-step"><div class="num">01</div><strong>Pick your hats</strong><span>Choose your blank, colors, and quantity. Send your logo in any format, we digitize it for embroidery free.</span></div>
      <div class="ind-step"><div class="num">02</div><strong>Approve your mockup</strong><span>We send a free digital proof so you can see exactly how your logo looks before we stitch a single hat.</span></div>
      <div class="ind-step"><div class="num">03</div><strong>We embroider &amp; ship</strong><span>Your hats are embroidered in-house in Burlington, NC and shipped free to your door, usually in 2 to 3 weeks.</span></div>
    </div>
  </section>

  <section class="ind-final">
    <h2>Ready to put your logo on a hat?</h2>
    <p>Start a custom order in minutes, or request a quote for a bigger run. Free shipping, free logo setup, no minimum.</p>
    <a href="/pages/custom-order" class="ind-cta">Start a Custom Order</a>
    <span class="ind-cta-sub">Questions first? Email help@threadbreak.com</span>
  </section>
</div>
