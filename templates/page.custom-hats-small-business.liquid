{%- comment -%} build: industry-small-business-clean {%- endcomment -%}
<div id="tbindustry">
  <style>
    #tbindustry{--ink:#14121C;--purple:#5028AA;--purple2:#6234c9;--ice:#F3EFFC;--line:#E2E0EA;--muted:#6B6A78;--white:#fff;font-family:'DM Sans',sans-serif;color:var(--ink);}
    #tbindustry *{box-sizing:border-box;margin:0;padding:0}
    #tbindustry .ind-hero{background:linear-gradient(135deg,#14121C 0%,#241f33 100%);color:#F7F4F0;padding:150px 20px 44px;text-align:center;border-bottom:5px solid var(--purple);}
    #tbindustry .ind-hero-inner{max-width:760px;margin:0 auto;}
    #tbindustry .ind-hero h1{font-family:'Bebas Neue',sans-serif;font-size:clamp(38px,7vw,64px);line-height:1.02;margin:0 0 18px;}
    #tbindustry .ind-hero p{font-size:17px;line-height:1.6;color:#C9C8D4;margin:0 auto 26px;max-width:560px;}
    #tbindustry .ind-cta{display:inline-flex;align-items:center;gap:8px;background:var(--purple);color:#fff;text-decoration:none;font-family:'Bebas Neue',sans-serif;font-size:1.35rem;letter-spacing:.05em;padding:.85rem 2.2rem;border-radius:12px;transition:background .18s,transform .18s;box-shadow:0 6px 24px rgba(80,40,170,.4);}
    #tbindustry .ind-cta:hover{background:var(--purple2);transform:translateY(-2px);}
    #tbindustry .ind-cta-sub{display:block;margin-top:14px;font-size:13px;color:#9a97a8;}
    #tbindustry .ind-gallery{max-width:760px;margin:0 auto;padding:40px 20px 0;}
    #tbindustry .ind-gallery-row{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
    #tbindustry .ind-gallery-row img{width:100%;max-width:320px;aspect-ratio:4/3;object-fit:cover;border-radius:14px;border:1px solid var(--line);box-shadow:0 6px 20px rgba(20,18,28,.12);}
    #tbindustry .ind-section{max-width:960px;margin:0 auto;padding:56px 20px;}
    #tbindustry .ind-section h2{font-family:'Bebas Neue',sans-serif;font-size:clamp(28px,4.5vw,40px);line-height:1.05;margin:0 0 20px;color:var(--ink);}
    #tbindustry .ind-section p{font-size:16px;line-height:1.7;color:#3d3a4a;margin:0 0 16px;}
    #tbindustry .ind-points{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px;margin-top:8px;}
    #tbindustry .ind-point{background:var(--ice);border:1px solid var(--line);border-radius:14px;padding:24px;}
    #tbindustry .ind-point h3{font-size:17px;font-weight:700;margin:0 0 8px;color:var(--purple);}
    #tbindustry .ind-point p{font-size:14.5px;line-height:1.6;color:#3d3a4a;margin:0;}
    #tbindustry .ind-band{background:var(--ice);}
    #tbindustry .ind-hats{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:8px;}
    #tbindustry .ind-hat{border:1.5px solid var(--line);border-radius:14px;overflow:hidden;background:#fff;display:flex;flex-direction:column;}
    #tbindustry .ind-hat-photo{position:relative;width:100%;aspect-ratio:1/1;background:#fff;overflow:hidden;}
    #tbindustry .ind-hat-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;animation:hatFade 12s ease-in-out infinite;}
    #tbindustry .ind-hat-photo[data-n="1"] img{opacity:1;animation:none;}
    #tbindustry .ind-hat-photo[data-n="2"] img{animation-name:hatFade2;animation-duration:10s;}
    #tbindustry .ind-hat-photo[data-n="2"] img:nth-child(2){animation-delay:5s;}
    #tbindustry .ind-hat-photo[data-n="3"] img:nth-child(2){animation-delay:4s;}
    #tbindustry .ind-hat-photo[data-n="3"] img:nth-child(3){animation-delay:8s;}
    #tbindustry .ind-hat-body{padding:20px 22px 22px;}
    #tbindustry .ind-hat-body strong{display:block;font-size:16px;margin-bottom:6px;}
    #tbindustry .ind-hat-body span{display:block;font-size:14px;color:var(--muted);line-height:1.55;}
    #tbindustry .ind-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-top:8px;}
    #tbindustry .ind-step{padding:4px;}
    #tbindustry .ind-step .num{font-family:'Bebas Neue',sans-serif;font-size:1.6rem;color:var(--purple);margin-bottom:6px;}
    #tbindustry .ind-step strong{display:block;font-size:16px;margin-bottom:6px;}
    #tbindustry .ind-step span{display:block;font-size:14.5px;color:#3d3a4a;line-height:1.6;}
    #tbindustry .ind-final{text-align:center;background:linear-gradient(135deg,#14121C 0%,#241f33 100%);color:#F7F4F0;padding:56px 20px;}
    #tbindustry .ind-final h2{color:#fff;}
    #tbindustry .ind-final p{color:#C9C8D4;max-width:520px;margin:0 auto 26px;}
    @keyframes hatFade{0%{opacity:0}4%{opacity:1}30%{opacity:1}37%{opacity:0}100%{opacity:0}}
    @keyframes hatFade2{0%{opacity:0}6%{opacity:1}44%{opacity:1}56%{opacity:0}100%{opacity:0}}
    @media(max-width:600px){#tbindustry .ind-hero{padding-top:165px;}#tbindustry .ind-hats{grid-template-columns:1fr;}#tbindustry .ind-gallery-row img{max-width:100%;}}
    @media(prefers-reduced-motion:reduce){#tbindustry .ind-hat-photo img{animation:none;opacity:0;}#tbindustry .ind-hat-photo img:first-child{opacity:1;}}
    #tbindustry .ind-cta-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;align-items:center;}
    #tbindustry .ind-cta-alt{display:inline-flex;align-items:center;background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.45);text-decoration:none;font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:.05em;padding:.75rem 1.6rem;border-radius:12px;transition:border-color .18s,background .18s;}
    #tbindustry .ind-cta-alt:hover{background:rgba(255,255,255,.08);border-color:#fff;}
    #tbindustry .ind-usecase{background:var(--ice);border:1px solid var(--line);border-radius:16px;padding:28px;margin-top:8px;}
    #tbindustry .ind-usecase h3{font-size:17px;font-weight:700;color:var(--purple);margin:0 0 10px;}
    #tbindustry .ind-usecase ul{margin:0;padding-left:18px;}
    #tbindustry .ind-usecase li{font-size:15px;line-height:1.65;color:#3d3a4a;margin-bottom:7px;}
    #tbindustry .ind-racer{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:center;}
    #tbindustry .ind-racer img{width:100%;border-radius:16px;border:1px solid var(--line);box-shadow:0 10px 30px rgba(20,18,28,.18);display:block;}
    #tbindustry .ind-crosslinks{border-top:1px solid var(--line);padding-top:26px;margin-top:8px;}
    #tbindustry .ind-crosslinks p{font-size:14px;color:var(--muted);margin:0 0 10px;}
    #tbindustry .ind-crosslinks a{display:inline-block;margin:0 14px 8px 0;font-size:14.5px;color:var(--purple);text-decoration:underline;}
    @media(max-width:700px){#tbindustry .ind-racer{grid-template-columns:1fr;}}
  </style>

  <section class="ind-hero">
    <div class="ind-hero-inner">
      <h1>Custom Hats for Small Businesses</h1>
      <p>Branded hats are one of the most affordable ways to look established and get your name out there. Custom embroidered caps with your logo, made in-house in Burlington, NC, with no minimum and free shipping, so it works whether you need two hats or two hundred.</p>
      <a href="/pages/custom-order" class="ind-cta">Start a Custom Order</a>
      <span class="ind-cta-sub">Order as few as 1 hat &middot; free shipping &middot; free logo digitizing</span>
    </div>
  </section>

  <div class="ind-gallery">
    <div class="ind-gallery-row">
      <img src="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG-6154.jpg?v=1786922824&width=680&format=webp" alt="Custom embroidered small businesses hats made by Threadbreak" loading="lazy">
      <img src="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/6CB0AC79-A34F-4B4D-AD9D-FBAEF30942E3.jpg?v=1786337802&width=680&format=webp" alt="Custom embroidered small businesses hats made by Threadbreak" loading="lazy">
    </div>
  </div>

  <section class="ind-section">
    <h2>Give your brand a more established look</h2>
    <p>A clean embroidered hat with your logo creates a consistent, professional appearance at your shop, at the market, on a job, or out in the community. It is walking advertising every time you or your team wears one, and it turns customers into fans when you sell or hand them out. We make it easy and affordable to get started: no minimum order, free logo digitizing, and volume pricing that kicks in as you grow. Start with a few, reorder more whenever you need them.</p>
    <div class="ind-points">
      <div class="ind-point">
        <h3>No minimum to start</h3>
        <p>Order a single hat to test it, or a batch for the whole team. Pricing drops as your quantity goes up.</p>
      </div>
      <div class="ind-point">
        <h3>Free logo setup</h3>
        <p>Send your logo in any format. We digitize it for embroidery at no charge and send a free proof first.</p>
      </div>
      <div class="ind-point">
        <h3>Easy reorders</h3>
        <p>Once your logo is on file, reorders are fast and consistent. Restock or add hats as you hire and grow.</p>
      </div>
    </div>
  </section>

