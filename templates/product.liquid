{%- assign selected_variant = product.selected_or_first_available_variant -%}
<div class="product-page">

<section class="product-main">

<!-- GALLERY -->
<div class="product-gallery">
<div class="product-gallery-main">
<img src="{{ selected_variant.featured_image | default: product.featured_image | img_url: '800x800', crop: 'center' }}"
alt="{{ product.title | escape }}"
id="product-main-img"
class="product-main-img">
</div>
<div class="product-thumbs">
{%- for image in product.images limit: 6 -%}
<button class="product-thumb{% if forloop.first %} active{% endif %}"
data-src="{{ image | img_url: '800x800', crop: 'center' }}">
<img src="{{ image | img_url: '160x160', crop: 'center' }}" alt="{{ product.title | escape }}">
</button>
{%- endfor -%}
</div>
</div>

<!-- INFO -->
<div class="product-info">
<h1 class="product-title">{{ product.title }}</h1>

{%- assign is_apparel = false -%}
{%- assign is_premade = false -%}
{%- assign is_bundle = false -%}
{%- if product.type == 'Custom Hat Bundle' -%}{%- assign is_bundle = true -%}{%- endif -%}
{%- for col in product.collections -%}
  {%- if col.handle == 'apparel' -%}{%- assign is_apparel = true -%}{%- endif -%}
  {%- if col.handle == 'pre-made-hats' -%}{%- assign is_premade = true -%}{%- endif -%}
{%- endfor -%}
{%- unless is_apparel -%}
<!-- Start of Judge.me code -->
<div style='margin-bottom: 0.75rem;' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
{{ product.metafields.judgeme.badge }}
</div>
<!-- End of Judge.me code -->
{%- endunless -%}

<div class="product-price-row">
<p class="product-price" id="product-price">{{ selected_variant.price | money }}</p>

</div>

{%- form 'product', product, id: 'product-form', enctype: 'multipart/form-data' -%}
<input type="hidden" name="id" id="variant-id" value="{{ selected_variant.id }}">

{%- unless product.has_only_default_variant -%}
{%- for option in product.options_with_values -%}
<div class="product-option">
<p class="option-label">{{ option.name }}: <span class="option-selected" id="option-{{ forloop.index0 }}-label">{{ option.selected_value }}</span></p>
<div class="option-swatches">
{%- for value in option.values -%}
{%- assign opt_idx = forloop.parentloop.index0 -%}
{%- for variant in product.variants -%}
{%- if variant.option1 == value or variant.option2 == value -%}
<button type="button"
class="swatch{% if value == option.selected_value %} active{% endif %}"
data-value="{{ value | escape }}"
data-option-index="{{ opt_idx }}"
data-variant-id="{{ variant.id }}"
data-variant-price="{{ variant.price }}"
data-variant-available="{{ variant.available }}"
data-variant-image="{% if variant.featured_image %}{{ variant.featured_image | img_url: '800x800', crop: 'center' }}{% endif %}">
{{ value }}
</button>
{%- break -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
</div>
</div>
{%- endfor -%}
{%- endunless -%}

{%- if is_bundle -%}
<style>
.bundle-opts{margin:18px 0;display:flex;flex-direction:column;gap:16px}
.bundle-opt-label{display:block;font-weight:600;font-size:15px;margin-bottom:6px;color:#14121C}
.bundle-req{color:#5028AA}
.bundle-select,.bundle-file{width:100%;border:1.5px solid #E2E0EA;border-radius:10px;padding:12px 14px;font-size:15px;font-family:inherit;background:#fff}
.bundle-select:focus,.bundle-file:focus{outline:2px solid #5028AA;border-color:#5028AA}
.bundle-file{padding:10px 14px}
.bundle-hint{font-size:13px;color:#6B6A78;margin:6px 0 0;line-height:1.5}
.bundle-notice{margin-top:12px;background:#F3EFFC;border-left:5px solid #5028AA;border-radius:8px;padding:12px 14px;display:flex;gap:10px;align-items:flex-start}
.bundle-notice-icon{flex-shrink:0;width:20px;height:20px;border-radius:50%;background:#5028AA;color:#fff;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;line-height:1}
.bundle-notice p{margin:0;font-size:13px;line-height:1.55;color:#14121C}
.bundle-notice strong{color:#5028AA}
.bundle-en-toggle{margin-top:8px;background:none;border:none;padding:0;color:#5028AA;font-weight:700;font-size:13px;font-family:inherit;cursor:pointer;text-decoration:underline;display:inline-flex;align-items:center;gap:5px}
.bundle-en-toggle::after{content:"▾";font-size:11px}
.bundle-en-toggle[aria-expanded="true"]::after{content:"▴"}
.bundle-en-example{margin-top:10px}
.bundle-en-example img{max-width:100%;border-radius:10px;border:1px solid #E2E0EA;display:block}
  .leadtime-notice{margin:14px 0 4px;font-size:14px;color:#3d3a4a;background:#F3EFFC;border:1px solid #E2E0EA;border-radius:10px;padding:10px 14px;}
  .leadtime-notice strong{color:#5028AA;}
  .fit-specs{margin:22px 0 0;padding:18px 20px;background:#fff;border:1px solid #E2E0EA;border-radius:12px;}
  .fit-specs-head{font-weight:700;font-size:15px;margin:0 0 10px;color:#14121C;}
  .fit-specs ul{margin:0;padding-left:18px;}
  .fit-specs li{font-size:14px;line-height:1.6;color:#3d3a4a;margin-bottom:6px;}
  .fit-specs-note{font-size:13px;color:#6B6A78;margin:10px 0 0;}
</style>
<div class="bundle-opts">
<div class="bundle-opt">
<label class="bundle-opt-label" for="logo-placement">Logo placement <span class="bundle-req">*</span></label>
<select id="logo-placement" name="properties[Logo placement]" class="bundle-select" required>
<option value="">Choose placement...</option>
<option value="Centered front">Centered front</option>
<option value="Left panel">Left panel</option>
<option value="Right panel">Right panel</option>
</select>
</div>
<div class="bundle-opt">
<label class="bundle-opt-label" for="logo-file">Upload your logo <span class="bundle-req">*</span></label>
<input type="file" id="logo-file" name="properties[Logo file]" class="bundle-file" accept="image/*,.pdf,.ai,.eps,.svg,.png,.jpg,.jpeg" required>
<p class="bundle-hint">Front embroidery. PNG, JPG, PDF, AI, EPS, or SVG. We'll confirm your design before stitching.</p>
<div class="bundle-notice">
<span class="bundle-notice-icon">!</span>
<div>
<p><strong>Embroidery Notice:</strong> AI-generated and highly detailed logos don't always translate well to embroidery. If your design isn't suitable, we'll recommend the best solution, such as simplifying the artwork, using a DTF transfer, or a patch to ensure the best possible result.</p>
<button type="button" class="bundle-en-toggle" onclick="var ex=document.getElementById('bundleEnExample');var sh=ex.hasAttribute('hidden');if(sh){ex.removeAttribute('hidden');this.setAttribute('aria-expanded','true');this.firstChild.textContent='Hide example';}else{ex.setAttribute('hidden','');this.setAttribute('aria-expanded','false');this.firstChild.textContent='View example';}" aria-expanded="false">View example</button>
<div class="bundle-en-example" id="bundleEnExample" hidden>
<img src="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/ChatGPT_Image_Aug_14_2026_at_10_40_32_PM.png?v=1786761670" alt="Example showing how a detailed logo simplifies for embroidery" loading="lazy">
</div>
</div>
</div>
</div>
</div>
{%- endif -%}

{%- if is_premade -%}
<p class="leadtime-notice">Embroidered to order &middot; ships in <strong>2-5 business days</strong></p>
{%- endif -%}

<div class="product-actions">
<div class="qty-wrap">
<button type="button" class="qty-btn" id="qty-minus">−</button>
<input type="number" name="quantity" value="1" min="1" id="qty-input" class="qty-input">
<button type="button" class="qty-btn" id="qty-plus">+</button>
</div>
{%- if is_premade -%}
<button type="submit" name="add" class="btn btn-fill product-atc" id="atc-btn">
{%- if selected_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
</button>
{%- else -%}
<button type="submit" name="add" class="btn btn-fill product-atc" id="atc-btn">
{%- if selected_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
</button>
{%- endif -%}
</div>

<div class="product-trust-row" style="justify-content:center;">
<span class="ptr-item">
<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
Secure checkout
</span>
<span class="ptr-sep">·</span>
<span class="ptr-item">
<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
Free shipping
</span>
<span class="ptr-sep">·</span>
<span class="ptr-item">✦ Made in NC</span>
</div>

{%- if product.metafields.custom.sticker_url != blank -%}
<a href="{{ product.metafields.custom.sticker_url }}" class="sticker-upsell">
<span class="sticker-upsell-icon">🔖</span>
<div>
<p class="sticker-upsell-title">Also available as a sticker pack</p>
<p class="sticker-upsell-sub">Get this design as a sticker. Tap to shop.</p>
</div>
<span class="sticker-upsell-arrow">→</span>
</a>
{%- endif -%}

{%- endform -%}

<div class="product-desc">{{ product.description }}</div>

<div class="fit-specs">
  <p class="fit-specs-head">Fit &amp; sizing</p>
  <ul>
    <li><strong>One size fits most adults.</strong> Adjustable snapback closure, generally fits about 6 5/8 to 7 5/8.</li>
    <li>Structured crown that holds its shape.</li>
    <li>Embroidered in-house in Burlington, NC.</li>
  </ul>
  <p class="fit-specs-note">Head sizes vary. If you are near the top of that range, the snapback opens to its widest setting.</p>
</div>
</div>

</div>
</section>

<section class="product-reviews-wrap">
<!-- Start of Judge.me code -->{% assign has_legacy = false %}{% if product.metafields.judgeme.widget.size > 20 %}{% assign has_legacy = true %}{% endif %}<div style='clear:both'></div><div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-product-id='{{ product.id }}' data-widget='review' data-auto-install='false' data-shop-reviews-count='{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}' data-entry-point='review_widget.js' data-entry-key='review-widget/main.js'>{% if has_legacy %}<div class='jdgm-legacy-widget-content' style='display: none;'>{{ product.metafields.judgeme.widget }}</div>{% endif %}</div>{% if product.metafields.judgeme.review_widget_data %}<script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>{% endif %}<!-- End of Judge.me code -->
</section>

{%- if product.metafields.custom.wild_photo_1 != blank -%}
<section class="in-the-wild">
<div class="wild-header">
<p class="eyebrow reveal">
{%- if product.metafields.custom.wild_location != blank -%}
Spotted at {{ product.metafields.custom.wild_location }}
{%- else -%}
In The Wild
{%- endif -%}
</p>
<h2 class="reveal reveal-d1">In The Wild.</h2>
<p class="reveal reveal-d2">Real fans. Real games. Real hats.</p>
</div>
<div class="wild-photos{% if product.metafields.custom.wild_photo_2 == blank %} wild-photos--single{% endif %}">
<div class="wild-photo reveal">
<img src="{{ product.metafields.custom.wild_photo_1 | img_url: '800x800' }}" alt="{{ product.title | escape }} in the wild">
{%- if product.metafields.custom.wild_location != blank -%}
<div class="wild-tag">📍 {{ product.metafields.custom.wild_location }}</div>
{%- endif -%}
</div>
{%- if product.metafields.custom.wild_photo_2 != blank -%}
<div class="wild-photo reveal reveal-d1">
<img src="{{ product.metafields.custom.wild_photo_2 | img_url: '800x800' }}" alt="{{ product.title | escape }} in the wild">
{%- if product.metafields.custom.wild_location != blank -%}
<div class="wild-tag">📍 {{ product.metafields.custom.wild_location }}</div>
{%- endif -%}
</div>
{%- endif -%}
</div>
</section>
{%- endif -%}



{%- if product.collections.first.products.size > 1 -%}

<section class="related-products">
<p class="eyebrow reveal">Keep Browsing</p>
<h2 class="reveal reveal-d1">You May Also Like</h2>
<div class="related-grid">
{%- for related in product.collections.first.products limit: 5 -%}
{%- unless related.handle == product.handle -%}
<a href="{{ related.url }}" class="hat-card reveal">
<div class="hat-img-wrap">
<img src="{{ related.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ related.title | escape }}" class="hat-img">
</div>
<div class="hat-info">
<div class="hat-name">{{ related.title }}</div>
<div class="hat-price">{{ related.price | money }}</div>
</div>
</a>
{%- endunless -%}
{%- endfor -%}
</div>
</section>
{%- endif -%}

</div>

<script>
// Qty buttons
document.getElementById('qty-minus').addEventListener('click', function() {
  var i = document.getElementById('qty-input');
  i.value = Math.max(1, parseInt(i.value) - 1);
});
document.getElementById('qty-plus').addEventListener('click', function() {
  var i = document.getElementById('qty-input');
  i.value = parseInt(i.value) + 1;
});

// Thumbnail swap
document.querySelectorAll('.product-thumb').forEach(function(thumb) {
  thumb.addEventListener('click', function() {
    var main = document.getElementById('product-main-img');
    if (main) {
      main.style.opacity = '0';
      setTimeout(function() { main.src = thumb.dataset.src; main.style.opacity = '1'; }, 200);
    }
    document.querySelectorAll('.product-thumb').forEach(function(t) { t.classList.remove('active'); });
    thumb.classList.add('active');
  });
});

// Swatch click - update variant ID, image, label, AND PRICE
document.querySelectorAll('.swatch').forEach(function(swatch) {
  swatch.addEventListener('click', function() {
    if (swatch.disabled) return;
    var optIdx = swatch.dataset.optionIndex;
    document.querySelectorAll('.swatch[data-option-index="' + optIdx + '"]').forEach(function(s) { s.classList.remove('active'); });
    swatch.classList.add('active');

    // Update hidden variant ID
    var variantId = swatch.dataset.variantId;
    if (variantId) document.getElementById('variant-id').value = variantId;

    // Update image
    var variantImg = swatch.dataset.variantImage;
    if (variantImg) {
      var main = document.getElementById('product-main-img');
      if (main) {
        main.style.opacity = '0';
        setTimeout(function() { main.src = variantImg; main.style.opacity = '1'; }, 200);
      }
    }

    // Update option label
    var label = swatch.closest('.product-option').querySelector('.option-selected');
    if (label) label.textContent = swatch.dataset.value;

    // Update price
    var price = swatch.dataset.variantPrice;
    if (price) {
      var dollars = (parseInt(price) / 100).toFixed(2);
      var priceEl = document.getElementById('product-price');
      if (priceEl) priceEl.textContent = '$' + dollars;
    }

    // Update ATC availability
    var available = swatch.dataset.variantAvailable;
    var btn = document.getElementById('atc-btn');
    if (btn) {
      if (available === 'false') {
        btn.textContent = 'Sold Out';
        btn.style.opacity = '0.4';
        btn.style.cursor = 'not-allowed';
      } else {
        btn.textContent = 'Add to Cart';
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
      }
    }
  });
});

// Scroll reveal
var observer = new IntersectionObserver(function(entries) {
  entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(function(el) { observer.observe(el); });
</script>
