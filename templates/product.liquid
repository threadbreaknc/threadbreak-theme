<h2 class="reveal reveal-d1">You May Also Like</h2>
<div class="related-grid">
{%- for related in product.collections.first.products limit: 5 -%}
{%- unless related.handle == product.handle -%}
<a href="{{ related.url }}" class="hat-card reveal">
<div class="hat-img-wrap">
<img src="{{ related.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ related.title | escape }}" class="hat-img">
</div>
<div class="hat-info">
<div class="hat-name">{{ related.title }}</div>
<div class="hat-price">{{ related.price | money }}</div>
</div>
</a>
{%- endunless -%}
{%- endfor -%}
</div>
</section>
{%- endif -%}

</div>

<script>
// Qty buttons
document.getElementById('qty-minus').addEventListener('click', function() {
  var i = document.getElementById('qty-input');
  i.value = Math.max(1, parseInt(i.value) - 1);
});
document.getElementById('qty-plus').addEventListener('click', function() {
  var i = document.getElementById('qty-input');
  i.value = parseInt(i.value) + 1;
});

// Thumbnail swap
document.querySelectorAll('.product-thumb').forEach(function(thumb) {
  thumb.addEventListener('click', function() {
    var main = document.getElementById('product-main-img');
    if (main) {
      main.style.opacity = '0';
      setTimeout(function() { main.src = thumb.dataset.src; main.style.opacity = '1'; }, 200);
    }
    document.querySelectorAll('.product-thumb').forEach(function(t) { t.classList.remove('active'); });
    thumb.classList.add('active');
  });
});

// Swatch click - update variant ID, image, label, AND PRICE
// open/close the thumbnail dropdowns
// texting a proof needs a number; Shopify's checkout phone is optional
(function(){
  var sel = document.getElementById('proof-method');
  if (!sel) return;
  var wrap = document.getElementById('proof-phone-wrap');
  var phone = document.getElementById('proof-phone');
  var hint = document.getElementById('proof-hint');
  sel.addEventListener('change', function(){
    var isText = sel.value === 'Text message';
    if (wrap){ if (isText) wrap.removeAttribute('hidden'); else { wrap.setAttribute('hidden',''); if (phone) phone.value=''; } }
    if (phone) phone.required = isText;
    if (hint) hint.textContent = isText
      ? "We'll text your mockup from (336) 585-6176 within one business day. Nothing gets stitched until you approve it."
      : "We'll email your mockup from help@threadbreak.com within one business day. Nothing gets stitched until you approve it.";
  });
})();

document.querySelectorAll('.opt-dd-btn').forEach(function(btn){
  btn.addEventListener('click', function(e){
    e.stopPropagation();
    var menu = document.getElementById('optdd-menu-' + btn.dataset.optdd);
    if (!menu) return;
    var open = !menu.hasAttribute('hidden');
    document.querySelectorAll('.opt-dd-menu').forEach(function(m){ m.setAttribute('hidden',''); });
    document.querySelectorAll('.opt-dd-btn').forEach(function(b){ b.setAttribute('aria-expanded','false'); });
    if (!open) { menu.removeAttribute('hidden'); btn.setAttribute('aria-expanded','true'); }
  });
});
document.addEventListener('click', function(){
  document.querySelectorAll('.opt-dd-menu').forEach(function(m){ m.setAttribute('hidden',''); });
  document.querySelectorAll('.opt-dd-btn').forEach(function(b){ b.setAttribute('aria-expanded','false'); });
});
document.querySelectorAll('.opt-dd-menu').forEach(function(m){ m.addEventListener('click', function(e){ e.stopPropagation(); }); });

// seed the dropdown trigger with the initially selected thumbnail
document.querySelectorAll('.option-swatches.as-dropdown').forEach(function(wrap){
  var active = wrap.querySelector('.opt-dd-opt.active') || wrap.querySelector('.opt-dd-opt');
  var trigger = wrap.querySelector('.opt-dd-btn');
  if (active && trigger) {
    var th = active.dataset.variantThumb;
    var tw = trigger.querySelector('.opt-dd-thumb-wrap');
    if (tw && th) tw.innerHTML = '<img src="' + th + '" alt="">';
  }
});

document.querySelectorAll('.swatch, .opt-dd-opt').forEach(function(swatch) {
  swatch.addEventListener('click', function() {
    if (swatch.disabled) return;
    var optIdx = swatch.dataset.optionIndex;
    document.querySelectorAll('.swatch[data-option-index="' + optIdx + '"], .opt-dd-opt[data-option-index="' + optIdx + '"]').forEach(function(s) { s.classList.remove('active'); });
    swatch.classList.add('active');

    // dropdown: reflect the pick on the trigger button, then close
    var menu = swatch.closest('.opt-dd-menu');
    if (menu) {
      var wrap = swatch.closest('.option-swatches');
      var trigger = wrap.querySelector('.opt-dd-btn');
      if (trigger) {
        trigger.querySelector('.opt-dd-current').textContent = swatch.dataset.value;
        var tw = trigger.querySelector('.opt-dd-thumb-wrap');
        var th = swatch.dataset.variantThumb;
        if (tw) tw.innerHTML = th ? '<img src="' + th + '" alt="">' : '';
        trigger.setAttribute('aria-expanded','false');
      }
      menu.setAttribute('hidden','');
    }

    // sale banner for discounted variants
    var cmp = parseInt(swatch.dataset.variantCompare || '0');
    var pr = parseInt(swatch.dataset.variantPrice || '0');
    var banner = document.getElementById('saleBanner');
    if (banner) {
      if (cmp > pr) {
        var save = ((cmp - pr) / 100).toFixed(0);
        banner.innerHTML = '<span class="sb-save">Save $' + save + '</span><span><strong>' + swatch.dataset.value + '</strong> is on sale, was $' + (cmp/100).toFixed(2).replace(/\.00$/,'') + '. Limited stock at this price.</span>';
        banner.style.display = 'flex';
      } else {
        banner.style.display = 'none';
      }
    }

    // Update hidden variant ID
    var variantId = swatch.dataset.variantId;
    if (variantId) document.getElementById('variant-id').value = variantId;

    // Update image
    var variantImg = swatch.dataset.variantImage;
    if (variantImg) {
      var main = document.getElementById('product-main-img');
      if (main) {
        main.style.opacity = '0';
        setTimeout(function() { main.src = variantImg; main.style.opacity = '1'; }, 200);
      }
    }

    // Update option label
    var label = swatch.closest('.product-option').querySelector('.option-selected');
    if (label) label.textContent = swatch.dataset.value;

    // Update price
    var price = swatch.dataset.variantPrice;
    if (price) {
      var dollars = (parseInt(price) / 100).toFixed(2);
      var priceEl = document.getElementById('product-price');
      if (priceEl) priceEl.textContent = '$' + dollars;
      var wasEl = document.querySelector('.product-price-was');
      var cmpv = parseInt(swatch.dataset.variantCompare || '0');
      if (wasEl) {
        if (cmpv > parseInt(price)) { wasEl.textContent = '$' + (cmpv/100).toFixed(2); wasEl.style.display = ''; }
        else { wasEl.style.display = 'none'; }
      }
    }

    // Update ATC availability
    var available = swatch.dataset.variantAvailable;
    var btn = document.getElementById('atc-btn');
    if (btn) {
      if (available === 'false') {
        btn.textContent = 'Sold Out';
        btn.style.opacity = '0.4';
        btn.style.cursor = 'not-allowed';
      } else {
        btn.textContent = 'Add to Cart';
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
      }
    }
  });
});

// Scroll reveal
var observer = new IntersectionObserver(function(entries) {
  entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(function(el) { observer.observe(el); });
</script>
