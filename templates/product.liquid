{%- comment -%} brand mark, matched off vendor or title {%- endcomment -%}
{%- assign brand_logo = "" -%}
{%- assign brand_alt = "" -%}
{%- assign vt = product.vendor | append: " " | append: product.title | downcase -%}
{%- if vt contains "richardson" -%}
  {%- assign brand_logo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/richardson.png?v=1787437321" -%}{%- assign brand_alt = "Richardson" -%}
{%- elsif vt contains "yupoong" or vt contains "yp classics" -%}
  {%- assign brand_logo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/yupoong.png?v=1787437321" -%}{%- assign brand_alt = "Yupoong" -%}
{%- elsif vt contains "atonal" -%}
  {%- assign brand_logo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/atonal.png?v=1787437321" -%}{%- assign brand_alt = "Atonal" -%}
{%- elsif vt contains "otto" -%}
  {%- assign brand_logo = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/otoo.png?v=1787437321" -%}{%- assign brand_alt = "Otto" -%}
{%- endif -%}

{%- assign selected_variant = product.selected_or_first_available_variant -%}
<div class="product-page">

<section class="product-main">

<!-- GALLERY -->
<div class="product-gallery">
<div class="product-gallery-main">
<img src="{{ selected_variant.featured_image | default: product.featured_image | img_url: '800x800', crop: 'center' }}"
alt="{{ product.title | escape }}"
id="product-main-img"
class="product-main-img">
{%- if brand_logo != blank -%}
<img class="gallery-brand" src="{{ brand_logo }}" alt="{{ brand_alt }}" loading="lazy">
{%- endif -%}
</div>
<div class="product-thumbs">
{%- for image in product.images limit: 6 -%}
<button class="product-thumb{% if forloop.first %} active{% endif %}"
data-src="{{ image | img_url: '800x800', crop: 'center' }}">
<img src="{{ image | img_url: '160x160', crop: 'center' }}" alt="{{ product.title | escape }}">
</button>
{%- endfor -%}
</div>
</div>

<!-- INFO -->
<div class="product-info">
<h1 class="product-title">{{ product.title }}</h1>
{%- assign title_is_bundle = false -%}
{%- if product.type == 'Custom Hat Bundle' -%}{%- assign title_is_bundle = true -%}{%- endif -%}
{%- if title_is_bundle -%}
  {%- assign jm = shop.metafields.judgeme -%}
  <a href="/pages/reviews" class="bundle-trust">
    <span class="bt-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
    <span class="bt-text"><strong>{{ jm.all_reviews_rating | default: 5.0 | round: 1 }} out of 5</strong> from {{ jm.all_reviews_count | default: 45 }} verified customer reviews</span>
  </a>
{%- endif -%}

{%- assign is_apparel = false -%}
{%- assign is_premade = false -%}
{%- assign is_clearance = false -%}
{%- assign is_bundle = false -%}
{%- if product.type == 'Custom Hat Bundle' -%}{%- assign is_bundle = true -%}{%- endif -%}
{%- for col in product.collections -%}
  {%- if col.handle == 'apparel' -%}{%- assign is_apparel = true -%}{%- endif -%}
  {%- if col.handle == 'pre-made-hats' -%}{%- assign is_premade = true -%}{%- endif -%}
  {%- if col.handle contains 'clearance' -%}{%- assign is_clearance = true -%}{%- endif -%}
{%- endfor -%}
{%- unless is_apparel -%}
<!-- Start of Judge.me code -->
<div style='margin-bottom: 0.75rem;' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
{{ product.metafields.judgeme.badge }}
</div>
<!-- End of Judge.me code -->
{%- endunless -%}

<div class="product-price-row">
<p class="product-price" id="product-price">{{ selected_variant.price | money }}</p>
{%- if selected_variant.compare_at_price > selected_variant.price -%}
<s class="product-price-was">{{ selected_variant.compare_at_price | money }}</s>
{%- else -%}
<s class="product-price-was" style="display:none"></s>
{%- endif -%}

</div>
{%- assign any_sale = false -%}
{%- for v in product.variants -%}{%- if v.compare_at_price > v.price -%}{%- assign any_sale = true -%}{%- endif -%}{%- endfor -%}
{%- if any_sale -%}
<div class="sale-banner" id="saleBanner"{% unless selected_variant.compare_at_price > selected_variant.price %} style="display:none"{% endunless %}>
  {%- if selected_variant.compare_at_price > selected_variant.price -%}
    {%- assign save = selected_variant.compare_at_price | minus: selected_variant.price | divided_by: 100 -%}
    <span class="sb-save">Save ${{ save }}</span>
    <span><strong>{{ selected_variant.title }}</strong> is on sale, was {{ selected_variant.compare_at_price | money }}. Limited stock at this price.</span>
  {%- endif -%}
</div>
{%- endif -%}


{%- form 'product', product, id: 'product-form', enctype: 'multipart/form-data' -%}
<input type="hidden" name="id" id="variant-id" value="{{ selected_variant.id }}">

{%- unless product.has_only_default_variant -%}
{%- for option in product.options_with_values -%}
<div class="product-option">
<p class="option-label">{{ option.name }}: <span class="option-selected" id="option-{{ forloop.index0 }}-label">{{ option.selected_value }}</span></p>
{%- comment -%}
  Many colors would make a wall of buttons, so anything over 8 values renders as a
  thumbnail dropdown instead. Same data attributes either way, so the JS is shared.
{%- endcomment -%}
{%- comment -%}
  Use the thumbnail dropdown whenever the variants actually have photos, rather
  than guessing from how many colors there are. A 3-color hat benefits from
  seeing the colorway just as much as a 17-color one.
{%- endcomment -%}
{%- assign many = false -%}
{%- assign has_variant_photos = false -%}
{%- for v in product.variants -%}
  {%- if v.featured_image -%}{%- assign has_variant_photos = true -%}{%- break -%}{%- endif -%}
{%- endfor -%}
{%- if has_variant_photos and option.name == "Color" -%}{%- assign many = true -%}{%- endif -%}
{%- comment -%} no photos to show, so a long list still reads better as a dropdown {%- endcomment -%}
{%- if option.values.size > 8 -%}{%- assign many = true -%}{%- endif -%}
{%- comment -%} alphabetical, with any "Mix" option pushed to the end {%- endcomment -%}
{%- assign sorted_values = option.values | sort -%}
{%- assign mix_value = "" -%}
{%- for v in sorted_values -%}
  {%- assign vd = v | downcase -%}
  {%- if vd contains "mix" -%}{%- assign mix_value = v -%}{%- endif -%}
{%- endfor -%}
{%- assign color_count = option.values.size -%}
{%- if mix_value != "" -%}{%- assign color_count = color_count | minus: 1 -%}{%- endif -%}

<div class="option-swatches{% if many %} as-dropdown{% endif %}">
{%- if many -%}
  <button type="button" class="opt-dd-btn" data-optdd="{{ forloop.index0 }}" aria-expanded="false">
    <span class="opt-dd-thumb-wrap" id="optdd-thumb-{{ forloop.index0 }}"></span>
    <span class="opt-dd-current">{{ option.selected_value }}</span>
    <svg class="opt-dd-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
  </button>
  <div class="opt-dd-menu" id="optdd-menu-{{ forloop.index0 }}" hidden>
{%- endif -%}

{%- for value in sorted_values -%}
{%- if value == mix_value -%}{%- continue -%}{%- endif -%}
{%- assign opt_idx = forloop.parentloop.index0 -%}
{%- for variant in product.variants -%}
{%- if variant.option1 == value or variant.option2 == value -%}
{%- assign on_sale = false -%}
{%- if variant.compare_at_price > variant.price -%}{%- assign on_sale = true -%}{%- endif -%}
<button type="button"
class="{% if many %}opt-dd-opt{% else %}swatch{% endif %}{% if value == option.selected_value %} active{% endif %}{% if on_sale %} is-sale{% endif %}"
data-value="{{ value | escape }}"
data-option-index="{{ opt_idx }}"
data-variant-id="{{ variant.id }}"
data-variant-price="{{ variant.price }}"
data-variant-compare="{{ variant.compare_at_price | default: 0 }}"
data-variant-available="{{ variant.available }}"
data-variant-image="{% if variant.featured_image %}{{ variant.featured_image | img_url: '800x800', crop: 'center' }}{% endif %}"
data-variant-thumb="{% if variant.featured_image %}{{ variant.featured_image | img_url: '96x96', crop: 'center' }}{% endif %}">
{%- if many and variant.featured_image -%}<img class="opt-dd-thumb" src="{{ variant.featured_image | img_url: '96x96', crop: 'center' }}" alt="{{ value | escape }}" loading="lazy">{%- endif -%}
<span class="opt-dd-name">{{ value }}</span>
{%- if on_sale -%}<span class="opt-sale-tag">Sale</span>{%- endif -%}
</button>
{%- break -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}

{%- if mix_value != "" -%}
  {%- for variant in product.variants -%}
  {%- if variant.option1 == mix_value -%}
  <button type="button"
  class="{% if many %}opt-dd-opt{% else %}swatch{% endif %} is-mix{% if mix_value == option.selected_value %} active{% endif %}"
  data-value="{{ mix_value | escape }}"
  data-option-index="0"
  data-variant-id="{{ variant.id }}"
  data-variant-price="{{ variant.price }}"
  data-variant-compare="{{ variant.compare_at_price | default: 0 }}"
  data-variant-available="{{ variant.available }}"
  data-is-mix="1"
  data-variant-image="{% if variant.featured_image %}{{ variant.featured_image | img_url: '800x800', crop: 'center' }}{% endif %}"
  data-variant-thumb="{% if variant.featured_image %}{{ variant.featured_image | img_url: '96x96', crop: 'center' }}{% endif %}">
  {%- if many -%}<span class="opt-dd-wheel"></span>{%- endif -%}
  <span class="opt-dd-name">Mix colors</span>
  </button>
  {%- break -%}
  {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if many -%}
  </div>
{%- endif -%}
</div>
{%- if option.name == "Color" -%}
<p class="color-count"><span class="color-wheel"></span>{{ color_count }} colors available{% if mix_value != "" %} &middot; mix any of them{% endif %}</p>
{%- endif -%}
</div>
{%- endfor -%}
{%- endunless -%}

{%- if is_bundle -%}
<style>
.bundle-opts{margin:18px 0;display:flex;flex-direction:column;gap:16px}
.bundle-opt-label{display:block;font-weight:600;font-size:15px;margin-bottom:6px;color:#14121C}
.bundle-req{color:#5028AA}
.bundle-select,.bundle-file{width:100%;border:1.5px solid #E2E0EA;border-radius:10px;padding:12px 14px;font-size:15px;font-family:inherit;background:#fff}
.bundle-select:focus,.bundle-file:focus{outline:2px solid #5028AA;border-color:#5028AA}
.bundle-file{padding:10px 14px}
.bundle-hint{font-size:13px;color:#6B6A78;margin:6px 0 0;line-height:1.5}
.bundle-hint a{color:#5028AA;font-weight:600;text-decoration:underline}
.bundle-hint strong{color:#14121C}
/* a class-level display would beat the browser default [hidden]{display:none},
   so force it or the proof phone field shows before text is selected */
.bundle-opt[hidden]{display:none !important}
.bundle-notice{margin-top:12px;background:#F3EFFC;border-left:5px solid #5028AA;border-radius:8px;padding:12px 14px;display:flex;gap:10px;align-items:flex-start}
.bundle-notice-icon{flex-shrink:0;width:20px;height:20px;border-radius:50%;background:#5028AA;color:#fff;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;line-height:1}
.bundle-notice p{margin:0;font-size:13px;line-height:1.55;color:#14121C}
.bundle-notice strong{color:#5028AA}
.bundle-en-toggle{margin-top:8px;background:none;border:none;padding:0;color:#5028AA;font-weight:700;font-size:13px;font-family:inherit;cursor:pointer;text-decoration:underline;display:inline-flex;align-items:center;gap:5px}
.bundle-en-toggle::after{content:"▾";font-size:11px}
.bundle-en-toggle[aria-expanded="true"]::after{content:"▴"}
.bundle-en-example{margin-top:10px}
.bundle-en-example img{max-width:100%;border-radius:10px;border:1px solid #E2E0EA;display:block}
  .leadtime-notice{margin:14px 0 4px;font-size:14px;color:#3d3a4a;background:#F3EFFC;border:1px solid #E2E0EA;border-radius:10px;padding:10px 14px;}
  .leadtime-notice strong{color:#5028AA;}
  .fit-specs{margin:22px 0 0;padding:18px 20px;background:#fff;border:1px solid #E2E0EA;border-radius:12px;}
  .fit-specs-head{font-weight:700;font-size:15px;margin:0 0 10px;color:#14121C;}
  .fit-specs ul{margin:0;padding-left:18px;}
  .fit-specs li{font-size:14px;line-height:1.6;color:#3d3a4a;margin-bottom:6px;}
  .fit-specs-note{font-size:13px;color:#6B6A78;margin:10px 0 0;}
  .product-price-was{margin-left:8px;font-size:0.8em;color:#8b8996;text-decoration:line-through;}
  /* thumbnail dropdown for options with many values */
  .option-swatches.as-dropdown{position:relative;max-width:420px}
  .opt-dd-btn{width:100%;display:flex;align-items:center;gap:11px;background:#fff;border:1.5px solid #E2E0EA;border-radius:11px;padding:9px 13px;font-family:inherit;font-size:15px;cursor:pointer;text-align:left;color:#14121C}
  .opt-dd-btn:hover{border-color:#B7A6EE}
  .opt-dd-current{flex:1}
  .opt-dd-chev{flex:0 0 auto;transition:transform .18s}
  .opt-dd-btn[aria-expanded="true"] .opt-dd-chev{transform:rotate(180deg)}
  .opt-dd-thumb-wrap img{width:40px;height:40px;object-fit:contain;border-radius:7px;border:1px solid #E2E0EA;display:block}
  .opt-dd-menu{position:absolute;z-index:40;top:calc(100% + 6px);left:0;right:0;max-height:300px;overflow-y:auto;background:#fff;border:1.5px solid #E2E0EA;border-radius:12px;box-shadow:0 14px 34px rgba(20,18,28,.16);scrollbar-width:thin}
  .opt-dd-menu::-webkit-scrollbar{width:9px}
  .opt-dd-menu::-webkit-scrollbar-thumb{background:#B7A6EE;border-radius:9px;border:2px solid #fff}
  .opt-dd-opt{width:100%;display:flex;align-items:center;gap:11px;padding:8px 12px;background:none;border:none;border-bottom:1px solid #f2f1f6;font-family:inherit;font-size:14px;cursor:pointer;text-align:left;color:#14121C}
  .opt-dd-opt:last-child{border-bottom:none}
  .opt-dd-opt:hover{background:#F3EFFC}
  .opt-dd-opt.active{background:#eee9fb;font-weight:600}
  .opt-dd-opt img{width:44px;height:44px;object-fit:contain;border-radius:7px;border:1px solid #E2E0EA;flex:0 0 auto}
  .opt-dd-name{flex:1}
  /* sale styling */
  .opt-sale-tag{background:#C62828;color:#fff;font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border-radius:999px;padding:2px 8px;flex:0 0 auto}
  .opt-dd-opt.is-sale .opt-dd-name{color:#C62828;font-weight:700}
  .swatch.is-sale{border-color:#C62828;color:#C62828;font-weight:700}
  .sale-banner{display:flex;align-items:center;gap:10px;background:#FDECEC;border:1.5px solid #C62828;border-left:5px solid #C62828;border-radius:11px;padding:12px 15px;margin:14px 0;font-size:14px;line-height:1.5}
  .sale-banner strong{color:#C62828}
  .sale-banner .sb-save{background:#C62828;color:#fff;border-radius:999px;padding:3px 10px;font-size:12px;font-weight:700;white-space:nowrap}
  .color-wheel,.opt-dd-wheel{width:18px;height:18px;border-radius:50%;flex:0 0 auto;display:inline-block;vertical-align:-4px;border:1px solid rgba(0,0,0,.12);
    background:conic-gradient(#e23b3b,#e2a13b,#d7e23b,#4ce23b,#3be2c0,#3b8fe2,#7a3be2,#e23bc0,#e23b3b)}
  .opt-dd-wheel{width:44px;height:44px;border-radius:7px;vertical-align:middle}
  .color-count{display:flex;align-items:center;gap:8px;margin-top:9px;font-size:13px;color:#6B6A78}
  .opt-dd-opt.is-mix .opt-dd-name,.swatch.is-mix{font-weight:700}
  /* product description needs real spacing between paragraphs */
  .product-desc p{margin:0 0 1.1em;line-height:1.65}
  .product-desc h3{font-size:16px;font-weight:700;color:#14121C;margin:1.8em 0 .7em}
  .product-desc h3:first-child{margin-top:0}
  .product-desc p:last-child{margin-bottom:0}
  .product-desc ul{margin:0 0 1.1em;padding-left:20px}
  .product-desc li{margin-bottom:.45em;line-height:1.6}
  .product-desc strong{color:#14121C}
  .bundle-trust{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:16px 0 12px;padding:11px 14px;background:#F3EFFC;border:1px solid #E2E0EA;border-radius:11px;text-decoration:none;color:#14121C;transition:border-color .15s}
  .bundle-trust:hover{border-color:#5028AA}
  .bt-stars{color:#F5C518;font-size:17px;letter-spacing:2px;flex:0 0 auto}
  .bt-text{font-size:13.5px;color:#3d3a4a}
  .bt-text strong{color:#14121C}
  /* theme.css wraps thumbs onto a second row on phones; keep them to one
     scrollable row instead so the gallery reads as a single strip. */
  @media(max-width:600px){
    .product-thumbs{flex-wrap:nowrap !important;overflow-x:auto;gap:7px !important;
      padding-bottom:4px;scrollbar-width:none;-webkit-overflow-scrolling:touch;justify-content:flex-start !important;}
    .product-thumbs::-webkit-scrollbar{display:none;}
    .product-thumb{width:56px !important;height:56px !important;flex:0 0 auto;}
  }
  /* .gallery-brand badge sizing now lives in theme.css (global) so it applies
     to every product template, not just Custom Hat Bundle pages. */
  /* tighter vertical rhythm between title, rating and price */
  .product-title{margin-bottom:8px}
  .bundle-trust{margin:0 0 10px}
  .product-price-row{margin:0 0 10px}
  /* the native file control blends in, so give it a real button */
  .bundle-file::file-selector-button,
  .bundle-file::-webkit-file-upload-button{
    font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:.04em;
    background:#5028AA;color:#fff;border:none;border-radius:9px;
    padding:9px 18px;margin-right:11px;cursor:pointer;transition:background .15s;}
  .bundle-file::file-selector-button:hover{background:#6234c9;}
  .bundle-file{cursor:pointer;font-size:13px;color:#6B6A78;}
</style>
<div class="bundle-opts">
<div class="bundle-opt">
<label class="bundle-opt-label" for="logo-placement">Front logo placement <span class="bundle-req">*</span></label>
<select id="logo-placement" name="properties[Front logo placement]" class="bundle-select" required>
<option value="">Choose placement...</option>
<option value="Centered">Centered</option>
<option value="Left panel">Left panel</option>
<option value="Right panel">Right panel</option>
</select>
<p class="bundle-hint">Left and right are as <strong>you see the hat</strong>, not as the wearer sees it. Picture the hat facing you: the left panel is on your left.</p>
<p class="bundle-hint">This package includes front embroidery only. Need a logo on the side or back? Build it on our <a href="/pages/custom-order">custom order page</a>.</p>
</div>
<div class="bundle-opt">
<label class="bundle-opt-label" for="proof-method">How should we send your proof? <span class="bundle-req">*</span></label>
<select id="proof-method" name="properties[Proof delivery]" class="bundle-select" required>
<option value="">Choose one...</option>
<option value="Email">Email</option>
<option value="Text message">Text message</option>
</select>
<p class="bundle-hint" id="proof-hint">We'll send your mockup within one business day. Nothing gets stitched until you approve it.</p>
</div>
<div class="bundle-opt" id="proof-phone-wrap" hidden>
<label class="bundle-opt-label" for="proof-phone">Mobile number for your proof <span class="bundle-req">*</span></label>
<input type="tel" id="proof-phone" name="properties[Proof phone]" class="bundle-select" inputmode="tel" autocomplete="tel" placeholder="(336) 555-0123">
</div>
<div class="bundle-opt">
<label class="bundle-opt-label" for="logo-file">Upload your logo <span class="bundle-req">*</span></label>
<input type="file" id="logo-file" name="properties[Logo file]" class="bundle-file" accept="image/*,.pdf,.ai,.eps,.svg,.png,.jpg,.jpeg" required>
<p class="bundle-hint">Front embroidery. PNG, JPG, PDF, AI, EPS, or SVG. We'll confirm your design before stitching.</p>
<div class="bundle-notice">
<span class="bundle-notice-icon">!</span>
<div>
<p><strong>Embroidery Notice:</strong> AI-generated and highly detailed logos don't always translate well to embroidery. If your design isn't suitable, we'll recommend the best solution, such as simplifying the artwork, using a DTF transfer, or a patch to ensure the best possible result.</p>
<button type="button" class="bundle-en-toggle" onclick="var ex=document.getElementById('bundleEnExample');var sh=ex.hasAttribute('hidden');if(sh){ex.removeAttribute('hidden');this.setAttribute('aria-expanded','true');this.firstChild.textContent='Hide example';}else{ex.setAttribute('hidden','');this.setAttribute('aria-expanded','false');this.firstChild.textContent='View example';}" aria-expanded="false">View example</button>
<div class="bundle-en-example" id="bundleEnExample" hidden>
<img src="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/ChatGPT_Image_Aug_14_2026_at_10_40_32_PM.png?v=1786761670" alt="Example showing how a detailed logo simplifies for embroidery" loading="lazy">
</div>
</div>
</div>
</div>
</div>
{%- endif -%}

{%- if is_clearance -%}
<p class="leadtime-notice">Ready to ship &middot; <strong>sold as-is</strong>, each hat has a disclosed cosmetic or production issue</p>
{%- elsif is_premade -%}
<p class="leadtime-notice">Embroidered to order &middot; ships in <strong>2-5 business days</strong></p>
{%- elsif is_apparel -%}
<p class="leadtime-notice">Printed to order &middot; ships in <strong>2-5 business days</strong></p>
{%- endif -%}

<div class="product-actions">
<div class="qty-wrap">
<button type="button" class="qty-btn" id="qty-minus">−</button>
<input type="number" name="quantity" value="1" min="1" id="qty-input" class="qty-input">
<button type="button" class="qty-btn" id="qty-plus">+</button>
</div>
{%- if is_premade -%}
<button type="submit" name="add" class="btn btn-fill product-atc" id="atc-btn">
{%- if selected_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
</button>
{%- else -%}
<button type="submit" name="add" class="btn btn-fill product-atc" id="atc-btn">
{%- if selected_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
</button>
{%- endif -%}
</div>

<div class="product-trust-row" style="justify-content:center;">
<span class="ptr-item">
<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
Secure checkout
