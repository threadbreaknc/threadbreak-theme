<script>
(function(){
  "use strict";
  var canvas = document.getElementById("pboCanvas");
  if (!canvas) return;
  var $ = function(id){ return document.getElementById(id); };

  var MATERIALS = [
    { id:"brushed_silver", name:"Brushed Silver", swatch:"https://cdn.shopify.com/s/files/1/0974/8453/7988/files/brushed_silver_black.jpg?v=1787885403" },
    { id:"saddle_tan", name:"Saddle Tan", swatch:"https://cdn.shopify.com/s/files/1/0974/8453/7988/files/saddle_tan_black.jpg?v=1787885402" },
    { id:"vintage_gray", name:"Vintage Gray", swatch:"https://cdn.shopify.com/s/files/1/0974/8453/7988/files/vintage_gray_black.webp?v=1787885403" },
    { id:"saddle_red", name:"Saddle Red", swatch:"https://cdn.shopify.com/s/files/1/0974/8453/7988/files/saddle_red_black.jpg?v=1787885403" },
    { id:"rawhide", name:"Rawhide", swatch:"https://cdn.shopify.com/s/files/1/0974/8453/7988/files/rawhide_black.webp?v=1787885402" },
    { id:"vintage_sky_blue", name:"Vintage Sky Blue", swatch:"https://cdn.shopify.com/s/files/1/0974/8453/7988/files/vintage_sky_blue_black.webp?v=1787885403" },
    { id:"vintage_caramel_brown", name:"Vintage Caramel Brown", swatch:"https://cdn.shopify.com/s/files/1/0974/8453/7988/files/vintage_caramel_brown_black.webp?v=1787885402", sample:{ cx:0.5, cy:0.78, w:0.42, h:0.22 } }
  ];
  var SHAPES = [
    { id:"rectangle", label:"Rectangle", ratio:1.633 },
    { id:"rounded",   label:"Rounded rectangle", ratio:1.633 },
    { id:"circle",    label:"Circle", ratio:1 },
    { id:"diecut",    label:"Die cut (follows your logo)", ratio:1.633 }
  ];
  var PLACEMENTS = [
    { id:"center", label:"Front center" },
    { id:"left",   label:"Front left" },
    { id:"right",  label:"Front right" }
  ];

  var state = {
    material: MATERIALS[0], shape: SHAPES[0], placement: PLACEMENTS[0],
    logoFile: null, logoImage: null, threshold: 140, invert: false, edge: "none",
    logoScale: 1, logoX: 0, logoY: 0
  };

  /* ---------- material preload + uniform-strip sampling ---------- */
  var matImageCache = {}, matPatternCanvasCache = {};
  function findUniformRegion(img){
    var w = img.naturalWidth, h = img.naturalHeight;
    if (!w || !h) return { x:0, y:0, w:1, h:1 };
    var c = document.createElement("canvas");
    c.width = w; c.height = h;
    var ctx = c.getContext("2d");
    ctx.drawImage(img, 0, 0);
    var marginX = Math.round(w * 0.1), marginY = Math.round(h * 0.1);
    var areaW = w - marginX * 2, areaH = h - marginY * 2;
    var cols = 6, rows = 6;
    var cw = Math.max(8, Math.floor(areaW / cols)), ch = Math.max(8, Math.floor(areaH / rows));
    var best = null;
    for (var ry = 0; ry < rows; ry++){
      for (var rx = 0; rx < cols; rx++){
        var x = marginX + rx * cw, y = marginY + ry * ch;
        if (x + cw > w || y + ch > h) continue;
        var data;
        try { data = ctx.getImageData(x, y, cw, ch).data; } catch(e){ continue; }
        var n = 0, sum = 0, sumsq = 0;
        for (var i = 0; i < data.length; i += 16){
          var l = 0.299*data[i] + 0.587*data[i+1] + 0.114*data[i+2];
          sum += l; sumsq += l*l; n++;
        }
        if (!n) continue;
        var mean = sum / n;
        var variance = Math.max(0, sumsq / n - mean * mean);
        if (!best || variance < best.variance) best = { x:x, y:y, w:cw, h:ch, variance:variance, mean:mean };
      }
    }
    return best || { x: marginX, y: marginY, w: areaW || w, h: areaH || h };
  }
  function explicitRegion(img, f){
    var W = img.naturalWidth, H = img.naturalHeight;
    var w = Math.max(8, Math.round(W * f.w)), h = Math.max(8, Math.round(H * f.h));
    var x = Math.round(W * f.cx - w / 2), y = Math.round(H * f.cy - h / 2);
    x = Math.max(0, Math.min(W - w, x));
    y = Math.max(0, Math.min(H - h, y));
    return { x:x, y:y, w:w, h:h };
  }
  function regionCanvas(img, region){
    var c = document.createElement("canvas");
    c.width = Math.max(1, region.w); c.height = Math.max(1, region.h);
    var ctx = c.getContext("2d");
    ctx.drawImage(img, region.x, region.y, region.w, region.h, 0, 0, region.w, region.h);
    return c;
  }
  function preloadMaterials(){
    MATERIALS.forEach(function(m){
      var img = new Image();
      img.crossOrigin = "anonymous";
      img.onload = function(){
        matImageCache[m.id] = img;
        try {
          var region = m.sample ? explicitRegion(img, m.sample) : findUniformRegion(img);
          matPatternCanvasCache[m.id] = regionCanvas(img, region);
        } catch(e){ /* CORS or decode failure: fall back to a flat fill below */ }
        if (state.material.id === m.id) draw();
      };
      img.onerror = function(){};
      img.src = m.swatch;
    });
  }

  /* ---------- canvas engraving preview ---------- */
  function roundRectPath(ctx, x, y, w, h, r){
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
  }
  function clipPath(ctx, shape, w, h, inset){
    ctx.beginPath();
    if (shape === "circle"){
      var r = Math.min(w, h) / 2 - inset;
      ctx.arc(w / 2, h / 2, r, 0, Math.PI * 2);
    } else if (shape === "rounded"){
      var rad = Math.min(w, h) * 0.14;
      roundRectPath(ctx, inset, inset, w - 2 * inset, h - 2 * inset, rad);
    } else {
      ctx.rect(inset, inset, w - 2 * inset, h - 2 * inset);
    }
    ctx.closePath();
  }
  function drawLogoInto(ctx, img, outW, outH){
    var pad = 0.86 * (state.logoScale || 1);
    var scale = Math.min((outW * pad) / img.naturalWidth, (outH * pad) / img.naturalHeight);
    var dw = img.naturalWidth * scale, dh = img.naturalHeight * scale;
    var dx = (outW - dw) / 2 + outW * (state.logoX || 0);
    var dy = (outH - dh) / 2 + outH * (state.logoY || 0);
    ctx.drawImage(img, dx, dy, dw, dh);
  }
  function buildInkMask(img, threshold, invert, outW, outH){
    var c = document.createElement("canvas");
    c.width = outW; c.height = outH;
    var ctx = c.getContext("2d");
    ctx.clearRect(0, 0, outW, outH);
    drawLogoInto(ctx, img, outW, outH);
    var imgd;
    try { imgd = ctx.getImageData(0, 0, outW, outH); } catch(e){ return c; }
    var d = imgd.data;
    for (var i = 0; i < d.length; i += 4){
      var a = d[i + 3];
      var ink = false;
      if (a >= 10){
        var l = 0.299*d[i] + 0.587*d[i+1] + 0.114*d[i+2];
        ink = invert ? (l > threshold) : (l < threshold);
      }
      if (ink){ d[i] = 0; d[i+1] = 0; d[i+2] = 0; d[i+3] = 255; }
      else { d[i] = 0; d[i+1] = 0; d[i+2] = 0; d[i+3] = 0; }
    }
    ctx.putImageData(imgd, 0, 0);
    return c;
  }
  function buildSilhouette(img, outW, outH){
    var c = document.createElement("canvas");
    c.width = outW; c.height = outH;
    var ctx = c.getContext("2d");
    drawLogoInto(ctx, img, outW, outH);
    var id;
    try { id = ctx.getImageData(0, 0, outW, outH); } catch(e){ return c; }
    var d = id.data;
    for (var i = 0; i < d.length; i += 4){
      var a = d[i + 3];
      var l = 0.299*d[i] + 0.587*d[i+1] + 0.114*d[i+2];
      var on = a >= 12 && l < 242;
      d[i] = 0; d[i+1] = 0; d[i+2] = 0; d[i+3] = on ? 255 : 0;
    }
    ctx.putImageData(id, 0, 0);
    return c;
  }
  function dilateMask(src, r){
    var w = src.width, h = src.height;
    var out = document.createElement("canvas");
    out.width = w; out.height = h;
    var octx = out.getContext("2d");
    if (r < 1){ octx.drawImage(src, 0, 0); return out; }
    var id;
    try { id = src.getContext("2d").getImageData(0, 0, w, h); } catch(e){ octx.drawImage(src, 0, 0); return out; }
    var a = new Uint8Array(w * h), tmp = new Uint8Array(w * h);
    var d = id.data;
    var i, j;
    for (i = 0, j = 0; j < w * h; i += 4, j++) a[j] = d[i + 3] > 8 ? 1 : 0;
    for (var y = 0; y < h; y++){
      var row = y * w;
      for (var x = 0; x < w; x++){
        var on = 0;
        var x0 = Math.max(0, x - r), x1 = Math.min(w - 1, x + r);
        for (var k = x0; k <= x1; k++) if (a[row + k]){ on = 1; break; }
        tmp[row + x] = on;
      }
    }
    for (var x2 = 0; x2 < w; x2++){
      for (var y2 = 0; y2 < h; y2++){
        var on2 = 0;
        var y0 = Math.max(0, y2 - r), y1 = Math.min(h - 1, y2 + r);
        for (var k2 = y0; k2 <= y1; k2++) if (tmp[k2 * w + x2]){ on2 = 1; break; }
        a[y2 * w + x2] = on2;
      }
    }
    var od = octx.createImageData(w, h);
    var p = od.data;
    for (i = 0, j = 0; j < w * h; i += 4, j++){
      p[i] = 0; p[i+1] = 0; p[i+2] = 0; p[i+3] = a[j] ? 255 : 0;
    }
    octx.putImageData(od, 0, 0);
    return out;
  }
  function edt(bin, w, h){
    var INF = 1e20;
    var f = new Float64Array(Math.max(w, h));
    var d = new Float64Array(Math.max(w, h));
    var v = new Int32Array(Math.max(w, h));
    var z = new Float64Array(Math.max(w, h) + 1);
    var grid = new Float64Array(w * h);
    for (var j = 0; j < w * h; j++) grid[j] = bin[j] ? 0 : INF;

    function pass(len, get, set){
      for (var q = 0; q < len; q++) f[q] = get(q);
      var k = 0;
      v[0] = 0; z[0] = -INF; z[1] = INF;
      for (var q2 = 1; q2 < len; q2++){
        var s;
        while (true){
          var r = v[k];
          s = ((f[q2] + q2*q2) - (f[r] + r*r)) / (2*q2 - 2*r);
          if (s <= z[k]){ k--; if (k < 0) break; } else break;
        }
        k++; v[k] = q2; z[k] = s; z[k+1] = INF;
      }
      k = 0;
      for (var q3 = 0; q3 < len; q3++){
        while (z[k+1] < q3) k++;
        var r2 = v[k];
        set(q3, (q3 - r2) * (q3 - r2) + f[r2]);
      }
    }
    for (var y = 0; y < h; y++){
      pass(w, function(x){ return grid[y*w + x]; }, function(x, val){ grid[y*w + x] = val; });
    }
    var col = new Float64Array(h);
    for (var x = 0; x < w; x++){
      (function(x){
        pass(h, function(y){ return grid[y*w + x]; }, function(y, val){ col[y] = val; });
        for (var y2 = 0; y2 < h; y2++) grid[y2*w + x] = col[y2];
      })(x);
    }
    var out = new Float64Array(w * h);
    for (var i = 0; i < w * h; i++) out[i] = Math.sqrt(grid[i]);
    return out;
  }
  var dieSilCache = null;
  function dieCutSilhouette(logoImg, W, H){
    if (!logoImg) return null;
    var key = W + "x" + H + ":" + state.logoScale + ":" + state.logoX + ":" + state.logoY;
    if (dieSilCache && dieSilCache.img === logoImg && dieSilCache.key === key) return dieSilCache.canvas;

    var SS = 2;
    var w = W * SS, h = H * SS;
    var sil = buildSilhouette(logoImg, w, h);
    var id;
    try { id = sil.getContext("2d").getImageData(0, 0, w, h); } catch(e){ return null; }
    var n = w * h;
    var ink = new Uint8Array(n);
    var anyInk = false;
    for (var i = 0, j = 0; j < n; i += 4, j++){
      if (id.data[i + 3] > 8){ ink[j] = 1; anyInk = true; }
    }
    if (!anyInk) return null;

    var base = Math.min(w, h);
    var pad = Math.max(2, Math.round(base * 0.018));
    var round = Math.max(4, Math.round(base * 0.045));

    var outside = edt(ink, w, h);
    var grown = new Uint8Array(n);
    var growR = pad + round;
    for (j = 0; j < n; j++) grown[j] = outside[j] <= growR ? 1 : 0;

    var holes = new Uint8Array(n);
    for (j = 0; j < n; j++) holes[j] = grown[j] ? 0 : 1;
    var inside = edt(holes, w, h);

    var big = document.createElement("canvas");
    big.width = w; big.height = h;
    var bctx = big.getContext("2d");
    var out = bctx.createImageData(w, h);
    var od = out.data;
    for (i = 0, j = 0; j < n; i += 4, j++){
      var cov = inside[j] - round + 0.5;
      cov = cov < 0 ? 0 : (cov > 1 ? 1 : cov);
      od[i] = 0; od[i+1] = 0; od[i+2] = 0; od[i+3] = Math.round(cov * 255);
    }
    bctx.putImageData(out, 0, 0);

    var c = document.createElement("canvas");
    c.width = W; c.height = H;
    var ctx = c.getContext("2d");
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";
    ctx.drawImage(big, 0, 0, W, H);

    dieSilCache = { img: logoImg, key: key, canvas: c };
    return c;
  }
  function inkBounds(inkCanvas){
    var w = inkCanvas.width, h = inkCanvas.height;
    var id;
    try { id = inkCanvas.getContext("2d").getImageData(0, 0, w, h); } catch(e){ return null; }
    var d = id.data;
    var minX = w, minY = h, maxX = -1, maxY = -1;
    for (var y = 0; y < h; y++){
      var row = y * w * 4;
      for (var x = 0; x < w; x++){
        if (d[row + x * 4 + 3] > 8){
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
    }
    if (maxX < 0) return null;
    return { x: minX, y: minY, w: maxX - minX + 1, h: maxY - minY + 1 };
  }
  function computeDieCutRect(ink, W, H){
    var b = ink ? inkBounds(ink) : null;
    var padBase = Math.min(W, H);
    var pad = Math.max(8, Math.round(padBase * 0.06));
    var x, y, w, h;
    if (b){
      x = b.x - pad; y = b.y - pad; w = b.w + pad * 2; h = b.h + pad * 2;
    } else {
      x = W * 0.12; y = H * 0.12; w = W * 0.76; h = H * 0.76;
    }
    var inset = 4;
    if (x < inset){ w += x - inset; x = inset; }
    if (y < inset){ h += y - inset; y = inset; }
    if (x + w > W - inset) w = W - inset - x;
    if (y + h > H - inset) h = H - inset - y;
    w = Math.max(12, w); h = Math.max(12, h);
    var r = Math.max(6, Math.round(Math.min(w, h) * 0.16));
    return { x:x, y:y, w:w, h:h, r:r };
  }
  function shapeMask(shape, W, H, ink, dieRect, dieSil){
    var c = document.createElement("canvas");
    c.width = W; c.height = H;
    var ctx = c.getContext("2d");
    ctx.fillStyle = "#000";
    if (shape === "diecut"){
      if (dieSil){ ctx.drawImage(dieSil, 0, 0); return c; }
      var r = dieRect || computeDieCutRect(ink, W, H);
      ctx.beginPath();
      roundRectPath(ctx, r.x, r.y, r.w, r.h, r.r);
      ctx.closePath();
      ctx.fill();
      return c;
    }
    clipPath(ctx, shape, W, H, 8);
    ctx.fill();
    return c;
  }
  function compositeLayer(paintFn, mask){
    var c = document.createElement("canvas");
    c.width = mask.width; c.height = mask.height;
    var ctx = c.getContext("2d");
    paintFn(ctx);
    ctx.globalCompositeOperation = "destination-in";
    ctx.drawImage(mask, 0, 0);
    return c;
  }
  function drawPlaceholderText(ctx, W, H){
    ctx.save();
    ctx.fillStyle = "rgba(20,18,28,.5)";
    ctx.font = "600 15px DM Sans, sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText("Upload your logo to preview", W / 2, H / 2);
    ctx.restore();
  }
  function erodeMask(src, r){
    var w = src.width, h = src.height;
    var inv = document.createElement("canvas");
    inv.width = w; inv.height = h;
    var ictx = inv.getContext("2d");
    ictx.fillStyle = "#000";
    ictx.fillRect(0, 0, w, h);
    ictx.globalCompositeOperation = "destination-out";
    ictx.drawImage(src, 0, 0);
    var grown = dilateMask(inv, r);
    var out = document.createElement("canvas");
    out.width = w; out.height = h;
    var octx = out.getContext("2d");
    octx.drawImage(src, 0, 0);
    octx.globalCompositeOperation = "destination-out";
    octx.drawImage(grown, 0, 0);
    return out;
  }
  function drawShapeBorder(ctx, mode, shape, W, H, dieRect, dieSil){
    if (mode === "none") return;
    var base = Math.min(W, H);
    var lw = mode === "stitch" ? Math.max(2, base * 0.0095) : Math.max(2.5, base * 0.013);
    if (shape === "diecut" && dieSil){
      var inset = Math.round(lw * 1.6);
      var ring = document.createElement("canvas");
      ring.width = W; ring.height = H;
      var rctx = ring.getContext("2d");
      rctx.drawImage(dieSil, 0, 0);
      rctx.globalCompositeOperation = "destination-out";
      rctx.drawImage(erodeMask(dieSil, inset), 0, 0);
      rctx.globalCompositeOperation = "source-in";
      rctx.fillStyle = "#141117";
      rctx.fillRect(0, 0, W, H);
      if (mode === "stitch"){
        rctx.globalCompositeOperation = "destination-out";
        var step = Math.max(8, base * 0.038), gap = step * 0.42;
        for (var d = 0; d < W + H; d += step){
          rctx.save();
          rctx.lineWidth = gap;
          rctx.strokeStyle = "#000";
          rctx.beginPath();
          rctx.moveTo(d, 0); rctx.lineTo(d - H, H);
          rctx.stroke();
          rctx.restore();
        }
      }
      ctx.drawImage(ring, 0, 0);
      return;
    }
    ctx.save();
    ctx.beginPath();
    if (shape === "diecut"){
      var r = dieRect || computeDieCutRect(null, W, H);
      var i = Math.max(3, Math.round(base * 0.018));
      roundRectPath(ctx, r.x + i, r.y + i, Math.max(8, r.w - i * 2), Math.max(8, r.h - i * 2), Math.max(4, r.r - i));
      ctx.closePath();
    } else {
      clipPath(ctx, shape, W, H, Math.round(base * 0.045));
    }
    ctx.strokeStyle = "#141117";
    ctx.lineWidth = lw;
    if (mode === "stitch"){
      ctx.setLineDash([Math.max(5, base * 0.028), Math.max(4, base * 0.02)]);
      ctx.lineCap = "round";
    } else {
      ctx.setLineDash([]);
    }
    ctx.stroke();
    ctx.restore();
  }

  function draw(){
    var W = canvas.width, H = canvas.height;
    var ctx = canvas.getContext("2d");
    ctx.clearRect(0, 0, W, H);

    var logoImg = state.logoImage;
    var ink = logoImg ? buildInkMask(logoImg, state.threshold, state.invert, W, H) : null;
    var isDie = state.shape.id === "diecut";
    var dieSil = isDie ? dieCutSilhouette(logoImg, W, H) : null;
    var dieRect = isDie && !dieSil ? computeDieCutRect(ink, W, H) : null;
    var mask = shapeMask(state.shape.id, W, H, ink, dieRect, dieSil);

    var patternSrc = matPatternCanvasCache[state.material.id];
    var matLayer = compositeLayer(function(mctx){
      if (patternSrc){
        var sw = patternSrc.width, sh = patternSrc.height;
        var scale = Math.max(W / sw, H / sh);
        var dw = sw * scale, dh = sh * scale;
        mctx.drawImage(patternSrc, (W - dw) / 2, (H - dh) / 2, dw, dh);
      } else {
        mctx.fillStyle = "#cfc9dd";
        mctx.fillRect(0, 0, W, H);
      }
    }, mask);
    ctx.drawImage(matLayer, 0, 0);

    if (ink){
      var inkLayer = compositeLayer(function(ictx){ ictx.drawImage(ink, 0, 0); }, mask);
      ctx.drawImage(inkLayer, 0, 0);
    } else {
      drawPlaceholderText(ctx, W, H);
    }

    drawShapeBorder(ctx, effectiveEdge(), state.shape.id, W, H, dieRect, dieSil);
  }

  function isDieCut(){ return state.shape.id === "diecut"; }
  function effectiveEdge(){ return isDieCut() ? "none" : state.edge; }
  function syncEdgeControl(){
    var note = $("pboDieNote");
    if (note) note.hidden = !isDieCut();
    var sel = $("pbo-edge");
    if (!sel) return;
    var die = isDieCut();
    sel.disabled = die;
    sel.value = die ? "none" : state.edge;
    var wrap = sel.closest(".pbo-field-edge");
    if (wrap) wrap.classList.toggle("pbo-field-off", die);
  }
  function syncFileUI(){
    var drop = $("pboCanvasDrop"), bar = $("pboFileBar"), have = $("pboFileName");
    var f = state.logoFile;
    if (drop) drop.hidden = !!f;
    if (bar) bar.hidden = !f;
    if (have) have.textContent = f ? f.name : "";
  }
  function applyCanvasShape(){
    var box = $("pboCanvasBox");
    if (!canvas || !box) return;
    var ratio = state.shape.ratio || 1;
    var base = 520;
    var w, h;
    if (ratio >= 1){ w = base; h = Math.round(base / ratio); }
    else { h = base; w = Math.round(base * ratio); }
    canvas.width = w; canvas.height = h;
    box.style.aspectRatio = w + " / " + h;
    draw();
  }

  function renderMaterials(){
    var host = $("pboMaterials");
    host.innerHTML = MATERIALS.map(function(m){
      return '<button type="button" class="pbo-mat-chip' + (m.id === state.material.id ? ' on' : '') + '" data-mat="' + m.id + '">' +
        '<span class="pbo-mat-swatch" style="background-image:url(\'' + m.swatch + '\')"></span>' +
        '<span class="pbo-mat-name">' + m.name + '</span></button>';
    }).join("");
    host.querySelectorAll("[data-mat]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.material = MATERIALS.filter(function(m){ return m.id === btn.dataset.mat; })[0];
        $("pboMaterialInput").value = state.material.name;
        renderMaterials();
        draw();
      });
    });
  }
  function renderShapes(){
    var host = $("pboShapes");
    host.innerHTML = SHAPES.map(function(s){
      return '<button type="button" class="pbo-chip' + (s.id === state.shape.id ? ' on' : '') + '" data-shape="' + s.id + '">' + s.label + '</button>';
    }).join("");
    host.querySelectorAll("[data-shape]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.shape = SHAPES.filter(function(s){ return s.id === btn.dataset.shape; })[0];
        $("pboShapeInput").value = state.shape.label;
        renderShapes();
        syncEdgeControl();
        applyCanvasShape();
      });
    });
  }
  function renderPlacements(){
    var host = $("pboPlacements");
    host.innerHTML = PLACEMENTS.map(function(p){
      return '<button type="button" class="pbo-chip' + (p.id === state.placement.id ? ' on' : '') + '" data-place="' + p.id + '">' + p.label + '</button>';
    }).join("");
    host.querySelectorAll("[data-place]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.placement = PLACEMENTS.filter(function(p){ return p.id === btn.dataset.place; })[0];
        $("pboPlacementInput").value = state.placement.label;
        renderPlacements();
      });
    });
  }

  /* ---------- upload + controls ---------- */
  (function enableCanvasUpload(){
    var drop = $("pboCanvasDrop"), input = $("pbo-artwork"), box = $("pboCanvasBox");
    if (!drop || !input || !box) return;
    drop.addEventListener("click", function(){ input.click(); });
    var rep = $("pboReplace"), rem = $("pboRemove");
    if (rep) rep.addEventListener("click", function(){ input.click(); });
    if (rem) rem.addEventListener("click", function(){
      input.value = "";
      input.dispatchEvent(new Event("change"));
    });
    ["dragenter","dragover"].forEach(function(t){ box.addEventListener(t, function(e){
      e.preventDefault(); drop.classList.add("over");
    }); });
    ["dragleave","drop"].forEach(function(t){ box.addEventListener(t, function(e){
      e.preventDefault(); drop.classList.remove("over");
    }); });
    box.addEventListener("drop", function(e){
      var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (!f) return;
      var dt = new DataTransfer();
      dt.items.add(f);
      input.files = dt.files;
      input.dispatchEvent(new Event("change"));
    });
  })();

  $("pbo-artwork").addEventListener("change", function(e){
    var file = e.target.files && e.target.files[0];
    if (!file){
      state.logoFile = null; state.logoImage = null;
      state.logoScale = 1; state.logoX = 0; state.logoY = 0;
      if ($("pbo-logoscale")) $("pbo-logoscale").value = 100;
      syncFileUI();
      draw();
      return;
    }
    if (file.size > 10 * 1024 * 1024){
      alert("That file is over 10 MB. Please send a smaller file or email it to help@threadbreak.com.");
      e.target.value = ""; return;
    }
    state.logoFile = file;
    state.logoScale = 1; state.logoX = 0; state.logoY = 0;
    if ($("pbo-logoscale")) $("pbo-logoscale").value = 100;
    syncFileUI();

    if (/^image\/(png|jpe?g|webp|gif|svg\+xml)$/i.test(file.type) || /\.(png|jpe?g|webp|gif|svg)$/i.test(file.name)){
      var reader = new FileReader();
      reader.onload = function(ev){
        var img = new Image();
        img.onload = function(){ state.logoImage = img; draw(); };
        img.onerror = function(){ state.logoImage = null; draw(); };
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    } else {
      state.logoImage = null;
      draw();
    }
  });

  $("pbo-threshold").addEventListener("input", function(e){ state.threshold = +e.target.value; draw(); });
  $("pbo-invert").addEventListener("change", function(e){ state.invert = e.target.checked; draw(); });
  $("pbo-edge").addEventListener("change", function(e){ state.edge = e.target.value; draw(); });
  $("pbo-logoscale").addEventListener("input", function(e){ state.logoScale = +e.target.value / 100; draw(); });
  $("pbo-reset").addEventListener("click", function(){
    state.logoScale = 1; state.logoX = 0; state.logoY = 0;
    $("pbo-logoscale").value = 100;
    draw();
  });

  (function enableLogoDrag(){
    var box = $("pboCanvasBox");
    if (!box) return;
    var drag = null;
    box.addEventListener("pointerdown", function(e){
      if (!state.logoImage) return;
      var r = box.getBoundingClientRect();
      drag = { px: e.clientX, py: e.clientY, ox: state.logoX, oy: state.logoY, w: r.width, h: r.height };
      box.classList.add("dragging");
      box.setPointerCapture(e.pointerId);
    });
    box.addEventListener("pointermove", function(e){
      if (!drag) return;
      state.logoX = Math.max(-0.45, Math.min(0.45, drag.ox + (e.clientX - drag.px) / drag.w));
      state.logoY = Math.max(-0.45, Math.min(0.45, drag.oy + (e.clientY - drag.py) / drag.h));
      draw();
    });
    var end = function(e){
      if (!drag) return;
      drag = null;
      box.classList.remove("dragging");
      try { box.releasePointerCapture(e.pointerId); } catch(err){}
    };
    box.addEventListener("pointerup", end);
    box.addEventListener("pointercancel", end);
  })();

  (function enableInfoToggle(){
    var btn = $("pbo-engrave-btn"), panel = $("pbo-engrave-info");
    if (!btn || !panel) return;
    btn.addEventListener("click", function(){
      var open = panel.hidden;
      panel.hidden = !open;
    });
  })();

  (function enableProofToggle(){
    var sel = $("pbo-proof-method");
    if (!sel) return;
    var wrap = $("pbo-proof-phone-wrap"), phone = $("pbo-proof-phone"), hint = $("pbo-proof-hint");
    sel.addEventListener("change", function(){
      var isText = sel.value === "Text message";
      if (wrap){ if (isText) wrap.removeAttribute("hidden"); else { wrap.setAttribute("hidden",""); if (phone) phone.value = ""; } }
      if (phone) phone.required = isText;
      if (hint) hint.textContent = isText
        ? "We'll text your proof from (336) 585-6176 within one business day. Nothing gets engraved until you approve it."
        : "We'll email your proof from help@threadbreak.com within one business day. Nothing gets engraved until you approve it.";
    });
  })();

  preloadMaterials();
  renderMaterials();
  renderShapes();
  renderPlacements();
  syncEdgeControl();
  syncFileUI();
  applyCanvasShape();
})();
</script>
{%- endif -%}
