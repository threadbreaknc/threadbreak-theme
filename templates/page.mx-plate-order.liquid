  // hat list: selected hat expands in place with photos, colors and per-color quantity
  function selectHat(hat){
    var keep = [];
    state.colors.forEach(function(x){
      var m = hat.colors.filter(function(c){ return c.name === x.c.name; })[0];
      if (m) keep.push({ c:m, n:x.n });
    });
    state.hat = hat; state.hatGroup = groupOf(hat); state.colors = keep;
