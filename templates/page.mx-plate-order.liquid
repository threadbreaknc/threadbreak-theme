    if (state.colors.length === 1) state.colors[0].n = q;
    else if (state.colors.length > 1){
      var over = assigned() - q;
      for (var i = state.colors.length-1; i >= 0 && over > 0; i--){
        var take = Math.min(over, state.colors[i].n - 1);
        state.colors[i].n -= take; over -= take;
