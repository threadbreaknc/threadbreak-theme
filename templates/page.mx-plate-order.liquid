ight:1;padding: 0;-moz-appearance: textfield}#tbmx .mx-qty-input::-webkit-outer-spin-button,#tbmx .mx-qty-input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}#tbmx .mx-qty-input:focus{outline:none;border-bottom: 2px solid var(--dirt-bright)}#tbmx .hat-list{display:flex;flex-direction:column;gap: 8px}#tbmx .hat-opt{background: var(--ink-raised);border: 1.5px solid var(--line);border-radius: 10px;overflow:hidden}#tbmx .hat-opt.mx-open{border-color: var(--dirt-bright)}#tbmx .hat-opt-head{display:flex;align-items:center;gap: 12px;width:100%;padding: 10px;background:none;border:none;color: inherit;text-align:left;cursor:pointer;font-family:'DM Sans',sans-serif}#tbmx .hat-opt-head .hthumb{width: 64px;flex-shrink:0;padding: 4px 6px;border-radius: 6px}#tbmx .hat-opt-head .htext{flex:1}#tbmx .hat-opt-head .hb{display:block;font-size: 11px;color: var(--paper-dim);font-weight:700}#tbmx .hat-opt-head .hn{display:block;font-size: 14px;font-weight:700;margin-top:2px;line-height:1.25}#tbmx .hat-opt-head .hp{display:block;font-size: 12px;color: var(--dirt-bright);font-weight:700;margin-top: 3px}#tbmx .hat-opt-body{padding: 2px 12px 14px}#tbmx .hat-big{background:#e6e3dc;border-radius: 10px;padding: 22px;max-width: 300px;margin: 0 auto 8px;aspect-ratio: 1 / 1;display:flex;align-items:center;justify-content:center}#tbmx .hat-big svg,#tbmx .hat-big img{width:100%;height:auto;display:block}#tbmx .preview-cap{text-align:center;font-size: 12px;color: var(--paper-dim);margin-bottom: 14px;min-height: 16px}#tbmx .hc-label{font-size: 12.5px;font-weight:700;color: var(--paper-dim);margin-bottom: 10px}#tbmx .hc-swatches{display:flex;flex-wrap:wrap;gap: 10px}#tbmx .color-list{margin-top: 14px}#tbmx .crow{display:flex;align-items:center;gap: 10px;padding: 9px 0;border-top: 1px solid var(--line)}#tbmx .crow .cdot{width: 26px;height: 26px;border-radius:50%;border: 2px solid var(--line);flex-shrink:0}#tbmx .crow .cname{flex:1;font-size: 14px;font-weight:700}#tbmx .cq{display:flex;align-items:center;gap: 8px}#tbmx .cq button{width: 36px;height: 36px;border-radius:50%;border: 1.5px solid var(--line);background: var(--ink);color: var(--paper);font-size: 19px;line-height:1;cursor:pointer}#tbmx .cq span{min-width: 24px;text-align:center;font-weight:700}#tbmx .crow .rm{background:none;border:none;color: var(--paper-dim);font-size: 22px;padding: 4px 6px;cursor:pointer}#tbmx .assign{font-size: 13px;font-weight:700;margin-top: 10px}#tbmx .assign.ok{color:#6fcf97}#tbmx .assign.bad{color: var(--dirt-bright)}#tbmx{padding-top:6rem;line-height:1.5;width:100%}#tbmx button{font-family:'DM Sans',sans-serif;letter-spacing:0;text-transform:none}#tbmx .cta-block{font-family:'Bebas Neue',sans-serif;letter-spacing:.5px}#tbmx .step-btn,#tbmx .cq button{padding:0}</style>
<section class="mx-hero">
<svg class="hero-crest" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="var(--paper)" stroke-width="1.4">
<path d="M50,12 Q56,2 62,6 Q78,10 84,26 Q88,38 79,44 Q84,52 74,60 L64,54 L50,63 L36,54 L26,60 Q16,52 21,44 Q12,38 16,26 Q22,10 38,6 Q44,2 50,12 Z"/>
