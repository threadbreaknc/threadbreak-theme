        m.addEventListener('click', function(){ adjust(i,-1); });
        pl.addEventListener('click', function(){ adjust(i,1); });
        q.appendChild(m); q.appendChild(span); q.appendChild(pl); row.appendChild(q);
        var rm = document.createElement('button'); rm.type='button'; rm.className='rm'; rm.innerHTML='&times;'; rm.setAttribute('aria-label','Remove '+x.c.name);
        rm.addEventListener('click', function(){ removeColor(i); });
        row.appendChild(rm);
      }
      list.appendChild(row);
    });
    var a = body.querySelector('.assign'), tot = assigned();
    if (state.qty > 1){
      if (state.colors.length === 0){ a.textContent = '0 of '+state.qty+' hats assigned'; a.className='assign bad'; }
      else if (tot === state.qty){ a.textContent = state.qty+' of '+state.qty+' hats assigned'; a.className='assign ok'; }
      else if (tot < state.qty){ a.textContent = tot+' of '+state.qty+' assigned. Add '+(state.qty-tot)+' more.'; a.className='assign bad'; }
      else { a.textContent = tot+' of '+state.qty+' assigned. Remove '+(tot-state.qty)+'.'; a.className='assign bad'; }
    } else a.style.display = 'none';
    return body;
  }

  function renderHats(scroll){
    var gbox = $('hatBrands'), sbox = $('hatScroll'), dbox = $('hatDetail');
    var keepLeft = sbox.scrollLeft;
    gbox.innerHTML = ''; sbox.innerHTML = ''; dbox.innerHTML = '';
    HAT_GROUPS.forEach(function(g){
      var b = document.createElement('button'); b.type='button'; b.textContent = g;
      b.setAttribute('aria-pressed', state.hatGroup === g ? 'true' : 'false');
      b.addEventListener('click', function(){ state.hatGroup = g; renderHats(); });
      gbox.appendChild(b);
    });
    if (!state.hatGroup){ $('hatHint').textContent = 'Pick a hat brand, then a style.'; sbox.style.display = 'none'; return; }
    sbox.style.display = '';
    $('hatHint').textContent = state.hat ? 'Tap another style to switch, or pick colors below.' : 'Swipe the styles and tap one.';
    HATS.filter(function(h){ return groupOf(h) === state.hatGroup; }).forEach(function(hat){
      var sel = state.hat === hat, t = TIERS[hat.tier];
      var priceTxt = state.qty > 1 ? money(unitPrice(t,state.qty)) + ' each' : money(t.single);
      var c = document.createElement('button'); c.type='button'; c.className = 'mx-hatcard' + (sel ? ' mx-open' : '');
      var thumbImg = sel && state.preview && state.preview.img ? state.preview.img : hat.img;
      c.innerHTML = '<span class="hthumb">'+photo(thumbImg, 200, hat.name)+'</span><span class="hn">'+esc(hat.name)+'</span><span class="hp">'+priceTxt+'</span>';
      c.addEventListener('click', function(){ if (!sel) selectHat(hat); });
      sbox.appendChild(c);
    });
    sbox.scrollLeft = keepLeft;
    if (state.hat && groupOf(state.hat) === state.hatGroup){
      dbox.appendChild(buildBody(state.hat));
      if (scroll) setTimeout(function(){ dbox.scrollIntoView({ behavior:'smooth', block:'nearest' }); }, 30);
    }
  }

  function currentName(){ return state.useName ? $('nameInput').value.trim() : ''; }

  function update(scrollToHat){
    var num = $('numInput').value.trim(), name = currentName();
    var nameOk = !state.useName || name.length > 0;
    var colorsDone = !!state.hat && state.colors.length > 0 && assigned() === state.qty;
    var ready = state.brand!==null && !!state.plate && num.length>0 && nameOk && colorsDone;
    var parts = [];
    if (state.brand!==null) parts.push('<b>'+BRANDS[state.brand].name+'</b>');
    if (state.plate) parts.push(DESIGN_NAMES[BRANDS[state.brand].plates.indexOf(state.plate)]);
    if (num) parts.push('#<b>'+esc(num)+'</b>');
    parts.push(state.useName ? (name ? esc(name) : 'name needed') : 'no name');
    parts.push(state.leather.name + ' patch');
    parts.push(state.place.toLowerCase() + ' placement');
    if (state.hat) parts.push(esc(state.hat.name));
    if (state.hat && state.colors.length){
      parts.push(state.colors.map(function(x){ return esc(x.c.name) + (state.qty>1 ? ' x' + x.n : ''); }).join(', '));
    }
    var html = (state.brand===null || !state.plate) ? 'Pick a brand and design to get started.' : parts.join(' &middot; ');
    if (state.hat){
      var t = TIERS[state.hat.tier], tot = totalPrice(t, state.qty), save = r2(t.single*state.qty - tot);
      html += '<span class="total">' + state.qty + (state.qty>1?' hats':' hat') + ': <b>' + money(tot) + '</b> shipped';
      if (save > 0) html += ' <span class="save">You save ' + money(save) + '</span>';
      html += '</span>';
    }
    if (!ready){
      var need = [];
      if (state.brand!==null && state.plate && !num) need.push('your number');
      if (state.brand!==null && state.plate && state.useName && !name) need.push('your name (or choose No name)');
      if (!state.hat) need.push('a hat');
      else if (!state.colors.length) need.push('a hat color');
      else if (assigned() !== state.qty) need.push('colors for all ' + state.qty + ' hats');
      if (need.length) html += '<span class="total" style="font-size:12.5px;color:var(--paper-dim)">Still needed: ' + need.join(', ') + '</span>';
    }
    $('summary').innerHTML = html;
    $('addBtn').disabled = !ready;
    renderPriceBox();
    renderHats(scrollToHat === true);
  }
  ['numInput','nameInput'].forEach(function(id){ $(id).addEventListener('input', function(){ update(); }); });

  var PLACE_LABEL = { Left:'Left side of front panel (as you face the hat)', Center:'Center of front panel', Right:'Right side of front panel (as you face the hat)' };
  state.place = 'Center';
  [].forEach.call($('placeRow').children, function(b){
    b.addEventListener('click', function(){
      state.place = b.dataset.p;
      [].forEach.call($('placeRow').children, function(x){ x.setAttribute('aria-pressed', x===b ? 'true':'false'); });
      update();
    });
  });

  $('addBtn').addEventListener('click', function(){
    var btn = $('addBtn'), msg = $('cartMsg');
    var num = $('numInput').value.trim(), name = currentName();
    var vid = VARIANTS[state.hat.tier][bracket(state.qty)];
    var props = {
      'Bike brand': BRANDS[state.brand].name,
      'Design': DESIGN_NAMES[BRANDS[state.brand].plates.indexOf(state.plate)] + ' (plate art ' + state.plate + ')',
      'Number': num,
      'Name': name || 'None',
      'Patch color': state.leather.name,
      'Patch placement': PLACE_LABEL[state.place],
      'Hat': (state.hat.name.toLowerCase().indexOf(state.hat.brand.toLowerCase()) === -1 ? state.hat.name + ' (' + state.hat.brand + ')' : state.hat.name),
      'Hat colors': state.colors.map(function(x){ return x.c.name + ' x' + x.n; }).join(', ')
    };
    btn.disabled = true; var label = btn.textContent; btn.textContent = 'Adding...'; msg.textContent = '';
    fetch('/cart/add.js', { method:'POST', headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
      body: JSON.stringify({ items:[{ id:vid, quantity:state.qty, properties:props }] }) })
      .then(function(r){ if (!r.ok) throw new Error('add failed'); return r.json(); })
      .then(function(){ window.location.href = '/cart'; })
      .catch(function(){
        btn.disabled = false; btn.textContent = label;
        msg.textContent = 'Something went wrong adding this to your cart. Please try again or email help@threadbreak.com.';
      });
  });
  update();
})();
</script>
</div>
