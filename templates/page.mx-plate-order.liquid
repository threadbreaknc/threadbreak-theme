  function renderPriceBox(){
    var box = $('priceBox'), q = state.qty;
    if (!state.hat){
      var o = TIERS.otto, p = TIERS.premium;
      box.innerHTML = '<div><span class="each">At '+q+(q>1?' hats':' hat')+':</span></div>' +
