        '<div class="nudge">Pick a hat below for your exact price.</div>';
      return;
    }
    var t = TIERS[state.hat.tier];
    var tot = totalPrice(t,q), full = r2(t.single*q), save = r2(full - tot);
    var html = '<div class="big">'+money(tot)+'</div>' +
      '<div><span class="each">'+q+(q>1?' hats':' hat')+'</span>' + (q>1 ? ' &middot; '+money(unitPrice(t,q))+' each' : '') + ', shipped</div>';
