<div class="field-block">
<div class="field-label"><span class="n">3</span> Number and name</div>
<div class="two-col">
<div>
<label class="mini" for="numInput">Number</label>
<input type="text" id="numInput" maxlength="4" inputmode="text" autocapitalize="characters" autocomplete="off" placeholder="617">
</div>
<div>
<label class="mini" for="nameInput">Name <span class="opt">(optional)</span></label>
<input type="text" id="nameInput" maxlength="14" autocapitalize="characters" autocomplete="off" placeholder="SMITH">
</div>
</div>
<p class="hint">The designs above show a sample number and name. Yours is engraved in the same style.</p>
</div>
<div class="field-block">
<div class="field-label"><span class="n">4</span> Leatherette color</div>
<div class="swatch-row" id="colorRow"></div>
<p class="hint">The plates above update to show your color.</p>
</div>
<div class="field-block">
<div class="field-label"><span class="n">5</span> How many hats</div>
<div class="stepper">
<button type="button" class="step-btn" id="qtyMinus" aria-label="Fewer hats">&minus;</button>
<input type="number" id="qtyNum" class="mx-qty-input" min="1" max="100" value="1" inputmode="numeric" aria-label="Number of hats">
<button type="button" class="step-btn" id="qtyPlus" aria-label="More hats">+</button>
</div>
<div class="quick-qty" id="quickQty">
<button type="button" data-q="1" aria-pressed="true">1 hat</button>
<button type="button" data-q="5" aria-pressed="false">5 &middot; Family Deal</button>
<button type="button" data-q="10" aria-pressed="false">10 &middot; Friends + Family</button>
</div>
<p class="hint">Every hat in your order gets the same plate, number and name. Hat colors can be different.</p>
<div class="price-box" id="priceBox"></div>
<table class="ladder" id="ladder"></table>
</div>
<div class="field-block">
<div class="field-label"><span class="n">6</span> Hat and color</div>
<p class="hint" id="hatHint">Tap a hat, then choose its colors.</p>
<div class="hat-list" id="hatList"></div>
</div>
<div class="summary" id="summary">Pick a brand and design to get started.</div>
<button class="cta cta-block" id="addBtn" disabled>Email my order</button>
<p class="proof-note">We produce your patch exactly as entered, so double-check the number and spelling before ordering. Made to order in 1 to 2 weeks. Need it sooner? Email help@threadbreak.com before you order.</p>
</div>
</div>
</section>
<script>
(function(){
var BRANDS = [
{ name:'GasGas',    plates:[1,9,17] },
{ name:'Honda',     plates:[2,10,18] },
{ name:'Husqvarna', plates:[3,11,19] },
{ name:'Kawasaki',  plates:[4,12,20] },
{ name:'KTM',       plates:[5,13,21] },
{ name:'Suzuki',    plates:[6,14,22] },
{ name:'Triumph',   plates:[7,15,23] },
{ name:'Yamaha',    plates:[8,16,24] }
];
var LEATHER = [
{ name:'Threadbreak Purple', hex:'#5028aa' },
{ name:'Saddle Tan', hex:'#a9713e' },
{ name:'Brushed Silver', hex:'#b7b4ad' },
{ name:'Vintage Gray', hex:'#6f6a63' },
{ name:'Saddle Red', hex:'#8c2c22' },
{ name:'Rawhide', hex:'#c79a5d' },
{ name:'Vintage Sky Blue', hex:'#5c7f8c' },
{ name:'Vintage Caramel Brown', hex:'#6b4527' }
];
var BASIC = [
{ name:'Black', hex:'#1a1a1a' }, { name:'Navy', hex:'#1f2a44' }, { name:'Charcoal', hex:'#4a4d52' },
{ name:'Heather Gray', hex:'#9a9ca0' }, { name:'White', hex:'#f2f2ee' }, { name:'Royal', hex:'#2c4fa3' },
{ name:'Red', hex:'#b3262d' }, { name:'Forest Green', hex:'#1f4d36' }, { name:'Khaki', hex:'#b9a47a' }
];
var HATS = [
{ id:'otto-31069', brand:'Otto',       name:'31-069 5-Panel Mid Profile',     tier:'otto',    kind:'twill',   img:null, colors:BASIC },
{ id:'r112',       brand:'Richardson', name:'112 Trucker',                    tier:'premium', kind:'trucker', img:null, colors:BASIC },
{ id:'r112-5',     brand:'Richardson', name:'112 5-Panel Trucker',            tier:'premium', kind:'trucker', img:null, colors:BASIC },
{ id:'flex-6277',  brand:'Flexfit',    name:'6277',                           tier:'premium', kind:'twill',   img:null, colors:BASIC },
{ id:'flex-110f',  brand:'Flexfit',    name:'110F',                           tier:'premium', kind:'twill',   img:null, colors:BASIC },
{ id:'yp-6006',    brand:'Yupoong',    name:'YP Classics 6006 Trucker',       tier:'premium', kind:'trucker', img:null, colors:BASIC },
{ id:'yp-6606',    brand:'Yupoong',    name:'YP Classics 6606 Retro Trucker', tier:'premium', kind:'trucker', img:null, colors:BASIC }
];
var TIERS = {
otto:    { label:'Otto',                          single:39.95, five:25.00, ten:20.00 },
premium: { label:'Richardson, Yupoong, Flexfit',  single:44.95, five:29.95, ten:24.95 }
};
var MAX_QTY = 100, SMALL_DISCOUNT = 0.10;
function r2(n){ return Math.round(n*100)/100; }
function money(n){ return '$' + n.toFixed(2); }
function unitPrice(t, q){
if (q >= 10) return t.ten;        // 10 or more stays at the 10-hat price
if (q >= 5)  return t.five;
if (q >= 2)  return r2(t.single*(1-SMALL_DISCOUNT));
return t.single;
}
function totalPrice(t, q){
if (q >= 2 && q < 5) return r2(t.single*(1-SMALL_DISCOUNT)*q);
return r2(unitPrice(t,q)*q);
}
function shade(hex,f){ var n=parseInt(hex.slice(1),16),r=n>>16,g=(n>>8)&255,b=n&255; return 'rgb('+Math.round(r*f)+','+Math.round(g*f)+','+Math.round(b*f)+')'; }
function lum(hex){ var n=parseInt(hex.slice(1),16); return (0.299*(n>>16)+0.587*((n>>8)&255)+0.114*(n&255))/255; }
function hatSVG(kind, hex){
var dark = shade(hex,0.7), seam='rgba(0,0,0,.28)';
var mesh = lum(hex) < 0.5 ? 'rgba(255,255,255,.2)' : 'rgba(0,0,0,.12)';
var s = '<svg viewBox="0 0 120 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">';
s += '<path d="M18 56 C18 20 38 10 60 10 C82 10 102 20 102 56 Z" fill="'+hex+'"/>';
if (kind === 'trucker'){
s += '<path d="M18 56 C18 36 24 24 34 18 L42 56 Z" fill="'+mesh+'"/>';
s += '<path d="M102 56 C102 36 96 24 86 18 L78 56 Z" fill="'+mesh+'"/>';
s += '<path d="M34 18 L42 56 M86 18 L78 56" stroke="'+seam+'" stroke-width="1.2" fill="none"/>';
} else {
s += '<path d="M60 10 L60 56 M60 10 C47 22 41 38 41 56 M60 10 C73 22 79 38 79 56" stroke="'+seam+'" stroke-width="1.2" fill="none"/>';
}
s += '<circle cx="60" cy="10.5" r="2.4" fill="'+dark+'"/>';
s += '<path d="M8 56 Q60 90 112 56 Q60 64 8 56 Z" fill="'+dark+'"/>';
return s + '</svg>';
}
function thumb(hat, hex){
return '<span class="hthumb">' + (hat.img ? '<img src="'+hat.img+'" alt="">' : hatSVG(hat.kind, hex)) + '</span>';
}
var form = document.getElementById('plateForm');
var state = { brand:null, plate:null, leather:LEATHER[1], hat:null, qty:1, colors:[], preview:null };
var $ = function(id){ return document.getElementById(id); };
function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
function assigned(){ return state.colors.reduce(function(a,x){ return a + x.n; }, 0); }
function findColor(c){ for (var i=0;i<state.colors.length;i++) if (state.colors[i].c.name === c.name) return i; return -1; }
var brandRow = $('brandRow');
BRANDS.forEach(function(b, i){
var btn = document.createElement('button');
btn.type='button'; btn.className='brand-chip'; btn.textContent=b.name; btn.setAttribute('aria-pressed','false');
btn.addEventListener('click', function(){
state.brand = i; state.plate = null;
[].forEach.call(brandRow.children, function(c, j){ c.setAttribute('aria-pressed', j===i ? 'true':'false'); });
[].forEach.call(document.querySelectorAll('#tbmx .plate-card'), function(card){
var idx = b.plates.indexOf(+card.dataset.plate);
card.hidden = idx === -1;
card.querySelector('input').checked = false;
if (idx !== -1) card.querySelector('.plate-name').textContent = 'Design ' + (idx + 1);
});
$('designHint').textContent = b.name + ' designs: tap one to select it.';
update();
});
brandRow.appendChild(btn);
});
document.querySelectorAll('#tbmx .plate-card input').forEach(function(inp){
inp.addEventListener('change', function(){ state.plate = +inp.value; update(); });
});
var colorRow = $('colorRow');
LEATHER.forEach(function(c){
var b = document.createElement('button');
b.type='button'; b.className='mx-swatch'; b.setAttribute('aria-pressed', c===state.leather ? 'true':'false');
b.innerHTML = '<div class="dot" style="background:'+c.hex+'"></div><span>'+c.name+'</span>';
b.addEventListener('click', function(){
state.leather = c; form.style.setProperty('--leather', c.hex);
[].forEach.call(colorRow.children, function(x){ x.setAttribute('aria-pressed', x===b ? 'true':'false'); });
update();
});
colorRow.appendChild(b);
});
function setQty(q){
q = parseInt(q,10); if (isNaN(q)) q = 1;
q = Math.max(1, Math.min(MAX_QTY, q));
state.qty = q;
if (state.colors.length === 1) state.colors[0].n = q;
else if (state.colors.length > 1){
var over = assigned() - q;
for (var i = state.colors.length-1; i >= 0 && over > 0; i--){
var take = Math.min(over, state.colors[i].n - 1);
state.colors[i].n -= take; over -= take;
}
}
if ($('qtyNum') !== document.activeElement) $('qtyNum').value = q;
[].forEach.call($('quickQty').children, function(b){ b.setAttribute('aria-pressed', +b.dataset.q === q ? 'true':'false'); });
update();
}
$('qtyMinus').addEventListener('click', function(){ setQty(state.qty-1); });
$('qtyPlus').addEventListener('click', function(){ setQty(state.qty+1); });
$('qtyNum').addEventListener('input', function(e){ if (e.target.value !== '') setQty(e.target.value); });
$('qtyNum').addEventListener('blur', function(e){ e.target.value = state.qty; });
[].forEach.call($('quickQty').children, function(b){ b.addEventListener('click', function(){ setQty(+b.dataset.q); }); });
(function(){
var o=TIERS.otto, p=TIERS.premium;
$('ladder').innerHTML =
'<tr><th></th><th>Otto</th><th>Richardson<br>Yupoong, Flexfit</th></tr>' +
'<tr><td>1 hat</td><td>'+money(o.single)+'</td><td>'+money(p.single)+'</td></tr>' +
'<tr><td>2 to 4 hats<span class="sm">10% off every hat</span></td><td class="hot">'+money(r2(o.single*0.9))+' each</td><td class="hot">'+money(r2(p.single*0.9))+' each</td></tr>' +
'<tr><td>5 hats<span class="sm">Family Deal</span></td><td class="hot">'+money(o.five)+' each</td><td class="hot">'+money(p.five)+' each</td></tr>' +
'<tr><td>10 or more<span class="sm">Friends + Family</span></td><td class="hot">'+money(o.ten)+' each</td><td class="hot">'+money(p.ten)+' each</td></tr>';
})();
function renderPriceBox(){
var box = $('priceBox'), q = state.qty;
if (!state.hat){
var o = TIERS.otto, p = TIERS.premium;
box.innerHTML = '<div><span class="each">At '+q+(q>1?' hats':' hat')+':</span></div>' +
'<div>Otto: <span class="each">'+money(unitPrice(o,q))+' each</span> ('+money(totalPrice(o,q))+')</div>' +
'<div>Richardson, Yupoong, Flexfit: <span class="each">'+money(unitPrice(p,q))+' each</span> ('+money(totalPrice(p,q))+')</div>' +
'<div class="nudge">Pick a hat below for your exact price.</div>';
return;
}
var t = TIERS[state.hat.tier];
var tot = totalPrice(t,q), full = r2(t.single*q), save = r2(full - tot);
var html = '<div class="big">'+money(tot)+'</div>' +
'<div><span class="each">'+q+(q>1?' hats':' hat')+'</span>' + (q>1 ? ' &middot; '+money(r2(tot/q))+' each' : '') + ', shipped</div>';
if (save > 0) html += '<div class="good">You save '+money(save)+(q<5 ? ' (10% off each hat)' : '')+'</div>';
var nudge = '';
if (q === 1) nudge = 'Order 2 or more and save 10% on every hat.';
else if (q < 5){
var t5 = totalPrice(t,5);
nudge = 'Order 5 and pay '+money(t5)+' ('+money(t.five)+' each)' + (t5 <= tot ? ', less than your '+q+' hats cost.' : '.');
} else if (q < 10){
var t10 = totalPrice(t,10);
nudge = 'Order 10 and pay '+money(t10)+' ('+money(t.ten)+' each)' + (t10 <= tot ? ', ' + (t10<tot?'less than':'the same as') + ' your '+q+' hats cost.' : '.');
} else nudge = '10 or more hats are '+money(t.ten)+' each.';
html += '<div class="nudge">'+nudge+'</div>';
box.innerHTML = html;
}
function selectHat(hat){
var keep = [];
state.colors.forEach(function(x){
var m = hat.colors.filter(function(c){ return c.name === x.c.name; })[0];
if (m) keep.push({ c:m, n:x.n });
});
state.hat = hat; state.colors = keep;
state.preview = keep.length ? keep[keep.length-1].c : null;
if (state.colors.length === 1) state.colors[0].n = state.qty;
update(true);
}
function tapColor(c){
var i = findColor(c);
state.preview = c;
if (i >= 0){
state.colors.splice(i,1);
if (state.colors.length === 1) state.colors[0].n = state.qty;
} else if (state.qty === 1){
state.colors = [{ c:c, n:1 }];
} else if (state.colors.length === 0){
state.colors = [{ c:c, n:state.qty }];
} else {
var rem = state.qty - assigned();
if (rem > 0) state.colors.push({ c:c, n:rem });
else {
var big = state.colors.reduce(function(a,x){ return x.n > a.n ? x : a; }, state.colors[0]);
if (big.n > 1){ big.n -= 1; state.colors.push({ c:c, n:1 }); }
else state.colors.push({ c:c, n:1 });
}
}
update();
}
function adjust(i, d){
var n = state.colors[i].n + d;
if (n < 1) return;
state.colors[i].n = n;
update();
}
function removeColor(i){
state.colors.splice(i,1);
if (state.colors.length === 1) state.colors[0].n = state.qty;
update();
}
function buildBody(hat){
var body = document.createElement('div'); body.className = 'hat-opt-body';
var pv = state.preview || { name:'', hex:'#4a4d52' };
var big = hat.img ? '<img src="'+hat.img+'" alt="">' : hatSVG(hat.kind, pv.hex);
var html = '<div class="hat-big">'+big+'</div>' +
'<div class="preview-cap">'+(state.preview ? esc(state.preview.name) : 'Pick a color to preview it')+'</div>' +
'<div class="hc-label">'+(state.qty > 1 ? 'Tap colors to add them. You can mix colors.' : 'Choose your color.')+'</div>' +
'<div class="hc-swatches"></div><div class="color-list"></div><div class="assign"></div>';
body.innerHTML = html;
var sw = body.querySelector('.hc-swatches');
hat.colors.forEach(function(c){
var d = document.createElement('button');
d.type='button'; d.className='hc-dot'; d.title=c.name; d.setAttribute('aria-label', c.name);
d.style.background = c.hex; d.setAttribute('aria-pressed', findColor(c) >= 0 ? 'true':'false');
d.addEventListener('click', function(){ tapColor(c); });
sw.appendChild(d);
});
var list = body.querySelector('.color-list');
state.colors.forEach(function(x, i){
var row = document.createElement('div'); row.className = 'crow';
row.innerHTML = '<span class="cdot" style="background:'+x.c.hex+'"></span><span class="cname">'+esc(x.c.name)+'</span>';
if (state.qty > 1){
var q = document.createElement('div'); q.className = 'cq';
var m = document.createElement('button'); m.type='button'; m.textContent='\u2212'; m.setAttribute('aria-label','Fewer '+x.c.name);
var pl = document.createElement('button'); pl.type='button'; pl.textContent='+'; pl.setAttribute('aria-label','More '+x.c.name);
var span = document.createElement('span'); span.textContent = x.n;
m.addEventListener('click', function(){ adjust(i,-1); });
pl.addEventListener('click', function(){ adjust(i,1); });
q.appendChild(m); q.appendChild(span); q.appendChild(pl); row.appendChild(q);
var rm = document.createElement('button'); rm.type='button'; rm.className='rm'; rm.innerHTML='&times;'; rm.setAttribute('aria-label','Remove '+x.c.name);
rm.addEventListener('click', function(){ removeColor(i); });
row.appendChild(rm);
}
list.appendChild(row);
});
var a = body.querySelector('.assign'), tot = assigned();
if (state.qty > 1){
if (state.colors.length === 0){ a.textContent = '0 of '+state.qty+' hats assigned'; a.className='assign bad'; }
else if (tot === state.qty){ a.textContent = state.qty+' of '+state.qty+' hats assigned'; a.className='assign ok'; }
else if (tot < state.qty){ a.textContent = tot+' of '+state.qty+' assigned. Add '+(state.qty-tot)+' more.'; a.className='assign bad'; }
else { a.textContent = tot+' of '+state.qty+' assigned. Remove '+(tot-state.qty)+'.'; a.className='assign bad'; }
} else a.style.display = 'none';
return body;
}
var lastHat = null;
function renderHats(scroll){
var list = $('hatList'); list.innerHTML = '';
HATS.forEach(function(hat){
var sel = state.hat === hat, t = TIERS[hat.tier];
var priceTxt = state.qty > 1 ? money(unitPrice(t,state.qty)) + ' each' : money(t.single);
var opt = document.createElement('div'); opt.className = 'hat-opt' + (sel ? ' mx-open' : '');
var head = document.createElement('button'); head.type='button'; head.className='hat-opt-head';
head.setAttribute('aria-expanded', sel ? 'true':'false');
head.innerHTML = thumb(hat, sel && state.preview ? state.preview.hex : '#4a4d52') +
'<span class="htext"><span class="hb">'+hat.brand+'</span><span class="hn">'+hat.name+'</span><span class="hp">'+priceTxt+'</span></span>';
head.addEventListener('click', function(){ if (!sel) selectHat(hat); });
opt.appendChild(head);
if (sel) opt.appendChild(buildBody(hat));
list.appendChild(opt);
if (sel && scroll) setTimeout(function(){ opt.scrollIntoView({ behavior:'smooth', block:'start' }); }, 30);
});
}
function update(scrollToHat){
var num = $('numInput').value.trim(), name = $('nameInput').value.trim();
var colorsDone = !!state.hat && state.colors.length > 0 && assigned() === state.qty;
var ready = state.brand!==null && !!state.plate && num.length>0 && colorsDone;
var parts = [];
if (state.brand!==null) parts.push('<b>'+BRANDS[state.brand].name+'</b>');
if (state.plate) parts.push('Design '+(BRANDS[state.brand].plates.indexOf(state.plate)+1));
if (num) parts.push('#<b>'+esc(num)+'</b>');
if (name) parts.push(esc(name));
parts.push(state.leather.name + ' patch');
if (state.hat) parts.push(state.hat.brand + ' ' + state.hat.name);
if (state.hat && state.colors.length){
parts.push(state.colors.map(function(x){ return esc(x.c.name) + (state.qty>1 ? ' x' + x.n : ''); }).join(', '));
}
var html = (state.brand===null || !state.plate) ? 'Pick a brand and design to get started.' : parts.join(' &middot; ');
if (state.hat){
var t = TIERS[state.hat.tier], tot = totalPrice(t, state.qty), save = r2(t.single*state.qty - tot);
html += '<span class="total">' + state.qty + (state.qty>1?' hats':' hat') + ': <b>' + money(tot) + '</b> shipped';
if (save > 0) html += ' <span class="save">You save ' + money(save) + '</span>';
html += '</span>';
}
if (!ready){
var need = [];
if (state.brand!==null && state.plate && !num) need.push('your number');
if (!state.hat) need.push('a hat');
else if (!state.colors.length) need.push('a hat color');
else if (assigned() !== state.qty) need.push('colors for all ' + state.qty + ' hats');
if (need.length) html += '<span class="total" style="font-size:12.5px;color:var(--paper-dim)">Still needed: ' + need.join(', ') + '</span>';
}
$('summary').innerHTML = html;
$('addBtn').disabled = !ready;
renderPriceBox();
renderHats(scrollToHat === true);
}
['numInput','nameInput'].forEach(function(id){ $(id).addEventListener('input', function(){ update(); }); });
$('addBtn').addEventListener('click', function(){
var num = $('numInput').value.trim(), name = $('nameInput').value.trim();
var t = TIERS[state.hat.tier], tot = totalPrice(t, state.qty);
var lines = [
'Bike brand: ' + BRANDS[state.brand].name,
'Design: ' + (BRANDS[state.brand].plates.indexOf(state.plate)+1) + ' (artboard ' + state.plate + ')',
'Number: ' + num,
'Name: ' + (name || '(none)'),
'Patch color: ' + state.leather.name,
'Hat: ' + state.hat.brand + ' ' + state.hat.name,
'Quantity: ' + state.qty,
'Hat colors: ' + state.colors.map(function(x){ return x.c.name + ' x' + x.n; }).join(', '),
'Total: ' + money(tot) + ' shipped'
];
var url = 'mailto:help@threadbreak.com?subject=' + encodeURIComponent('MX plate hat order: ' + BRANDS[state.brand].name + ' #' + num) +
'&body=' + encodeURIComponent(lines.join('\n') + '\n\nYour name and shipping address:\n');
var m = document.querySelector('#tbmx .cart-msg');
if (!m){ m = document.createElement('p'); m.className='cart-msg'; $('addBtn').after(m); }
m.textContent = 'Online checkout is coming soon. This opens an email to us with your exact order.';
window.location.href = url;
});
update();
})();
</script>
</div>
