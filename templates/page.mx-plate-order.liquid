    if (i >= 0){
      state.colors.splice(i,1);
      if (state.colors.length === 1) state.colors[0].n = state.qty;
    } else if (state.qty === 1){
      state.colors = [{ c:c, n:1 }];
    } else if (state.colors.length === 0){
      state.colors = [{ c:c, n:state.qty }];
    } else {
      var rem = state.qty - assigned();
      if (rem > 0) state.colors.push({ c:c, n:rem });
      else {
        var big = state.colors.reduce(function(a,x){ return x.n > a.n ? x : a; }, state.colors[0]);
        if (big.n > 1){ big.n -= 1; state.colors.push({ c:c, n:1 }); }
        else state.colors.push({ c:c, n:1 });
      }
    }
    update();
  }
