  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function assigned(){ return state.colors.reduce(function(a,x){ return a + x.n; }, 0); }
  function findColor(c){ for (var i=0;i<state.colors.length;i++) if (state.colors[i].c.name === c.name) return i; return -1; }
  function photo(f, w, alt, cls){ return f ? '<img'+(cls?' class="'+cls+'"':'')+' src="'+imgUrl(f,w)+'" alt="'+esc(alt||'')+'" loading="lazy" decoding="async">' : ''; }

  // brands + designs
