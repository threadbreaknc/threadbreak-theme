<div class="quote-page">

  <!-- HERO -->
  <section class="quote-hero">
    <div class="quote-hero-content">
      <p class="eyebrow">Custom Embroidery · Wholesale · Bulk Orders</p>
      <h1>Get a Quote.</h1>
      <p class="quote-hero-sub">Tell us what you need and we'll get back to you within 24 hours with pricing. No commitment required.</p>
    </div>
    <div class="quote-hero-stats">
      <div class="qstat"><strong>10+</strong><span>Hat minimum</span></div>
      <div class="qstat"><strong>24hr</strong><span>Response time</span></div>
      <div class="qstat"><strong>Free</strong><span>Digital proof</span></div>
      <div class="qstat"><strong>All</strong><span>Major brands</span></div>
    </div>
  </section>

  <!-- STITCH TYPE EXPLAINER -->
  <section class="stitch-section">
    <div class="stitch-header">
      <p class="eyebrow reveal">Know Before You Order</p>
      <h2 class="reveal reveal-d1">Flat Stitch vs.<br>3D Puff.</h2>
      <p class="stitch-intro reveal reveal-d2">Two different embroidery techniques, both look great, but each works better for certain designs. Here's what you need to know.</p>
    </div>

    <div class="stitch-cards">

      <!-- FLAT STITCH CARD -->
      <div class="stitch-card reveal" id="stitch-flat">
        <div class="stitch-visual">
          <div class="stitch-demo stitch-demo-flat">
            <span class="flat-word">FLAT STITCH</span>
            <p class="stitch-sublabel">Sits flush against fabric, no movement, no depth</p>
          </div>
          <div class="stitch-badge stitch-badge-flat">Flat Stitch</div>
        </div>
        <div class="stitch-info">
          <h3>Flat Stitch</h3>
          <p>Traditional embroidery that sits flush against the fabric. Sharp, clean, and works great for detailed logos with fine lines, small text, or complex shapes.</p>
          <ul class="stitch-pros">
            <li>✦ Best for detailed designs & small text</li>
            <li>✦ Works on all hat styles</li>
            <li>✦ Cleaner edges on complex logos</li>
            <li>✦ Most popular choice</li>
          </ul>
        </div>
      </div>

      <!-- 3D PUFF CARD -->
      <div class="stitch-card reveal reveal-d1" id="stitch-puff">
        <div class="stitch-visual stitch-visual-dark">
          <div class="stitch-demo stitch-demo-puff">
            <div class="puff-word-demo">
              <span class="puff-letter">3</span>
              <span class="puff-letter">D</span>
              <span class="puff-letter"> </span>
              <span class="puff-letter">P</span>
              <span class="puff-letter">U</span>
              <span class="puff-letter">F</span>
              <span class="puff-letter">F</span>
            </div>
            <p class="puff-label">Raises off the fabric, watch it pop</p>
          </div>
          <div class="stitch-badge stitch-badge-puff">3D Puff</div>
        </div>
        <div class="stitch-info">
          <h3>3D Puff Embroidery</h3>
          <p>A foam layer is placed under the stitching, causing the design to raise up from the fabric. Bold, dimensional, and eye-catching, the streetwear look.</p>
          <ul class="stitch-pros">
            <li>✦ Bold raised 3D effect</li>
            <li>✦ Best for block letters & simple shapes</li>
            <li>✦ Premium, high-end appearance</li>
            <li>✦ <em>Additional charge applies</em></li>
          </ul>
          <div class="puff-warning">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2L1 21h22L12 2zm0 3.5L20.5 19h-17L12 5.5zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z"/></svg>
            Not all designs work with 3D puff, fine details and small text don't transfer well. We'll let you know if your design isn't a good fit.
          </div>
        </div>
      </div>

    </div>

    <div class="stitch-note reveal">
      <strong>Not sure which to choose?</strong> Just send us your design and we'll recommend the best technique. 3D puff carries an additional charge and requires design approval, we'll confirm before proceeding.
    </div>
  </section>

  <!-- QUOTE FORM -->
  <section class="quote-form-section">
    <div class="quote-form-header">
      <p class="eyebrow reveal">Ready to Order?</p>
      <h2 class="reveal reveal-d1">Request a Quote.</h2>
    </div>

    {%- form 'contact', id: 'quote-form' -%}

      {%- if form.posted_successfully? -%}
        <div class="quote-success">
          <div class="quote-success-stars" aria-hidden="true">
            <span class="qstar" style="--tx:-70px;--ty:-50px;">✦</span>
            <span class="qstar" style="--tx:70px;--ty:-60px;">✦</span>
            <span class="qstar" style="--tx:-40px;--ty:-80px;">✦</span>
            <span class="qstar" style="--tx:50px;--ty:-40px;">✦</span>
            <span class="qstar" style="--tx:-90px;--ty:-25px;">✦</span>
            <span class="qstar" style="--tx:90px;--ty:-35px;">✦</span>
          </div>
          <div class="quote-success-icon">✦</div>
          <h3>Request Received.</h3>
          <div class="quote-success-divider"></div>
          <p>We'll get back to you at <strong>{{ form.email }}</strong> within 24 hours.</p>
          <p class="quote-success-sub">Check your inbox, we'll be in touch soon.</p>
        </div>
      {%- else -%}

      <input type="hidden" name="contact[subject]" value="Quote Request – Threadbreak">

      <div class="qform">

        <div class="qform-section">
          <h4 class="qform-section-title">01, Contact Info</h4>
          <div class="qform-row">
            <div class="qform-field">
              <label for="q-name">Name <span class="req">*</span></label>
              <input type="text" id="q-name" name="contact[name]" required placeholder="Your name">
            </div>
            <div class="qform-field">
              <label for="q-email">Email <span class="req">*</span></label>
              <input type="email" id="q-email" name="contact[email]" required placeholder="you@email.com">
            </div>
          </div>
          <div class="qform-row">
            <div class="qform-field">
              <label for="q-company">Company / Brand</label>
              <input type="text" id="q-company" name="contact[company]" placeholder="Optional">
            </div>
            <div class="qform-field">
              <label for="q-phone">Phone</label>
              <input type="tel" id="q-phone" name="contact[phone]" placeholder="Optional">
            </div>
          </div>
        </div>

        <div class="qform-section">
          <h4 class="qform-section-title">02, Order Details</h4>

          <div class="qform-field">
            <label for="q-qty">How Many Hats? <span class="req">*</span></label>
            <input type="number" id="q-qty" name="contact[quantity]" required min="10" placeholder="e.g. 24" style="max-width:200px;background:#ffffff;color:#1a1520;border:1px solid rgba(26,21,32,0.15);">
            <p class="qform-hint" style="margin-top:0.4rem;">Minimum order is <strong style="color:var(--purple-light);">10 hats</strong>. The more you order, the better the price.</p>
          </div>

          <div class="qform-field">
            <label>Hat Style Preference</label>
            <div class="qform-options">
              <label class="qopt"><input type="radio" name="contact[hat_style]" value="Snapback"><span>Snapback</span></label>
              <label class="qopt"><input type="radio" name="contact[hat_style]" value="Fitted"><span>Fitted</span></label>
              <label class="qopt"><input type="radio" name="contact[hat_style]" value="Dad Hat"><span>Dad Hat</span></label>
              <label class="qopt"><input type="radio" name="contact[hat_style]" value="Trucker"><span>Trucker</span></label>
              <label class="qopt"><input type="radio" name="contact[hat_style]" value="Beanie"><span>Beanie</span></label>
              <label class="qopt"><input type="radio" name="contact[hat_style]" value="Not sure"><span>Not sure</span></label>
            </div>
          </div>

          <div class="qform-field">
            <label>Stitch Type</label>
            <div class="qform-options">
              <label class="qopt"><input type="radio" name="contact[stitch_type]" value="Flat Embroidery"><span>Flat Embroidery</span></label>
              <label class="qopt"><input type="radio" name="contact[stitch_type]" value="3D Puff"><span>3D Puff <em style="font-size:0.7em;opacity:0.7">(additional charge)</em></span></label>
              <label class="qopt"><input type="radio" name="contact[stitch_type]" value="Not sure"><span>Not sure</span></label>
            </div>
          </div>

          <div class="qform-field">
            <label for="q-hat-color">Preferred Hat Color(s)</label>
            <input type="text" id="q-hat-color" name="contact[hat_color]" placeholder="e.g. Black, White, Natural, Navy, etc.">
          </div>

          <div class="qform-field">
            <label for="q-colors">Thread / Embroidery Colors</label>
            <input type="text" id="q-colors" name="contact[colors]" placeholder="e.g. Red, White, Black, or we can match your logo's colors exactly">
          </div>

          <div class="qform-field">
            <label for="q-notes">Additional Notes <span class="req">*</span></label>
            <textarea id="q-notes" name="contact[body]" rows="5" required placeholder="Deadline, specific brands, budget range, anything else we should know..."></textarea>
          </div>

          <div class="qform-field">
            <label for="q-file">Upload Your Logo / Design File</label>
            <p class="qform-hint" style="margin-bottom:0.75rem;">PNG, JPG, PDF, AI, SVG accepted. File saves to our system on submit.</p>
            <input type="file" id="q-file" name="contact[logo]" accept=".png,.jpg,.jpeg,.pdf,.ai,.svg,.eps" class="qform-file-input">
          </div>

        </div>

        <div class="qform-submit-row">
          <button type="submit" class="btn btn-fill quote-submit">Send Quote Request →</button>
          <p class="quote-privacy">We respond within 24 hours. No spam, ever.</p>
        </div>

      </div>

      {%- endif -%}
    {%- endform -%}
  </section>

</div>