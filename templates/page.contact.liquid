    colors:["Black","Black/White","Charcoal","Charcoal/Black","Charcoal/White","Navy","Navy/White","Navy/Khaki","Heather Grey/White","Heather Grey/Black","Loden","Loden/Black","Dark Green","Dark Green/White","Brown/Khaki","Khaki/Coffee","Khaki/White","White/Black","Red/Black","Cardinal/White"],
    tiers:[[10,20,52559808135300],[24,18,52559808168068],[48,17,52559808200836],[96,16,52559808233604],[144,14,52559808266372]] },
  { id:"yupoong", name:"Yupoong Classic 5-Panel Trucker", brand:"YP Classics 6006", desc:"Flat bill snapback · one size fits most", popular:12,
    imgs:["https://cdn.shopify.com/s/files/1/0974/8453/7988/files/77759_f_fm-2.jpg?v=1784998725","https://cdn.shopify.com/s/files/1/0974/8453/7988/files/68095_f_fm.jpg?v=1784998725","https://cdn.shopify.com/s/files/1/0974/8453/7988/files/35926_f_fm.jpg?v=1784998725","https://cdn.shopify.com/s/files/1/0974/8453/7988/files/64032_f_fm.jpg?v=1784998750"],
    colors:["Black","Black/White","Black/White/Black","White","Charcoal","Charcoal/Black","Charcoal/White","Navy","Navy/White","Navy/White/Navy","Red","Red/Black","Red/White/Red","Brown/White","Brown/White/Brown","Carolina Blue/White/Carolina Blue","Green Camo/Black","Heather/Black","Heather/White","Kelly/White/Kelly","Multicam Alpine/White","Multicam Arid/Brown","Multicam Arid/Tan","Multicam Black/Black","Multicam Green/Black","Multicam Tropic/Green","Pink","Pink/White/Pink","Royal/White","Royal/White/Royal","Silver/Black"],
    tiers:[[10,20,52559808299140],[24,18,52559808331908],[48,17,52559808364676],[96,16,52559808397444],[144,14,52559808430212]] },
  { id:"other", name:"Different style?", brand:"You name it", desc:"Flexfit, fitted, beanies, visors, and more. We'll source it", quote:true, popular:99,
    colors:["Black","Navy","Charcoal","White","Red","Khaki"] },
];
const SIZES = ["Adult (one size)","Youth","Mix of both"];
const DECOS = [
  { id:"flat",  label:"Flat embroidery", add:0 },
  { id:"puff",  label:"3D puff", add:3, variantId:52543282741380 },
];
const PLACEMENTS = [
  { id:"front", label:"Front", add:0, locked:true },
  { id:"side",  label:"Side", add:5, variantId:52543282806916 },
  { id:"back",  label:"Back", add:5, variantId:52543282839684 },
];
const QUOTE_EMAIL = "help@threadbreak.com";
/* Paste your Apps Script web app URL (ends in /exec) here, see
   threadbreak-apps-script.gs. Until set, uploads are skipped and
   quote requests fall back to email. */
const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbz0-rO8Y8fqsyAGPM1WLd_Q48GiOGKHxUYxq-UCT4a6ONXWLW6fIo2feCzDOcjmuAPE/exec";
/* ========================================================= */

const state = {
  style: STYLES[0], colorSel: [STYLES[0].colors[0]], colorQty: { [STYLES[0].colors[0]]: 24 },
  showAllColors: false, hasChosen: false, sizing: SIZES[0], qty: 10, deco: DECOS[0],
  placements: new Set(["front"]), files: { front:null, side:null, back:null }
};
const $ = id => document.getElementById(id);
const money = n => "$" + (Number.isInteger(n) ? n : n.toFixed(2));
const quoteMode = () => !!state.style.quote;

/* ---- auto swatches from manufacturer color names ---- */
const HUES = { black:"#1B1B1F", white:"#F5F5F5", natural:"#E8E0CC", charcoal:"#4A4A52",
  "charcoal grey":"#4A4A52", grey:"#8E8E96", gray:"#8E8E96", "light grey":"#C9CBD1",
  "heather grey":"#A8A8B0", heather:"#A8A8B0", silver:"#C0C0C8", aluminum:"#C9CBD1",
  navy:"#1E2A4A", royal:"#2A4FC7", "true blue":"#3A66B0", "columbia blue":"#7BAFD4",
  "carolina blue":"#7BAFD4", "light blue":"#A8CBE8", "smoke blue":"#5E7A96",
  "legion blue":"#1F4E6B", "blue teal":"#2E7F8F", cyan:"#57B8D8",
  red:"#C0243A", cardinal:"#8C1D2F", maroon:"#6E2639", "hot pink":"#E24E9C", pink:"#F4A6C0",
  orange:"#E07020", "dark orange":"#C4551F", yellow:"#F2D01E", gold:"#D4A93C",
  "vegas gold":"#C5B358", "amber gold":"#C99435",
  "kelly":"#349C55", "kelly green":"#349C55", "dark green":"#1F4A34", loden:"#4F5A43",
  "loden green":"#4F5A43", "army olive":"#5A6234",
  khaki:"#B9A583", biscuit:"#E4D5B0", cream:"#F0E9D8", birch:"#E8E2D4", tan:"#C2A878",
  brown:"#6B4A2F", "grey brown":"#8A7A6A", coffee:"#4E3A2A", carmel:"#B87E3F",
  "chocolate chip":"#6B5B4A", "mink beige":"#C7B29E", gunmetal:"#5A5F66",
  purple:"#5D3A9B", quarry:"#8C9490",
  "neon blue":"#2AB8E8", "neon green":"#7CE81E", "neon orange":"#FF7A1A",
  "neon pink":"#FF5EC0", "neon yellow":"#E8F51E" };
function camoCss(n){
  let t = ["#4B5320","#6B8E23","#3B3B2F"];                       // field/green/army/tropic
  if (/arid|tan|desert|duck/.test(n)) t = ["#C2B280","#A48A5F","#8B7355"];
  else if (/black/.test(n))           t = ["#1B1B1F","#3C3C44","#55555E"];
  else if (/alpine/.test(n))          t = ["#E8E8E8","#C9CBD1","#9DA1A8"];
  return `repeating-linear-gradient(45deg,${t[0]} 0 4px,${t[1]} 4px 8px,${t[2]} 8px 12px)`;
}
function colorCss(name){
  const clean = name.replace(/\s*CMB\s*$/i, "");
  const parts = clean.split("/").map(s => s.trim());
  const isCamo = s => /camo|multicam/i.test(s);
  if (parts.length === 2 && (isCamo(parts[0]) || isCamo(parts[1]))){
    const camo = camoCss(clean.toLowerCase());
    if (isCamo(parts[0]) && isCamo(parts[1])) return camo;
    if (isCamo(parts[1])){
      const a = HUES[parts[0].toLowerCase()] || "#CFCFD8";
      return `linear-gradient(90deg, ${a} 0 50%, rgba(0,0,0,0) 50% 100%), ${camo}`;
    }
    const b = HUES[parts[1].toLowerCase()] || "#CFCFD8";
    return `linear-gradient(90deg, rgba(0,0,0,0) 0 50%, ${b} 50% 100%), ${camo}`;
  }
  if (isCamo(clean)) return camoCss(clean.toLowerCase());
  const hexes = parts.map(s => HUES[s.toLowerCase()] || "#CFCFD8");
  if (hexes.length === 1) return hexes[0];
  const step = 100 / hexes.length;
  return "linear-gradient(90deg," + hexes.map((c,i)=>`${c} ${i*step}% ${(i+1)*step}%`).join(",") + ")";
}

function tierFor(style, qty){
  let t = style.tiers[0];
  for (const tier of style.tiers) if (qty >= tier[0]) t = tier;
  return t;
}
function perHat(){
  if (quoteMode()) return null;
  const base = tierFor(state.style, state.qty)[1];
  const extras = [...state.placements].reduce((s,p)=> s + PLACEMENTS.find(x=>x.id===p).add, 0);
  return base + state.deco.add + extras;
}
function evenSplit(){
  const n = state.colorSel.length;
  const base = Math.floor(state.qty / n);
  const rem = state.qty - base * n;
  state.colorQty = {};
  state.colorSel.forEach((c,i) => state.colorQty[c] = base + (i === 0 ? rem : 0));
}
function colorSummary(){
  if (state.colorSel.length === 1) return state.colorSel[0];
  return state.colorSel.map(c => `${c} ×${state.colorQty[c] || 0}`).join(", ");
}

function buildOrderSummary(){
  const rows = $("sbSummaryRows");
  if (!rows) return;
  const per = perHat();
  const places = [...state.placements].map(p => (PLACEMENTS.find(x=>x.id===p)||{}).label || p);
  const lines = [
    ["Hat", state.style.quote ? "Different style (custom quote)" : `${state.style.name} (${state.style.brand})`],
    ["Quantity", `${state.qty} hats`],
    ["Colors", colorSummary()],
    ["Decoration", state.deco.label],
    ["Placement", places.join(", ") || "Front"],
  ];
  if (state.style.youth) lines.push(["Sizing", state.sizing]);
  let html = lines.map(([l,v]) =>
    `<div class="sb-sum-row"><span class="sb-sum-label">${l}</span><span class="sb-sum-val">${v}</span></div>`).join("");
  if (per !== null){
    html += `<div class="sb-sum-row"><span class="sb-sum-label">Per hat</span><span class="sb-sum-val">${money(per)}</span></div>`;
    html += `<div class="sb-sum-row sb-sum-total"><span class="sb-sum-label">Estimated total</span><span class="sb-sum-val">${money(per*state.qty)}</span></div>`;
    html += `<div class="sb-summary-cta"><p>Look good? Complete your purchase.</p><button type="button" class="sb-cta" id="sbSummaryCheckout">Checkout</button></div>`;
  } else {
    html += `<div class="sb-sum-row sb-sum-total"><span class="sb-sum-label">Total</span><span class="sb-sum-val">We'll quote it</span></div>`;
    html += `<div class="sb-summary-cta"><p>Look good? We'll send your exact pricing.</p><button type="button" class="sb-cta" id="sbSummaryCheckout">Request my quote</button></div>`;
  }
  rows.innerHTML = html;
  const co = $("sbSummaryCheckout");
  if (co) co.addEventListener("click", () => quoteMode() ? submitQuote() : submitCheckout());
}

let heroTimer = null, heroIdx = 0, heroTop = "A";
function renderHero(){
  clearInterval(heroTimer);
  const a = $("heroImgA"), b = $("heroImgB");
  if (!a || !b) return; // selected style has no photos (quote card)
  const imgs = state.style.imgs || [];
  heroIdx = 0; heroTop = "A";
  a.src = imgs[0]; a.classList.add("on"); b.classList.remove("on");
  const dots = $("heroDots");
  dots.innerHTML = imgs.map((_,i) =>
    `<button type="button" class="${i===0?'on':''}" aria-label="Photo ${i+1}"></button>`).join("");
  const show = i => {
    if (i === heroIdx) return;
    heroIdx = i;
    const top = heroTop === "A" ? a : b;   // currently visible
    const bottom = heroTop === "A" ? b : a; // will become visible
    const swap = () => {
      bottom.classList.add("on");
      top.classList.remove("on");
      heroTop = heroTop === "A" ? "B" : "A";
    };
    if (bottom.src === imgs[i]) swap();
    else {
      bottom.onload = swap;
      bottom.src = imgs[i];
    }
    dots.querySelectorAll("button").forEach((btn,j) => btn.classList.toggle("on", j === i));
  };
  const restart = () => {
    clearInterval(heroTimer);
    if (imgs.length > 1) heroTimer = setInterval(() => show((heroIdx + 1) % imgs.length), 2600);
  };
  dots.querySelectorAll("button").forEach((btn,i) =>
    btn.addEventListener("click", e => { e.preventDefault(); e.stopPropagation(); show(i); restart(); }));
  restart();
}

function updatePricingUI(){
  if (!quoteMode()){
    const activeTier = tierFor(state.style, state.qty);
    $("tiers").querySelectorAll(".tier").forEach(el =>
      el.classList.toggle("on", +el.dataset.q === activeTier[0]));
    const idx = state.style.tiers.indexOf(activeTier);
    const next = state.style.tiers[idx+1];
    const sv = $("savings");
    sv.textContent = next
      ? `Add ${next[0]-state.qty} more and your price drops to ${money(next[1])}/hat.`
      : "You're at our best rate. Nice.";
    sv.classList.add("show");
  }
  const per = perHat();
  const newTotal = per === null ? null : per * state.qty;
  $("sbQty").textContent = state.qty;
  $("sbPer").textContent = per === null ? "TBD" : money(per);

  const perEl = $("sbPer");
  const totalEl = $("sbTotal");
  // pulse both per-hat and total purple whenever the price changes (no up/down direction)
  if (newTotal !== null && window._tbPrevTotal != null && newTotal !== window._tbPrevTotal){
    [perEl, totalEl].forEach(el => {
      if (!el) return;
      el.classList.remove("flash");
      void el.offsetWidth;  // restart animation
      el.classList.add("flash");
    });
  }
  window._tbPrevTotal = newTotal;

  totalEl.textContent = per === null ? "-" : money(newTotal);
  $("sbTotalLabel").textContent = per === null ? "We'll quote it" : "Estimated total";
  const bt = document.querySelector(".bd-total");
  if (bt) bt.textContent = state.qty + " hats total";
}

function renderColors(){
  const list = state.style.colors;
  const cut = state.style.popular || list.length;
  const visible = state.showAllColors ? list : list.slice(0, Math.min(cut, list.length));
  const hidden = list.length - visible.length;
  $("colors").innerHTML = visible.map(c =>
    `<button type="button" class="chip ${state.colorSel.includes(c)?'on':''}" data-c="${c}"><span class="dot" style="background:${colorCss(c)}"></span>${c}</button>`
  ).join("") + (hidden > 0
    ? `<button type="button" class="chip more" id="moreColors">+ ${hidden} more colors</button>`
    : (state.showAllColors && list.length > cut ? `<button type="button" class="chip more" id="lessColors">Show fewer</button>` : ""));
  $("colors").querySelectorAll(".chip[data-c]").forEach(b =>
    b.addEventListener("click", () => {
      const c = b.dataset.c;
      const i = state.colorSel.indexOf(c);
      if (i >= 0){ if (state.colorSel.length === 1) return; state.colorSel.splice(i,1); }
      else state.colorSel.push(c);
      evenSplit(); render();
    }));
  const more = $("moreColors"); if (more) more.addEventListener("click", () => { state.showAllColors = true; render(); });
  const less = $("lessColors"); if (less) less.addEventListener("click", () => { state.showAllColors = false; render(); });

  // per-color quantity breakdown
  const wrap = $("breakdownWrap");
  if (state.colorSel.length > 1){
    wrap.innerHTML = `<div class="breakdown">` + state.colorSel.map(c => `
      <div class="bd-row">
        <span class="dot" style="background:${colorCss(c)}"></span>
        <span class="bd-name">${c}</span>
        <input class="bd-qty" type="number" min="0" inputmode="numeric" value="${state.colorQty[c] || 0}" data-c="${c}" aria-label="Quantity for ${c}">
      </div>`).join("") + `<div class="bd-total">${state.qty} hats total</div></div>`;
    wrap.querySelectorAll(".bd-qty").forEach(inp =>
      inp.addEventListener("input", e => {
        state.colorQty[e.target.dataset.c] = Math.max(0, parseInt(e.target.value || "0", 10));
        state.qty = Math.max(1, state.colorSel.reduce((s,c)=> s + (state.colorQty[c] || 0), 0));
        $("qty").value = state.qty;
        updatePricingUI();
      }));
  } else {
    wrap.innerHTML = "";
  }

  $("colorHint").textContent = quoteMode()
    ? "Rough color direction is fine. We'll confirm exact colorways in your quote."
    : (state.colorSel.length > 1
      ? "Set how many hats you want in each color. The total drives your price."
      : "Tap more than one color to split your order across colorways. Don't see yours? Mention it in the notes.");
}

function render(){
  document.body.classList.toggle("quote-mode", quoteMode());

  $("styles").innerHTML = STYLES.map(s => {
    const sel = state.hasChosen && s.id === state.style.id;
    const expanded = sel && s.imgs && s.imgs.length;
    const media = expanded
      ? `<div class="hero-wrap">
           <div class="hero-stage">
             <img class="hero-img hero-a on" id="heroImgA" src="${s.imgs[0]}" alt="${s.name}">
             <img class="hero-img hero-b" id="heroImgB" alt="">
           </div>
           <div class="hero-dots" id="heroDots"></div>
         </div>`
      : (s.imgs && s.imgs.length
        ? `<img class="style-thumb" src="${s.imgs[0]}" alt="${s.name}" loading="lazy" onerror="this.style.visibility='hidden'">`
        : `<div class="style-thumb ph">?</div>`);
    return `
    <label class="style-card ${sel?'on':''} ${expanded?'expanded':''}">
      <input type="radio" name="style" value="${s.id}" ${sel?'checked':''}>
      ${media}
      <div class="style-info">
        <div class="style-name">${s.name}</div>
        <div class="style-brand">${s.brand}</div>
        <div class="style-desc">${s.desc}</div>
        <div class="style-price">${s.quote ? "Custom quote" : "from " + money(s.tiers[s.tiers.length-1][1]) + "/hat"}</div>
      </div>
    </label>`;
  }).join("");
  document.querySelectorAll('input[name=style]').forEach(r =>
    r.addEventListener('change', e => {
      state.hasChosen = true;
      state.style = STYLES.find(s=>s.id===e.target.value);
      state.showAllColors = false;
      state.colorSel = state.colorSel.filter(c => state.style.colors.includes(c));
      if (!state.colorSel.length) state.colorSel = [state.style.colors[0]];
      evenSplit(); render();
    }));
  // (selection handled entirely by the radio 'change' handler above)
  renderHero();

  renderColors();

  $("sizingWrap").style.display = state.style.youth ? "block" : "none";
  if (state.style.youth){
    $("sizes").innerHTML = SIZES.map(s =>
      `<button type="button" class="chip ${s===state.sizing?'on':''}" data-s="${s}">${s}</button>`).join("");
    $("sizes").querySelectorAll('.chip').forEach(b =>
      b.addEventListener('click', () => { state.sizing = b.dataset.s; render(); }));
  }

  if (!quoteMode()){
    $("tiers").innerHTML = state.style.tiers.map(t => `
      <div class="tier" data-q="${t[0]}">
        <div class="t-qty">${t[0]}+</div>
        <div class="t-price">${money(t[1])}</div>
      </div>`).join("");
    $("tiers").querySelectorAll('.tier').forEach(el =>
      el.addEventListener('click', () => {
        state.qty = +el.dataset.q; $("qty").value = state.qty;
        evenSplit(); render();
      }));
  }

  $("deco").innerHTML = DECOS.map(d =>
    `<button type="button" class="chip ${d.id===state.deco.id?'on':''}" data-d="${d.id}">${d.label}${d.add?` <small>+${money(d.add)}</small>`:''}</button>`).join("");
  $("deco").querySelectorAll('.chip').forEach(b =>
    b.addEventListener('click', () => { state.deco = DECOS.find(d=>d.id===b.dataset.d); render(); }));

  $("placements").innerHTML = PLACEMENTS.map(p =>
    `<button type="button" class="chip ${state.placements.has(p.id)?'on':''}" data-p="${p.id}">${p.label}${p.add?` <small>+${money(p.add)}</small>`:''}</button>`).join("");
  $("placements").querySelectorAll('.chip').forEach(b =>
    b.addEventListener('click', () => {
      const p = b.dataset.p;
      if (p === "front") return;
      state.placements.has(p) ? state.placements.delete(p) : state.placements.add(p);
      render();
    }));

  updateBarBtn();
  updatePricingUI();
  renderUploads();
  accSummaries();
  // reveal the bottom bar only after they've started selecting
  const sb = $("scoreboard");
  if (sb) sb.classList.toggle("sb-hidden", !state.hasChosen);
}

function activeUploadSlots(){
  return ["front","side","back"].filter(p => p === "front" || state.placements.has(p));
}
function renderUploads(){
  const slots = activeUploadSlots();
  $("uploads").innerHTML = slots.map(p => {
    const f = state.files[p];
    const label = PLACEMENTS.find(x=>x.id===p).label;
    return `<label class="upload ${f?'has-file':''}">
      <input type="file" data-slot="${p}" accept="image/*,.pdf,.ai,.eps,.svg">
      <div class="u-title">${f ? f.name : label + " logo"}</div>
      <div class="u-sub">${f ? "✓ attached, tap to swap" : "Tap to upload"}</div>
    </label>`;
  }).join("");
  $("uploads").querySelectorAll("input[type=file]").forEach(inp =>
    inp.addEventListener("change", e => {
      const f = e.target.files[0];
      if (f && f.size > 10 * 1024 * 1024){
        alert("That file is over 10 MB. Try a smaller export, or email it to help@threadbreak.com after checkout.");
        e.target.value = "";
        return;
      }
      state.files[e.target.dataset.slot] = f || null;
      renderUploads();
    }));
}

$("qty").addEventListener("input", e => {
  const v = Math.max(1, parseInt(e.target.value || "1", 10));
  state.qty = Math.max(10, v);
  evenSplit();
  renderColors();
  updatePricingUI();
});
$("qty").addEventListener("blur", e => {
  if (parseInt(e.target.value || "0", 10) < 10) e.target.value = 10;
});

function fileToB64(file){
  return new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(r.result.split(",")[1]);
    r.onerror = () => rej(new Error("read failed"));
    r.readAsDataURL(file);
  });
}
function orderMeta(){
  const per = perHat();
  const meta = {
    style: state.style.name,
    requestedStyle: quoteMode() ? ($("quoteStyle").value.trim() || "Not specified, see notes") : "",
    color: colorSummary(),
    qty: state.qty,
    deco: state.deco.label,
    placements: [...state.placements].map(p=>PLACEMENTS.find(x=>x.id===p).label).join(", "),
    notes: $("notes").value.trim() || "-",
    estimate: per === null ? "quote" : money(per) + "/hat, " + money(per*state.qty) + " total"
  };
  if (state.style.youth) meta.sizing = state.sizing;
  return meta;
}
function scriptConfigured(){ return APPS_SCRIPT_URL && !APPS_SCRIPT_URL.startsWith("PASTE"); }
async function sendToDrive(type){
  if (!scriptConfigured()) return { ok:false, skipped:true, uploaded:[] };
  const uploaded = [];
  const files = [];
  for (const p of activeUploadSlots()){
    const f = state.files[p];
    if (!f) continue;
    files.push({
      placement: PLACEMENTS.find(x=>x.id===p).label,
      name: f.name,
      mimeType: f.type || "application/octet-stream",
      data: await fileToB64(f)
    });
    uploaded.push(PLACEMENTS.find(x=>x.id===p).label);
  }
  try {
    // Fire-and-forget (no-cors): the combined Apps Script saves every file in
    // the `files` array. We cannot read the response in no-cors mode, so we
    // report success optimistically once the POST is sent.
    await fetch(APPS_SCRIPT_URL, {
      method: "POST",
      mode: "no-cors",
      headers: { "Content-Type": "text/plain" },
      body: JSON.stringify({ type, meta: orderMeta(), files })
    });
    return { ok:true, uploaded };
  } catch (e) {
    return { ok:false, uploaded };
  }
}

async function submitQuote(){
  const btn = $("submitBtn");
  btn.disabled = true; btn.textContent = "Sending…";
  const meta = orderMeta();
  const summary = [
    `Requested style/brand: ${meta.requestedStyle}`,
    `Color(s): ${meta.color}`, `Quantity: ${meta.qty}`,
    `Decoration: ${meta.deco}`, `Placements: ${meta.placements}`,
    `Notes: ${meta.notes}`
  ].join("\n");

  const sent = await sendToDrive("quote");
  btn.disabled = false; btn.textContent = "Request my quote";

  if (sent.ok){
    $("confTitle").textContent = "Request sent ✓";
    $("confBody").innerHTML = "We've got it" + (sent.uploaded.length ? ", artwork and all" : "") + ". We'll reply from <strong>help@threadbreak.com</strong> with your exact price and free mockup within 1 business day. Watch your inbox.";
  } else {
    $("confTitle").textContent = "Almost there, hit send";
    $("confBody").innerHTML = "Your quote request just opened in your email app. Press send and we'll reply within 1 business day. Please attach your logo file(s) to that email too. Or copy the summary below to <strong>help@threadbreak.com</strong>.";
    window.location.href = `mailto:${QUOTE_EMAIL}?subject=${encodeURIComponent("Custom Hat Quote Request")}&body=${encodeURIComponent("CUSTOM HAT QUOTE REQUEST (threadbreak.com)\n\n" + summary)}`;
  }
  $("summary").textContent = summary;
  $("confirm").classList.add("show");
  $("confirm").scrollIntoView({ behavior:"smooth", block:"start" });
}

async function submitCheckout(){
  const btn = $("sbSummaryCheckout") || $("submitBtn");
  btn.disabled = true;
  $("cartErr").classList.remove("show");

  const hasFiles = activeUploadSlots().some(p => state.files[p]);
  let artNote = "Customer will email logo to help@threadbreak.com";
  if (hasFiles){
    btn.textContent = "Sending art…";
    const up = await sendToDrive("order-artwork");
    if (up.ok) artNote = "Uploaded ✓ (" + up.uploaded.join(", ") + ")";
    else artNote = "ACTION: email customer for logo (upload not received)";
  }

  btn.textContent = "Adding…";
  const meta = orderMeta();
  const tier = tierFor(state.style, state.qty);
  const props = { "Hat Color(s)": meta.color, "Decoration": meta.deco, "Placements": meta.placements, "Artwork": artNote };
  if (meta.sizing) props["Sizing"] = meta.sizing;
  if (meta.notes !== "-") props["Notes"] = meta.notes;

  const items = [{ id: tier[2], quantity: state.qty, properties: props }];
  if (state.deco.variantId)
    items.push({ id: state.deco.variantId, quantity: state.qty, properties: { "Applies to": state.style.name } });
  for (const p of state.placements) {
    const pl = PLACEMENTS.find(x=>x.id===p);
    if (pl.variantId)
      items.push({ id: pl.variantId, quantity: state.qty, properties: { "Applies to": state.style.name } });
  }

  try {
    const res = await fetch("/cart/add.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ items })
    });
    if (!res.ok) throw new Error("cart add failed");
    window.location.href = "/checkout";
  } catch (e) {
    btn.disabled = false; btn.textContent = "Checkout";
    $("cartErr").classList.add("show");
    $("cartErr").scrollIntoView({ behavior:"smooth", block:"center" });
  }
}

function accSummaries(){
  // Step 1: chosen hat
  const s1 = $("sum1");
  if (s1) s1.textContent = state.hasChosen ? (state.style.quote ? "Different style (custom quote)" : state.style.name) : "";
  // Step 2: quantity
  const s2 = $("sum2");
  if (s2) s2.textContent = state.hasChosen ? `${state.qty} hats total` : "";
  // Step 3: colors
  const s3 = $("sum3");
  if (s3) s3.textContent = state.hasChosen ? colorSummary() : "";
  // Step 4: decoration + placements
  const s4 = $("sum4");
  if (s4){
    const places = [...state.placements].map(p => (PLACEMENTS.find(x=>x.id===p)||{}).label || p);
    s4.textContent = state.hasChosen ? `${state.deco.label}${places.length?" · "+places.join(", "):""}` : "";
  }
}

function markDone(step, done){
  const sec = document.querySelector(`.acc[data-step="${step}"]`);
  if (sec) sec.classList.toggle("done", !!done);
}

function setOpen(step, open){
  const sec = document.querySelector(`.acc[data-step="${step}"]`);
  if (sec) sec.classList.toggle("open", open);
}

function updateBarBtn(){
  const btn = $("submitBtn");
  if (!btn) return;
  const step4Open = document.querySelector('.acc[data-step="4"]')?.classList.contains("open");
  // only show the button once they've opened the final step
  btn.style.display = step4Open ? "" : "none";
  btn.textContent = quoteMode() ? "Review request" : "Review order";
}

function initAccordion(){
  // header click toggles that step open/closed (multiple can be open)
  document.querySelectorAll('[data-acc-toggle]').forEach(head => {
    head.addEventListener("click", () => {
      head.closest(".acc").classList.toggle("open");
      updateBarBtn();
    });
  });
  // Continue buttons: mark done, collapse this step, open next, then gently scroll after collapse settles
  document.querySelectorAll('[data-continue]').forEach(btn => {
    btn.addEventListener("click", () => {
      const step = +btn.getAttribute("data-continue");
      markDone(step, true);
      setOpen(step, false);
      setOpen(step + 1, true);
      updateBarBtn();
      const next = document.querySelector(`.acc[data-step="${step+1}"]`);
      if (next){
        // wait for the collapse transition (0.35s) so the target position is final, then scroll
        setTimeout(() => {
          const y = next.getBoundingClientRect().top + window.pageYOffset - 90;
          window.scrollTo({ top: y, behavior: "smooth" });
        }, 380);
      }
    });
  });
  // Step 4's button opens the order-review modal
  document.querySelectorAll('[data-checkout]').forEach(btn => {
    btn.addEventListener("click", () => { markDone(4, true); openSummary(); });
  });
  const sc = $("sbSummaryClose");
  if (sc) sc.addEventListener("click", closeSummary);
  const ov = $("sbOverlay");
  if (ov) ov.addEventListener("click", closeSummary);
  document.addEventListener("keydown", e => { if (e.key === "Escape") closeSummary(); });
}

function openSummary(){
  buildOrderSummary();
  $("sbSummary").classList.add("open");
  const ov = $("sbOverlay"); if (ov) ov.classList.add("open");
}
function closeSummary(){
  $("sbSummary").classList.remove("open");
  const ov = $("sbOverlay"); if (ov) ov.classList.remove("open");
}

function tbcoInit(){
  const pib = $("puffInfoBtn"), pi = $("puffInfo");
  if (pib && pi) pib.addEventListener("click", () => {
    const open = pi.hasAttribute("hidden");
    if (open){ pi.removeAttribute("hidden"); pib.setAttribute("aria-expanded","true"); pib.textContent = "Hide"; }
    else { pi.setAttribute("hidden",""); pib.setAttribute("aria-expanded","false"); pib.textContent = "What is 3D puff?"; }
  });
  initAccordion();
  $("submitBtn").addEventListener("click", openSummary);
  render();
  cleanupReviews();
}

// The empty bordered box is an empty <section> Judge.me leaves inside the
// carousel wrapper. CSS :empty misses it (it contains whitespace), so hide it here.
function cleanupReviews(){
  const kill = () => {
    document.querySelectorAll("#tbco .jdgm-carousel-wrapper section").forEach(sec => {
      if (sec.textContent.trim() === "" && !sec.querySelector("img")) sec.style.display = "none";
    });
  };
  [300, 900, 2000].forEach(t => setTimeout(kill, t));
}
if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", tbcoInit);
else tbcoInit();
</script>
