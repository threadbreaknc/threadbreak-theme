<div class="quote-page">

  <!-- HERO -->
  <section class="quote-hero-photo">
    <!-- Scrolling photo strip -->
    <div class="qhp-strip-wrap">
      <div class="qhp-strip" id="qhp-strip">
        {%- assign photos = "https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_5393.jpg?v=1783192304,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_4219.jpg?v=1783192609,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_2222.jpg?v=1783192609,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_2635.jpg?v=1783192608,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_4060.jpg?v=1783192607,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_3791.jpg?v=1783192608,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_4183.jpg?v=1783192608,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_4311.jpg?v=1783192304,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/30E97845-C9BA-48A3-BD1E-6538E9193FE6_2.jpg?v=1783192304,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_5393.jpg?v=1783192304,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_4219.jpg?v=1783192609,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_2222.jpg?v=1783192609,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_2635.jpg?v=1783192608,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_4060.jpg?v=1783192607,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_3791.jpg?v=1783192608,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_4183.jpg?v=1783192608,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/IMG_4311.jpg?v=1783192304,https://cdn.shopify.com/s/files/1/0974/8453/7988/files/30E97845-C9BA-48A3-BD1E-6538E9193FE6_2.jpg?v=1783192304" | split: "," -%}
        {%- for photo in photos -%}
          <div class="qhp-photo" style="background-image:url('{{ photo }}');"></div>
        {%- endfor -%}
      </div>
    </div>
    <!-- Fade overlay -->
    <div class="qhp-fade"></div>
    <!-- Text content -->
    <div class="qhp-content">
      <p class="qhp-eyebrow">Custom & Wholesale Embroidery</p>
      <h1 class="qhp-h1">Get a Quote.</h1>
      <p class="qhp-sub">Tell us what you need. We'll get back to you within 24 hours.</p>
      <div class="qhp-pills">
        <span class="qhp-pill">✦ Min. 10 hats</span>
        <span class="qhp-pill">✦ 24hr response</span>
        <span class="qhp-pill">✦ Free shipping</span>
      </div>
    </div>
  </section>

  <!-- LOCATION + PROCESS -->
  <section class="quote-info-strip">
    <div class="qis-inner">

      <div class="qis-block">
        <h3 class="qis-title">Where We Are</h3>
        <div class="qis-location-items">
          <div class="qis-loc-item">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
            <span>Burlington, NC</span>
          </div>
          <div class="qis-loc-item">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            <span>Local pickup by appointment</span>
          </div>
          <div class="qis-loc-item">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span>Free shipping anywhere in the US</span>
          </div>
        </div>
      </div>

      <div class="qis-divider"></div>

      <div class="qis-block qis-process">
        <h3 class="qis-title">How It Works</h3>
        <div class="qis-steps">
          <div class="qis-step"><span class="qis-num">01</span><span>You submit a quote request</span></div>
          <div class="qis-step"><span class="qis-num">02</span><span>We create a mockup and send for approval</span></div>
          <div class="qis-step"><span class="qis-num">03</span><span>Design gets digitized for embroidery</span></div>
          <div class="qis-step"><span class="qis-num">04</span><span>We stitch a test sample and send you a photo</span></div>
          <div class="qis-step"><span class="qis-num">05</span><span>You approve — we run the full order</span></div>
          <div class="qis-step"><span class="qis-num">06</span><span>Ships free to your door, or schedule local pickup in Burlington, NC</span></div>
        </div>
      </div>

    </div>
  </section>

  <!-- QUOTE FORM -->
  <section class="quote-form-section">
    <div class="quote-form-header">
      <p class="eyebrow reveal">Ready to Order?</p>
      <h2 class="reveal reveal-d1">Request a Quote.</h2>
    </div>

    <div class="qform" id="quote-form-wrap">

      <!-- SUCCESS STATE -->
      <div class="quote-success" id="quote-success" style="display:none;text-align:center;padding:4rem 2rem;">
        <div class="quote-success-stars" aria-hidden="true">
          <span class="qstar" style="--tx:-70px;--ty:-50px;">✦</span>
          <span class="qstar" style="--tx:70px;--ty:-60px;">✦</span>
          <span class="qstar" style="--tx:-40px;--ty:-80px;">✦</span>
          <span class="qstar" style="--tx:50px;--ty:-40px;">✦</span>
          <span class="qstar" style="--tx:-90px;--ty:-25px;">✦</span>
          <span class="qstar" style="--tx:90px;--ty:-35px;">✦</span>
        </div>
        <div class="quote-success-icon">✦</div>
        <h3>Request Received.</h3>
        <div class="quote-success-divider"></div>
        <p>We'll get back to you within 24 hours.</p>
        <p class="quote-success-sub">Check your inbox, we'll be in touch soon.</p>
      </div>

      <!-- FORM -->
      <form id="quote-form" enctype="multipart/form-data">

        <div class="qform-section">
          <h4 class="qform-section-title">Contact Info</h4>
          <div class="qform-row">
            <div class="qform-field">
              <label for="q-name">Name <span class="req">*</span></label>
              <input type="text" id="q-name" name="name" required placeholder="Your name">
            </div>
            <div class="qform-field">
              <label for="q-email">Email <span class="req">*</span></label>
              <input type="email" id="q-email" name="email" required placeholder="you@email.com">
            </div>
          </div>
          <div class="qform-row">
            <div class="qform-field">
              <label for="q-phone">Phone <span style="font-weight:400;opacity:0.4;font-size:0.85em;">(optional)</span></label>
              <input type="tel" id="q-phone" name="phone" placeholder="Optional">
            </div>
            <div class="qform-field">
              <label for="q-company">Company / Brand <span style="font-weight:400;opacity:0.4;font-size:0.85em;">(optional)</span></label>
              <input type="text" id="q-company" name="company" placeholder="Optional">
            </div>
          </div>
        </div>

        <div class="qform-section">
          <h4 class="qform-section-title">Order Details</h4>

          <div class="qform-field">
            <label for="q-qty">How Many Hats? <span class="req">*</span></label>
            <input type="number" id="q-qty" name="quantity" required min="10" placeholder="e.g. 24" style="max-width:200px;background:#ffffff;color:#1a1520;border:1px solid rgba(26,21,32,0.15);">
            <p class="qform-hint" style="margin-top:0.4rem;color:rgba(26,21,32,0.5);font-size:0.78rem;">Minimum order is <strong style="color:var(--purple);">10 hats</strong>. The more you order, the better the price.</p>
          </div>

          <div class="qform-field">
            <label for="q-hat-pref">Hat Preference</label>
            <input type="text" id="q-hat-pref" name="hatPreference" placeholder="e.g. Otto snapback in black, Richardson 112 in navy, Yupoong trucker — or not sure">
            <p style="font-size:0.72rem;color:rgba(26,21,32,0.4);margin-top:0.4rem;">Include brand, style, and color if you have a preference.</p>
          </div>

          <div class="qform-field">
            <label style="display:flex;align-items:center;gap:0.5rem;">
              Stitch Type
              <button type="button" class="stitch-info-btn" id="stitch-info-btn" aria-label="What is this?">?</button>
            </label>
            <div class="stitch-tooltip" id="stitch-tooltip" style="display:none;">
              <button type="button" class="stitch-tooltip-close" id="stitch-tooltip-close">✕</button>
              <div class="stitch-tooltip-item">
                <strong>Flat Embroidery</strong>
                <p>The standard. Clean, sharp stitching that sits flat on the fabric. Works with any design, including fine detail and small text. No extra charge.</p>
              </div>
              <div class="stitch-tooltip-divider"></div>
              <div class="stitch-tooltip-item">
                <strong>3D Puff</strong>
                <p>A foam layer under the stitching raises the design off the fabric for a bold, dimensional look. Best for block letters and simple shapes. Fine details and small text don't transfer well. <em style="color:var(--purple);">Additional charge applies.</em></p>
              </div>
            </div>
            <div class="qform-options">
              <label class="qopt"><input type="radio" name="stitchType" value="Flat Embroidery"><span>Flat Embroidery</span></label>
              <label class="qopt"><input type="radio" name="stitchType" value="3D Puff"><span>3D Puff <em style="font-size:0.7em;opacity:0.7">(+ charge)</em></span></label>
              <label class="qopt"><input type="radio" name="stitchType" value="Not sure"><span>Not sure</span></label>
            </div>
          </div>

          <div class="qform-field">
            <label>Embroidery Placement <span style="font-weight:400;opacity:0.4;font-size:0.85em;">— additional charge per location</span></label>
            <div class="qform-options">
              <label class="qopt"><input type="checkbox" name="placement" value="Front Center"><span>Front Center</span></label>
              <label class="qopt"><input type="checkbox" name="placement" value="Front Left"><span>Front Left</span></label>
              <label class="qopt"><input type="checkbox" name="placement" value="Front Right"><span>Front Right</span></label>
              <label class="qopt"><input type="checkbox" name="placement" value="Left Side"><span>Left Side</span></label>
              <label class="qopt"><input type="checkbox" name="placement" value="Right Side"><span>Right Side</span></label>
              <label class="qopt"><input type="checkbox" name="placement" value="Not sure"><span>Not sure</span></label>
            </div>
          </div>

          <div class="qform-field">
            <label for="q-deadline">When Do You Need It By? <span style="font-weight:400;opacity:0.4;font-size:0.85em;">(optional)</span></label>
            <input type="date" id="q-deadline" name="deadline" style="max-width:220px;">
            <p style="font-size:0.72rem;color:rgba(26,21,32,0.4);margin-top:0.4rem;">Custom orders typically take 2-3 weeks.</p>
          </div>

          <div class="qform-field">
            <label for="q-notes">Anything Else? <span style="font-weight:400;opacity:0.4;font-size:0.85em;">(optional)</span></label>
            <textarea id="q-notes" name="notes" rows="4" placeholder="Budget range, specific design ideas, questions..."></textarea>
          </div>

          <div class="qform-field">
            <label for="q-file">Upload Your Logo / Design File <span style="font-weight:400;opacity:0.4;font-size:0.85em;">(optional)</span></label>
            <p style="font-size:0.75rem;color:rgba(26,21,32,0.45);margin-bottom:0.6rem;">PNG, JPG, PDF, AI, SVG, EPS accepted. Max 10MB.</p>
            <input type="file" id="q-file" name="logo" accept=".png,.jpg,.jpeg,.pdf,.ai,.svg,.eps" class="qform-file-input">
          </div>

        </div>

        <div class="qform-submit-row">
          <button type="submit" class="btn btn-fill quote-submit" id="quote-submit-btn">
            <span id="quote-btn-text">Send Quote Request →</span>
            <span id="quote-btn-loading" style="display:none;">Sending...</span>
          </button>
          <p class="quote-privacy">We respond within 24 hours. No spam, ever.</p>
        </div>

        <p id="quote-error" style="display:none;color:#c0392b;font-size:0.82rem;margin-top:1rem;"></p>

      </form>
    </div>
  </section>

</div>

<script>
document.getElementById('quote-form').addEventListener('submit', async function(e) {
  e.preventDefault();

  const btn = document.getElementById('quote-submit-btn');
  const btnText = document.getElementById('quote-btn-text');
  const btnLoading = document.getElementById('quote-btn-loading');
  const errorEl = document.getElementById('quote-error');

  btn.disabled = true;
  btnText.style.display = 'none';
  btnLoading.style.display = 'inline';
  errorEl.style.display = 'none';

  try {
    const form = e.target;
    const fileInput = document.getElementById('q-file');
    const file = fileInput.files[0];

    // Build payload
    const payload = {
      name: form.name.value,
      email: form.email.value,
      company: form.company.value,
      phone: form.phone.value,
      quantity: form.quantity.value,
      hatPreference: form.hatPreference ? form.hatPreference.value : '',
      stitchType: form.stitchType ? (form.stitchType.value || '') : '',
      placement: [...document.querySelectorAll('input[name="placement"]:checked')].map(cb => cb.value).join(', ') || 'Not specified',
      deadline: form.deadline ? form.deadline.value : '',
      notes: form.notes.value,
      fileName: '',
      fileType: '',
      file: ''
    };

    // Encode file as base64 if provided
    if (file) {
      payload.fileName = file.name;
      payload.fileType = file.type;
      const base64 = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result.split(',')[1]);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
      payload.file = base64;
    }

    // Use no-cors mode — we can't read the response but the data WILL be received
    await fetch('https://script.google.com/macros/s/AKfycbxYr32UWH88iaImaMmd-GbPV9X-J2TDES2soBNUVCZWGj_xUinIMesdywh3Y4I0VgjM/exec', {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain' },
      body: JSON.stringify(payload)
    });

    // Since no-cors means we can't read the response, we show success optimistically
    document.getElementById('quote-form').style.display = 'none';
    document.getElementById('quote-success').style.display = 'block';
    document.querySelectorAll('.qstar').forEach((star, i) => {
      star.style.animationDelay = (i * 0.1) + 's';
    });

  } catch (err) {
    // Network error
    errorEl.textContent = 'Connection error. Please email us directly at help@threadbreak.com';
    errorEl.style.display = 'block';
    btn.disabled = false;
    btnText.style.display = 'inline';
    btnLoading.style.display = 'none';
  }
});

// Stitch type tooltip
const infoBtn = document.getElementById('stitch-info-btn');
const tooltip = document.getElementById('stitch-tooltip');
const closeBtn = document.getElementById('stitch-tooltip-close');
if (infoBtn) {
  infoBtn.addEventListener('click', () => {
    tooltip.style.display = tooltip.style.display === 'none' ? 'block' : 'none';
  });
}
if (closeBtn) {
  closeBtn.addEventListener('click', () => {
    tooltip.style.display = 'none';
  });
}
</script>

<style>
.stitch-info-btn {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1px solid var(--purple);
  background: transparent;
  color: var(--purple);
  font-size: 0.65rem;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
  flex-shrink: 0;
}
.stitch-info-btn:hover { background: var(--purple); color: #fff; }
.stitch-tooltip {
  background: #fff;
  border: 1px solid rgba(112,80,200,0.2);
  border-left: 3px solid var(--purple);
  padding: 1.25rem 1.25rem 1.25rem 1.5rem;
  margin-bottom: 1rem;
  position: relative;
  max-width: 520px;
}
.stitch-tooltip-close {
  position: absolute;
  top: 0.6rem;
  right: 0.75rem;
  background: none;
  border: none;
  font-size: 0.7rem;
  color: rgba(26,21,32,0.3);
  cursor: pointer;
  padding: 0;
}
.stitch-tooltip-close:hover { color: var(--black); }
.stitch-tooltip-item strong {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--black);
  display: block;
  margin-bottom: 0.4rem;
}
.stitch-tooltip-item p {
  font-size: 0.8rem;
  line-height: 1.65;
  color: rgba(26,21,32,0.6);
  margin: 0;
}
.stitch-tooltip-divider {
  height: 1px;
  background: rgba(26,21,32,0.08);
  margin: 1rem 0;
}
</style>
