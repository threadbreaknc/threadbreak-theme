<div class="quote-page">

  <!-- HERO -->
  <section class="quote-hero">
    <div class="quote-hero-bg"></div>
    <div class="quote-hero-content">
      <p class="eyebrow reveal">Custom & Wholesale</p>
      <h1 class="reveal reveal-d1">Get a Quote.</h1>
      <p class="quote-hero-sub reveal reveal-d2">Tell us what you need. We'll get back to you within 24 hours with pricing, timelines, and next steps.</p>
      <div class="quote-stats reveal reveal-d3" style="display:flex;gap:2.5rem;margin-top:2rem;align-items:flex-start;">
        <div class="qstat" style="display:flex;flex-direction:column;gap:0.15rem;">
          <strong style="font-family:var(--font-display);font-size:2rem;color:var(--black);line-height:1;">10+</strong>
          <span style="font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:rgba(26,21,32,0.4);">Hat Minimum</span>
        </div>
        <div style="width:1px;height:35px;background:rgba(26,21,32,0.1);margin-top:4px;"></div>
        <div class="qstat" style="display:flex;flex-direction:column;gap:0.15rem;">
          <strong style="font-family:var(--font-display);font-size:2rem;color:var(--black);line-height:1;">24hr</strong>
          <span style="font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:rgba(26,21,32,0.4);">Response Time</span>
        </div>
        <div style="width:1px;height:35px;background:rgba(26,21,32,0.1);margin-top:4px;"></div>
        <div class="qstat" style="display:flex;flex-direction:column;gap:0.15rem;">
          <strong style="font-family:var(--font-display);font-size:2rem;color:var(--black);line-height:1;">Free</strong>
          <span style="font-size:0.65rem;letter-spacing:0.2em;text-transform:uppercase;color:rgba(26,21,32,0.4);">Shipping</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STITCH EXPLAINER -->
  <section class="stitch-section" style="padding:5rem 6rem;background:#ffffff;">
    <h3 class="stitch-title reveal" style="font-family:var(--font-display);font-size:1.8rem;letter-spacing:0.05em;color:var(--black);margin-bottom:2.5rem;">Choose Your Stitch Type</h3>
    <div class="stitch-cards" style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(26,21,32,0.08);">

      <div class="stitch-card reveal" style="background:#fff;overflow:hidden;">
        <div class="stitch-visual" style="background:#f4f1fc;padding:4rem 3rem;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;">
          <span style="font-family:var(--font-display);font-size:3.5rem;letter-spacing:0.08em;color:var(--black);display:block;">FLAT STITCH</span>
          <span style="font-size:0.62rem;letter-spacing:0.35em;text-transform:uppercase;color:rgba(26,21,32,0.35);display:block;">Clean · Sharp · Any Design</span>
        </div>
        <div class="stitch-info" style="padding:2rem 2.5rem;">
          <h4 style="font-family:var(--font-display);font-size:1.4rem;letter-spacing:0.04em;color:var(--black);margin-bottom:0.75rem;">Flat Embroidery</h4>
          <p>The classic. Clean, sharp, and works on virtually any design. Best for detailed logos, text-heavy designs, and small elements.</p>
          <ul class="stitch-pros">
            <li>✦ Works with any design complexity</li>
            <li>✦ Sharp, clean edges</li>
            <li>✦ Best for fine detail</li>
          </ul>
        </div>
      </div>

      <div class="stitch-card reveal reveal-d1" style="background:#fff;overflow:hidden;">
        <div class="stitch-visual stitch-visual-dark" style="background:#0f1a2e;padding:4rem 3rem;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;">
          <style>
            @keyframes puffPulse {
              0%, 100% { text-shadow: 0 4px 16px rgba(112,80,200,0.5), 0 0 40px rgba(112,80,200,0.2); transform: translateY(0); }
              50% { text-shadow: 0 8px 32px rgba(112,80,200,0.9), 0 0 80px rgba(112,80,200,0.5), 0 0 120px rgba(112,80,200,0.2); transform: translateY(-4px); }
            }
          </style>
          <span style="font-family:var(--font-display);font-size:3.5rem;letter-spacing:0.08em;color:#9b6ee8;display:block;animation:puffPulse 2.5s ease-in-out infinite;">3D PUFF</span>
          <span style="font-size:0.62rem;letter-spacing:0.35em;text-transform:uppercase;color:rgba(255,255,255,0.3);display:block;">Raised · Bold · Dimensional</span>
        </div>
        <div class="stitch-info" style="padding:2rem 2.5rem;background:#ddd8eb;">
          <h4 style="font-family:var(--font-display);font-size:1.4rem;letter-spacing:0.04em;color:var(--black);margin-bottom:0.75rem;">3D Puff Embroidery</h4>
          <p>A foam layer is placed under the stitching, causing the design to raise up from the fabric. Bold, dimensional, and eye-catching, the streetwear look.</p>
          <ul class="stitch-pros">
            <li>✦ Bold raised 3D effect</li>
            <li>✦ Best for block letters & simple shapes</li>
            <li>✦ Premium, high-end appearance</li>
            <li>✦ <em>Additional charge applies</em></li>
          </ul>
          <div class="puff-warning">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2L1 21h22L12 2zm0 3.5L20.5 19h-17L12 5.5zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z"/></svg>
            Not all designs work with 3D puff, fine details and small text don't transfer well. We'll let you know if your design isn't a good fit.
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- QUOTE FORM -->
  <section class="quote-form-section">
    <div class="quote-form-header">
      <p class="eyebrow reveal">Ready to Order?</p>
      <h2 class="reveal reveal-d1">Request a Quote.</h2>
    </div>

    <div class="qform" id="quote-form-wrap">

      <!-- SUCCESS STATE -->
      <div class="quote-success" id="quote-success" style="display:none;text-align:center;padding:4rem 2rem;">
        <div class="quote-success-stars" aria-hidden="true">
          <span class="qstar" style="--tx:-70px;--ty:-50px;">✦</span>
          <span class="qstar" style="--tx:70px;--ty:-60px;">✦</span>
          <span class="qstar" style="--tx:-40px;--ty:-80px;">✦</span>
          <span class="qstar" style="--tx:50px;--ty:-40px;">✦</span>
          <span class="qstar" style="--tx:-90px;--ty:-25px;">✦</span>
          <span class="qstar" style="--tx:90px;--ty:-35px;">✦</span>
        </div>
        <div class="quote-success-icon">✦</div>
        <h3>Request Received.</h3>
        <div class="quote-success-divider"></div>
        <p>We'll get back to you within 24 hours.</p>
        <p class="quote-success-sub">Check your inbox, we'll be in touch soon.</p>
      </div>

      <!-- FORM -->
      <form id="quote-form" enctype="multipart/form-data">

        <div class="qform-section">
          <h4 class="qform-section-title">01, Contact Info</h4>
          <div class="qform-row">
            <div class="qform-field">
              <label for="q-name">Name <span class="req">*</span></label>
              <input type="text" id="q-name" name="name" required placeholder="Your name">
            </div>
            <div class="qform-field">
              <label for="q-email">Email <span class="req">*</span></label>
              <input type="email" id="q-email" name="email" required placeholder="you@email.com">
            </div>
          </div>
          <div class="qform-row">
            <div class="qform-field">
              <label for="q-company">Company / Brand</label>
              <input type="text" id="q-company" name="company" placeholder="Optional">
            </div>
            <div class="qform-field">
              <label for="q-phone">Phone</label>
              <input type="tel" id="q-phone" name="phone" placeholder="Optional">
            </div>
          </div>
        </div>

        <div class="qform-section">
          <h4 class="qform-section-title">02, Order Details</h4>

          <div class="qform-field">
            <label for="q-qty">How Many Hats? <span class="req">*</span></label>
            <input type="number" id="q-qty" name="quantity" required min="10" placeholder="e.g. 24" style="max-width:200px;background:#ffffff;color:#1a1520;border:1px solid rgba(26,21,32,0.15);">
            <p class="qform-hint" style="margin-top:0.4rem;color:rgba(26,21,32,0.5);font-size:0.78rem;">Minimum order is <strong style="color:var(--purple);">10 hats</strong>. The more you order, the better the price.</p>
          </div>

          <div class="qform-field">
            <label>Hat Style Preference</label>
            <div class="qform-options">
              <label class="qopt"><input type="radio" name="hatStyle" value="Snapback"><span>Snapback</span></label>
              <label class="qopt"><input type="radio" name="hatStyle" value="Fitted"><span>Fitted</span></label>
              <label class="qopt"><input type="radio" name="hatStyle" value="Dad Hat"><span>Dad Hat</span></label>
              <label class="qopt"><input type="radio" name="hatStyle" value="Trucker"><span>Trucker</span></label>
              <label class="qopt"><input type="radio" name="hatStyle" value="Beanie"><span>Beanie</span></label>
              <label class="qopt"><input type="radio" name="hatStyle" value="Not sure"><span>Not sure</span></label>
            </div>
          </div>

          <div class="qform-field">
            <label>Stitch Type</label>
            <div class="qform-options">
              <label class="qopt"><input type="radio" name="stitchType" value="Flat Embroidery"><span>Flat Embroidery</span></label>
              <label class="qopt"><input type="radio" name="stitchType" value="3D Puff"><span>3D Puff <em style="font-size:0.7em;opacity:0.7">(additional charge)</em></span></label>
              <label class="qopt"><input type="radio" name="stitchType" value="Not sure"><span>Not sure</span></label>
            </div>
          </div>

          <div class="qform-field">
            <label for="q-hat-color">Preferred Hat Color(s)</label>
            <input type="text" id="q-hat-color" name="hatColor" placeholder="e.g. Black, White, Natural, Navy, etc.">
          </div>

          <div class="qform-field">
            <label for="q-colors">Thread / Embroidery Colors</label>
            <input type="text" id="q-colors" name="colors" placeholder="e.g. Red, White, Black, or match my logo colors">
          </div>

          <div class="qform-field">
            <label for="q-notes">Additional Notes <span class="req">*</span></label>
            <textarea id="q-notes" name="notes" rows="5" required placeholder="Deadline, specific brands, budget range, anything else we should know..."></textarea>
          </div>

          <div class="qform-field">
            <label for="q-file">Upload Your Logo / Design File</label>
            <p style="font-size:0.75rem;color:rgba(26,21,32,0.45);margin-bottom:0.6rem;">PNG, JPG, PDF, AI, SVG, EPS accepted. Max 10MB.</p>
            <input type="file" id="q-file" name="logo" accept=".png,.jpg,.jpeg,.pdf,.ai,.svg,.eps" class="qform-file-input">
          </div>

        </div>

        <div class="qform-submit-row">
          <button type="submit" class="btn btn-fill quote-submit" id="quote-submit-btn">
            <span id="quote-btn-text">Send Quote Request →</span>
            <span id="quote-btn-loading" style="display:none;">Sending...</span>
          </button>
          <p class="quote-privacy">We respond within 24 hours. No spam, ever.</p>
        </div>

        <p id="quote-error" style="display:none;color:#c0392b;font-size:0.82rem;margin-top:1rem;"></p>

      </form>
    </div>
  </section>

</div>

<script>
document.getElementById('quote-form').addEventListener('submit', async function(e) {
  e.preventDefault();

  const btn = document.getElementById('quote-submit-btn');
  const btnText = document.getElementById('quote-btn-text');
  const btnLoading = document.getElementById('quote-btn-loading');
  const errorEl = document.getElementById('quote-error');

  btn.disabled = true;
  btnText.style.display = 'none';
  btnLoading.style.display = 'inline';
  errorEl.style.display = 'none';

  try {
    const form = e.target;
    const fileInput = document.getElementById('q-file');
    const file = fileInput.files[0];

    // Build payload
    const payload = {
      name: form.name.value,
      email: form.email.value,
      company: form.company.value,
      phone: form.phone.value,
      quantity: form.quantity.value,
      hatStyle: form.hatStyle ? (form.hatStyle.value || '') : '',
      stitchType: form.stitchType ? (form.stitchType.value || '') : '',
      hatColor: form.hatColor.value,
      colors: form.colors.value,
      notes: form.notes.value,
      fileName: '',
      fileType: '',
      file: ''
    };

    // Encode file as base64 if provided
    if (file) {
      payload.fileName = file.name;
      payload.fileType = file.type;
      const base64 = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result.split(',')[1]);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
      payload.file = base64;
    }

    // Use no-cors mode — we can't read the response but the data WILL be received
    await fetch('https://script.google.com/macros/s/AKfycbxYr32UWH88iaImaMmd-GbPV9X-J2TDES2soBNUVCZWGj_xUinIMesdywh3Y4I0VgjM/exec', {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain' },
      body: JSON.stringify(payload)
    });

    // Since no-cors means we can't read the response, we show success optimistically
    document.getElementById('quote-form').style.display = 'none';
    document.getElementById('quote-success').style.display = 'block';
    document.querySelectorAll('.qstar').forEach((star, i) => {
      star.style.animationDelay = (i * 0.1) + 's';
    });

  } catch (err) {
    // Network error
    errorEl.textContent = 'Connection error. Please email us directly at help@threadbreak.com';
    errorEl.style.display = 'block';
    btn.disabled = false;
    btnText.style.display = 'inline';
    btnLoading.style.display = 'none';
  }
});
</script>
