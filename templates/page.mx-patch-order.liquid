      state.size = SIZES.find(x => x.id === b.dataset.size);
      state.sizeChosen = true;
      renderSizes(); sync();
    });
  });
  renderSizeHint();
  const notReady = $("sizesNotReady");
  if (notReady){
    notReady.innerHTML = sizesReady() ? "" :
      '<div class="sizes-not-ready">Patch size variants are still being set up in Shopify - checkout is temporarily disabled on this page. (Dev note: set the real variant IDs in the SIZES array.)</div>';
  }
}
function renderPatchDesign(){
  renderOutlines(); renderFonts(); renderNumberStyles(); renderColors(); renderPlacements(); renderSizes();
  renderPatchPreview();
}

/* ---------- review ---------- */
function renderReview(){
  const each = perHat();
  const rows = [
    ["Hat", state.style ? nameOf(state.style) + " (" + state.style.brand + ")" : "-"],
    ["Colors", colorSummary()],
    ["Sizing", state.style ? sizingOf(state.style) : "-"],
    ["Quantity", state.qty || "-"],
    ["Confirmation sent by", ($("proofMethod") && $("proofMethod").value)
      ? ($("proofMethod").value === "Text message" && $("proofPhone") && $("proofPhone").value.trim()
          ? "Text to " + $("proofPhone").value.trim() : $("proofMethod").value)
      : "-"],
    ["Leather color", state.color.name],
    ["Outline", state.outline.label],
    ["Rider name", state.showName ? (state.riderName || "-") : "Not included"],
    ["Number", state.riderNumber || "-"],
    ["Number font", state.font],
    ["Number style", state.numberStyle === "outline" ? "Outline" : "Solid"],
    ["Placement", state.placement.label],
    ["Patch size", state.sizeChosen ? (state.size.label + " (" + sizeDimLabel(state.size) + ")") : "-"],
    ["Price per hat", each ? money(each) : "-"],
    ["Order total", each && state.qty ? money(each * state.qty) : "-"]
  ];
  $("review").innerHTML = rows.map(r =>
    '<div class="rev-line"><span>' + r[0] + '</span><strong>' + r[1] + '</strong></div>').join("");
}

/* ---------- SVG production file: cut layer + engrave layer ----------
   Layer "cut" is the outline path (single source of truth: pathCommands),
   stroked hairline-red - the common laser-software convention for "this is
   the line to cut, not fill". Layer "engrave" is the rider name/number
   converted to real vector glyph outlines via opentype.js (not <text>), so
   the file is exact regardless of which fonts are installed on the machine
   that opens it. Falls back to a <text> element (with a visible XML comment
   explaining why) if a font file can't be fetched/parsed. */
const fontCache = {};
async function loadOpentypeFont(url){
  if (fontCache[url]) return fontCache[url];
  const buf = await fetch(url).then(r => {
    if (!r.ok) throw new Error("font fetch failed: " + url);
    return r.arrayBuffer();
  });
  const font = window.opentype.parse(buf);
  fontCache[url] = font;
  return font;
}
function svgTextGroup(font, text, cx, cy, fontSizePx, mode, skewDeg){
  // opentype's baseline is at y=0 growing down for getPath, so we lay the
  // text out at (0,0) then measure + recenter with a translate, same idea
  // as canvas's textAlign:center/textBaseline:middle.
  const path = font.getPath(text, 0, 0, fontSizePx);
  const box = path.getBoundingBox();
  const w = box.x2 - box.x1, h = box.y2 - box.y1;
  const dx = cx - (box.x1 + w / 2);
  const dy = cy - (box.y1 + h / 2);
  const d = path.toPathData(2);
  const fill = mode === "outline" ? "none" : "#000";
  const stroke = mode === "outline" ? "#000" : "none";
  const strokeWidth = mode === "outline" ? Math.max(1, fontSizePx * 0.06) : 0;
  const skew = skewDeg ? " skewX(" + (-skewDeg) + ")" : "";
  return '<g transform="translate(' + dx.toFixed(2) + ' ' + dy.toFixed(2) + ')' + skew + '">' +
    '<path d="' + d + '" fill="' + fill + '"' + (stroke !== "none" ? ' stroke="' + stroke + '" stroke-width="' + strokeWidth.toFixed(2) + '"' : '') + '/></g>';
}
async function buildProductionSVG(){
  const DPI = 300;
  const inches = state.size.wide;
  const PX = Math.round(inches * DPI);
  const pad = PX * 0.03;
  const size = PX - pad * 2;
  const cmds = pathCommands(state.outline.id, size, pad);
  const cutD = pathToSVGD(cmds, 2);

  const sa = safeArea(state.outline.id);
  const baseCx = pad + size * 0.5;
  const safeLeft = pad + size * sa.left, safeRight = pad + size * sa.right;
  const safeW = safeRight - safeLeft;

  let engraveInner = "";
  let fontWarning = "";
  try {
    if (state.showName && state.riderName.trim()){
      const nameFont = await loadOpentypeFont(NAME_FONT_TTF);
      const numFont = await loadOpentypeFont(FONTS.find(f => f.id === state.font).ttf);

      const nameTop = pad + size * sa.top;
      const dividerY = pad + size * sa.dividerY;
      const nameCenterY = (nameTop + dividerY) / 2 + state.nameOffset.y * PX;
      const nameCx = baseCx + state.nameOffset.x * PX;
      const nameSize = PX * 0.085 * state.nameScale;
      engraveInner += svgTextGroup(nameFont, state.riderName, nameCx, nameCenterY, nameSize, "solid", NAME_ITALIC_SKEW_DEG);

      const numTop = dividerY + PX * 0.02;
      const numBottom = pad + size * sa.bottom;
      const numCenterY = (numTop + numBottom) / 2 + state.numberOffset.y * PX;
      const numCx = baseCx + state.numberOffset.x * PX;
      const numSize = (numBottom - numTop) * 1.05 * state.numberScale;
      engraveInner += svgTextGroup(numFont, state.riderNumber || "0", numCx, numCenterY, numSize, state.numberStyle, 0);
    } else {
      const numFont = await loadOpentypeFont(FONTS.find(f => f.id === state.font).ttf);
      const top = pad + size * sa.top, bottom = pad + size * sa.bottom;
      const numCenterY = (top + bottom) / 2 + state.numberOffset.y * PX;
      const numCx = baseCx + state.numberOffset.x * PX;
      const numSize = (bottom - top) * 1.05 * state.numberScale;
      engraveInner += svgTextGroup(numFont, state.riderNumber || "0", numCx, numCenterY, numSize, state.numberStyle, 0);
    }
  } catch (e) {
    fontWarning = "<!-- WARNING: could not load a vector font (" + (e && e.message) + "). Falling back to a plain <text> element below - this is NOT a true vector outline and should be re-exported once the font CDN is reachable. -->";
    engraveInner = '<text x="' + baseCx + '" y="' + (pad + size/2) + '" font-family="' + state.font + '" font-size="' + (size*0.3) + '" text-anchor="middle" fill="#000">' + (state.riderNumber || "") + '</text>';
  }

  const svg =
    '<?xml version="1.0" encoding="UTF-8"?>\n' +
    fontWarning + '\n' +
    '<svg xmlns="http://www.w3.org/2000/svg" width="' + inches + 'in" height="' + inches + 'in" viewBox="0 0 ' + PX + ' ' + PX + '">\n' +
    '  <!-- Threadbreak MX patch production file: hat=' + (state.style ? state.style.id : "") + ' color=' + state.color.id + ' outline=' + state.outline.id + ' size=' + state.size.id + ' -->\n' +
    '  <g id="cut" data-layer="cut-line">\n' +
    '    <path d="' + cutD + '" fill="none" stroke="#FF0000" stroke-width="1"/>\n' +
    '  </g>\n' +
    '  <g id="engrave" data-layer="engrave-content">\n' +
    '    ' + engraveInner + '\n' +
    '  </g>\n' +
    '</svg>\n';
  return svg;
}
function svgFileName(){
  const parts = ["mx-patch", state.outline.id, (state.riderName || "num"), state.riderNumber || "", state.size.id];
  return parts.filter(Boolean).join("-").toLowerCase().replace(/\s+/g, "-") + ".svg";
}
async function downloadProductionSVG(){
  const btn = $("downloadSvg");
  const original = btn.textContent;
  btn.disabled = true; btn.textContent = "Building file...";
  try {
    const svg = await buildProductionSVG();
    const blob = new Blob([svg], { type: "image/svg+xml" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = svgFileName();
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 2000);
  } catch (e) {
    alert("Couldn't build the patch file. Please try again, or email help@threadbreak.com.");
    console.error("[tbmxpo] svg export failed", e);
  } finally {
    btn.disabled = false; btn.textContent = original;
  }
}

/* ---------- step machinery (identical pattern to the logo patch page) ---------- */
function canLeave(step){
  if (step === 1) return !!state.style && state.colors.length > 0;
  if (step === 2){
    if (!state.qty || state.qty < 5) return false;
    if (state.colors.length > 1){
      const t = Object.values(state.split).reduce((a,b) => a + (+b || 0), 0);
      return t === state.qty;
    }
    return true;
  }
  if (step === 3){
    if (!state.sizeChosen) return false;
    if (!state.riderNumber.trim()) return false;
    const m = $("proofMethod") ? $("proofMethod").value : "";
    if (!m) return false;
    if (m === "Text message"){
      const p = $("proofPhone") ? $("proofPhone").value.replace(/\D/g, "") : "";
      if (p.length < 10) return false;
    }
    return true;
  }
  return true;
}
function goto(step){
  state.step = step;
  if (step > state.maxStep) state.maxStep = step;
  if (step === 1) renderHats();
  if (step === 2) renderSplit();
  if (step === 3) renderPatchDesign();
  document.querySelectorAll("#tbmxpo .tbstep").forEach(sec => {
    sec.classList.toggle("active", +sec.dataset.step === step);
  });
  if (step === 4) renderReview();
  renderRail();
  requestAnimationFrame(() => {
    const sec = document.querySelector('#tbmxpo .tbstep.active');
    if (!sec) return;
    const top = sec.getBoundingClientRect().top;
    const visibleFrom = railBottom();
    const visibleTo = window.innerHeight - 60;
    if (top < visibleFrom - 4 || top > visibleTo) easeScrollToEl(sec, 500);
  });
  sync();
}
function renderRail(){
  const narrow = window.matchMedia("(max-width: 640px)").matches;
  const names = narrow
    ? ["Hat", "Qty", "Design", "Review"]
    : ["Hat & colors", "Quantity", "Plate design", "Review"];
  $("rail").innerHTML = names.map((n, i) => {
    const step = i + 1;
    const cls = state.step === step ? "active" : (state.done.has(step) ? "done" : "");
    const mark = (state.done.has(step) && state.step !== step) ? "&#10003;" : step;
    return '<div class="rail-item ' + cls + '" data-goto="' + step + '"><span class="dot">' + mark + '</span>' + n + '</div>';
  }).join("");
  $("rail").querySelectorAll("[data-goto]").forEach(el => {
    const t = +el.dataset.goto;
    const reachable = t <= state.maxStep || (t === state.step + 1 && canLeave(state.step));
    el.style.opacity = reachable ? "1" : ".45";
    el.style.cursor = reachable ? "pointer" : "not-allowed";
    el.addEventListener("click", () => {
      if (!reachable) return;
      if (t > state.step){ state.done.add(state.step); if (state.colors.length > 1) evenSplit(); renderSplit(); }
      goto(t);
    });
  });
}

/* ---------- summaries + sticky bar ---------- */
function sync(){
  $("sum1").innerHTML = state.style
    ? nameOf(state.style) + (state.colors.length ? " &middot; " + (state.colors.length === 1 ? state.colors[0] : state.colors.length + " colors") : "")
    : "";
  $("sum2").textContent = state.qty ? state.qty + " hats" : "";
  $("sum3").innerHTML = state.color.name + " &middot; " + state.outline.label + (state.sizeChosen ? " &middot; " + state.size.label : "");
  $("sum4").textContent = "";

  $("next1").disabled = !canLeave(1);
  $("next2").disabled = !canLeave(2);
  if ($("next3")) $("next3").disabled = !canLeave(3);

  const each = perHat();
  const pn = $("priceNow");
  if (pn){
    pn.style.display = (each && state.qty) ? "flex" : "none";
    if (each && state.qty){
      pn.innerHTML =
        '<div class="pn"><span class="pn-l">Price per hat</span><span class="pn-v">' + money(each) + '</span></div>' +
        '<div class="pn"><span class="pn-l">' + state.qty + ' hats</span><span class="pn-v">' + money(each * state.qty) + '</span></div>' +
        '<div class="pn-note">' + (state.sizeChosen ? 'Includes the ' + state.size.label.toLowerCase() : 'Based on the small') + ' leatherette patch, laser engraved in black, and free shipping to the lower 48.</div>';
    }
  }
  const nt = nextTier();
  $("nudge").innerHTML = (nt && state.qty)
    ? '<div class="tier-nudge">Add ' + (nt[0] - state.qty) + ' more and your price drops to ' + money(nt[1] + state.size.add) + '/hat.</div>'
    : "";

  $("barQty").textContent = state.qty || 0;
  $("barEach").textContent = each ? money(each) : "-";
  $("barTotal").textContent = each && state.qty ? money(each * state.qty) : "-";
  $("bar").classList.toggle("show", !!state.style);
  $("barCta").textContent = state.step === 4 ? "Add to Cart" : "Continue";
  $("barCta").disabled = state.step < 4 && !canLeave(state.step);
}

/* ---------- Apps Script + cart plumbing ---------- */
function orderMeta(){
  const per = perHat();
  return {
    name: "", email: "", phone: "",
    style: state.style ? state.style.name : "",
    color: colorSummary(),
    qty: state.qty,
    sizing: state.style ? sizingOf(state.style) : "",
    leatherColor: state.color.name,
    outline: state.outline.label,
    riderName: state.showName ? state.riderName : "",
    riderNumber: state.riderNumber,
    numberFont: state.font,
    numberStyle: state.numberStyle,
    placement: state.placement.label,
    patchSize: state.sizeChosen ? (state.size.label + " (" + sizeDimLabel(state.size) + ")") : "",
    notes: ($("notes") && $("notes").value.trim()) || "-",
    proof: ($("proofMethod") && $("proofMethod").value) || "",
    proofPhone: ($("proofPhone") && $("proofPhone").value.trim()) || "",
    social: ($("noSocial") && $("noSocial").checked) ? "Do NOT share on social" : "OK to share on social",
    estimate: per === null ? "quote" : money(per) + "/hat, " + money(per * state.qty) + " total",
    colorSplit: state.colors.length > 1 ? JSON.stringify(state.split) : "",
    patchSizeLabel: state.sizeChosen ? state.size.label : "Small (default)",
    patchDims: state.size ? sizeDimLabel(state.size) : "",
    sizeUpcharge: state.size ? money(state.size.add) + "/hat" : "",
    perHat: per === null ? "" : money(per),
    orderTotal: (per === null || !state.qty) ? "" : money(per * state.qty),
    tierPrice: (function(){ const t = tierFor(state.style, state.qty); return t ? money(t[1]) : ""; })(),
    hatVariantId: (function(){ const t = tierFor(state.style, state.qty); return t ? String(t[2]) : ""; })(),
    sizeVariantId: state.size && state.size.variantId != null ? String(state.size.variantId) : "",
    nameScale: Math.round((state.nameScale || 1) * 100) + "%",
    numberScale: Math.round((state.numberScale || 1) * 100) + "%",
    nameOffset: Math.round((state.nameOffset.x || 0) * 100) + "%, " + Math.round((state.nameOffset.y || 0) * 100) + "%",
    numberOffset: Math.round((state.numberOffset.x || 0) * 100) + "%, " + Math.round((state.numberOffset.y || 0) * 100) + "%",
    submittedAt: new Date().toISOString(),
    pageUrl: (typeof window !== "undefined" && window.location) ? window.location.href : ""
  };
}
function scriptConfigured(){ return APPS_SCRIPT_URL && APPS_SCRIPT_URL.indexOf("PASTE") !== 0; }

async function sendToDrive(svgText){
  if (!scriptConfigured()) return { ok:false, skipped:true };
  const files = [{ kind: "svg", placement: state.placement.label, name: svgFileName(), mimeType: "image/svg+xml", data: btoa(unescape(encodeURIComponent(svgText))) }];
  const meta = orderMeta();
  const body = JSON.stringify({ type: "mx-patch-order", meta: meta, files: files });

  const box = $("uploadProgress"), fill = $("upFill"), label = $("upLabel");
  if (box) box.style.display = "block";
  if (label) label.textContent = "Sending your patch file...";
  let simPct = 8;
  if (fill) fill.style.width = simPct + "%";
  const simTimer = setInterval(() => {
    if (simPct < 90){ simPct += Math.max(1, (90 - simPct) * 0.08); if (fill) fill.style.width = simPct + "%"; }
  }, 200);

  return new Promise(resolve => {
    const finish = result => {
      clearInterval(simTimer);
      if (fill) fill.style.width = "100%";
      if (label) label.textContent = "Sent";
      setTimeout(() => resolve(result), 300);
    };
    fetch(APPS_SCRIPT_URL, {
      method: "POST", mode: "no-cors",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: body
    })
    .then(() => finish({ ok:true }))
    .catch(() => { clearInterval(simTimer); resolve({ ok:false }); });
  });
}

async function submitCheckout(){
  if (!sizesReady()){
    alert("Patch size variants aren't set up yet in Shopify. This page can't take real orders until that's done - see the TODO at the top of the template file.");
    return;
  }
  const btn = $("checkout");
  btn.disabled = true;
  $("cartErr").classList.remove("show");

  btn.textContent = "Building patch file...";
  let svgText = "";
  try { svgText = await buildProductionSVG(); } catch(e){ console.error("[tbmxpo] svg build failed", e); }
  if (svgText) await sendToDrive(svgText);

  btn.textContent = "Adding...";
  const meta = orderMeta();
  const tier = tierFor(state.style, state.qty);
  const props = {
    "Hat Color(s)": meta.color,
    "Sizing": meta.sizing,
    "Decoration": "Leatherette patch (laser engraved, black)",
    "Leather color": meta.leatherColor,
    "Outline": meta.outline,
    "Rider name": meta.riderName || "(none)",
    "Number": meta.riderNumber,
    "Number font": meta.numberFont,
    "Number style": meta.numberStyle === "outline" ? "Outline" : "Solid",
    "Placement": meta.placement,
    "Patch size": meta.patchSize
  };
  props["Confirmation delivery"] = meta.proof + (meta.proof === "Text message" && meta.proofPhone ? " to " + meta.proofPhone : "");
  if (meta.notes !== "-") props["Notes"] = meta.notes;
  props["Social sharing"] = meta.social;

  const items = [
    { id: tier[2], quantity: state.qty, properties: props },
    { id: state.size.variantId, quantity: state.qty, properties: { "Applies to": state.style.name, "Patch size": state.size.label } }
  ];

  try {
    const res = await fetch("/cart/add.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ items: items })
    });
    if (!res.ok){
      let detail = "";
      try { const j = await res.json(); detail = j.description || j.message || ""; } catch(_) {}
      throw new Error(detail || ("cart add failed (" + res.status + ")"));
    }
    window.location.href = "/checkout";
  } catch (e) {
    btn.disabled = false; btn.textContent = "Add to Cart";
    const box = $("cartErr");
    const msg = (e && e.message) ? e.message : "";
    box.innerHTML = "Something went wrong adding this to your cart. Please try again, or email help@threadbreak.com and we'll sort it out."
      + (msg ? '<br><span style="font-size:12px;opacity:.8">Details: ' + msg + '</span>' : "");
    box.classList.add("show");
    box.scrollIntoView({ behavior:"smooth", block:"center" });
    console.error("[tbmxpo] cart add failed", e, items);
  }
}

/* ---------- wire up ---------- */
$("qty").addEventListener("input", e => {
  state.qty = +e.target.value || null;
  if (state.colors.length > 1) evenSplit();
  renderSplit(); sync();
});
$("next1").addEventListener("click", () => { state.done.add(1); if (state.colors.length > 1) evenSplit(); renderSplit(); goto(2); });
$("next2").addEventListener("click", () => { state.done.add(2); goto(3); });
$("next3").addEventListener("click", () => { state.done.add(3); goto(4); });
$("checkout").addEventListener("click", submitCheckout);
$("downloadSvg").addEventListener("click", downloadProductionSVG);
$("barCta").addEventListener("click", () => {
  if (state.step === 4){ submitCheckout(); return; }
  if (!canLeave(state.step)) return;
  state.done.add(state.step);
  if (state.step === 1 && state.colors.length > 1){ evenSplit(); renderSplit(); }
  goto(Math.min(state.step + 1, 4));
});
document.querySelectorAll("#tbmxpo [data-back]").forEach(b => {
  b.addEventListener("click", () => { goto(+b.dataset.back); });
});

$("nameSwitch").addEventListener("click", () => {
  state.showName = !state.showName;
  $("nameSwitch").classList.toggle("on", state.showName);
  $("nameFieldWrap").style.display = state.showName ? "flex" : "none";
  renderPatchPreview(); sync();
});
$("riderName").addEventListener("input", e => { state.riderName = e.target.value.toUpperCase(); e.target.value = state.riderName; renderPatchPreview(); sync(); });
$("riderNumber").addEventListener("input", e => { state.riderNumber = e.target.value.toUpperCase(); e.target.value = state.riderNumber; renderPatchPreview(); sync(); });
$("nameSize").addEventListener("input", e => { state.nameScale = +e.target.value / 100; renderPatchPreview(); });
$("numberSize").addEventListener("input", e => { state.numberScale = +e.target.value / 100; renderPatchPreview(); });
$("resetLayout").addEventListener("click", () => {
  state.nameOffset = { x:0, y:0 }; state.numberOffset = { x:0, y:0 };
  state.nameScale = 1; state.numberScale = 1; state.selected = null;
  $("nameSize").value = 100; $("numberSize").value = 100;
  renderPatchPreview();
});

/* ---------- drag to reposition name/number on the canvas ---------- */
(function enableDrag(){
  const box = $("patchCanvasBox");
  const canvas = $("patchCanvas");
  if (!box || !canvas) return;
  function canvasPoint(evt){
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width, scaleY = canvas.height / rect.height;
    return { x: (evt.clientX - rect.left) * scaleX, y: (evt.clientY - rect.top) * scaleY };
  }
  function hitTest(pt){
    const order = ["number", "name"];
    for (const key of order){
      const b = currentHit[key];
      if (!b) continue;
      if (Math.abs(pt.x - b.cx) <= b.w/2 + 20 && Math.abs(pt.y - b.cy) <= b.h/2 + 20) return key;
    }
    return null;
  }
  let dragging = null, dragStart = null, dragOffsetStart = null;
  box.addEventListener("pointerdown", e => {
    const pt = canvasPoint(e);
    const target = hitTest(pt);
    state.selected = target;
    if (target){
      dragging = target; dragStart = pt;
      dragOffsetStart = { ...(target === "name" ? state.nameOffset : state.numberOffset) };
      box.classList.add("dragging");
      box.setPointerCapture(e.pointerId);
    }
    renderPatchPreview();
  });
  box.addEventListener("pointermove", e => {
    if (!dragging) return;
    const pt = canvasPoint(e);
    const dx = (pt.x - dragStart.x) / canvas.width;
    const dy = (pt.y - dragStart.y) / canvas.width;
    const clamp = v => Math.max(-0.4, Math.min(0.4, v));
    const target = dragging === "name" ? state.nameOffset : state.numberOffset;
    target.x = clamp(dragOffsetStart.x + dx);
    target.y = clamp(dragOffsetStart.y + dy);
    renderPatchPreview();
  });
  const end = e => {
    if (!dragging) return;
    dragging = null;
    box.classList.remove("dragging");
    try { box.releasePointerCapture(e.pointerId); } catch(_){}
  };
  box.addEventListener("pointerup", end);
  box.addEventListener("pointercancel", end);
})();

(function(){
  const sel = $("proofMethod"), wrap = $("proofPhoneWrap"), hint = $("proofHint");
  if (!sel) return;
  sel.addEventListener("change", () => {
    const isText = sel.value === "Text message";
    if (wrap){ if (isText) wrap.removeAttribute("hidden"); else { wrap.setAttribute("hidden",""); if ($("proofPhone")) $("proofPhone").value = ""; } }
    if (hint) hint.textContent = isText
      ? "We build your plate straight from the file you design here, so please double-check the spelling and number before adding to cart. We'll text a confirmation from (336) 585-6176 within one business day."
      : "We build your plate straight from the file you design here, so please double-check the spelling and number before adding to cart. We'll email a confirmation from help@threadbreak.com within one business day.";
    sync();
  });
  if ($("proofPhone")) $("proofPhone").addEventListener("input", sync);
})();

renderHats();
preloadColors();
renderPatchDesign();
renderRail();
sync();
})();
</script>
