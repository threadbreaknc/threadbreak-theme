  #tbmxpo .next{margin-top:20px;background:var(--purple);color:#fff;border:none;border-radius:11px;padding:13px 26px;font-family:'Bebas Neue',sans-serif;font-size:19px;letter-spacing:.04em;cursor:pointer;transition:.18s}
