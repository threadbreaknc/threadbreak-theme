}
function renderColors(){
  const host = $("colors");
  if (!host) return;
  host.innerHTML = COLORS.map(c =>
    '<button type="button" class="mat-chip ' + (c.id === state.color.id ? "on" : "") + '" data-color="' + c.id + '">' +
      '<span class="mat-swatch" style="' + (c.swatch ? "background-image:url('" + c.swatch + "')" : "background-color:" + c.hex) + '"></span>' +
      '<span class="mat-name">' + c.name + '</span>' +
    '</button>').join("");
  host.querySelectorAll("[data-color]").forEach(b => {
    b.addEventListener("click", () => {
      state.color = COLORS.find(x => x.id === b.dataset.color);
      renderColors(); renderPatchPreview(); sync();
    });
