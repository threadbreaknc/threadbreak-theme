      <p class="tbstep-hint"><strong>5 hat minimum.</strong> Wholesale pricing starts at 10, with additional volume discounts at 24+. Mixed colors all count toward the same total.</p>
      <div class="qty-row">
        <div class="field"><label for="qty">Total quantity (5 minimum)</label><input class="qty-input" id="qty" type="number" min="5" step="1" inputmode="numeric" placeholder="5"></div>
      </div>
      <div class="price-now" id="priceNow"></div>
      <div id="nudge"></div>
      <div id="splitHost"></div>
      <div class="btn-row"><button type="button" class="back" data-back="1">Back</button><button type="button" class="next" id="next2" disabled>Design Your Plate</button></div>
    </div>
  </section>

  <!-- STEP 3: plate design -->
  <section class="tbstep" data-step="3">
    <div class="tbstep-head"><div class="tbstep-num">3</div><h2>Design your number plate</h2><div class="tbstep-sum" id="sum3"></div></div>
    <div class="tbstep-body">
      <p class="tbstep-hint">Every patch is laser engraved on genuine leatherette. Pick a color, an outline, a font, then type the rider's name and number. Drag either one to reposition it.</p>

      <div class="patch-layout">
        <div class="patch-layout-preview">
          <div class="patch-preview">
            <div class="patch-canvas-box" id="patchCanvasBox">
              <canvas id="patchCanvas" width="1000" height="1000"></canvas>
            </div>
            <p class="drag-hint">Tap and drag the name or number to reposition it.</p>
            <p class="fld fld-tight">Outline</p>
            <div class="chips" id="outlines"></div>
            <div class="patch-controls">
              <div class="field">
                <label for="nameSize">Name size</label>
                <input type="range" id="nameSize" min="50" max="160" value="100">
              </div>
              <div class="field">
                <label for="numberSize">Number size</label>
                <input type="range" id="numberSize" min="50" max="160" value="100">
              </div>
              <button type="button" class="ctl-reset" id="resetLayout">Reset position &amp; size</button>
            </div>
            <p class="hint">This live preview approximates the final art. Your Add to Cart file below is the real, exact vector file we cut from.</p>
          </div>
        </div>

        <div class="patch-layout-fields">
          <div class="toggle-row">
            <span class="t">Include name</span>
            <div class="switch on" id="nameSwitch"></div>
          </div>
          <div class="field" id="nameFieldWrap"><label for="riderName">Rider name</label><input type="text" id="riderName" placeholder="SMITH" maxlength="16" value="SMITH"></div>
          <div class="field" style="margin-top:10px"><label for="riderNumber">Number</label><input type="text" id="riderNumber" placeholder="25" maxlength="4" value="25"></div>

          <p class="fld">Number font</p>
          <div class="chips" id="fonts"></div>

          <p class="fld">Number style</p>
          <div class="chips" id="numberStyles"></div>

          <p class="fld">Leather color</p>
          <div class="matgrid" id="colors"></div>

          <p class="fld">Placement</p>
          <div class="chips" id="placements"></div>

          <p class="fld">Size <span style="color:#c33">*</span></p>
          <div class="chips" id="sizes"></div>
          <div id="sizeHint"></div>
          <div id="sizesNotReady"></div>

          <p class="fld">How should we send your order confirmation? <span style="color:#c33">*</span></p>
          <div class="field" style="max-width:340px">
            <select id="proofMethod">
              <option value="">Choose one...</option>
              <option value="Email">Email</option>
              <option value="Text message">Text message</option>
            </select>
          </div>
          <div class="field" id="proofPhoneWrap" style="max-width:340px;margin-top:12px" hidden>
            <label for="proofPhone">Mobile number for your confirmation <span style="color:#c33">*</span></label>
            <input type="tel" id="proofPhone" inputmode="tel" autocomplete="tel" placeholder="(336) 555-0123">
          </div>
          <p class="hint" id="proofHint">We build your plate straight from the file you design here, so please double-check the spelling and number before adding to cart. We'll still confirm the order details within one business day.</p>

          <div class="field" style="margin-top:18px"><label for="notes">Notes</label><textarea id="notes" rows="3" placeholder="Placement preferences, deadlines, anything else we should know"></textarea></div>

          <label class="social-optout">
            <input type="checkbox" id="noSocial">
            <span><strong>Keep my finished order private.</strong> Leave this unchecked if you're comfortable with us featuring your finished hats in our portfolio or on social media.</span>
          </label>
        </div>
      </div>

      <div class="btn-row"><button type="button" class="back" data-back="2">Back</button><button type="button" class="next" id="next3">Review Order</button></div>
    </div>
  </section>

  <!-- STEP 4: review -->
  <section class="tbstep" data-step="4">
    <div class="tbstep-head"><div class="tbstep-num">4</div><h2>Review</h2><div class="tbstep-sum" id="sum4"></div></div>
