}
function sizeDimLabel(size){
  return size.wide + '" x ' + size.wide + '"';
}
function renderSizeHint(){
  const host = $("sizeHint");
  if (!host) return;
  const onSide = state.placement && state.placement.id !== "front";
  host.innerHTML = onSide
    ? '<div class="size-hint">Left and right panels are narrow, so we typically recommend Small or Medium there.</div>'
    : "";
}
function renderSizes(){
  const host = $("sizes");
  if (!host) return;
  host.innerHTML = SIZES.map(s =>
    '<button type="button" class="chip ' + (state.sizeChosen && s.id === state.size.id ? "on" : "") + '" data-size="' + s.id + '">' + s.label +
    ' <span class="size-dim">(' + sizeDimLabel(s) + ')</span><span class="tag">+' + money(s.add) + '/hat</span></button>').join("");
  host.querySelectorAll("[data-size]").forEach(b => {
