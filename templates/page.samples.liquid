{%- comment -%}
  Physical sample policy page. Copy lives here so layout and text stay together.
{%- endcomment -%}
<style>
  .tbsm{--purple:#5028AA;--ink:#14121C;--muted:#5c5a68;--line:#E2E0EA;--ice:#F4F1FB;background:#fff;color:var(--ink);font-family:'DM Sans',system-ui,sans-serif}
  .tbsm-wrap{max-width:980px;margin:0 auto;padding:8.5rem 20px 4rem}
  .tbsm-eyebrow{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--purple);margin:0 0 8px}
  .tbsm h1{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(2.6rem,7vw,4.4rem);line-height:1;margin:0 0 12px}
  .tbsm-lead{font-size:18px;line-height:1.65;color:#2a2638;max-width:700px;margin:0 0 30px}
  .tbsm h2{font-size:clamp(22px,3.2vw,28px);line-height:1.2;margin:0 0 12px;font-weight:700}
  .tbsm p{font-size:16.5px;line-height:1.7;color:#2a2638;margin:0 0 14px}
  .tbsm a{color:var(--purple);font-weight:600}
  .tbsm-top{display:grid;grid-template-columns:1.1fr 1fr;gap:20px;align-items:stretch;margin:0 0 44px}
  .tbsm-photo{border-radius:18px;overflow:hidden;background:var(--ice);min-height:280px}
  .tbsm-photo img{width:100%;height:100%;object-fit:cover;display:block}
  .tbsm-price{border:1px solid var(--line);border-radius:18px;padding:26px 24px;background:linear-gradient(180deg,#F8F5FF,#fff);display:flex;flex-direction:column}
  .tbsm-price .amt{font-family:'Bebas Neue',sans-serif;font-size:64px;line-height:.9;color:var(--purple);margin:4px 0 2px}
  .tbsm-price .amt small{font-family:'DM Sans',sans-serif;font-size:16px;font-weight:700;color:var(--ink);margin-left:6px;letter-spacing:0}
  .tbsm-price .per{font-size:14px;color:var(--muted);margin:0 0 16px}
  .tbsm-list{list-style:none;margin:0 0 18px;padding:0}
  .tbsm-list li{position:relative;padding:0 0 0 28px;margin:0 0 10px;font-size:15.5px;line-height:1.5;color:#2a2638}
  .tbsm-list li::before{content:"\2713";position:absolute;left:0;top:0;width:20px;height:20px;border-radius:50%;background:#EEE8FB;color:var(--purple);font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center}
  .tbsm-btns{display:flex;flex-wrap:wrap;gap:10px;margin-top:auto}
  .tbsm-btn{display:inline-block;padding:13px 20px;border-radius:11px;background:var(--purple);color:#fff !important;text-decoration:none;font-weight:700;font-size:15px}
  .tbsm-btn.alt{background:#fff;color:var(--ink) !important;border:1.5px solid var(--line)}
  .tbsm-btn:hover{filter:brightness(1.08)}
  .tbsm-two{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:0 0 44px}
  .tbsm-card{border:1px solid var(--line);border-radius:16px;padding:22px 22px 8px;background:#fff}
  .tbsm-card h3{font-size:18px;margin:0 0 12px;display:flex;align-items:center;gap:10px}
  .tbsm-card h3 span{width:30px;height:30px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;font-size:15px}
  .tbsm-card.yes h3 span{background:#E7F5EC;color:#2f8a4e}
  .tbsm-card.no h3 span{background:#F4F1FB;color:var(--purple)}
  .tbsm-card .tbsm-list li::before{background:transparent;color:inherit;content:"\2022";font-size:20px;width:auto;height:auto;top:-1px;left:6px}
  .tbsm-steps{counter-reset:s;list-style:none;margin:0 0 44px;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .tbsm-steps li{counter-increment:s;border:1px solid var(--line);border-radius:16px;padding:18px 16px;background:#fff;font-size:15px;line-height:1.5;color:#2a2638}
  .tbsm-steps li::before{content:counter(s);display:flex;width:30px;height:30px;border-radius:50%;background:var(--purple);color:#fff;font-weight:800;font-size:14px;align-items:center;justify-content:center;margin:0 0 10px}
  .tbsm-steps li b{display:block;color:var(--ink);margin-bottom:3px}
  .tbsm-note{background:var(--ice);border-radius:14px;padding:16px 18px;font-size:15px;line-height:1.6;color:#2a2638;margin:0 0 44px}
  .tbsm-cta{text-align:center;background:var(--ink);color:#fff;border-radius:18px;padding:40px 24px}
  .tbsm-cta h2{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(28px,5vw,40px);color:#fff;margin:0 0 8px}
  .tbsm-cta p{color:#C9C6D6;max-width:480px;margin:0 auto 20px}
  .tbsm-cta .tbsm-btns{justify-content:center}
  .tbsm-cta .tbsm-btn.alt{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.2);color:#fff !important}
  .tbsm-form-wrap{border:1px solid var(--line);border-radius:18px;padding:28px 24px;margin:0 0 44px;background:#fff;scroll-margin-top:110px;box-shadow:0 14px 40px -28px rgba(80,40,170,.5)}
  .tbsm-form-sub{color:var(--muted) !important;margin-bottom:18px !important}
  .sm-label,.sm-field label{display:block;font-size:14px;font-weight:700;color:var(--ink);margin:0 0 7px}
  .sm-req{color:var(--purple)}
  .sm-chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px}
  .sm-chip{position:relative;cursor:pointer}
  .sm-chip input{position:absolute;opacity:0;pointer-events:none}
  .sm-chip span{display:inline-block;padding:10px 14px;border:1.5px solid var(--line);border-radius:11px;font-size:14.5px;font-weight:600;color:var(--ink);background:#fff;transition:border-color .15s,background .15s}
  .sm-chip input:checked + span{border-color:var(--purple);background:#F3EFFC;color:var(--purple)}
  .sm-chip.is-locked{cursor:default}
  .sm-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .sm-field{margin:0 0 16px}
  .sm-field input[type=text],.sm-field input[type=email],.sm-field input[type=tel],.sm-field textarea{width:100%;box-sizing:border-box;padding:12px 13px;border:1.5px solid var(--line);border-radius:11px;font:inherit;font-size:15.5px;color:var(--ink);background:#fff}
  .sm-field input:focus,.sm-field textarea:focus{outline:none;border-color:var(--purple)}
  .sm-help{font-size:13.5px !important;color:var(--muted) !important;line-height:1.5 !important;margin:-8px 0 18px !important}
  .sm-field .sm-help{margin:6px 0 0 !important}
  .sm-file{display:block;position:relative;border:1.5px dashed #C9BEEB;border-radius:11px;padding:16px;text-align:center;font-size:14.5px;font-weight:600;color:var(--purple) !important;background:#FAF8FF;cursor:pointer}
  .sm-file.has-file{border-style:solid;border-color:var(--purple)}
  .sm-file input{position:absolute;inset:0;opacity:0;cursor:pointer}
  .sm-total{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;background:var(--ice);border-radius:12px;padding:14px 16px;margin:6px 0 14px}
  .sm-total span{font-weight:700}
  .sm-total strong{font-family:'Bebas Neue',sans-serif;font-size:34px;line-height:1;color:var(--purple);font-weight:400}
  .sm-total small{flex-basis:100%;font-size:13px;color:var(--muted)}
  .sm-err{display:none;color:#c0392b !important;font-size:14px !important;font-weight:600;margin:0 0 10px !important}
  .sm-err.show{display:block}
  .sm-progress{display:none;align-items:center;gap:10px;margin:0 0 12px;font-size:14px;color:var(--muted)}
  .sm-progress.show{display:flex}
  .sm-bar{flex:1;height:6px;border-radius:9px;background:#EEE8FB;overflow:hidden}
  .sm-bar div{height:100%;width:0;background:var(--purple);transition:width .2s}
  .sm-submit{border:0;cursor:pointer;width:100%;font-size:16px;padding:15px 20px}
  .sm-submit:disabled{opacity:.6;cursor:default}
  .sm-fine{margin:10px 0 0 !important;text-align:center}
  .sm-done{text-align:center;padding:10px 0}
  .sm-done h3{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:36px;margin:0 0 8px;color:var(--purple)}
  @media(max-width:700px){.sm-row{grid-template-columns:1fr;gap:0}.tbsm-form-wrap{padding:22px 16px}}
  .tbsm [hidden]{display:none !important}
  .sm-search{width:100%;box-sizing:border-box;padding:12px 13px;border:1.5px solid var(--line);border-radius:11px;font:inherit;font-size:15.5px;margin:0 0 10px;background:#fff}
  .sm-search:focus{outline:none;border-color:var(--purple)}
  .sm-hats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;max-height:470px;overflow-y:auto;padding:2px;margin:0 0 18px;-webkit-overflow-scrolling:touch}
  .sm-hat{display:flex;flex-direction:column;align-items:center;text-align:center;gap:4px;padding:10px 8px 12px;border:1.5px solid var(--line);border-radius:12px;background:#fff;cursor:pointer;font:inherit;color:var(--ink)}
  .sm-hat:hover{border-color:#B7A6EE}
  .sm-hat.on{border-color:var(--purple);background:#F3EFFC}
  .sm-hat img{width:100%;aspect-ratio:1;object-fit:contain;background:#fff;border-radius:8px}
  .sm-hat b{font-size:13px;line-height:1.25}
  .sm-hat small{font-size:11.5px;color:var(--muted)}
  .sm-loading{grid-column:1/-1;color:var(--muted) !important;font-size:14.5px !important;padding:16px 0;text-align:center}
  .sm-pick{display:flex;align-items:center;gap:14px;border:1.5px solid var(--purple);background:#F8F5FF;border-radius:14px;padding:10px 14px 10px 10px;margin:0 0 16px}
  .sm-pick img{width:84px;height:84px;object-fit:contain;background:#fff;border-radius:10px;flex:0 0 84px}
  .sm-pick b{display:block;font-size:16px}
  .sm-pick span{display:block;font-size:14px;color:var(--muted);margin:2px 0 6px}
  .sm-change{background:none;border:0;padding:0;font:inherit;font-size:13.5px;font-weight:700;color:var(--purple);cursor:pointer;text-decoration:underline}
  .sm-colors{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;max-height:330px;overflow-y:auto;padding:2px;margin:0 0 18px}
  .sm-color{display:flex;align-items:center;gap:8px;padding:6px 10px 6px 6px;border:1.5px solid var(--line);border-radius:10px;background:#fff;cursor:pointer;font:inherit;font-size:13.5px;text-align:left;color:var(--ink)}
  .sm-color img{width:38px;height:38px;object-fit:contain;border-radius:6px;background:#fff;flex:0 0 38px}
  .sm-color.on{border-color:var(--purple);background:#F3EFFC}
  .sm-color.oos{opacity:.45;cursor:not-allowed}
  .sm-color em{display:block;font-style:normal;font-size:11px;font-weight:700;color:#b42318}
  @media(max-width:700px){.sm-hats{grid-template-columns:repeat(2,1fr);max-height:420px}.sm-colors{grid-template-columns:1fr 1fr}}
  .sm-help-top{margin:-2px 0 10px !important}
  .sm-mats{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin:0 0 18px}
  .sm-mat{display:flex;flex-direction:column;align-items:center;gap:6px;padding:8px;border:1.5px solid var(--line);border-radius:12px;background:#fff;cursor:pointer;font:inherit;font-size:13px;font-weight:600;color:var(--ink);text-align:center}
  .sm-mat img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:8px}
  .sm-mat.on{border-color:var(--purple);background:#F3EFFC;color:var(--purple)}
  @media(max-width:700px){.sm-mats{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:820px){.tbsm-steps{grid-template-columns:1fr 1fr}}
  @media(max-width:700px){
    .tbsm-wrap{padding-top:7.5rem}
    .tbsm-top,.tbsm-two{grid-template-columns:1fr}
    .tbsm-photo{min-height:0;aspect-ratio:4/3}
    .tbsm-steps{grid-template-columns:1fr}
    .tbsm-btns .tbsm-btn{flex:1 1 auto;text-align:center}
  }
</style>

<div class="tbsm">
  <div class="tbsm-wrap">
    <p class="tbsm-eyebrow">Physical samples</p>
    <h1>See it stitched before you order</h1>
    <p class="tbsm-lead">Want to see your logo on a real hat before you commit? We'll make one physical sample so you can check the size, placement, colors and stitch style in person. Samples are available for both embroidered and laser engraved patch hats.</p>

    <div class="tbsm-top">
      <div class="tbsm-photo"><img src="https://cdn.shopify.com/s/files/1/0974/8453/7988/files/660B5CDC-607C-4CB3-AC44-66FDB8578C7D.jpg?v=1792644744&width=1000" alt="Threadbreak six head embroidery machine stitching a run of custom hats in Burlington, NC" loading="eager"></div>
      <div class="tbsm-price">
        <p class="tbsm-eyebrow">Sample cost</p>
        <div class="amt">$99<small>shipped</small></div>
        <p class="per">One sample hat with your logo in one location. Each additional location is $25. Applies to hats in our current catalog.</p>
        <ul class="tbsm-list">
          <li>Your logo digitized for embroidery or set up for laser engraving</li>
          <li>One finished hat in the style and color you choose</li>
          <li>A chance to check size, placement, colors and stitch style</li>
          <li>Shipping included</li>
        </ul>
        <div class="tbsm-btns">
          <a class="tbsm-btn" href="#sample-form">Request a sample</a>
          <a class="tbsm-btn alt" href="sms:+13365856176">Text us</a>
        </div>
      </div>
    </div>

    <h2>What happens next</h2>
    <div class="tbsm-two">
      <div class="tbsm-card yes">
        <h3><span>&#10003;</span>If you place an order</h3>
        <ul class="tbsm-list">
          <li>$70 of your sample fee is credited toward any order of 5 or more hats.</li>
          <li>The $29 hat cost isn't credited, but you keep the sample. It's an extra hat on top of your order.</li>
        </ul>
      </div>
      <div class="tbsm-card no">
        <h3><span>&#8635;</span>If you don't move forward</h3>
        <ul class="tbsm-list">
          <li>The $99 (plus any additional locations) is non-refundable.</li>
          <li>It covers digitizing, setup, materials, labor and machine time.</li>
        </ul>
      </div>
    </div>

    <h2>How it works</h2>
    <ol class="tbsm-steps">
      <li><b>Request and pay</b>Fill out the form below with your logo and the hat you want. We email you an invoice for the sample.</li>
      <li><b>Approve the mockup</b>Within 48 hours of payment, we send a digital mockup showing size and placement.</li>
      <li><b>Get your sample</b>Once you approve, we make your hat in 1-2 weeks and ship it to you.</li>
      <li><b>Place your order</b>Order 5 or more hats and we apply your $70 credit.</li>
    </ol>

    <p class="tbsm-note"><strong>Good to know.</strong> Sample pricing applies to the hats in our current <a href="/pages/custom-order">embroidery</a> and <a href="/pages/custom-patch-hats">patch hat</a> catalogs. Hats outside our catalog, specialty blanks or hats you supply may cost more, and we'll confirm the price with you before we invoice. The $99 covers one logo location. Adding the sides or back is $25 per additional location. Not sure you need a sample at all? Every order already includes a digital mockup before we stitch. See <a href="/pages/embroidery-guide">our embroidery guide</a> for what to expect.</p>

    <section class="tbsm-form-wrap" id="sample-form">
      <h2>Request a sample</h2>
      <p class="tbsm-form-sub">Fill this out and we'll email you an invoice. Your mockup comes within 48 hours of payment.</p>
      <form id="smForm" novalidate>
        <p class="sm-label">Sample type <span class="sm-req">*</span></p>
        <div class="sm-chips">
          <label class="sm-chip"><input type="radio" name="smType" value="Embroidered" checked><span>Embroidered</span></label>
          <label class="sm-chip"><input type="radio" name="smType" value="Laser engraved patch"><span>Laser engraved patch</span></label>
        </div>

        <p class="sm-label">Choose your hat <span class="sm-req">*</span></p>
        <div id="smPicker">
          <input type="search" id="smSearch" class="sm-search" placeholder="Search hats: Richardson, trucker, rope, camo..." autocomplete="off">
          <div class="sm-hats" id="smHats"><p class="sm-loading">Loading hats...</p></div>
          <div class="sm-pick" id="smPick" hidden>
            <img id="smPickImg" alt="">
            <div><b id="smPickName"></b><span id="smPickColor">Choose a color below</span><button type="button" class="sm-change" id="smChange">Change hat</button></div>
          </div>
          <div id="smColorWrap" hidden>
            <p class="sm-label">Color <span class="sm-req">*</span></p>
            <div class="sm-colors" id="smColors"></div>
          </div>
          <div id="smSizeWrap" hidden>
            <p class="sm-label">Size <span class="sm-req">*</span></p>
            <div class="sm-chips" id="smSizes"></div>
          </div>
        </div>
        <div id="smPatchWrap" hidden>
          <p class="sm-label">Patch color <span class="sm-req">*</span></p>
          <p class="sm-help sm-help-top">Engraved lines always come out black, whichever leatherette you pick.</p>
          <div class="sm-mats" id="smMats"></div>
          <p class="sm-label">Patch shape <span class="sm-req">*</span></p>
          <div class="sm-chips" id="smShapes"></div>
        </div>
        <div class="sm-row" id="smManual" hidden>
          <div class="sm-field"><label for="smStyle">Hat style <span class="sm-req">*</span></label><input type="text" id="smStyle" placeholder="e.g. Richardson 112, Otto 31-069"></div>
          <div class="sm-field"><label for="smColor">Hat color <span class="sm-req">*</span></label><input type="text" id="smColor" placeholder="e.g. Black/White"></div>
        </div>
        <p class="sm-help">Want a hat that isn't listed? Tell us in the notes. Hats outside our catalog may cost more.</p>

        <p class="sm-label">Logo locations</p>
        <div class="sm-chips">
          <label class="sm-chip is-locked"><input type="checkbox" checked disabled data-loc="Front"><span>Front (included)</span></label>
          <label class="sm-chip"><input type="checkbox" name="smLoc" data-loc="Left side"><span>Left side +$25</span></label>
          <label class="sm-chip"><input type="checkbox" name="smLoc" data-loc="Right side"><span>Right side +$25</span></label>
          <label class="sm-chip"><input type="checkbox" name="smLoc" data-loc="Back"><span>Back +$25</span></label>
        </div>

        <div class="sm-field">
          <label>Your logo</label>
          <label class="sm-file" id="smFileWrap"><input type="file" id="smFile" accept="image/*,.pdf,.ai,.eps,.svg,.png,.jpg,.jpeg"><span id="smFileLabel">Tap to upload your logo</span></label>
          <p class="sm-help">PNG, JPG, PDF, AI or SVG. If you have logos for the sides or back, send them in the notes or reply to our email.</p>
        </div>

        <div class="sm-row">
          <div class="sm-field"><label for="smName">Name <span class="sm-req">*</span></label><input type="text" id="smName" autocomplete="name"></div>
          <div class="sm-field"><label for="smEmail">Email <span class="sm-req">*</span></label><input type="email" id="smEmail" autocomplete="email"></div>
        </div>
        <div class="sm-row">
          <div class="sm-field"><label for="smPhone">Phone</label><input type="tel" id="smPhone" autocomplete="tel"></div>
          <div class="sm-field"><label for="smQty">Order size you're planning</label><input type="text" id="smQty" placeholder="e.g. 24 hats"></div>
        </div>
        <div class="sm-field"><label for="smNotes">Notes</label><textarea id="smNotes" rows="3" placeholder="Thread colors, 3D puff, sizing, anything we should know"></textarea></div>

        <div class="sm-total"><span>Sample total</span><strong id="smTotal">$99</strong><small>Shipping included. Final price confirmed on your invoice.</small></div>
        <p class="sm-err" id="smErr">Please fill in the required fields.</p>
        <div class="sm-progress" id="smProgress"><div class="sm-bar"><div id="smBar"></div></div><span id="smProgLabel">Sending...</span></div>
        <button type="button" class="tbsm-btn sm-submit" id="smSubmit">Request my sample</button>
        <p class="sm-help sm-fine">The sample fee is non-refundable once paid. $70 is credited toward any order of 5 or more hats.</p>
      </form>
      <div class="sm-done" id="smDone" hidden>
        <h3>Got it!</h3>
        <p id="smDoneMsg"></p>
      </div>
    </section>

    <div class="tbsm-cta">
      <h2>Questions first?</h2>
      <p>Reach out and we'll help you pick the right hat for your sample.</p>
      <div class="tbsm-btns">
        <a class="tbsm-btn" href="mailto:help@threadbreak.com?subject=Sample%20question">Email help@threadbreak.com</a>
        <a class="tbsm-btn alt" href="sms:+13365856176">Text (336) 585-6176</a>
      </div>
    </div>
  </div>
</div>

{% render 'ss-stock' %}
<script>
(function(){
  var URL_ = "https://script.google.com/macros/s/AKfycbwuCYOYP96-fhmSnVsPYHuPi0LT1segF4291MGeHJ4eWCW_FONn7deif6Wj81CD_Yox/exec";
  var $ = function(id){ return document.getElementById(id); };
  var file = null;
  function val(id){ return ($(id).value || "").trim(); }
  function esc(t){ return String(t).replace(/[&<>"]/g, function(m){ return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]; }); }
  function locs(){ return Array.prototype.slice.call(document.querySelectorAll('input[name="smLoc"]:checked')).map(function(c){ return c.getAttribute("data-loc"); }); }
  function total(){ return 99 + 25 * locs().length; }
  function upd(){ $("smTotal").textContent = "$" + total(); }
  document.querySelectorAll('input[name="smLoc"]').forEach(function(c){ c.addEventListener("change", upd); });

  // ---- hat catalog: read the same STYLES list the order forms use, so new hats show up here automatically ----
  var SOURCES = { "Embroidered": "/pages/custom-order", "Laser engraved patch": "/pages/custom-patch-hats" };
  var cache = {}, cur = { styles: [], SSI: null }, pick = { s: null, c: "", z: "" }, patch = { m: "", sh: "" };
  var STOCK = (window.TB_STOCK && window.TB_STOCK.styles) || {};
  var norm = function(c){ return String(c || "").toLowerCase().replace(/grey/g, "gray").replace(/[^a-z0-9]/g, ""); };
  var ALIAS = {
    rich112: { "Royal Blue/Black": "Royal/Black", "Royal Blue/White": "Royal/White" },
    rich112p: { "Realtree/Neon Yellow": "Realtree Edge/Neon Yellow", "Realtree/Neon Pink": "Realtree Edge/Neon Pink" },
    yupoong: { "Navy Blue": "Navy", "Heather Grey/Black": "Heather/Black", "Heather Grey/White": "Heather/White", "Carolina Blue/White": "Carolina Blue/White/Caroline Blue", "Red/White": "Red/White/Red" },
    yp6606: { "Blue/Silver": "Steel Blue/Silver", "Green Camo": "Green Camo/Black" },
    rich168: { "Black Camo": "Black/Camo/Loden", "Charcoal/White/Black": "Charcoal/Black/White", "Pale Khaki/Loden": "Pale Khaki/Loden Green" },
    rich256: { "Black": "Black/Black", "Cardinal": "Cardinal/White" }
  };
  function isOut(s, c){ if (s.oos && s.oos.indexOf(c) > -1) return true; var st = STOCK[s.id]; if (!st) return false; var al = ALIAS[s.id]; var e = st[norm((al && al[c]) || c)]; return !!e && e.qty < 12; }
  function thumb(u, w){ if (!u) return ""; return u.indexOf("cdn.shopify.com") > -1 ? u.replace(/([?&])width=\d+/, "$1").replace(/[?&]$/, "") + (u.indexOf("?") > -1 ? "&" : "?") + "width=" + w : u; }
  function colorImg(s, c){ return (s.colorImgs && s.colorImgs[c]) ? cur.SSI(s.colorImgs[c], "f_fm") : s.imgs[0]; }

  function load(type){
    if (cache[type]) return Promise.resolve(cache[type]);
    return fetch(SOURCES[type], { credentials: "same-origin" }).then(function(r){ return r.text(); }).then(function(h){
      var blocks = h.split("<scr" + "ipt>"), code = null;
      for (var k = 0; k < blocks.length; k++){ if (blocks[k].indexOf("const STYLES = [") > -1){ code = blocks[k].split("<\/script>")[0]; break; } }
      if (!code) throw new Error("no styles");
      var out = (new Function(code + "\n;return { STYLES: STYLES, SSI: SSI, MATERIALS: (typeof MATERIALS !== 'undefined' ? MATERIALS : null), SHAPES: (typeof SHAPES !== 'undefined' ? SHAPES : null) };"))();
      out.STYLES = out.STYLES.filter(function(x){ return x && x.colors && x.colors.length; }).sort(function(a, b){
        var la = /^10 10/.test(a.brand) ? 1 : 0, lb = /^10 10/.test(b.brand) ? 1 : 0;
        if (la !== lb) return la - lb;
        return a.brand.localeCompare(b.brand, "en", { numeric: true });
      });
      cache[type] = out; return out;
    });
  }
  function type(){ return (document.querySelector('input[name="smType"]:checked') || {}).value || "Embroidered"; }
  function renderHats(){
    var q = val("smSearch").toLowerCase();
    var list = cur.styles.filter(function(s){ return !q || (s.name + " " + s.brand + " " + (s.desc || "")).toLowerCase().indexOf(q) > -1; });
    $("smHats").innerHTML = list.length ? list.map(function(s){
      return '<button type="button" class="sm-hat' + (pick.s === s ? " on" : "") + '" data-id="' + esc(s.id) + '">' +
        '<img src="' + esc(thumb(s.imgs[0], 300)) + '" alt="" loading="lazy" decoding="async">' +
        '<b>' + esc(s.name) + '</b><small>' + esc(s.colors.length) + ' colors</small></button>';
    }).join("") : '<p class="sm-loading">No hats match that search.</p>';
  }
  function choose(s){
    pick = { s: s, c: "", z: "" };
    $("smHats").hidden = true; $("smSearch").hidden = true;
    $("smPick").hidden = false; $("smPickImg").src = thumb(s.imgs[0], 400); $("smPickName").textContent = s.name;
    $("smPickColor").textContent = "Choose a color below";
    $("smColors").innerHTML = s.colors.map(function(c){
      var out = isOut(s, c);
      return '<button type="button" class="sm-color' + (out ? " oos" : "") + '" data-color="' + esc(c) + '"' + (out ? " disabled" : "") + '>' +
        '<img src="' + esc(thumb(colorImg(s, c), 160)) + '" alt="" loading="lazy" decoding="async" onerror="this.style.visibility=\'hidden\'">' +
        '<span>' + esc(c) + (out ? ' <em>Out of stock</em>' : '') + '</span></button>';
    }).join("");
    $("smColorWrap").hidden = false;
    var sz = s.sizes || null;
    $("smSizeWrap").hidden = !sz;
    $("smSizes").innerHTML = sz ? sz.map(function(z){ return '<label class="sm-chip"><input type="radio" name="smSize" value="' + esc(z) + '"><span>' + esc(z) + '</span></label>'; }).join("") : "";
    $("smPicker").scrollIntoView({ behavior: "smooth", block: "start" });
  }
  function reset(){
    pick = { s: null, c: "", z: "" };
    $("smPick").hidden = true; $("smColorWrap").hidden = true; $("smSizeWrap").hidden = true;
    $("smHats").hidden = false; $("smSearch").hidden = false; renderHats();
  }
  function start(){
    var t = type();
    $("smHats").innerHTML = '<p class="sm-loading">Loading hats...</p>'; reset();
    patch = { m: "", sh: "" }; $("smPatchWrap").hidden = true;
    load(t).then(function(out){ if (type() !== t) return; cur = { styles: out.STYLES, SSI: out.SSI }; renderHats(); renderPatch(t, out); })
      .catch(function(){ $("smPicker").hidden = true; $("smManual").hidden = false; });
  }
  function renderPatch(t, out){
    var on = t !== "Embroidered" && out.MATERIALS && out.MATERIALS.length;
    $("smPatchWrap").hidden = !on; if (!on) return;
    $("smMats").innerHTML = out.MATERIALS.map(function(m){
      return '<button type="button" class="sm-mat" data-mat="' + esc(m.name) + '"><img src="' + esc(thumb(m.swatch, 200)) + '" alt="" loading="lazy"><span>' + esc(m.name) + '</span></button>';
    }).join("");
    $("smShapes").innerHTML = (out.SHAPES || []).map(function(x){
      return '<label class="sm-chip"><input type="radio" name="smShape" value="' + esc(x.label) + '"><span>' + esc(x.label) + '</span></label>';
    }).join("");
  }
  $("smMats").addEventListener("click", function(e){
    var b = e.target.closest(".sm-mat"); if (!b) return;
    document.querySelectorAll(".sm-mat.on").forEach(function(x){ x.classList.remove("on"); });
    b.classList.add("on"); patch.m = b.getAttribute("data-mat");
  });
  $("smShapes").addEventListener("change", function(e){ patch.sh = e.target.value; });
  $("smHats").addEventListener("click", function(e){
    var b = e.target.closest(".sm-hat"); if (!b) return;
    var id = b.getAttribute("data-id");
    for (var k = 0; k < cur.styles.length; k++) if (cur.styles[k].id === id) return choose(cur.styles[k]);
  });
  $("smColors").addEventListener("click", function(e){
    var b = e.target.closest(".sm-color"); if (!b || b.disabled) return;
    pick.c = b.getAttribute("data-color");
    document.querySelectorAll(".sm-color.on").forEach(function(x){ x.classList.remove("on"); });
    b.classList.add("on");
    $("smPickColor").textContent = pick.c;
    $("smPickImg").src = thumb(colorImg(pick.s, pick.c), 400);
  });
  $("smSizes").addEventListener("change", function(e){ pick.z = e.target.value; });
  $("smChange").addEventListener("click", reset);
  $("smSearch").addEventListener("input", renderHats);
  document.querySelectorAll('input[name="smType"]').forEach(function(r){ r.addEventListener("change", start); });
  start();

  $("smFile").addEventListener("change", function(e){
    var f = e.target.files[0]; if (!f) return;
    $("smFileLabel").textContent = f.name + " (tap to change)";
    $("smFileWrap").classList.add("has-file");
    var r = new FileReader();
    r.onload = function(ev){ file = { data: ev.target.result.split(",")[1], name: f.name, mimeType: f.type, placement: "Front" }; };
    r.readAsDataURL(f);
  });
  function hatName(){ return $("smManual").hidden ? (pick.s ? pick.s.name : "") : val("smStyle"); }
  function hatColor(){ return $("smManual").hidden ? pick.c : val("smColor"); }
  $("smSubmit").addEventListener("click", function(){
    var manual = !$("smManual").hidden;
    var needSize = !manual && pick.s && pick.s.sizes;
    var needPatch = !$("smPatchWrap").hidden;
    var hatOk = hatName() && hatColor() && (!needSize || pick.z) && (!needPatch || (patch.m && patch.sh));
    var ok = hatOk && val("smName") && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val("smEmail"));
    var err = $("smErr");
    err.textContent = !hatName() ? "Please choose a hat." : !hatColor() ? "Please choose a hat color." : (needSize && !pick.z) ? "Please choose a size." : (needPatch && !patch.m) ? "Please choose a patch color." : (needPatch && !patch.sh) ? "Please choose a patch shape." : "Please fill in your name and email.";
    err.classList.toggle("show", !ok);
    if (!ok){
      var hatOnly = hatName() && hatColor() && (!needSize || pick.z);
      var tgt = !hatOk ? (manual && !hatOnly ? $(!val("smStyle") ? "smStyle" : "smColor") : (!hatOnly ? $("smPicker") : $("smPatchWrap"))) : $(!val("smName") ? "smName" : "smEmail");
      tgt.scrollIntoView({ behavior:"smooth", block:"center" }); if (tgt.focus) tgt.focus();
      return;
    }
    var btn = $("smSubmit"); btn.disabled = true;
    var t = type();
    var places = ["Front"].concat(locs());
    var hat = hatName() + (pick.s && !manual ? " (" + pick.s.brand + ")" : "");
    var meta = {
      name: val("smName"), email: val("smEmail"), phone: val("smPhone") || "-",
      style: "PHYSICAL SAMPLE - " + hat, requestedStyle: hat,
      color: hatColor() + (pick.z ? " / size " + pick.z : ""), qty: "1 (sample)",
      deco: t + (needPatch ? " - " + patch.m + " leatherette, " + patch.sh : ""), placements: places.join(", "),
      notes: "PHYSICAL SAMPLE REQUEST. Total $" + total() + ". Planned order: " + (val("smQty") || "-") + ". Notes: " + (val("smNotes") || "-"),
      social: "-", estimate: "sample $" + total()
    };
    var prog = $("smProgress"), bar = $("smBar"); prog.classList.add("show");
    $("smProgLabel").textContent = file ? "Sending your logo..." : "Sending your request...";
    var pct = 0, sim = setInterval(function(){ pct += (90 - pct) * 0.15; bar.style.width = pct + "%"; }, 200);
    function done(){
      clearInterval(sim); bar.style.width = "100%";
      setTimeout(function(){
        $("smForm").style.display = "none";
        $("smDoneMsg").innerHTML = "Thanks " + esc(meta.name.split(" ")[0]) + "! We've got your " + esc(t.toLowerCase()) + " sample request for a " + esc(hatName()) + " in " + esc(hatColor()) + " ($" + total() + "). We'll email your invoice from <strong>help@threadbreak.com</strong>, and your mockup follows within 48 hours of payment. Check your spam folder just in case.";
        $("smDone").hidden = false;
        $("smDone").scrollIntoView({ behavior:"smooth", block:"center" });
      }, 350);
    }
    fetch(URL_, { method:"POST", mode:"no-cors", headers:{ "Content-Type":"application/json" },
      body: JSON.stringify({ type:"quote", meta: meta, files: file ? [file] : [] }) }).then(done).catch(done);
  });
})();
</script>
