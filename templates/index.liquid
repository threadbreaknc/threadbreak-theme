<script>
(function(){
  var vid = document.querySelector('.hc-hero-video');
  var fade = document.getElementById('hcLoopFade');
  if (!vid) return;

  // Desktop starts the video immediately: waiting for window.load plus a timeout
  // guaranteed the poster flashed first. Mobile still keeps the poster only, so
  // phones get a fast LCP and never download the video.
  var isDesktop = !window.matchMedia('(max-width: 768px)').matches;
  function initHeroVideo(){
    if (!isDesktop) return;
    if (vid.dataset.loaded) return;
    var src = vid.getAttribute('data-video-src');
    if (!src) return;
    vid.dataset.loaded = "1";
    vid.preload = 'auto';
    var s1 = document.createElement('source'); s1.src = src; s1.type = 'video/quicktime';
    var s2 = document.createElement('source'); s2.src = src; s2.type = 'video/mp4';
    vid.appendChild(s1); vid.appendChild(s2);
    vid.load();
    var p = vid.play();
    if (p && p.catch) p.catch(function(){});
  }
  // this script sits after the video element, so the download starts at parse time
  initHeroVideo();

  var TRIM = 2.5;
  var FADE = 0.5;
  var looping = false;

  vid.addEventListener('timeupdate', function(){
    if (!vid.duration || isNaN(vid.duration)) return;
    var cutoff = vid.duration - TRIM;
    if (!looping && vid.currentTime >= cutoff - FADE){
      if (fade) fade.classList.add('show');
    }
    if (!looping && vid.currentTime >= cutoff){
      looping = true;
      vid.currentTime = 0;
      setTimeout(function(){
        if (fade) fade.classList.remove('show');
        looping = false;
      }, FADE * 1000);
    }
  });
})();
</script>
