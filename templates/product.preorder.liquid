{%- assign selected_variant = product.selected_or_first_available_variant -%}

<div class="product-page">
  <section class="product-main">

    <!-- GALLERY -->
    <div class="product-gallery">
      <div class="product-gallery-main">
        <img
          src="{{ selected_variant.featured_image | default: product.featured_image | img_url: '800x800', crop: 'center' }}"
          alt="{{ product.title | escape }}"
          id="product-main-img"
          class="product-main-img">
      </div>

      <div class="product-thumbs">
        {%- for image in product.images limit: 6 -%}
          <button
            type="button"
            class="product-thumb{% if forloop.first %} active{% endif %}"
            data-src="{{ image | img_url: '800x800', crop: 'center' }}">
            <img src="{{ image | img_url: '160x160', crop: 'center' }}" alt="{{ product.title | escape }}">
          </button>
        {%- endfor -%}
      </div>
    </div>

    <!-- INFO -->
    <div class="product-info">
      <h1 class="product-title">{{ product.title }}</h1>

      <div class="product-price-row">
        <p class="product-price" id="product-price">{{ selected_variant.price | money }}</p>
      </div>

      {%- form 'product', product, id: 'product-form' -%}
        <input type="hidden" name="id" id="variant-id" value="{{ selected_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product-option">
              <p class="option-label">
                {{ option.name }}:
                <span class="option-selected" id="option-{{ forloop.index0 }}-label">
                  {{ option.selected_value }}
                </span>
              </p>

              <div class="option-swatches">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="swatch{% if value == option.selected_value %} active{% endif %}"
                    data-value="{{ value | escape }}"
                    data-option-index="{{ forloop.parentloop.index0 }}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <!-- Low stock warning -->
        <div id="low-stock-msg" style="display:none;" class="low-stock-wrap">
          <span class="low-stock-dot"></span>
          <span id="low-stock-text"></span>
        </div>

        <div class="product-actions">
          <div class="qty-wrap">
            <button type="button" class="qty-btn" id="qty-minus">−</button>
            <input type="number" name="quantity" value="1" min="1" id="qty-input" class="qty-input">
            <button type="button" class="qty-btn" id="qty-plus">+</button>
          </div>

          <button
            type="submit"
            class="btn btn-fill product-atc"
            id="atc-btn"
            {% unless selected_variant.available %}disabled{% endunless %}>
            {%- if selected_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
          </button>
        </div>

        <div class="product-trust-row" style="justify-content:center;">
          <span class="ptr-item">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Secure checkout
          </span>
          <span class="ptr-sep">·</span>
          <span class="ptr-item">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            Free shipping
          </span>
          <span class="ptr-sep">·</span>
          <span class="ptr-item">✦ Made in NC</span>
        </div>

        {%- if product.metafields.custom.sticker_url != blank -%}
          <a href="{{ product.metafields.custom.sticker_url }}" class="sticker-upsell">
            <span class="sticker-upsell-icon">🔖</span>
            <div>
              <p class="sticker-upsell-title">Also available as a sticker pack</p>
              <p class="sticker-upsell-sub">Get this design as a sticker. Tap to shop.</p>
            </div>
            <span class="sticker-upsell-arrow">→</span>
          </a>
        {%- endif -%}

      {%- endform -%}

      <div class="product-desc">{{ product.description }}</div>
    </div>
  </section>

  {%- if product.metafields.custom.wild_photo_1 != blank -%}
    <section class="in-the-wild">
      <div class="wild-header">
        <p class="eyebrow reveal">
          {%- if product.metafields.custom.wild_location != blank -%}
            Spotted at {{ product.metafields.custom.wild_location }}
          {%- else -%}
            In The Wild
          {%- endif -%}
        </p>
        <h2 class="reveal reveal-d1">In The Wild.</h2>
        <p class="reveal reveal-d2">Real fans. Real games. Real hats.</p>
      </div>

      <div class="wild-photos{% if product.metafields.custom.wild_photo_2 == blank %} wild-photos--single{% endif %}">
        <div class="wild-photo reveal">
          <img src="{{ product.metafields.custom.wild_photo_1 | img_url: '800x800' }}" alt="{{ product.title | escape }} in the wild">
          {%- if product.metafields.custom.wild_location != blank -%}
            <div class="wild-tag">📍 {{ product.metafields.custom.wild_location }}</div>
          {%- endif -%}
        </div>

        {%- if product.metafields.custom.wild_photo_2 != blank -%}
          <div class="wild-photo reveal reveal-d1">
            <img src="{{ product.metafields.custom.wild_photo_2 | img_url: '800x800' }}" alt="{{ product.title | escape }} in the wild">
            {%- if product.metafields.custom.wild_location != blank -%}
              <div class="wild-tag">📍 {{ product.metafields.custom.wild_location }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if product.collections.first.products.size > 1 -%}
    <section class="related-products">
      <p class="eyebrow reveal">Keep Browsing</p>
      <h2 class="reveal reveal-d1">You May Also Like</h2>

      <div class="related-grid">
        {%- for related in product.collections.first.products limit: 5 -%}
          {%- unless related.handle == product.handle -%}
            <a href="{{ related.url }}" class="hat-card reveal">
              <div class="hat-img-wrap">
                <img src="{{ related.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ related.title | escape }}" class="hat-img">
              </div>
              <div class="hat-info">
                <div class="hat-name">{{ related.title }}</div>
                <div class="hat-price">{{ related.price | money }}</div>
              </div>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</div>

<style>
  .product-atc:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .product-atc:not(:disabled) {
    opacity: 1;
    cursor: pointer;
  }
  .low-stock-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #c0392b;
    margin-bottom: 0.75rem;
  }
  .low-stock-dot {
    width: 7px;
    height: 7px;
    background: #c0392b;
    border-radius: 50%;
    flex-shrink: 0;
    animation: stockPulse 1.5s ease-in-out infinite;
  }
  @keyframes stockPulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }
</style>

<script>
  var productData = {{ product | json }};

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function getSelectedOptions() {
    var selected = [];

    document.querySelectorAll('.product-option').forEach(function(optionWrap) {
      var active = optionWrap.querySelector('.swatch.active');
      if (active) selected.push(active.dataset.value);
    });

    return selected;
  }

  function findMatchingVariant() {
    var selectedOptions = getSelectedOptions();

    return productData.variants.find(function(variant) {
      return variant.options.every(function(optionValue, index) {
        return optionValue === selectedOptions[index];
      });
    });
  }

  function updateProductFromVariant(variant) {
    var variantInput = document.getElementById('variant-id');
    var priceEl = document.getElementById('product-price');
    var btn = document.getElementById('atc-btn');
    var mainImg = document.getElementById('product-main-img');

    if (!variant) {
      if (btn) {
        btn.textContent = 'Unavailable';
        btn.disabled = true;
      }
      return;
    }

    if (variantInput) variantInput.value = variant.id;
    if (priceEl) priceEl.textContent = formatMoney(variant.price);

    if (mainImg && variant.featured_image && variant.featured_image.src) {
      mainImg.style.opacity = '0';
      setTimeout(function() {
        mainImg.src = variant.featured_image.src;
        mainImg.style.opacity = '1';
      }, 200);
    }

    if (btn) {
      if (variant.available) {
        btn.textContent = 'Add to Cart';
        btn.disabled = false;
      } else {
        btn.textContent = 'Sold Out';
        btn.disabled = true;
      }
    }
  }

  // Inventory map for low stock warnings
  var inventoryMap = {
    {%- for variant in product.variants -%}
      '{{ variant.id }}': {{ variant.inventory_quantity }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  };

  function updateLowStock(variantId) {
    var qty = inventoryMap[String(variantId)];
    var wrap = document.getElementById('low-stock-msg');
    var text = document.getElementById('low-stock-text');
    if (!wrap || !text) return;
    if (qty !== undefined && qty === 0) {
      text.textContent = 'This size is sold out.';
      wrap.style.display = 'flex';
      wrap.style.color = '#888';
      wrap.querySelector('.low-stock-dot').style.background = '#888';
      wrap.querySelector('.low-stock-dot').style.animation = 'none';
    } else if (qty !== undefined && qty > 0 && qty < 5) {
      text.textContent = 'Only ' + qty + ' left in this size!';
      wrap.style.display = 'flex';
      wrap.style.color = '#c0392b';
      wrap.querySelector('.low-stock-dot').style.background = '#c0392b';
      wrap.querySelector('.low-stock-dot').style.animation = '';
    } else {
      wrap.style.display = 'none';
    }
  }

  // Check on page load
  // Show inventory on load
  var initialVariant = findMatchingVariant();
  if (initialVariant) updateLowStock(initialVariant.id);

  // Qty buttons
  var qtyMinus = document.getElementById('qty-minus');
  var qtyPlus = document.getElementById('qty-plus');
  var qtyInput = document.getElementById('qty-input');

  if (qtyMinus && qtyInput) {
    qtyMinus.addEventListener('click', function() {
      qtyInput.value = Math.max(1, parseInt(qtyInput.value || 1) - 1);
    });
  }

  if (qtyPlus && qtyInput) {
    qtyPlus.addEventListener('click', function() {
      qtyInput.value = parseInt(qtyInput.value || 1) + 1;
    });
  }

  // Thumbnail swap
  document.querySelectorAll('.product-thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      var main = document.getElementById('product-main-img');

      if (main) {
        main.style.opacity = '0';
        setTimeout(function() {
          main.src = thumb.dataset.src;
          main.style.opacity = '1';
        }, 200);
      }

      document.querySelectorAll('.product-thumb').forEach(function(t) {
        t.classList.remove('active');
      });

      thumb.classList.add('active');
    });
  });

  // Swatch click
  document.querySelectorAll('.swatch').forEach(function(swatch) {
    swatch.addEventListener('click', function() {
      var optIdx = swatch.dataset.optionIndex;

      document.querySelectorAll('.swatch[data-option-index="' + optIdx + '"]').forEach(function(s) {
        s.classList.remove('active');
      });

      swatch.classList.add('active');

      var label = document.getElementById('option-' + optIdx + '-label');
      if (label) label.textContent = swatch.dataset.value;

      var matchingVariant = findMatchingVariant();
      updateProductFromVariant(matchingVariant);
      if (matchingVariant) updateLowStock(matchingVariant.id);
    });
  });

  // Initial button state
  var startVariant = findMatchingVariant();
  updateProductFromVariant(startVariant);
  if (startVariant) updateLowStock(startVariant.id);

  // Scroll reveal
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) e.target.classList.add('visible');
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach(function(el) {
      observer.observe(el);
    });
  }
</script>
